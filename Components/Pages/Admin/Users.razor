    private async Task ApplyAuditFiltersAsync()
    {
        _auditPage = 1;
        await LoadAuditAsync();
    }

    private async Task PrevAuditPageAsync()
    {
        if (_auditPage <= 1)
        {
            return;
        }

        _auditPage--;
        await LoadAuditAsync();
    }

    private async Task NextAuditPageAsync()
    {
        if (!_auditHasNextPage)
        {
            return;
        }

        _auditPage++;
        await LoadAuditAsync();
    }

    private async Task LoadAuditAsync()
    {
        _auditLoading = true;
        try
        {
            DateTime? fromUtc = ParseDate(_auditFromDate, endOfDay: false);
            DateTime? toUtc = ParseDate(_auditToDate, endOfDay: true);
            AdminAuditListResponseDto response = await AdminAuditService.QueryAsync(
                new AdminAuditQueryDto(
                    _auditPage,
                    _auditPageSize,
                    _auditAdminFilter,
                    _auditTargetFilter,
                    _auditActionFilter,
                    fromUtc,
                    toUtc));
            _auditItems.Clear();
            _auditItems.AddRange(response.Items);
            _auditTotalCount = response.TotalCount;
            _auditHasNextPage = (_auditPage * _auditPageSize) < _auditTotalCount;
        }
        catch (Exception ex)
        {
            AddToast(ex.Message, "error");
            Logger.LogError(ex, "Failed to load audit events.");
        }
        finally
        {
            _auditLoading = false;
        }
    }

