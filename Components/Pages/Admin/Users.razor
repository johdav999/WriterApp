    private void SyncQueryString()
    {
        Dictionary<string, string?> values = new(StringComparer.Ordinal)
        {
            ["page"] = _page.ToString(System.Globalization.CultureInfo.InvariantCulture),
            ["pageSize"] = _pageSize.ToString(System.Globalization.CultureInfo.InvariantCulture),
            ["q"] = _searchText,
            ["plan"] = _planFilter,
            ["status"] = _subscriptionStatusFilter,
            ["overrideOnly"] = _overrideOnly ? "true" : null,
            ["tokensMin"] = _tokensLeftMinInput,
            ["tokensMax"] = _tokensLeftMaxInput,
            ["sort"] = _sort
        };

        string next = QueryHelpers.AddQueryString("/admin/users", values);
        if (!string.Equals(Navigation.ToBaseRelativePath(Navigation.Uri), next.TrimStart('/'), StringComparison.Ordinal))
        {
            Navigation.NavigateTo(next, replace: true);
        }
    }

    private static int ReadInt(IReadOnlyDictionary<string, Microsoft.Extensions.Primitives.StringValues> query, string key, int fallback)
    {
        if (!query.TryGetValue(key, out Microsoft.Extensions.Primitives.StringValues values))
        {
            return fallback;
        }

        return int.TryParse(values.ToString(), out int parsed) ? parsed : fallback;
    }

    private static string? ReadString(IReadOnlyDictionary<string, Microsoft.Extensions.Primitives.StringValues> query, string key)
    {
        if (!query.TryGetValue(key, out Microsoft.Extensions.Primitives.StringValues values))
        {
            return null;
        }

        string value = values.ToString();
        return string.IsNullOrWhiteSpace(value) ? null : value;
    }

    private static bool ReadBool(IReadOnlyDictionary<string, Microsoft.Extensions.Primitives.StringValues> query, string key)
    {
        if (!query.TryGetValue(key, out Microsoft.Extensions.Primitives.StringValues values))
        {
            return false;
        }

        string raw = values.ToString();
        return raw.Equals("true", StringComparison.OrdinalIgnoreCase) || raw == "1";
    }

    private static int? ParseNullableInt(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw))
        {
            return null;
        }

        return int.TryParse(raw, out int parsed) ? parsed : null;
    }

    private static DateTime? ParseDate(DateTime? raw, bool endOfDay)
    {
        if (!raw.HasValue)
        {
            return null;
        }

        DateTime utc = DateTime.SpecifyKind(raw.Value.Date, DateTimeKind.Utc);
        return endOfDay ? utc.AddDays(1).AddTicks(-1) : utc;
    }

    private async Task<AdminActorContext> GetAdminActorAsync()
    {
        AuthenticationState authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        ClaimsPrincipal user = authState.User;
        string? callerName = user.Identity?.Name;

        string adminUserId;
        try
        {
            adminUserId = UserIdResolver.ResolveUserId(user);
        }
        catch (SecurityException ex)
        {
            Logger.LogWarning(ex, "Admin action missing oid claim.");
            adminUserId = callerName ?? "admin";
        }

        string? adminEmail = user.FindFirstValue(ClaimTypes.Email)
            ?? user.FindFirstValue("emails")
            ?? user.FindFirstValue("preferred_username")
            ?? callerName;

        return new AdminActorContext(adminUserId, adminEmail);
    }

