@inject NavigationManager Navigation
@using WriterApp.Shared

@code {
    private const string DefaultReturnUrl = ReturnUrlSafety.DefaultProjectsPath;

    protected override void OnInitialized()
    {
        Uri current = Navigation.ToAbsoluteUri(Navigation.Uri);
        string returnUrl = ReturnUrlSafety.NormalizeOrFallback(current.PathAndQuery, DefaultReturnUrl);

        string target = $"/app/login?returnUrl={Uri.EscapeDataString(returnUrl)}";

        Navigation.NavigateTo(target, forceLoad: true);
    }
}
