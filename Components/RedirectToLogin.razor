@inject NavigationManager Navigation

@code {
    protected override void OnInitialized()
    {
        Uri current = Navigation.ToAbsoluteUri(Navigation.Uri);
        string returnUrl = current.PathAndQuery;
        if (string.IsNullOrWhiteSpace(returnUrl))
        {
            returnUrl = "/";
        }
        else if (!returnUrl.StartsWith("/", StringComparison.Ordinal))
        {
            returnUrl = "/" + returnUrl;
        }

        string target = $"/app/login?returnUrl={Uri.EscapeDataString(returnUrl)}";

        Navigation.NavigateTo(target, forceLoad: true);
    }
}
