@using Microsoft.AspNetCore.Components.Authorization

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Writer</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/app/documents" Match="NavLinkMatch.Prefix" title="Open the Projects hub.">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Projects
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <a class="nav-link" href="/app/projects" title="Plan structure in Projects view.">
                <span class="bi bi-diagram-nav-menu" aria-hidden="true"></span> Projects
            </a>
        </div>
        <AuthorizeView Policy="AdminOnly">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/admin/users">
                        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span>
                        Users
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>
        
    </nav>
</div>
