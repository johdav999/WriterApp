@page "/login"
@page "/app/login"
@using Microsoft.AspNetCore.Components.WebAssembly.Hosting
@using WriterApp.Client.Utilities
@inject NavigationManager Navigation
@inject IWebAssemblyHostEnvironment HostEnvironment

<PageTitle>Sign in</PageTitle>

<p>@_statusMessage</p>
@if (_showSignInLink)
{
    <p><a href="@_loginUrl">Sign in</a></p>
}

@code {
    private const string DefaultReturnUrl = SafeReturnUrl.DefaultDocumentsPath;
    private string _statusMessage = "Checking sign-in...";
    private string _loginUrl = "/.auth/login/aad";
    private bool _showSignInLink;

    protected override Task OnInitializedAsync()
    {
        Uri currentUri = Navigation.ToAbsoluteUri(Navigation.Uri);
        string returnUrl = ResolveReturnUrl(currentUri.Query);

        if (HostEnvironment.IsDevelopment() || currentUri.IsLoopback)
        {
            _statusMessage = "Signed in (dev). Redirecting...";
            Navigation.NavigateTo(returnUrl, forceLoad: true);
            return Task.CompletedTask;
        }

        _loginUrl = EasyAuthUrlBuilder.BuildLoginUrl(Navigation.BaseUri, returnUrl, DefaultReturnUrl);
        _statusMessage = "You are not signed in. Please use the sign-in link.";
        _showSignInLink = true;
        return Task.CompletedTask;
    }

    private static string ResolveReturnUrl(string queryString)
    {
        Dictionary<string, string> query = QueryStringParser.Parse(queryString);
        return SafeReturnUrl.ResolveFromQuery(query, fallback: DefaultReturnUrl);
    }
}
