@page "/start"
@page "/app/start"
@using System.Net
@using System.Net.Http.Json
@using WriterApp.Application.Documents
@using WriterApp.Client.Utilities
@inject NavigationManager Navigation
@inject HttpClient Http

<PageTitle>Start</PageTitle>

<p>@_statusMessage</p>
@if (!string.IsNullOrWhiteSpace(_signInUrl))
{
    <p><a href="@_signInUrl">@(_showDeletedAccountMessage ? "Sign out" : "Sign in")</a></p>
}

@code {
    private const string DefaultReturnUrl = SafeReturnUrl.DefaultProjectsPath;
    private string _statusMessage = "Preparing your workspace...";
    private string? _signInUrl;
    private bool _showDeletedAccountMessage;

    protected override async Task OnInitializedAsync()
    {
        Uri currentUri = Navigation.ToAbsoluteUri(Navigation.Uri);
        Dictionary<string, string> query = QueryStringParser.Parse(currentUri.Query);

        PlanTier requestedPlan = ParseRequestedPlan(query);
        string returnUrl = ResolveReturnUrl(query);

        AuthMeResponse? auth = await TryGetAuthMeAsync();
        if (_showDeletedAccountMessage)
        {
            _signInUrl = EasyAuthUrlBuilder.BuildLogoutUrl(Navigation.BaseUri, SafeReturnUrl.DefaultHomePath, SafeReturnUrl.DefaultHomePath);
            return;
        }

        if (auth is null || auth.IsAuthenticated != true || string.IsNullOrWhiteSpace(auth.UserId))
        {
            _statusMessage = "You are not signed in. Please use the sign-in link.";
            _signInUrl = EasyAuthUrlBuilder.BuildLoginUrl(Navigation.BaseUri, returnUrl, SafeReturnUrl.DefaultDocumentsPath);
            return;
        }

        if (requestedPlan == PlanTier.Free)
        {
            if (await IsFirstRunAsync())
            {
                string onboardingUrl = $"/app/onboarding?returnUrl={Uri.EscapeDataString(returnUrl)}";
                Navigation.NavigateTo(onboardingUrl, forceLoad: true);
                return;
            }

            Navigation.NavigateTo(returnUrl, forceLoad: true);
            return;
        }

        PlanTier currentPlan = ResolveCurrentPlanTier(auth);
        if (currentPlan >= requestedPlan)
        {
            Navigation.NavigateTo(returnUrl, forceLoad: true);
            return;
        }

        string checkoutUrl = $"/app/billing/checkout?plan={ToQueryValue(requestedPlan)}&returnUrl={Uri.EscapeDataString(returnUrl)}";
        Navigation.NavigateTo(checkoutUrl, forceLoad: true);
    }

    private async Task<AuthMeResponse?> TryGetAuthMeAsync()
    {
        try
        {
            using HttpResponseMessage response = await Http.GetAsync("/api/auth/me");
            if (response.StatusCode == HttpStatusCode.Forbidden)
            {
                DeletedAccountResponse? deleted = await response.Content.ReadFromJsonAsync<DeletedAccountResponse>();
                if (string.Equals(deleted?.Code, "account_deleted", StringComparison.Ordinal))
                {
                    _showDeletedAccountMessage = true;
                    _statusMessage = deleted?.Message ?? "This Prosa account has been deleted. Sign out before registering again.";
                    return null;
                }
            }

            if (response.StatusCode is HttpStatusCode.Unauthorized or HttpStatusCode.Forbidden)
            {
                return null;
            }

            if (!response.IsSuccessStatusCode)
            {
                return null;
            }

            return await response.Content.ReadFromJsonAsync<AuthMeResponse>();
        }
        catch
        {
            return null;
        }
    }

    private async Task<bool> IsFirstRunAsync()
    {
        UserProfileResponse? profile = await TryGetUserProfileAsync();
        if (profile?.HasOnboarded == true)
        {
            return false;
        }

        try
        {
            using HttpResponseMessage response = await Http.GetAsync("/api/projects/list-items");
            if (response.StatusCode == HttpStatusCode.NotFound)
            {
                return false;
            }

            if (!response.IsSuccessStatusCode)
            {
                return false;
            }

            List<ProjectListItemDto>? items = await response.Content.ReadFromJsonAsync<List<ProjectListItemDto>>();
            return items is null || items.Count == 0;
        }
        catch
        {
            return false;
        }
    }

    private async Task<UserProfileResponse?> TryGetUserProfileAsync()
    {
        try
        {
            using HttpResponseMessage response = await Http.GetAsync("/api/user/profile");
            if (response.StatusCode is HttpStatusCode.Unauthorized or HttpStatusCode.Forbidden)
            {
                return null;
            }

            if (!response.IsSuccessStatusCode)
            {
                return null;
            }

            return await response.Content.ReadFromJsonAsync<UserProfileResponse>();
        }
        catch
        {
            return null;
        }
    }

    private static PlanTier ParseRequestedPlan(Dictionary<string, string> query)
    {
        if (!query.TryGetValue("plan", out string? raw))
        {
            return PlanTier.Free;
        }

        if (string.IsNullOrWhiteSpace(raw))
        {
            return PlanTier.Free;
        }

        string normalized = raw.Trim().ToLowerInvariant();
        return normalized switch
        {
            "standard" => PlanTier.Standard,
            "pro" => PlanTier.Pro,
            "professional" => PlanTier.Pro,
            "free" => PlanTier.Free,
            _ => PlanTier.Free
        };
    }

    private static string ResolveReturnUrl(Dictionary<string, string> query)
    {
        return SafeReturnUrl.ResolveFromQuery(query, fallback: DefaultReturnUrl);
    }

    private static PlanTier ResolveCurrentPlanTier(AuthMeResponse auth)
    {
        PlanTier fromPlan = ParsePlanTier(auth.Plan);
        if (fromPlan != PlanTier.Free)
        {
            return fromPlan;
        }

        PlanTier fromPlanKey = ParsePlanTier(auth.PlanKey);
        if (fromPlanKey != PlanTier.Free)
        {
            return fromPlanKey;
        }

        foreach (string role in auth.Roles ?? Array.Empty<string>())
        {
            PlanTier fromRole = ParsePlanTier(role);
            if (fromRole > PlanTier.Free)
            {
                return fromRole;
            }
        }

        return PlanTier.Free;
    }

    private static PlanTier ParsePlanTier(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return PlanTier.Free;
        }

        string normalized = value.Trim().ToLowerInvariant();
        return normalized switch
        {
            "pro" => PlanTier.Pro,
            "professional" => PlanTier.Pro,
            "standard" => PlanTier.Standard,
            "free" => PlanTier.Free,
            _ when normalized.Contains("professional", StringComparison.Ordinal) => PlanTier.Pro,
            _ when normalized.Contains("standard", StringComparison.Ordinal) => PlanTier.Standard,
            _ when normalized.Contains("pro", StringComparison.Ordinal) => PlanTier.Pro,
            _ => PlanTier.Free
        };
    }

    private enum PlanTier
    {
        Free = 0,
        Standard = 1,
        Pro = 2
    }

    private sealed class AuthMeResponse
    {
        public bool IsAuthenticated { get; init; }
        public string? UserId { get; init; }
        public string? Plan { get; init; }
        public string? PlanKey { get; init; }
        public IReadOnlyList<string> Roles { get; init; } = Array.Empty<string>();
    }

    private sealed class UserProfileResponse
    {
        public bool HasOnboarded { get; init; }
    }

    private sealed class DeletedAccountResponse
    {
        public string? Code { get; init; }
        public string? Message { get; init; }
    }

    private static string ToQueryValue(PlanTier plan)
    {
        return plan switch
        {
            PlanTier.Standard => "standard",
            PlanTier.Pro => "pro",
            _ => "free"
        };
    }
}
