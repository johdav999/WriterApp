@page "/onboarding"
@using System
@using System.Collections.Generic
@using System.Linq
@using System.Net.Http.Json
@using WriterApp.Application.Documents
@using WriterApp.Client.Services
@using WriterApp.Client.State
@inject HttpClient Http
@inject NavigationManager Navigation
@inject OnboardingService OnboardingService
@inject OnboardingStateStore OnboardingStateStore

<PageTitle>Onboarding</PageTitle>

<section class="onboarding-shell">
    <header class="onboarding-header">
        <h1>Onboarding</h1>
        <p>Choose what you are writing. We will set up your first project and open the editor.</p>
        <p>Step 1 of 1</p>
    </header>

    <div class="onboarding-card">
        <div class="onboarding-field">
            <label>What are you writing?</label>
            <div class="onboarding-intent-grid" role="listbox" aria-label="Writing intent options">
                @foreach (IntentOption option in _intentOptions)
                {
                    bool isSelected = string.Equals(_selectedIntent, option.Key, StringComparison.Ordinal);
                    <button type="button"
                            class="onboarding-intent-tile @(isSelected ? "is-selected" : string.Empty)"
                            disabled="@_isBusy"
                            aria-selected="@isSelected"
                            aria-pressed="@isSelected"
                            @onclick="() => SelectIntentAsync(option.Key)">
                        <span class="intent-icon" aria-hidden="true">@option.Icon</span>
                        <span class="intent-content">
                            <span class="intent-title">@option.Label</span>
                            <span class="intent-subtitle">@option.Subtitle</span>
                        </span>
                        <span class="intent-check" aria-hidden="true">&#10003;</span>
                    </button>
                }
            </div>
        </div>

        @if (_isBusy)
        {
            <div class="onboarding-status is-info">Creating your project and opening the editor...</div>
        }
        else if (!string.IsNullOrWhiteSpace(_status))
        {
            <div class="onboarding-status @(_statusIsError ? "is-error" : "is-info")">@_status</div>
        }
    </div>
</section>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private string? _status;
    private bool _statusIsError;
    private bool _isBusy;
    private string _selectedIntent = "Other";

    private readonly IReadOnlyList<IntentOption> _intentOptions = new List<IntentOption>
    {
        new("Novel", "Novel", "Long-form fiction storytelling", "📖"),
        new("ShortStory", "Short story", "Compact narrative arcs", "✍️"),
        new("NonFiction", "Non-fiction", "Research and chapter-driven writing", "📚"),
        new("Blog", "Blog", "Posts, essays, and web publishing", "📝"),
        new("Other", "Other", "Custom structure and flexible workflow", "✨")
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await OnboardingStateStore.RefreshAsync();

            if (OnboardingStateStore.Current.HasCompletedOnboarding)
            {
                Navigation.NavigateTo("/projects", replace: true);
                return;
            }

            _selectedIntent = ResolveIntentKey(OnboardingStateStore.Current.PrimaryWritingIntent);
        }
        catch
        {
            _selectedIntent = "Other";
        }
    }

    private async Task SelectIntentAsync(string intent)
    {
        if (_isBusy)
        {
            return;
        }

        _isBusy = true;
        _status = null;
        _statusIsError = false;

        try
        {
            string normalizedIntent = ResolveIntentKey(intent);
            _selectedIntent = normalizedIntent;

            await OnboardingService.SetIntentAsync(normalizedIntent);
            await OnboardingService.SetStepAsync(1);

            (ProjectDto? project, Guid? firstSceneNodeId) = await CreateFirstProjectAsync(normalizedIntent);
            if (project is null)
            {
                _status = "Could not create your first project.";
                _statusIsError = true;
                return;
            }

            Guid? sceneNodeId = firstSceneNodeId ?? await TryGetFirstSceneIdAsync(project.Id);
            if (!sceneNodeId.HasValue)
            {
                _status = "Project created, but opening the first scene failed.";
                _statusIsError = true;
                return;
            }

            await OnboardingService.SetStepAsync(2);
            try
            {
                await OnboardingService.TrackEventAsync(
                    "onboarding_project_created",
                    new Dictionary<string, object?>
                    {
                        ["projectId"] = project.Id.ToString(),
                        ["intent"] = normalizedIntent
                    });
            }
            catch (Exception ex)
            {
                Console.Error.WriteLine(ex);
            }

            await OnboardingStateStore.RefreshAsync();
            Navigation.NavigateTo($"projects/{project.Id}/scenes/{sceneNodeId.Value}", replace: true);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(ex);
            _status = "We couldn't set up onboarding right now. Please try again.";
            _statusIsError = true;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task<(ProjectDto? Project, Guid? FirstSceneNodeId)> CreateFirstProjectAsync(string intent)
    {
        string projectName = GetDefaultProjectName(intent);
        ProjectCreateRequest request = new(projectName, null, null, null, null, null);
        using HttpResponseMessage response = await Http.PostAsJsonAsync("/api/projects", request);
        response.EnsureSuccessStatusCode();

        ProjectDto? created = await response.Content.ReadFromJsonAsync<ProjectDto>();
        if (created is null)
        {
            return (null, null);
        }

        Guid? firstSceneNodeId = await BuildInitialStructureAsync(created.Id, intent);
        return (created, firstSceneNodeId);
    }

    private async Task<Guid?> TryGetFirstSceneIdAsync(Guid projectId)
    {
        try
        {
            using HttpResponseMessage response = await Http.GetAsync($"/api/projects/{projectId}/tree");
            if (!response.IsSuccessStatusCode)
            {
                return null;
            }

            ProjectTreeDto? tree = await response.Content.ReadFromJsonAsync<ProjectTreeDto>();
            ProjectNodeDto? firstScene = tree is null ? null : FindFirstScene(tree.Nodes);
            return firstScene?.Id;
        }
        catch
        {
            return null;
        }
    }

    private async Task<Guid?> BuildInitialStructureAsync(Guid projectId, string intent)
    {
        string normalized = NormalizeIntent(intent);
        return normalized switch
        {
            "Novel" => await BuildNovelStructureAsync(projectId),
            "Blog" => await BuildBlogStructureAsync(projectId),
            "NonFiction" => await BuildNonFictionStructureAsync(projectId),
            "ShortStory" => await BuildShortStoryStructureAsync(projectId),
            _ => await BuildOtherStructureAsync(projectId)
        };
    }

    private async Task<Guid?> BuildNovelStructureAsync(Guid projectId)
    {
        ProjectNodeDto? act1 = await CreateNodeAsync(projectId, null, "part", "Act I");
        if (act1 is null)
        {
            return null;
        }

        ProjectNodeDto? scene1 = await CreateNodeAsync(projectId, act1.Id, "scene", "Scene 1");
        return scene1?.Id;
    }

    private async Task<Guid?> BuildBlogStructureAsync(Guid projectId)
    {
        ProjectNodeDto? draft = await CreateNodeAsync(projectId, null, "chapter", "Draft");
        await CreateNodeAsync(projectId, null, "chapter", "Headline Ideas");
        if (draft is null)
        {
            return null;
        }

        ProjectNodeDto? scene = await CreateNodeAsync(projectId, draft.Id, "scene", "Scene 1");
        return scene?.Id;
    }

    private async Task<Guid?> BuildNonFictionStructureAsync(Guid projectId)
    {
        ProjectNodeDto? chapter1 = await CreateNodeAsync(projectId, null, "chapter", "Chapter 1");
        await CreateNodeAsync(projectId, null, "chapter", "Research");
        if (chapter1 is null)
        {
            return null;
        }

        ProjectNodeDto? scene = await CreateNodeAsync(projectId, chapter1.Id, "scene", "Scene 1");
        return scene?.Id;
    }

    private async Task<Guid?> BuildShortStoryStructureAsync(Guid projectId)
    {
        ProjectNodeDto? draft = await CreateNodeAsync(projectId, null, "chapter", "Draft");
        await CreateNodeAsync(projectId, null, "chapter", "Ending Notes");
        if (draft is null)
        {
            return null;
        }

        ProjectNodeDto? scene = await CreateNodeAsync(projectId, draft.Id, "scene", "Scene 1");
        return scene?.Id;
    }

    private async Task<Guid?> BuildOtherStructureAsync(Guid projectId)
    {
        ProjectNodeDto? draft = await CreateNodeAsync(projectId, null, "chapter", "Draft");
        if (draft is null)
        {
            return null;
        }

        ProjectNodeDto? scene = await CreateNodeAsync(projectId, draft.Id, "scene", "Scene 1");
        return scene?.Id;
    }

    private async Task<ProjectNodeDto?> CreateNodeAsync(
        Guid projectId,
        Guid? parentId,
        string nodeType,
        string title)
    {
        ProjectNodeCreateRequest request = new(parentId, nodeType, title, null, null, null);
        using HttpResponseMessage response = await Http.PostAsJsonAsync($"api/projects/{projectId}/nodes", request);
        if (!response.IsSuccessStatusCode)
        {
            return null;
        }

        return await response.Content.ReadFromJsonAsync<ProjectNodeDto>();
    }

    private static ProjectNodeDto? FindFirstScene(IReadOnlyList<ProjectNodeDto> nodes)
    {
        return nodes
            .Where(node => string.Equals(node.NodeType, "scene", StringComparison.OrdinalIgnoreCase))
            .OrderBy(node => node.OrderIndex)
            .FirstOrDefault();
    }

    private static string NormalizeIntent(string raw)
    {
        string normalized = (raw ?? string.Empty).Trim().ToLowerInvariant();
        return normalized switch
        {
            "novel" => "Novel",
            "short story" => "ShortStory",
            "shortstory" => "ShortStory",
            "non-fiction" => "NonFiction",
            "non fiction" => "NonFiction",
            "nonfiction" => "NonFiction",
            "blog" => "Blog",
            _ => "Other"
        };
    }

    private static string GetDefaultProjectName(string intent)
    {
        return NormalizeIntent(intent) switch
        {
            "Novel" => "My Novel",
            "ShortStory" => "My Short Story",
            "NonFiction" => "My Non-fiction Draft",
            "Blog" => "My Blog Post",
            _ => "My First Project"
        };
    }

    private string ResolveIntentKey(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw))
        {
            return "Other";
        }

        string normalized = NormalizeIntent(raw);
        IntentOption? match = _intentOptions.FirstOrDefault(option =>
            string.Equals(option.Key, normalized, StringComparison.Ordinal));
        return match?.Key ?? "Other";
    }

    private sealed record IntentOption(string Key, string Label, string Subtitle, string Icon);
}
