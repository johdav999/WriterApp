@page "/account"
@page "/app/account"
@implements IDisposable
@using WriterApp.Client.State
@using WriterApp.Shared.Billing
@inject AuthMeStateService AuthMeStateService
@inject NavigationManager Navigation
@inject HttpClient Http
@using System.Net.Http.Json
@using WriterApp.Application.Security
@using WriterApp.Application.Feedback

<PageTitle>Account</PageTitle>

<div class="account-shell">
    <header class="account-header">
        <h1>Account</h1>
        <button type="button" class="secondary" @onclick="RefreshAsync">Refresh</button>
    </header>

    @if(AuthMeStateService.IsAuthenticated) {
    <AccountSummary Profile="AccountProfile">
        <div class="account-actions">
            @if (TryGetUpgradeHref(out string upgradeHref, out string upgradeLabel))
            {
                <button type="button" class="primary" @onclick="() => NavigateToUpgrade(upgradeHref)">@upgradeLabel</button>
            }
            <button type="button" class="secondary" @onclick="OpenBillingSettings">Open billing settings</button>
        </div>
    </AccountSummary>
    } else { <p>Sign in to see verified plan and usage information.</p> }
    <HelpLinks Documentation="OpenDocumentation" FeedbackHref="@(new Uri(Navigation.Uri).AbsolutePath + "#feedback-draft")" />
    <FeedbackComposer CanSend="AuthMeStateService.IsAuthenticated" Busy="_sending" Send="SendFeedback" Destination="Prosa support through this backend" />
    @if(_feedbackMessage is not null) { <p role="status">@_feedbackMessage</p> }
</div>

@code {
    private bool _sending; private string? _feedbackMessage;
    private void OpenDocumentation() => Navigation.NavigateTo("https://docs.prosa-app.com/",forceLoad:true);
    private async Task SendFeedback(FeedbackDraft draft) {
        if(_sending) return; _sending=true;
        try { draft.Validate(); using var response=await Http.PostAsJsonAsync("api/feedback",draft); _feedbackMessage=response.IsSuccessStatusCode ? "Feedback sent." : "Feedback delivery was not confirmed. Check your account before retrying."; }
        catch(Exception e) when(e is HttpRequestException or InvalidOperationException or TaskCanceledException) { _feedbackMessage="Delivery was not confirmed. Feedback may already have been sent; do not retry automatically."; }
        finally { _sending=false; }
    }
    private AuthMeDto AccountProfile => new() {
        StripeCustomerId=AuthMeStateService.StripeCustomerId,PlanKey=AuthMeStateService.PlanKey,EffectivePlanKey=AuthMeStateService.EffectivePlanKey,
        SubscriptionStatus=AuthMeStateService.SubscriptionStatus,CurrentPeriodEndUtc=AuthMeStateService.CurrentPeriodEndUtc,
        CancelAtPeriodEnd=AuthMeStateService.CancelAtPeriodEnd,IsPaidAccessActive=AuthMeStateService.IsPaidAccessActive,
        AiMonthlyTokenBudget=AuthMeStateService.AiMonthlyTokenBudget,AiTokensUsedThisPeriod=AuthMeStateService.AiTokensUsedThisPeriod,
        PeriodStartUtc=AuthMeStateService.PeriodStartUtc
    };

    protected override async Task OnInitializedAsync()
    {
        AuthMeStateService.Changed += OnAuthStateChanged;
        await AuthMeStateService.RefreshAsync();
    }

    public void Dispose()
    {
        AuthMeStateService.Changed -= OnAuthStateChanged;
    }

    private void OnAuthStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task RefreshAsync()
    {
        await AuthMeStateService.RefreshAsync(force: true);
    }

    private bool TryGetUpgradeHref(out string href, out string label)
    {
        if (string.Equals(AuthMeStateService.PlanKey, "Free", StringComparison.OrdinalIgnoreCase))
        {
            href = "/start?plan=standard";
            label = "Upgrade to Standard";
            return true;
        }

        if (string.Equals(AuthMeStateService.PlanKey, "Standard", StringComparison.OrdinalIgnoreCase))
        {
            href = "/start?plan=pro";
            label = "Change plan";
            return true;
        }

        href = string.Empty;
        label = string.Empty;
        return false;
    }

    private void OpenBillingSettings()
    {
        Navigation.NavigateTo("/app/account/billing", forceLoad: true);
    }

    private void NavigateToUpgrade(string href)
    {
        Navigation.NavigateTo(href, forceLoad: true);
    }
}
