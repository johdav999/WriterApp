@page "/account"
@page "/app/account"
@implements IDisposable
@using WriterApp.Client.State
@inject AuthMeStateService AuthMeStateService
@inject NavigationManager Navigation

<PageTitle>Account</PageTitle>

<div class="account-shell">
    <header class="account-header">
        <h1>Account</h1>
        <button type="button" class="secondary" @onclick="RefreshAsync">Refresh</button>
    </header>

    <section class="account-card">
        <div class="account-row"><strong>Plan:</strong> @AuthMeStateService.EffectivePlanKey</div>
        <div class="account-row"><strong>Subscription status:</strong> @GetSubscriptionStatusDisplay()</div>
        <div class="account-row">@GetBillingLifecycleMessage()</div>
        @if (AuthMeStateService.AiMonthlyTokenBudget > 0)
        {
            <div class="account-row"><strong>AI usage:</strong> @AuthMeStateService.AiTokensUsedThisPeriod / @AuthMeStateService.AiMonthlyTokenBudget tokens</div>
        }
        else
        {
            <div class="account-row"><strong>AI:</strong> not included</div>
        }
        <div class="account-row"><strong>Period start:</strong> @FormatPeriodStart()</div>

        <div class="account-actions">
            @if (TryGetUpgradeHref(out string upgradeHref, out string upgradeLabel))
            {
                <button type="button" class="primary" @onclick="() => NavigateToUpgrade(upgradeHref)">@upgradeLabel</button>
            }
            <button type="button" class="secondary" @onclick="OpenBillingSettings">Open billing settings</button>
        </div>
    </section>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        AuthMeStateService.Changed += OnAuthStateChanged;
        await AuthMeStateService.RefreshAsync();
    }

    public void Dispose()
    {
        AuthMeStateService.Changed -= OnAuthStateChanged;
    }

    private void OnAuthStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task RefreshAsync()
    {
        await AuthMeStateService.RefreshAsync(force: true);
    }

    private string FormatPeriodStart()
    {
        if (AuthMeStateService.PeriodStartUtc == DateTimeOffset.MinValue)
        {
            return "-";
        }

        return AuthMeStateService.PeriodStartUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm");
    }

    private string GetSubscriptionStatusDisplay()
    {
        return string.IsNullOrWhiteSpace(AuthMeStateService.SubscriptionStatus)
            ? "-"
            : AuthMeStateService.SubscriptionStatus;
    }

    private string GetBillingLifecycleMessage()
    {
        string planLabel = AuthMeStateService.EffectivePlanKey;
        string formattedDate = FormatBillingDate(AuthMeStateService.CurrentPeriodEndUtc);

        if (string.Equals(planLabel, "Free", StringComparison.OrdinalIgnoreCase))
        {
            return "You are on the Free plan. Upgrading starts a Stripe-managed subscription. Canceling a paid plan does not delete your account.";
        }

        if (AuthMeStateService.CancelAtPeriodEnd && AuthMeStateService.CurrentPeriodEndUtc.HasValue)
        {
            return $"Your {planLabel} plan is scheduled to cancel on {formattedDate}. After that, your account continues on the Free plan.";
        }

        if (AuthMeStateService.IsPaidAccessActive && AuthMeStateService.CurrentPeriodEndUtc.HasValue)
        {
            return $"Your {planLabel} plan renews on {formattedDate}.";
        }

        if (AuthMeStateService.CurrentPeriodEndUtc.HasValue)
        {
            return $"Your {planLabel} plan keeps access until {formattedDate}.";
        }

        return $"Your {planLabel} plan is active.";
    }

    private bool TryGetUpgradeHref(out string href, out string label)
    {
        if (string.Equals(AuthMeStateService.EffectivePlanKey, "Free", StringComparison.OrdinalIgnoreCase))
        {
            href = "/start?plan=standard";
            label = "Upgrade to Standard";
            return true;
        }

        if (string.Equals(AuthMeStateService.EffectivePlanKey, "Standard", StringComparison.OrdinalIgnoreCase))
        {
            href = "/start?plan=pro";
            label = "Change plan";
            return true;
        }

        href = string.Empty;
        label = string.Empty;
        return false;
    }

    private void OpenBillingSettings()
    {
        Navigation.NavigateTo("/app/account/billing", forceLoad: true);
    }

    private void NavigateToUpgrade(string href)
    {
        Navigation.NavigateTo(href, forceLoad: true);
    }

    private static string FormatBillingDate(DateTimeOffset? value)
    {
        return value.HasValue
            ? value.Value.ToLocalTime().ToString("yyyy-MM-dd")
            : "-";
    }
}
