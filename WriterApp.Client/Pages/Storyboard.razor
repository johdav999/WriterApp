@page "/projects/{ProjectId:guid}/storyboard"
@page "/app/projects/{ProjectId:guid}/storyboard"
@using System.Net
@using WriterApp.Application.Subscriptions
@using WriterApp.Client.Components.Projects
@using WriterApp.Client.Services
@using WriterApp.Client.State
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ILogger<Storyboard> Logger
@inject CurrentProjectStateService CurrentProjectStateService
@inject CurrentSceneStateService CurrentSceneStateService
@inject ProjectStructureCacheService ProjectStructureCacheService
@inject FeatureAccessService FeatureAccessService

<PageTitle>Storyboard</PageTitle>

<section class="storyboard-page">
    <header class="storyboard-page__header">
        <div>
            <h1>Storyboard</h1>
            <p class="storyboard-page__subtitle">Visual scene board for managing chapter and scene flow.</p>
        </div>
        @if (_project is not null)
        {
            <div class="storyboard-page__actions">
                <button type="button"
                        class="secondary"
                        title="Reload the storyboard data."
                        @onclick="RefreshStoryboardAsync">
                    Refresh storyboard
                </button>
                <button type="button"
                        class="secondary"
                        title="Open the project structure workspace."
                        @onclick="OpenStructure">
                    Open structure
                </button>
                <button type="button"
                        class="secondary"
                        title="Open the project workspace."
                        @onclick="OpenProject">
                    Open project
                </button>
            </div>
        }
    </header>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="storyboard-page__error">@_error</div>
    }

    @if (_loading)
    {
        <div class="storyboard-page__state">Loading storyboard...</div>
    }
    else if (_project is null)
    {
        <div class="storyboard-page__state">Project not found.</div>
    }
    else
    {
        <div class="@GetLayoutClass()">
            <div class="storyboard-page__panel storyboard-page__panel--board">
                <h2 class="storyboard-page__panel-title">Storyboard</h2>
                <div class="storyboard-page__panel-body">
                    <ProjectStoryboard @ref="_storyboardBoard"
                                       Project="_project"
                                       Nodes="_nodes"
                                       SelectedSceneId="SingleSelectedSceneId"
                                       SelectedSceneIds="_selectedSceneIds"
                                       OnSelectionChanged="HandleSelectionChangedAsync"
                                       OnSceneUpdated="OnSceneUpdatedAsync"
                                       OnStructureChanged="HandleStructureChangedAsync" />
                </div>
            </div>

            @if (!_insightsCollapsed)
            {
                <div class="storyboard-page__panel storyboard-page__panel--insights">
                    <div class="storyboard-page__panel-body">
                        <StoryboardInsightsPanel Project="_project"
                                                 ProjectId="ProjectId"
                                                 Nodes="_nodes"
                                                 SelectedSceneId="SingleSelectedSceneId"
                                                 SelectedSceneIds="_selectedSceneIds"
                                                 IsCollapsed="_insightsCollapsed"
                                                 IsCollapsedChanged="HandleInsightsCollapsedChanged"
                                                 CreateSuggestedScene="CreateSuggestedSceneAsync" />
                    </div>
                </div>
            }

            <div class="storyboard-page__panel storyboard-page__panel--detail">
                <div class="storyboard-page__panel-body">
                    <StoryboardSceneInspector ProjectId="ProjectId"
                                              SceneNode="SelectedSceneNode"
                                              SelectionCount="_selectedSceneIds.Count"
                                              OpenScene="OpenSelectedSceneAsync"
                                              RevealInNavigator="RevealSelectedSceneInNavigatorAsync"
                                              DuplicateScene="DuplicateSelectedSceneAsync"
                                              DeleteScene="DeleteSelectedSceneAsync"
                                              SceneUpdated="OnSceneUpdatedAsync" />
                </div>
            </div>

            @if (_insightsCollapsed)
            {
                <button type="button"
                        class="storyboard-page__insights-rail"
                        aria-expanded="false"
                        aria-label="Expand storyboard insights"
                        title="Expand insights"
                        @onclick="ExpandInsightsAsync">
                    <span class="storyboard-page__insights-rail-icon" aria-hidden="true">&lt;</span>
                    <span class="storyboard-page__insights-rail-label">Insights</span>
                </button>
            }
        </div>
    }
</section>

@code {
    [Parameter]
    public Guid ProjectId { get; set; }

    private ProjectDto? _project;
    private readonly List<ProjectNodeDto> _nodes = new();
    private bool _loading = true;
    private string? _error;
    private HashSet<Guid> _selectedSceneIds = new();
    private Guid? _primarySelectedSceneId;
    private ProjectStoryboard? _storyboardBoard;
    private bool _insightsCollapsed;

    private Guid? SingleSelectedSceneId => _selectedSceneIds.Count == 1
        ? _primarySelectedSceneId is Guid primary && _selectedSceneIds.Contains(primary)
            ? primary
            : _selectedSceneIds.First()
        : null;

    private ProjectNodeDto? SelectedSceneNode => SingleSelectedSceneId.HasValue
        ? _nodes.FirstOrDefault(node => node.Id == SingleSelectedSceneId.Value)
        : null;

    private string GetLayoutClass()
    {
        return _insightsCollapsed
            ? "storyboard-page__layout storyboard-page__layout--insights-collapsed"
            : "storyboard-page__layout";
    }

    private Task HandleInsightsCollapsedChanged(bool isCollapsed)
    {
        _insightsCollapsed = isCollapsed;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task ExpandInsightsAsync()
    {
        return HandleInsightsCollapsedChanged(false);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!FeatureAccessService.CanUse(FeatureKey.ProjectStoryboard))
        {
            Navigation.NavigateTo(
                FeatureAccessService.GetUpgradePathWithReturn(
                    FeatureKey.ProjectStoryboard,
                    $"/projects/{ProjectId:D}/storyboard"),
                replace: true);
            return;
        }

        await LoadStoryboardAsync();
    }

    private async Task LoadStoryboardAsync(bool forceRefresh = false)
    {
        _loading = true;
        _error = null;

        try
        {
            ProjectTreeDto? tree = null;
            if (!forceRefresh && ProjectStructureCacheService.TryGetProjectTree(ProjectId, out ProjectTreeDto cachedTree))
            {
                Logger.LogDebug("Storyboard tree loaded from cache. ProjectId={ProjectId} NodeCount={NodeCount}", ProjectId, cachedTree.Nodes.Count);
                tree = cachedTree;
            }
            else
            {
                if (forceRefresh)
                {
                    Logger.LogDebug("ProjectStructureCache force refresh ProjectId={ProjectId} Reason={Reason}", ProjectId, "storyboard-refresh");
                }

                using HttpResponseMessage response = await Http.GetAsync($"api/projects/{ProjectId}/tree");
                if (response.StatusCode == HttpStatusCode.NotFound)
                {
                    _project = null;
                    _nodes.Clear();
                    return;
                }

                if (!response.IsSuccessStatusCode)
                {
                    _error = "Failed to load storyboard.";
                    _project = null;
                    _nodes.Clear();
                    return;
                }

                tree = await response.Content.ReadFromJsonAsync<ProjectTreeDto>();
                if (tree is not null)
                {
                    ProjectStructureCacheService.SetProjectTree(tree);
                    Logger.LogDebug("Storyboard tree loaded from API. ProjectId={ProjectId} NodeCount={NodeCount}", ProjectId, tree.Nodes.Count);
                }
            }
            
            if (tree?.Project is null)
            {
                _error = "Failed to load storyboard.";
                _project = null;
                _nodes.Clear();
                return;
            }

            _project = tree.Project;
            CurrentProjectStateService.SetCurrent(_project.Id, _project.Title);
            _nodes.Clear();
            _nodes.AddRange(tree.Nodes.OrderBy(node => node.ParentId).ThenBy(node => node.OrderIndex));
            PreserveSelectedScene();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Storyboard page failed to load. ProjectId={ProjectId}", ProjectId);
            _error = "Failed to load storyboard.";
            _project = null;
            _nodes.Clear();
        }
        finally
        {
            _loading = false;
        }
    }

    private Task RefreshStoryboardAsync()
    {
        return LoadStoryboardAsync(forceRefresh: true);
    }

    private async Task HandleStructureChangedAsync()
    {
        if (_storyboardBoard is null)
        {
            Logger.LogInformation(
                "Storyboard structure sync fallback refresh. ProjectId={ProjectId} Reason={Reason}",
                ProjectId,
                "board-unavailable");
            await RefreshStoryboardAsync();
            return;
        }

        IReadOnlyList<ProjectNodeDto> snapshot = _storyboardBoard.GetRenderNodesSnapshot();
        if (snapshot.Count == 0 && _nodes.Count > 0)
        {
            Logger.LogWarning(
                "Storyboard structure sync fallback refresh. ProjectId={ProjectId} Reason={Reason} PreviousNodeCount={PreviousNodeCount}",
                ProjectId,
                "empty-snapshot",
                _nodes.Count);
            await RefreshStoryboardAsync();
            return;
        }

        Logger.LogInformation(
            "Storyboard structure sync applied locally. ProjectId={ProjectId} NodeCount={NodeCount}",
            ProjectId,
            snapshot.Count);

        _nodes.Clear();
        _nodes.AddRange(snapshot);
        PreserveSelectedScene();
        SyncCurrentSceneState();
        await InvokeAsync(StateHasChanged);
    }

    private async Task<bool> CreateSuggestedSceneAsync(StoryboardNextSceneSuggestion suggestion)
    {
        if (_storyboardBoard is null)
        {
            return false;
        }

        return await _storyboardBoard.CreateSuggestedSceneAsync(suggestion);
    }

    private Task OpenSelectedSceneAsync(Guid sceneId)
    {
        return _storyboardBoard is null
            ? Task.CompletedTask
            : _storyboardBoard.OpenSceneFromInspectorAsync(sceneId);
    }

    private Task RevealSelectedSceneInNavigatorAsync(Guid sceneId)
    {
        return _storyboardBoard is null
            ? Task.CompletedTask
            : _storyboardBoard.RevealSceneInNavigatorAsync(sceneId);
    }

    private Task DuplicateSelectedSceneAsync(Guid sceneId)
    {
        return _storyboardBoard is null
            ? Task.CompletedTask
            : _storyboardBoard.DuplicateSceneFromInspectorAsync(sceneId);
    }

    private Task DeleteSelectedSceneAsync(Guid sceneId)
    {
        return _storyboardBoard is null
            ? Task.CompletedTask
            : _storyboardBoard.PromptDeleteSceneFromInspectorAsync(sceneId);
    }

    private async Task HandleSelectionChangedAsync(StoryboardSelectionChange selection)
    {
        _selectedSceneIds = selection.SelectedSceneIds
            .Where(sceneId => _nodes.Any(node => node.Id == sceneId))
            .ToHashSet();

        _primarySelectedSceneId = selection.PrimarySceneId.HasValue && _selectedSceneIds.Contains(selection.PrimarySceneId.Value)
            ? selection.PrimarySceneId.Value
            : _selectedSceneIds.FirstOrDefault();

        Logger.LogInformation(
            "Storyboard selection updated locally. ProjectId={ProjectId} RequestedPrimarySceneId={RequestedPrimarySceneId} EffectivePrimarySceneId={EffectivePrimarySceneId} SelectionCount={SelectionCount}",
            ProjectId,
            selection.PrimarySceneId,
            _primarySelectedSceneId,
            _selectedSceneIds.Count);

        SyncCurrentSceneState();
        await InvokeAsync(StateHasChanged);
    }

    private Task OnSceneUpdatedAsync(StoryboardSceneInspectorUpdate update)
    {
        int index = _nodes.FindIndex(node => node.Id == update.SceneNode.Id);
        if (index >= 0)
        {
            _nodes[index] = update.SceneNode;
        }
        else
        {
            _nodes.Add(update.SceneNode);
        }

        _nodes.Sort(static (left, right) =>
        {
            int parentComparison = Nullable.Compare(left.ParentId, right.ParentId);
            if (parentComparison != 0)
            {
                return parentComparison;
            }

            int orderComparison = left.OrderIndex.CompareTo(right.OrderIndex);
            if (orderComparison != 0)
            {
                return orderComparison;
            }

            return left.Id.CompareTo(right.Id);
        });

        if (_selectedSceneIds.Count == 0)
        {
            _selectedSceneIds = [update.SceneNode.Id];
            _primarySelectedSceneId = update.SceneNode.Id;
        }

        SyncCurrentSceneState();
        StateHasChanged();
        return Task.CompletedTask;
    }

    private void PreserveSelectedScene()
    {
        _selectedSceneIds.RemoveWhere(sceneId => _nodes.All(node => node.Id != sceneId));

        if (_selectedSceneIds.Count > 0)
        {
            if (!_primarySelectedSceneId.HasValue || !_selectedSceneIds.Contains(_primarySelectedSceneId.Value))
            {
                _primarySelectedSceneId = _selectedSceneIds.First();
            }

            SyncCurrentSceneState();
            return;
        }

        if (CurrentSceneStateService.ProjectId == ProjectId
            && CurrentSceneStateService.SceneNodeId.HasValue
            && _nodes.Any(node => node.Id == CurrentSceneStateService.SceneNodeId.Value))
        {
            _selectedSceneIds = [CurrentSceneStateService.SceneNodeId.Value];
            _primarySelectedSceneId = CurrentSceneStateService.SceneNodeId.Value;
            SyncCurrentSceneState();
            return;
        }

        _selectedSceneIds.Clear();
        _primarySelectedSceneId = null;
        CurrentSceneStateService.Clear();
    }

    private void SyncCurrentSceneState()
    {
        Guid? singleSceneId = SingleSelectedSceneId;
        if (!singleSceneId.HasValue)
        {
            CurrentSceneStateService.Clear();
            return;
        }

        ProjectNodeDto? scene = _nodes.FirstOrDefault(node => node.Id == singleSceneId.Value);
        if (scene is null)
        {
            CurrentSceneStateService.Clear();
            return;
        }

        CurrentSceneStateService.SetCurrent(ProjectId, scene.Id, scene.Title);
    }

    private void OpenStructure()
    {
        Navigation.NavigateTo($"projects/{ProjectId:D}");
    }

    private void OpenProject()
    {
        Navigation.NavigateTo($"projects/{ProjectId:D}");
    }
}
