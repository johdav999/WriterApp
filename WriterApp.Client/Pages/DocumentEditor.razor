@page "/documents/{DocumentId:guid}/sections/{SectionId:guid}"
@using WriterApp.Application.Documents
@using WriterApp.Application.AI
@using WriterApp.Application.Exporting
@using WriterApp.Client.Components.Editor
@using WriterApp.Client.Components.AI
@using WriterApp.Client.Components

<PageTitle>@GetPageTitle()</PageTitle>

@if (_isLoading)
{
    <div class="landing-loading">Loading document...</div>
}
else if (_loadError is not null)
{
    <div class="landing-empty">@_loadError</div>
}
else if (_activeSection is null || _activePage is null)
{
    <div class="landing-empty">No pages available.</div>
}
else
{
    <div class="editor-shell @GetLayoutStateClass()" style="@GetLayoutStyle()">
        <div class="editor-workspace @GetWorkspaceClass()">
            <aside class="section-panel @GetSectionsPanelClass()">
                <div class="section-panel-header">
                    <h2>Sections</h2>
                    <div class="section-panel-actions">
                        @if (_isReorderingSections)
                        {
                            <span class="section-order-status">Saving order...</span>
                        }
                        @if (_sectionReorderDiagnosticsEnabled)
                        {
                            <span class="section-order-debug">
                                Reorder debug: @_lastReorderStatus / @_lastReorderCount / @_lastReorderCorrelationId
                            </span>
                        }
                        @if (_dndDebugEnabled)
                        {
                            <span class="section-order-debug">
                                DND: @_dndDebugStatus
                                @if (_dndDebugLastAt.HasValue)
                                {
                                    <span>@_dndDebugLastAt.Value.ToLocalTime().ToString("HH:mm:ss")</span>
                                }
                                <span>drag=@_dndDebugLastDraggedId</span>
                                <span>target=@_dndDebugLastTargetId</span>
                            </span>
                        }
                        @if (!string.IsNullOrWhiteSpace(_sectionError))
                        {
                            <span class="ai-preview-status error">@_sectionError</span>
                        }
                        <button type="button"
                                class="panel-toggle"
                                aria-label="Add section"
                                title='@GetTooltip("Add a new section or chapter.")'
                                @onclick="CreateSectionAsync"
                                disabled="@_isCreatingSection">
                            @(_isCreatingSection ? "Adding..." : "Add section")
                        </button>
                    </div>
                </div>
                <ul class="section-nav-list">
                    @foreach (SectionDto item in _sections)
                    {
                        <li class="section-nav-row"
                            @ondragover:preventDefault="true"
                            @ondrop="() => OnSectionDrop(item.Id)">
                            <button type="button"
                                    class="section-drag-handle"
                                    draggable="@(!_isReorderingSections ? "true" : "false")"
                                    @ondragstart="() => OnSectionDragStart(item.Id)"
                                    disabled="@_isReorderingSections"
                                    aria-label="Reorder section"
                                    title='@GetTooltip("Drag to reorder sections.")'>
                                ⋮⋮
                            </button>
                            @if (_renamingSectionId == item.Id)
                            {
                                <div class="section-rename">
                                    <input class="section-rename-input"
                                           value="@_sectionRenameDraft"
                                           maxlength="120"
                                           @oninput="OnSectionRenameInput"
                                           @onkeydown="(args) => OnSectionRenameKeyDown(args, item.Id)"
                                           @onblur="() => OnSectionRenameBlurAsync(item.Id)" />
                                    @if (!string.IsNullOrWhiteSpace(_sectionRenameError))
                                    {
                                        <div class="section-rename-error">@_sectionRenameError</div>
                                    }
                                </div>
                            }
                            else
                            {
                                <button type="button"
                                        class="section-nav-item @(item.Id == _activeSection.Id ? "is-active" : string.Empty)"
                                        @onclick="() => OnSectionSelected(item.Id)"
                                        title='@GetTooltip("Select this section to edit.")'>
                                    <span class="section-title section-title-editable"
                                          @onclick="() => BeginSectionRename(item.Id)"
                                          @onclick:stopPropagation="true"
                                          @onclick:preventDefault="true">
                                        @item.Title
                                    </span>
                                </button>
                                <div class="section-menu">
                                    <button type="button"
                                            class="section-menu-toggle"
                                            aria-label="Section actions"
                                            title='@GetTooltip("Section actions: rename, duplicate, or delete.")'
                                            @onclick="() => ToggleSectionMenu(item.Id)"
                                            @onclick:stopPropagation="true"
                                            @onclick:preventDefault="true">
                                        ...
                                    </button>
                                    @if (_sectionMenuOpenId == item.Id)
                                    {
                                        <div class="section-menu-panel">
                                            <button type="button" @onclick="() => BeginSectionRename(item.Id)">Rename</button>
                                            <button type="button" @onclick="() => DuplicateSectionAsync(item.Id)">Duplicate</button>
                                            <button type="button"
                                                    class="danger"
                                                    @onclick="() => PromptDeleteSection(item.Id)">
                                                Delete
                                            </button>
                                        </div>
                                    }
                                </div>
                            }
                        </li>
                    }
                    <li class="section-nav-row"
                        @ondragover:preventDefault="true"
                        @ondrop="OnSectionDropAfterLast">
                        <span class="visually-hidden">Drop to move to end</span>&nbsp;
                    </li>
                </ul>
            </aside>

            <section class="editor-main">
                <div class="editor-main-header">
                    <div class="editor-section-info">
                        <div class="editor-section-label">Section</div>
                        <div class="editor-section-title">@_activeSection.Title</div>
                    </div>
                    @if (ShowTranslationSwitcher)
                    {
                        <div class="translation-switcher">
                            <div class="translation-switcher-label">Translation</div>
                            <div class="translation-switcher-links">
                                @foreach (TranslationLinkItem item in GetTranslationLinks())
                                {
                                    <button type="button"
                                            class="translation-switcher-link @(item.IsActive ? "is-active" : string.Empty)"
                                            title='@GetTooltip(item.Title)'
                                            @onclick="() => NavigateToTranslation(item)">
                                        @item.Label
                                    </button>
                                }
                            </div>
                        </div>
                    }
                    <button type="button" class="panel-toggle" title='@GetTooltip("Hide panels and focus on writing.")' @onclick="ToggleFocusMode">
                        @(LayoutStateService.State.FocusMode ? "Exit focus" : "Focus mode")
                    </button>
                    <button type="button" class="panel-toggle" title='@GetTooltip("Toggle the right-hand panel.")' @onclick="ToggleContextPanel">
                        @(IsContextPanelCollapsed() ? "Show panel" : "Hide panel")
                    </button>
                </div>

                <div class="editor-toolbar" role="toolbar" aria-label="Editor formatting">
                    <div class="editor-toolbar-group" aria-label="Essentials" data-compact="true">
                        <button type="button" class="@GetActiveClass(_formattingState.IsBold)" disabled="@(!_formattingState.CanBold)" title='@GetTooltip("Make selected text bold.")' @onclick="OnBoldRequested">Bold</button>
                        <button type="button" class="@GetActiveClass(_formattingState.IsItalic)" disabled="@(!_formattingState.CanItalic)" title='@GetTooltip("Italicize selected text.")' @onclick="OnItalicRequested">Italic</button>
                        <select class="editor-toolbar-select" value="@GetBlockTypeValue()" title='@GetTooltip("Change text style.")' @onchange="OnBlockTypeChanged" disabled="@(!_formattingState.CanApplyHeading)">
                            <option value="paragraph">Paragraph</option>
                            <option value="heading:1">Heading 1</option>
                            <option value="heading:2">Heading 2</option>
                        </select>
                        <button type="button" disabled="@(!_formattingState.CanToggleList)" title='@GetTooltip("Create a bulleted list.")' @onclick="OnBulletListRequested">Bulleted list</button>
                        <button type="button" disabled="@(!_formattingState.CanToggleList)" title='@GetTooltip("Create a numbered list.")' @onclick="OnOrderedListRequested">Numbered list</button>
                        <button type="button" disabled="@(!_formattingState.CanBlockquote)" title='@GetTooltip("Format text as a quotation.")' @onclick="OnBlockquoteRequested">Blockquote</button>
                        <button type="button" class="@GetActiveClass(_formattingState.IsLink)" title='@GetTooltip("Insert or edit a link.")' @onclick="OnLinkRequested">Link</button>
                    </div>
                    <div class="editor-toolbar-group" aria-label="Zoom">
                        <button type="button" title='@GetTooltip("Decrease text size.")' @onclick="OnZoomOutRequested">A-</button>
                        <span class="editor-zoom-label">@GetZoomLabel()</span>
                        <button type="button" title='@GetTooltip("Increase text size.")' @onclick="OnZoomInRequested">A+</button>
                    </div>
                    <div class="editor-toolbar-group editor-toolbar-overflow" aria-label="More">
                        <button type="button" title='@GetTooltip("More formatting options.")' @onclick="ToggleToolbarOverflow">...</button>
                        @if (_isToolbarOverflowOpen)
                        {
                            <div class="editor-toolbar-overflow-panel">
                                <button type="button" class="@GetActiveClass(_formattingState.IsStrike)" disabled="@(!_formattingState.CanStrike)" @onclick="OnStrikeRequested">Strike</button>
                                <button type="button" class="@GetActiveClass(_formattingState.IsCode)" disabled="@(!_formattingState.CanCode)" @onclick="OnCodeRequested">Code</button>
                                <button type="button" disabled="@(!_formattingState.CanApplyHeading)" @onclick="() => OnHeadingRequested(3)">Heading 3</button>
                                <button type="button" disabled="@(!_formattingState.CanApplyHeading)" @onclick="() => OnHeadingRequested(4)">Heading 4</button>
                                <button type="button" disabled="@(!_formattingState.CanApplyHeading)" @onclick="() => OnHeadingRequested(5)">Heading 5</button>
                                <button type="button" disabled="@(!_formattingState.CanApplyHeading)" @onclick="() => OnHeadingRequested(6)">Heading 6</button>
                                <button type="button" disabled="@(!_formattingState.CanHorizontalRule)" @onclick="OnHorizontalRuleRequested">Horizontal rule</button>
                                <button type="button" class='@GetActiveClass(_formattingState.TextAlign == "left")' @onclick='@(() => OnAlignRequested("left"))'>Align left</button>
                                <button type="button" class='@GetActiveClass(_formattingState.TextAlign == "center")' @onclick='@(() => OnAlignRequested("center"))'>Align center</button>
                                <button type="button" class='@GetActiveClass(_formattingState.TextAlign == "right")' @onclick='@(() => OnAlignRequested("right"))'>Align right</button>
                                <button type="button" @onclick="OnIndentDecreaseRequested">Indent -</button>
                                <button type="button" @onclick="OnIndentIncreaseRequested">Indent +</button>
                            </div>
                        }
                    </div>
                </div>
                <div class="editor-actions">
                    <button type="button" title='@GetTooltip("Undo last change.")' @onclick="OnUndoRequested">Undo</button>
                    <button type="button" title='@GetTooltip("Redo last change.")' @onclick="OnRedoRequested">Redo</button>
                    <div class="document-menu">
                        <button type="button" title='@GetTooltip("Document-level actions.")' @onclick="ToggleDocumentMenu">Document</button>
                        @if (_isDocumentMenuOpen)
                        {
                            <div class="document-menu-panel">
                                <button type="button" @onclick="OnToggleEditorWidthMode">@GetEditorWidthLabel()</button>
                                <button type="button" @onclick="OnTogglePrintLayout">@GetPrintLayoutLabel()</button>
                                <button type="button" @onclick="OnSaveNow">Save now</button>
                                <button type="button" @onclick="OnExportDialogOpenAsync">Export...</button>
                                <button type="button" @onclick='@(() => OnExportRequested("synopsis", "markdown"))'>Export Synopsis (Markdown)</button>
                                <button type="button" @onclick='@(() => OnExportRequested("synopsis", "html"))'>Export Synopsis (HTML)</button>
                            </div>
                        }
                    </div>
                    @if (IsAiQuotaExceeded)
                    {
                        <span class="ai-quota-message">You've reached your monthly AI limit.</span>
                    }
                </div>

                @if (_isDiffMode)
                {
                    <div class="diff-header-bar" @onkeydown="OnDiffKeyDown" tabindex="0" @ref="_diffHeaderRef">
                        <div class="diff-header-group">
                            <label class="diff-header-label">Base</label>
                            <select value="@_diffBaseVersionId"
                                    @onchange="OnDiffBaseChanged">
                                <option value="">Select version</option>
                                @foreach (PageVersionListItemDto version in _pageVersions)
                                {
                                    <option value="@version.Id">@FormatVersionLabel(version)</option>
                                }
                            </select>
                        </div>
                        <div class="diff-header-group">
                            <label class="diff-header-label">Compare</label>
                            <select value="@_diffCompareVersionId"
                                    @onchange="OnDiffCompareChanged">
                                <option value="">Current</option>
                                @foreach (PageVersionListItemDto version in _pageVersions)
                                {
                                    <option value="@version.Id">@FormatVersionLabel(version)</option>
                                }
                            </select>
                        </div>
                        <button type="button"
                                class="diff-header-button"
                                title="Swap base and compare"
                                @onclick="SwapDiffVersionsAsync"
                                disabled="@(!_diffBaseVersionId.HasValue)">
                            Swap
                        </button>
                        <div class="diff-header-group">
                            <label class="diff-header-label">View</label>
                            <select value="@_diffViewMode"
                                    @onchange="OnDiffViewModeChanged">
                                <option value="inline">Inline</option>
                                <option value="side">Side-by-side</option>
                            </select>
                        </div>
                        <div class="diff-header-group">
                            <label class="diff-header-label">Granularity</label>
                            <select value="@_diffGranularity"
                                    @onchange="OnDiffGranularityChanged">
                                <option value="word">Word</option>
                                <option value="sentence">Sentence</option>
                            </select>
                        </div>
                        @if (string.Equals(_diffViewMode, "inline", StringComparison.OrdinalIgnoreCase))
                        {
                            <label class="diff-toggle">
                                <input type="checkbox" checked="@_diffShowDeletions" @onchange="OnDiffShowDeletionsChanged" />
                                Show deletions
                            </label>
                        }
                        else
                        {
                            <label class="diff-toggle">
                                <input type="checkbox" checked="@_diffSyncScroll" @onchange="OnDiffSyncScrollChanged" />
                                Sync scroll
                            </label>
                        }
                        <button type="button"
                                class="diff-header-button primary"
                                disabled="@(!_canCompareVersions)"
                                @onclick="LoadVersionDiffAsync">
                            Compare
                        </button>
                        <button type="button"
                                class="diff-header-button"
                                title="Exit diff mode"
                                @onclick="CloseDiffMode">
                            Close diff
                        </button>
                    </div>
                }

                @if (_pendingAiProposal is not null)
                {
                    <div class="ai-preview">
                        <div class="ai-preview-header">
                            <strong>AI suggestion</strong>
                            <span>@_pendingAiProposal.ActionLabel</span>
                            @if (!string.IsNullOrWhiteSpace(_pendingAiProposal.ErrorMessage))
                            {
                                <span class="ai-preview-status error">@_pendingAiProposal.ErrorMessage</span>
                            }
                        </div>
                        @if (IsTranslationProposal)
                        {
                            <TranslationProposalPanel SourceText="@_pendingAiProposal.OriginalText"
                                                      TranslatedText="@_pendingAiProposal.ProposedText"
                                                      AlignmentMode="@_translationAlignmentMode"
                                                      AlignmentModeChanged="OnTranslationAlignmentChanged"
                                                      OnCopyTranslated="CopyTranslatedTextAsync"
                                                      OnChangeLanguage="OpenTranslateModalFromProposal" />
                            <div class="translation-apply">
                                <div class="translation-apply-mode">
                                    <label for="translation-apply-mode">Apply</label>
                                    <select id="translation-apply-mode" @bind="_translationApplyMode">
                                        @foreach (TranslationApplyOption option in GetTranslationApplyOptions())
                                        {
                                            <option value="@option.Value">@option.Label</option>
                                        }
                                    </select>
                                </div>
                                <div class="translation-apply-actions">
                                    <button type="button" @onclick="OnApplyPendingAiProposal">Apply</button>
                                    <button type="button" class="btn btn-ghost" @onclick="OnDiscardPendingAiProposal">Discard</button>
                                </div>
                            </div>
                        }
                        else if (!string.IsNullOrWhiteSpace(_pendingAiProposal.OriginalText))
                        {
                            <div class="ai-preview-columns">
                                <div class="ai-preview-pane">
                                    <div class="ai-preview-label">Original</div>
                                    <div class="ai-preview-text">@_pendingAiProposal.OriginalText</div>
                                </div>
                                <div class="ai-preview-pane">
                                    <div class="ai-preview-label">Proposed</div>
                                    <div class="ai-preview-text">@_pendingAiProposal.ProposedText</div>
                                </div>
                            </div>
                        }
                        @if (!IsTranslationProposal)
                        {
                            <div class="ai-preview-actions">
                                <button type="button" @onclick="OnApplyPendingAiProposal">Apply</button>
                                <button type="button" @onclick="OnDiscardPendingAiProposal">Discard</button>
                                <button type="button"
                                        class="ai-details-toggle"
                                        aria-expanded="@_pendingDetailsExpanded"
                                        aria-controls="ai-pending-details"
                                        @onclick="TogglePendingDetails">
                                    @(_pendingDetailsExpanded ? "Hide details" : "Change details")
                                </button>
                            </div>
                        }
                        @if (_pendingDetailsExpanded)
                        {
                            <div id="ai-pending-details" class="ai-history-details">
                                <div class="ai-history-details-header">
                                    <div class="ai-history-details-summary">@GetPendingSummary()</div>
                                    <div class="ai-history-details-sub">
                                        <span>Preview</span>
                                        <span>@_pendingAiProposal.CreatedUtc.ToLocalTime().ToString("g")</span>
                                    </div>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(_pendingAiProposal.ActionLabel))
                                {
                                    <div class="ai-history-details-intent">
                                        <div class="ai-history-details-label">Intent</div>
                                        <div class="ai-history-details-text">@_pendingAiProposal.ActionLabel</div>
                                    </div>
                                }
                                <div class="ai-history-details-compare">
                                    <div class="ai-history-details-block">
                                        <div class="ai-history-details-label">Before</div>
                                        <pre>@FormatHistoryText(_pendingAiProposal.OriginalText)</pre>
                                    </div>
                                    <div class="ai-history-details-block">
                                        <div class="ai-history-details-label">After</div>
                                        <pre>@FormatHistoryText(_pendingAiProposal.ProposedText)</pre>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }

                <div class="editor-surface">
                    <div class="editor-viewport">
                        <div class="editor-content">
                            @if (_isDiffMode)
                            {
                                <div class="diff-canvas">
                                    @if (_diffLoading)
                                    {
                                        <div class="diff-empty">Building diff...</div>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(_diffError))
                                    {
                                        <div class="diff-empty">@_diffError</div>
                                    }
                                    else if (_diffResult is null)
                                    {
                                        <div class="diff-empty">Select versions to compare.</div>
                                    }
                                    else
                                    {
                                        <div class="diff-legend">
                                            <span class="diff-legend-item added">Added</span>
                                            <span class="diff-legend-item removed">Removed</span>
                                            <span class="diff-legend-item changed">Changed</span>
                                        </div>
                                        @if (_diffResult.Truncated)
                                        {
                                            <div class="diff-note">Diff truncated to first @_diffResult.MaxBlocks blocks.</div>
                                        }
                                        @if (string.Equals(_diffViewMode, "side", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <div class="diff-side-by-side" @onkeydown="OnDiffKeyDown" tabindex="0" @ref="_diffCanvasRef">
                                                <div class="diff-pane">
                                                    <div class="diff-pane-header">
                                                        <div class="diff-pane-title">Base</div>
                                                        <div class="diff-pane-sub">@GetDiffPaneSubtitle(_diffBaseVersionId)</div>
                                                    </div>
                                                    <div class="diff-pane-body" id="diff-pane-left" @onscroll='() => OnDiffPaneScrolled("diff-pane-left")'>
                                                        @foreach (PageVersionDiffBlockDto block in _diffResult.Blocks)
                                                        {
                                                            <div class="diff-line @GetDiffClass(block.Status)"
                                                                 id="@GetDiffAnchorId(block.Id)">
                                                                @RenderDiffSegments(GetBaseSegments(block))
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                                <div class="diff-pane">
                                                    <div class="diff-pane-header">
                                                        <div class="diff-pane-title">Compare</div>
                                                        <div class="diff-pane-sub">@GetDiffPaneSubtitle(_diffCompareVersionId)</div>
                                                    </div>
                                                    <div class="diff-pane-body" id="diff-pane-right" @onscroll='() => OnDiffPaneScrolled("diff-pane-right")'>
                                                        @foreach (PageVersionDiffBlockDto block in _diffResult.Blocks)
                                                        {
                                                            <div class="diff-line @GetDiffClass(block.Status)">
                                                                @RenderDiffSegments(GetCompareSegments(block))
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="diff-inline" @onkeydown="OnDiffKeyDown" tabindex="0" @ref="_diffCanvasRef">
                                                @foreach (PageVersionDiffBlockDto block in _diffResult.Blocks)
                                                {
                                                    if (!_diffShowDeletions && string.Equals(block.Status, "removed", StringComparison.OrdinalIgnoreCase))
                                                    {
                                                        continue;
                                                    }
                                                    <div class="diff-line @GetDiffClass(block.Status)"
                                                         id="@GetDiffAnchorId(block.Id)">
                                                        @RenderDiffSegments(GetInlineSegments(block), hideRemoved: !_diffShowDeletions)
                                                    </div>
                                                }
                                            </div>
                                        }
                                    }
                                </div>
                            }
                            else
                            {
                                @* Pages are derived from continuous section content; breaks are visual only. *@
                                <PageEditor @ref="_pageEditor"
                                            @key="_activePage.Id"
                                            Page="_activePage"
                                            OnPageSaved="OnPageSaved"
                                            ShowStatusBar="false"
                                            StatusChanged="OnEditorStatusChanged"
                                            Annotations="_annotations"
                                            QualityIssues="_qualityIssues"
                                            VersionStatusMessage="@_versionStatusMessage"
                                            AnnotationClicked="OnAnnotationClickedAsync"
                                            PageBreaks="PageBreaks"
                                            HeadingNumberingEnabled="@LayoutStateService.State.HeadingNumberingEnabled"
                                            HeadingNumberingScope="@GetHeadingNumberingScope()"
                                            HeadingNumberingPrefix="@_headingPrefixCounters"
                                            HeadingNumberingTraceId="@_headingTraceId"
                                            SearchHighlightQuery="@SearchQuery"
                                            FormattingChanged="OnFormattingChanged"
                                            SelectionChanged="OnSelectionChanged"
                                            ContextMenuRequested="OnEditorContextMenuRequested"
                                            SelectionBubbleChanged="OnSelectionBubbleChanged" />
                                @if (_selectionBubbleVisible)
                                {
                                    <div class="selection-bubble" style="@GetSelectionBubbleStyle()">
                                        <button type="button"
                                                class="@GetActiveClass(_formattingState.IsBold)"
                                                disabled="@(!_formattingState.CanBold)"
                                                @onclick="OnBoldRequested">Bold</button>
                                        <button type="button"
                                                class="@GetActiveClass(_formattingState.IsItalic)"
                                                disabled="@(!_formattingState.CanItalic)"
                                                @onclick="OnItalicRequested">Italic</button>
                                        <button type="button"
                                                class="@GetActiveClass(_formattingState.IsStrike)"
                                                disabled="@(!_formattingState.CanStrike)"
                                                @onclick="OnStrikeRequested">Strike</button>
                                        <button type="button"
                                                class="@GetActiveClass(_formattingState.IsCode)"
                                                disabled="@(!_formattingState.CanCode)"
                                                @onclick="OnCodeRequested">Code</button>
                                        <button type="button"
                                                class="@GetActiveClass(_formattingState.IsLink)"
                                                @onclick="OnLinkRequested">Link</button>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                    @if (!_isDiffMode)
                    {
                        <div class="editor-status-bar">
                            <span title="Total words in this section.">@_editorStatus.WordCount words</span>
                            <span title="Estimated page count.">Page @_editorStatus.CurrentPageIndex / @_editorStatus.PageCount</span>
                            <span class="@_editorStatus.SaveStatusClass" title="Your work is saved automatically.">@_editorStatus.SaveStatusLabel</span>
                            @if (!string.IsNullOrWhiteSpace(_editorStatus.VersionStatusMessage))
                            {
                                <span class="version-status" title="A version snapshot was saved.">@_editorStatus.VersionStatusMessage</span>
                            }
                        </div>
                    }
                </div>
            </section>


            <aside class="context-drawer @(GetContextPanelClass())">
                <RightPanelShell>
                    <Tabs>
                        @if (!_isDiffMode)
                        {
                            <div class="context-drawer-tabs">
                                <button type="button"
                                        class="context-tab @GetContextTabClass(ContextTab.Notes)"
                                        aria-selected="@(_activeContextTab == ContextTab.Notes)"
                                        title='@GetTooltip("Personal notes for this section.")'
                                        @onclick="() => SetContextTabAsync(ContextTab.Notes)">
                                    Notes
                                </button>
                                <button type="button"
                                        class="context-tab @GetContextTabClass(ContextTab.Scene)"
                                        aria-selected="@(_activeContextTab == ContextTab.Scene)"
                                        title='@GetTooltip("Structure and plan this scene.")'
                                        @onclick="() => SetContextTabAsync(ContextTab.Scene)">
                                    Scene
                                </button>
                                <button type="button"
                                        class="context-tab @GetContextTabClass(ContextTab.Outline)"
                                        aria-selected="@(_activeContextTab == ContextTab.Outline)"
                                        title='@GetTooltip("View and edit the document outline.")'
                                        @onclick="() => SetContextTabAsync(ContextTab.Outline)">
                                    Outline
                                </button>
                                <button type="button"
                                        class="context-tab @GetContextTabClass(ContextTab.Ai)"
                                        aria-selected="@(_activeContextTab == ContextTab.Ai)"
                                        title='@GetTooltip("AI tools for writing and planning.")'
                                        @onclick="() => SetContextTabAsync(ContextTab.Ai)">
                                    AI
                                </button>
                                <button type="button"
                                        class="context-tab @GetContextTabClass(ContextTab.Annotations)"
                                        aria-selected="@(_activeContextTab == ContextTab.Annotations)"
                                        title='@GetTooltip("Comments, TODOs, and highlights.")'
                                        @onclick="() => SetContextTabAsync(ContextTab.Annotations)">
                                    Annotations
                                </button>
                                <button type="button"
                                        class="context-tab @GetContextTabClass(ContextTab.Quality)"
                                        aria-selected="@(_activeContextTab == ContextTab.Quality)"
                                        title='@GetTooltip("Writing quality checks and consistency hints.")'
                                        @onclick="() => SetContextTabAsync(ContextTab.Quality)">
                                    Quality
                                </button>
                                <button type="button"
                                        class="context-tab @GetContextTabClass(ContextTab.History)"
                                        aria-selected="@(_activeContextTab == ContextTab.History)"
                                        title='@GetTooltip("Version history for this page.")'
                                        @onclick="() => SetContextTabAsync(ContextTab.History)">
                                    History
                                </button>
                            </div>
                        }
                    </Tabs>
                    <Header>
                        @if (_isDiffMode)
                        {
                            <div class="rp-title">Diff</div>
                        }
                        else if (_activeContextTab == ContextTab.Notes)
                        {
                            <div class="rp-title">Notes</div>
                        }
                        else if (_activeContextTab == ContextTab.Scene)
                        {
                            <div class="rp-title">Scene card</div>
                        }
                        else if (_activeContextTab == ContextTab.Outline)
                        {
                            <div class="rp-title">Outline</div>
                            <div class="rp-subtitle">Organize chapters, scenes, and beats.</div>
                            <details class="rp-options">
                                <summary>Apply options</summary>
                                <label><input type="checkbox" @bind="_outlineApplyCreateMissing" /> Create missing sections</label>
                                <label><input type="checkbox" @bind="_outlineApplyReorder" /> Reorder sections</label>
                                <label><input type="checkbox" @bind="_outlineApplyRename" /> Rename sections to match outline</label>
                                <label><input type="checkbox" @bind="_outlineApplyLinkNodes" /> Link nodes to sections</label>
                            </details>
                        }
                        else if (_activeContextTab == ContextTab.Ai)
                        {
                            <div class="rp-title">AI tools</div>
                            <div class="rp-subtitle">Run a command on the page or selection.</div>
                        }
                        else if (_activeContextTab == ContextTab.Annotations)
                        {
                            <div class="rp-title">Annotations</div>
                            <div class="annotations-toolbar">
                                <div class="annotations-filter">
                                    <label class="annotations-filter-label">Status</label>
                                    <select class="annotations-filter-select"
                                            value="@_annotationFilterStatus"
                                            @onchange="OnAnnotationStatusFilterChanged">
                                        <option value="open">Open</option>
                                        <option value="resolved">Resolved</option>
                                        <option value="all">All</option>
                                    </select>
                                </div>
                                <div class="annotations-filter">
                                    <label class="annotations-filter-label">Type</label>
                                    <select class="annotations-filter-select"
                                            value="@_annotationFilterKind"
                                            @onchange="OnAnnotationKindFilterChanged">
                                        <option value="all">All</option>
                                        <option value="comment">Comment</option>
                                        <option value="todo">TODO</option>
                                        <option value="highlight">Highlight</option>
                                    </select>
                                </div>
                                <button type="button" class="annotations-refresh" @onclick="LoadAnnotationsAsync">Refresh</button>
                            </div>
                        }
                        else if (_activeContextTab == ContextTab.Quality)
                        {
                            <div class="rp-title">Quality checks</div>
                            <div class="quality-toolbar">
                                <div class="quality-filter">
                                    <label class="quality-filter-label">Scope</label>
                                    <select class="quality-filter-select" value="@_qualityScope" @onchange="OnQualityScopeChanged">
                                        <option value="page">Page</option>
                                        <option value="selection">Selection</option>
                                    </select>
                                </div>
                                <div class="quality-filter">
                                    <label class="quality-filter-label">Severity</label>
                                    <select class="quality-filter-select" value="@_qualityFilterSeverity" @onchange="OnQualitySeverityChanged">
                                        <option value="all">All</option>
                                        <option value="warning">Warning</option>
                                        <option value="info">Info</option>
                                    </select>
                                </div>
                                <div class="quality-filter">
                                    <label class="quality-filter-label">Type</label>
                                    <select class="quality-filter-select" value="@_qualityFilterKind" @onchange="OnQualityKindChanged">
                                        <option value="all">All</option>
                                        <option value="readability">Readability</option>
                                        <option value="sentence-length">Sentence length</option>
                                        <option value="paragraph-length">Paragraph length</option>
                                        <option value="repeated-word">Repeated words</option>
                                        <option value="passive-voice">Passive voice</option>
                                        <option value="name-consistency">Name consistency</option>
                                        <option value="timeline">Timeline hints</option>
                                        <option value="glossary">Glossary</option>
                                    </select>
                                </div>
                                <button type="button" class="quality-refresh" @onclick="RunQualityChecksAsync">Run checks</button>
                            </div>
                            @if (_qualityFromCache)
                            {
                                <div class="quality-cache-note">Showing cached results for this version.</div>
                            }
                        }
                        else if (_activeContextTab == ContextTab.History)
                        {
                            <div class="rp-title">History</div>
                        }
                    </Header>
                    <Body>
                        @if (_isDiffMode)
                        {
                            <div class="drawer-panel diff-panel">
                                <div class="diff-summary">
                                    <div><strong>+@_diffSummary.AddedWords</strong> words</div>
                                    <div><strong>-@_diffSummary.RemovedWords</strong> words</div>
                                    <div><strong>@_diffSummary.ChangedBlocks</strong> changed</div>
                                    <div><strong>@_diffSummary.AddedBlocks</strong> added</div>
                                    <div><strong>@_diffSummary.RemovedBlocks</strong> removed</div>
                                </div>
                                @if (_diffChangeBlocks.Count == 0)
                                {
                                    <div class="drawer-empty">No changes detected.</div>
                                }
                                else
                                {
                                    <ul class="diff-change-list">
                                        @foreach (DiffChangeBlock block in _diffChangeBlocks)
                                        {
                                            <li class="diff-change-item @GetDiffChangeClass(block)"
                                                @onclick="() => JumpToChange(block)">
                                                <span class="diff-change-kind">@block.KindLabel</span>
                                                <span class="diff-change-preview">@block.Preview</span>
                                            </li>
                                        }
                                    </ul>
                                }
                            </div>
                        }
                        else if (_activeContextTab == ContextTab.Notes)
                        {
                            <textarea class="notes-input"
                                      value="@_notesDraft"
                                      @oninput="OnNotesInput"
                                      placeholder="Add notes for this section..."></textarea>
                        }
                        else if (_activeContextTab == ContextTab.Scene)
                        {
                            <div class="drawer-panel scene-card-panel">
                                <div class="drawer-panel-subtitle">Capture metadata for this section.</div>
                                <div class="scene-card-actions">
                                    <button type="button"
                                            class="btn btn-secondary"
                                            disabled="@_sceneAiInFlight"
                                            title='@GetTooltip("Generate scene details from the current text.")'
                                            @onclick="@(() => RunSceneAiAsync("scene.suggest", "Suggest scene card fields based on the section text."))">
                                        Suggest from text
                                    </button>
                                    <button type="button"
                                            class="btn btn-secondary"
                                            disabled="@_sceneAiInFlight"
                                            title='@GetTooltip("Improve or clarify this scene card.")'
                                            @onclick="@(() => RunSceneAiAsync("scene.refine", "Refine the scene card fields while keeping intent."))">
                                        Refine
                                    </button>
                                    <button type="button"
                                            class="btn btn-secondary"
                                            disabled="@_sceneAiInFlight"
                                            title='@GetTooltip("Identify unresolved story questions.")'
                                            @onclick="@(() => RunSceneAiAsync("scene.find-open-questions", "Find open questions in this section."))">
                                        Find open questions
                                    </button>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(_sceneAiError))
                                {
                                    <div class="drawer-empty">@_sceneAiError</div>
                                }
                                @if (_sceneAiProposal is not null)
                                {
                                    <div class="scene-card-preview">
                                        <div class="scene-card-preview-header">AI suggestion</div>
                                        @if (!string.IsNullOrWhiteSpace(_sceneAiExplanation))
                                        {
                                            <div class="scene-card-preview-explanation">@_sceneAiExplanation</div>
                                        }
                                        <div class="scene-card-preview-grid">
                                            <div class="scene-card-preview-col">
                                                <div class="scene-card-preview-label">Current</div>
                                                <div class="scene-card-preview-field">
                                                    <strong>Narrative purpose</strong>
                                                    <div>@_sceneNarrativePurpose</div>
                                                </div>
                                                <div class="scene-card-preview-field">
                                                    <strong>Emotional beat</strong>
                                                    <div>@_sceneEmotionalBeat</div>
                                                </div>
                                                <div class="scene-card-preview-field">
                                                    <strong>Key events</strong>
                                                    <div>@_sceneKeyEvents</div>
                                                </div>
                                                <div class="scene-card-preview-field">
                                                    <strong>Open questions</strong>
                                                    <div>@_sceneOpenQuestions</div>
                                                </div>
                                            </div>
                                            <div class="scene-card-preview-col">
                                                <div class="scene-card-preview-label">Proposed</div>
                                                <div class="scene-card-preview-field">
                                                    <strong>Narrative purpose</strong>
                                                    <div>@_sceneAiProposal.NarrativePurpose</div>
                                                </div>
                                                <div class="scene-card-preview-field">
                                                    <strong>Emotional beat</strong>
                                                    <div>@_sceneAiProposal.EmotionalBeat</div>
                                                </div>
                                                <div class="scene-card-preview-field">
                                                    <strong>Key events</strong>
                                                    <div>@_sceneAiProposal.KeyEvents</div>
                                                </div>
                                                <div class="scene-card-preview-field">
                                                    <strong>Open questions</strong>
                                                    <div>@_sceneAiProposal.OpenQuestions</div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="scene-card-preview-actions">
                                            <button type="button" class="btn btn-primary" @onclick="ApplySceneAiProposalAsync">Apply</button>
                                            <button type="button" class="btn btn-ghost" @onclick="DiscardSceneAiProposal">Discard</button>
                                        </div>
                                    </div>
                                }
                                <label class="scene-card-label" for="scene-narrative-purpose" title='@GetTooltip("Why this scene exists in the story.")'>Narrative purpose</label>
                                <textarea id="scene-narrative-purpose"
                                          class="notes-input scene-card-input"
                                          value="@_sceneNarrativePurpose"
                                          @oninput="OnSceneNarrativePurposeInput"
                                          title='@GetTooltip("Why this scene exists in the story.")'
                                          placeholder="Why this scene exists in the story..."></textarea>
                                <label class="scene-card-label" for="scene-emotional-beat" title='@GetTooltip("How the emotion changes in this scene.")'>Emotional beat</label>
                                <textarea id="scene-emotional-beat"
                                          class="notes-input scene-card-input"
                                          value="@_sceneEmotionalBeat"
                                          @oninput="OnSceneEmotionalBeatInput"
                                          title='@GetTooltip("How the emotion changes in this scene.")'
                                          placeholder="How the emotional tone shifts..."></textarea>
                                <label class="scene-card-label" for="scene-key-events" title='@GetTooltip("The main things that happen.")'>Key events</label>
                                <textarea id="scene-key-events"
                                          class="notes-input scene-card-input"
                                          value="@_sceneKeyEvents"
                                          @oninput="OnSceneKeyEventsInput"
                                          title='@GetTooltip("The main things that happen.")'
                                          placeholder="- Bullet your key events..."></textarea>
                                <label class="scene-card-label" for="scene-open-questions" title='@GetTooltip("Loose ends to resolve later.")'>Open questions</label>
                                <textarea id="scene-open-questions"
                                          class="notes-input scene-card-input"
                                          value="@_sceneOpenQuestions"
                                          @oninput="OnSceneOpenQuestionsInput"
                                          title='@GetTooltip("Loose ends to resolve later.")'
                                          placeholder="Loose ends or questions to answer later..."></textarea>
                                @if (!string.IsNullOrWhiteSpace(_sceneStatus))
                                {
                                    <div class="drawer-empty">@_sceneStatus</div>
                                }
                            </div>
                        }
                        else if (_activeContextTab == ContextTab.Outline)
                        {
                            <div class="drawer-panel outline-panel">
                                <div class="outline-tree">
                                    @if (_outlineNodes.Count == 0)
                                    {
                                        <div class="drawer-empty">No outline nodes yet.</div>
                                    }
                                    else
                                    {
                                        <ul class="outline-tree-list">
                                            @foreach (DocumentOutlineNodeDto node in GetOutlineChildren(null))
                                            {
                                                @RenderOutlineNode(node, 0)
                                            }
                                        </ul>
                                    }
                                </div>
                                @if (_outlineProposalPreview is not null)
                                {
                                    <div class="outline-proposal">
                                        <div class="outline-proposal-title">Proposed outline</div>
                                        <pre class="outline-proposal-preview">@_outlineProposalPreview</pre>
                                        @if (_outlineProposalTruncated)
                                        {
                                            <div class="outline-proposal-note">Some section content was truncated for generation.</div>
                                        }
                                        <div class="outline-proposal-actions">
                                            <button type="button" @onclick="ApplyOutlineProposalAsync">Apply outline</button>
                                            <button type="button" @onclick="DiscardOutlineProposal">Discard</button>
                                        </div>
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(_outlineGenerateError))
                                {
                                    <div class="outline-status outline-status--error">@_outlineGenerateError</div>
                                }
                                @if (!string.IsNullOrWhiteSpace(_outlineApplyError))
                                {
                                    <div class="outline-status outline-status--error">@_outlineApplyError</div>
                                }
                                @if (!string.IsNullOrWhiteSpace(_outlineStatus))
                                {
                                    <div class="outline-status">@_outlineStatus</div>
                                }
                            </div>
                        }
                        else if (_activeContextTab == ContextTab.Ai)
                        {
                            <div class="drawer-panel ai-panel">
                                @if (!IsAiAvailable)
                                {
                                    <div class="drawer-empty">@GetAiBlockedMessage()</div>
                                }
                                else if (_aiActions.Count == 0)
                                {
                                    <div class="drawer-empty">No AI commands available.</div>
                                }
                                else
                                {
                                    <div class="ai-actions-list">
                                        <div class="ai-action-group">
                                            <div class="ai-action-group-title">Selection actions</div>
                                            @if (!SelectionAiActions.Any())
                                            {
                                                <div class="ai-action-description">Select text to enable.</div>
                                            }
                                            else
                                            {
                                                @foreach (AiActionOption action in SelectionAiActions)
                                                {
                                                    <div class="ai-action-item">
                                                        <button type="button"
                                                                disabled="@(_currentSelectionRange is null || IsAiQuotaExceeded)"
                                                                @onclick="() => OnAiActionSelected(action)">
                                                            @action.Label
                                                        </button>
                                                        @if (!string.IsNullOrWhiteSpace(action.Description))
                                                        {
                                                            <div class="ai-action-description">@action.Description</div>
                                                        }
                                                    </div>
                                                }
                                            }
                                        </div>
                                        <div class="ai-action-group">
                                            <div class="ai-action-group-title">Section actions</div>
                                            @foreach (AiActionOption action in SectionAiActions)
                                            {
                                                <div class="ai-action-item">
                                                    <button type="button"
                                                            disabled="@IsAiQuotaExceeded"
                                                            @onclick="() => OnAiActionSelected(action)">
                                                        @action.Label
                                                    </button>
                                                    @if (!string.IsNullOrWhiteSpace(action.Description))
                                                    {
                                                        <div class="ai-action-description">@action.Description</div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }

                                <div class="ai-history-toolbar">
                                    <button type="button"
                                            class="ai-history-button"
                                            @onclick="LoadAiHistoryAsync">
                                        Refresh history
                                    </button>
                                    <span class="ai-history-count-pill">@_aiHistoryEntries.Count</span>
                                </div>
                                @if (_aiHistoryEntries.Count == 0)
                                {
                                    <div class="drawer-empty">No AI history yet.</div>
                                }
                                else
                                {
                                    <ul class="ai-history-list">
                                    @foreach (AiHistoryEntry entry in _aiHistoryEntries)
                                    {
                                        bool showDetails = _expandedAiHistoryId == entry.Id;
                                        <li class="ai-history-item">
                                            <div class="ai-history-meta">
                                                <span class="ai-history-badge">AI</span>
                                                <span class="ai-history-summary">@entry.Label</span>
                                            </div>
                                            <div class="ai-history-sub">
                                                <span>@entry.Timestamp.ToLocalTime().ToString("g")</span>
                                                @if (entry.IsApplied)
                                                {
                                                    <span class="ai-history-status is-applied">Applied</span>
                                                    @if (entry.AppliedCount > 1)
                                                    {
                                                        <span class="ai-history-status-count">x@entry.AppliedCount</span>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="ai-history-status is-pending">Pending</span>
                                                }
                                            </div>
                                            <div class="ai-history-actions">
                                                <button type="button"
                                                        class="ai-details-toggle"
                                                        aria-expanded="@showDetails"
                                                        aria-controls="@GetAiHistoryDetailsId(entry)"
                                                        @onclick="() => OnToggleAiHistoryDetails(entry)">
                                                    @(showDetails ? "Hide details" : "Details")
                                                </button>
                                            </div>
                                            @if (showDetails)
                                            {
                                                <div id="@GetAiHistoryDetailsId(entry)" class="ai-history-details">
                                                    <div class="ai-history-details-header">
                                                        <div class="ai-history-details-summary">@(entry.Summary ?? entry.Label)</div>
                                                        <div class="ai-history-details-sub">
                                                            <span>@(entry.IsApplied ? "Applied" : "Pending")</span>
                                                            @if (entry.LastAppliedAt.HasValue)
                                                            {
                                                                <span>@entry.LastAppliedAt.Value.ToLocalTime().ToString("g")</span>
                                                            }
                                                            <span>@entry.Timestamp.ToLocalTime().ToString("g")</span>
                                                        </div>
                                                    </div>
                                                    <div class="ai-history-details-compare">
                                                        <div class="ai-history-details-block">
                                                            <div class="ai-history-details-label">Before</div>
                                                            <pre>@FormatHistoryText(entry.BeforeText)</pre>
                                                        </div>
                                                        <div class="ai-history-details-block">
                                                            <div class="ai-history-details-label">After</div>
                                                            <pre>@FormatHistoryText(entry.AfterText)</pre>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </li>
                                    }
                                </ul>
                                }
                            </div>
                        }
                        else if (_activeContextTab == ContextTab.Annotations)
                        {
                            <div class="drawer-panel annotations-panel">
                                @if (_annotationsLoading)
                                {
                                    <div class="drawer-empty">Loading annotations...</div>
                                }
                                else if (!string.IsNullOrWhiteSpace(_annotationsError))
                                {
                                    <div class="drawer-empty">@_annotationsError</div>
                                }
                                else if (_annotations.Count == 0)
                                {
                                    <div class="drawer-empty">No annotations yet.</div>
                                }
                                else
                                {
                                    <ul class="annotations-list">
                                        @foreach (PageAnnotationDto annotation in _annotations)
                                        {
                                            <li class="annotation-item @GetAnnotationItemClass(annotation) @GetAnnotationFocusClass(annotation)"
                                                id="@GetAnnotationElementId(annotation)">
                                                <div class="annotation-meta">
                                                    <span class="annotation-kind">@GetAnnotationKindLabel(annotation.Kind)</span>
                                                    <span class="annotation-time">@annotation.CreatedAt.ToLocalTime().ToString("g")</span>
                                                    @if (string.Equals(annotation.Status, "resolved", StringComparison.OrdinalIgnoreCase))
                                                    {
                                                        <span class="annotation-status">Resolved</span>
                                                    }
                                                </div>
                                                @if (!string.IsNullOrWhiteSpace(annotation.Content))
                                                {
                                                    <div class="annotation-content">@annotation.Content</div>
                                                }
                                                <div class="annotation-actions">
                                                    @if (string.Equals(annotation.Status, "resolved", StringComparison.OrdinalIgnoreCase))
                                                    {
                                                        <button type="button" @onclick="() => ReopenAnnotationAsync(annotation)">Reopen</button>
                                                    }
                                                    else
                                                    {
                                                        <button type="button" class="danger" @onclick="() => ResolveAnnotationAsync(annotation)">Resolve</button>
                                                    }
                                                </div>
                                            </li>
                                        }
                                    </ul>
                                }
                            </div>
                        }
                        else if (_activeContextTab == ContextTab.Quality)
                        {
                            <div class="drawer-panel quality-panel">
                                @if (_qualityLoading)
                                {
                                    <div class="drawer-empty">Checking quality...</div>
                                }
                                else if (!string.IsNullOrWhiteSpace(_qualityError))
                                {
                                    <div class="drawer-empty">@_qualityError</div>
                                }
                                else if (_qualityIssues.Count == 0)
                                {
                                    <div class="drawer-empty">No quality issues found.</div>
                                }
                                else
                                {
                                    <ul class="quality-list">
                                        @foreach (PageQualityIssueDto issue in FilterQualityIssues())
                                        {
                                            <li class="quality-item @GetQualityIssueClass(issue)">
                                                <div class="quality-meta">
                                                    <span class="quality-kind">@issue.Kind</span>
                                                    <span class="quality-severity">@issue.Severity</span>
                                                </div>
                                                <div class="quality-message">@issue.Message</div>
                                                @if (!string.IsNullOrWhiteSpace(issue.Suggestion))
                                                {
                                                    <div class="quality-suggestion">@issue.Suggestion</div>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(issue.AnchorText))
                                                {
                                                    <div class="quality-anchor">“@issue.AnchorText”</div>
                                                }
                                                <div class="quality-actions">
                                                    <button type="button" class="danger" @onclick="() => DismissQualityIssueAsync(issue)">Dismiss</button>
                                                </div>
                                            </li>
                                        }
                                    </ul>
                                }
                            </div>
                        }
                        else if (_activeContextTab == ContextTab.History)
                        {
                            <div class="drawer-panel version-history-panel">
                                @if (_versionsLoading)
                                {
                                    <div class="drawer-empty">Loading versions...</div>
                                }
                                else if (!string.IsNullOrWhiteSpace(_versionsError))
                                {
                                    <div class="drawer-empty">@_versionsError</div>
                                }
                                else if (_pageVersions.Count == 0)
                                {
                                    <div class="drawer-empty">No versions yet.</div>
                                }
                                else
                                {
                                    <ul class="version-history-list">
                                        @foreach (PageVersionListItemDto version in _pageVersions)
                                        {
                                            <li class="version-history-item">
                                                <div class="version-history-meta">
                                                    <span class="version-history-badge">@GetVersionReasonLabel(version.Reason)</span>
                                                    <span class="version-history-time">@version.CreatedAt.ToLocalTime().ToString("g")</span>
                                                </div>
                                                <div class="version-history-sub">Words: @version.WordCount</div>
                                                <div class="version-history-actions">
                                                    <button type="button" @onclick="() => SelectDiffBaseAsync(version)">
                                                        Compare
                                                    </button>
                                                    <button type="button" class="danger" @onclick="() => PromptRestoreVersion(version)">
                                                        Restore
                                                    </button>
                                                </div>
                                            </li>
                                        }
                                    </ul>
                                }
                            </div>
                        }
                    </Body>
                    <Footer>
                        @if (_isDiffMode)
                        {
                            <div class="rp-footer-actions">
                                <button type="button" @onclick="GoToPreviousChange" disabled="@(!_diffChangeBlocks.Any())">Prev</button>
                                <button type="button" @onclick="GoToNextChange" disabled="@(!_diffChangeBlocks.Any())">Next</button>
                                @if (_diffCompareVersionId.HasValue)
                                {
                                    <button type="button" class="danger" @onclick="() => PromptRestoreVersionById(_diffCompareVersionId.Value)">
                                        Restore compare
                                    </button>
                                }
                            </div>
                        }
                        else if (_activeContextTab == ContextTab.Notes)
                        {
                            <div class="rp-footer-actions">
                                @if (!string.IsNullOrWhiteSpace(_notesStatus))
                                {
                                    <span class="rp-status">@_notesStatus</span>
                                }
                                <button type="button" @onclick="OnNotesSave">Save notes</button>
                            </div>
                        }
                        else if (_activeContextTab == ContextTab.Scene)
                        {
                            <div class="rp-footer-actions">
                                @if (!string.IsNullOrWhiteSpace(_sceneStatus))
                                {
                                    <span class="rp-status">@_sceneStatus</span>
                                }
                                <button type="button" title='@GetTooltip("Save scene metadata.")' @onclick="OnSceneCardSave">Save scene card</button>
                            </div>
                        }
                        else if (_activeContextTab == ContextTab.Outline)
                        {
                            <div class="rp-footer-actions outline-footer">
                                <div class="outline-action-bar__hint">
                                    @if (!_activeOutlineNodeId.HasValue)
                                    {
                                        <span>Select an outline item to edit.</span>
                                    }
                                </div>
                                <div class="outline-action-bar__buttons">
                                    <button type="button"
                                            class="outline-btn outline-btn--ghost"
                                            disabled="@(!_activeOutlineNodeId.HasValue)"
                                            @onclick="() => AddSiblingNodeAsync(_activeOutlineNodeId!.Value)">
                                        Add sibling
                                    </button>
                                    <button type="button"
                                            class="outline-btn outline-btn--ghost"
                                            disabled="@(!_activeOutlineNodeId.HasValue)"
                                            @onclick="() => AddChildNodeAsync(_activeOutlineNodeId!.Value)">
                                        Add child
                                    </button>
                                    <button type="button"
                                            class="outline-btn outline-btn--ghost"
                                            disabled="@(!_activeOutlineNodeId.HasValue)"
                                            @onclick="() => StartRenameNode(_activeOutlineNodeId!.Value)">
                                        Rename
                                    </button>
                                    <button type="button"
                                            class="outline-btn outline-btn--ghost outline-btn--danger"
                                            disabled="@(!_activeOutlineNodeId.HasValue)"
                                            @onclick="() => DeleteNodeAsync(_activeOutlineNodeId!.Value)">
                                        Delete
                                    </button>
                                </div>
                                <div class="outline-actions">
                                    <button type="button"
                                            class="outline-btn outline-btn--secondary"
                                            @onclick="GenerateOutlineAsync"
                                            disabled="@_outlineGenerateInFlight">
                                        @(_outlineGenerateInFlight ? "Generating..." : "Generate from content")
                                    </button>
                                    <button type="button"
                                            class="outline-btn outline-btn--primary"
                                            @onclick="ApplyOutlineToSectionsAsync"
                                            disabled="@_outlineApplyInFlight">
                                        @(_outlineApplyInFlight ? "Applying..." : "Apply outline to sections")
                                    </button>
                                </div>
                            </div>
                        }
                        else if (_activeContextTab == ContextTab.Annotations)
                        {
                            <div class="annotations-create">
                                <div class="annotations-selection">@GetAnnotationSelectionLabel()</div>
                                <textarea class="annotations-input"
                                          value="@_annotationDraftContent"
                                          @oninput="OnAnnotationDraftInput"
                                          placeholder="Add a comment or TODO..."></textarea>
                                <div class="annotations-create-actions">
                                    <button type="button"
                                            class="annotations-action"
                                            disabled="@(!_canCreateAnnotation)"
                                            @onclick='@(() => CreateAnnotationAsync("comment"))'>
                                        Add comment
                                    </button>
                                    <button type="button"
                                            class="annotations-action"
                                            disabled="@(!_canCreateAnnotation)"
                                            @onclick='@(() => CreateAnnotationAsync("todo"))'>
                                        Add TODO
                                    </button>
                                    <button type="button"
                                            class="annotations-action"
                                            disabled="@(!_canCreateAnnotation)"
                                            @onclick='@(() => CreateAnnotationAsync("highlight"))'>
                                        Add highlight
                                    </button>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(_annotationActionError))
                                {
                                    <div class="annotations-error">@_annotationActionError</div>
                                }
                            </div>
                        }
                    </Footer>
                </RightPanelShell>
            </aside>

        </div>
    </div>
}

@if (_isRestoreDialogOpen)
{
    <div class="modal-backdrop" @onclick="CancelRestoreVersion"></div>
    <div class="modal" role="dialog" aria-modal="true">
        <div class="modal-title">Restore this version?</div>
        <div class="modal-body">
            This will replace the current page content. A pre-restore snapshot will be created automatically.
            @if (_pendingRestoreVersion is not null)
            {
                <div class="version-restore-meta">
                    Version: @_pendingRestoreVersion.CreatedAt.ToLocalTime().ToString("g")
                </div>
