        </div>
        @if (!string.IsNullOrWhiteSpace(_restoreError))
        {
            <div class="modal-error">@_restoreError</div>
        }
        <div class="modal-actions">
            <button type="button"
                    class="danger"
                    @onclick="ConfirmRestoreVersionAsync"
                    disabled="@_restoreInFlight">
                Restore
            </button>
            <button type="button"
                    @onclick="CancelRestoreVersion"
                    disabled="@_restoreInFlight">
                Cancel
            </button>
        </div>
    </div>
}

@if (_isDeleteDialogOpen)
{
    <div class="modal-overlay" role="presentation">
        <div class="modal-backdrop" @onclick="CancelDeleteSection"></div>
