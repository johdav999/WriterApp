            <div class="export-panel-row">
                <label class="export-panel-label" for="export-format">Format</label>
                <select id="export-format" class="export-panel-select" @bind="_exportFormatSelection" @bind:after="MarkPresetAsCustom">
                    <option value="html">HTML</option>
                    <option value="markdown">Markdown</option>
                    @if (_docxExportEnabled)
                    {
                        <option value="docx">DOCX</option>
                    }
                    @if (_epubExportEnabled && string.Equals(_exportContentSelection, "document", StringComparison.OrdinalIgnoreCase))
                    {
                        <option value="epub">EPUB</option>
