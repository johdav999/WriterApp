            @if (string.Equals(_exportScopeType, "sections", StringComparison.OrdinalIgnoreCase))
            {
                <div class="export-panel-row export-panel-sections">
                    <label class="export-panel-label" for="scope-search">Sections</label>
                    <div class="export-panel-section-list">
                        <div class="export-panel-section-actions">
                            <input id="scope-search"
                                   class="export-panel-input"
                                   placeholder="Search sections..."
                                   @bind="_exportScopeSearch" />
                            <button type="button" class="link-button" @onclick="ToggleSelectAllSections">Select all</button>
