        </div>
    </div>
}

@if (_isContinuityProposalOpen && _pendingContinuityIssue is not null)
{
    <div class="modal-overlay" role="presentation">
        <div class="modal-backdrop" @onclick="CancelContinuityProposal"></div>
        <div class="modal quality-proposal-dialog"
             role="dialog"
             aria-modal="true"
             aria-labelledby="continuityProposalTitle"
             tabindex="0"
             @onkeydown="OnContinuityProposalKeyDown">
            <div class="modal-title" id="continuityProposalTitle">Apply suggested fix?</div>
            <div class="modal-body">
                <div class="quality-proposal-meta">
                    <span>@_pendingContinuityIssue.Type</span>
                    <span>@_pendingContinuityIssue.Severity</span>
                </div>
                <div class="quality-proposal-message">@_pendingContinuityIssue.Message</div>
                @if (!string.IsNullOrWhiteSpace(_pendingContinuityIssue.Evidence.Quote))
                {
                    <div class="quality-proposal-suggestion">"@_pendingContinuityIssue.Evidence.Quote"</div>
                }
                @if (_continuityProposalPreview is not null)
                {
                    <div class="quality-proposal-preview">
                        <div class="quality-proposal-label">Before</div>
                        <pre>@_continuityProposalPreview.Before</pre>
                        @if (_continuityProposalPreview.IsDeletion)
                        {
                            <div class="quality-proposal-label">Change</div>
                            <div class="quality-proposal-suggestion">Remove highlighted text</div>
                            <pre>@_continuityProposalPreview.DeletionText</pre>
                        }
                        else
                        {
                            <div class="quality-proposal-label">After</div>
                            <pre>@_continuityProposalPreview.After</pre>
                        }
                    </div>
                    @if (!string.IsNullOrEmpty(_continuityProposalPreview.Prefix) || !string.IsNullOrEmpty(_continuityProposalPreview.Suffix))
                    {
                        <div class="quality-proposal-context">
                            <div class="quality-proposal-label">Context</div>
                            <div class="quality-proposal-context-line">
                                <span>@_continuityProposalPreview.Prefix</span><span class="quality-proposal-token quality-proposal-token--before">@_continuityProposalPreview.Before</span><span>@_continuityProposalPreview.Suffix</span>
                            </div>
                            @if (!_continuityProposalPreview.IsDeletion)
                            {
                                <div class="quality-proposal-context-line">
                                    <span>@_continuityProposalPreview.Prefix</span><span class="quality-proposal-token quality-proposal-token--after">@_continuityProposalPreview.After</span><span>@_continuityProposalPreview.Suffix</span>
                                </div>
                            }
                        </div>
                    }
                }
            </div>
            @if (!string.IsNullOrWhiteSpace(_continuityProposalError))
            {
                <div class="modal-error">@_continuityProposalError</div>
                <div class="modal-actions">
                    <button type="button"
                            @onclick="ShowPendingContinuityIssueInTextAsync"
                            disabled="@_isApplyingContinuityProposal">
                        Show in text
                    </button>
                    <button type="button"
                            @onclick="RecomputeContinuityRangeAsync"
                            disabled="@_isApplyingContinuityProposal">
                        Recompute range
                    </button>
                </div>
            }
            <div class="modal-actions">
                <button type="button"
                        class="primary"
                        @onclick="ConfirmContinuityProposalApplyAsync"
                        disabled="@_isApplyingContinuityProposal">
                    @(_isApplyingContinuityProposal ? "Applying..." : "Apply")
                </button>
                <button type="button"
                        @onclick="CancelContinuityProposal"
                        disabled="@_isApplyingContinuityProposal">
                    Cancel
                </button>
            </div>
        </div>
    </div>
}

