                                                     AllowedTitle="Undo the last AI-applied change."
                                                     LockedTitle="@GetFeatureTooltip(FeatureKey.AiUndoRedo)"
                                                     IsBusy="_aiUndoRedoInFlight"
                                                     IsActionDisabled="@(!_hasAiUndoHistory)"
                                                     OnClick="OnAiUndoRequested">
                                        AI Undo
                                    </PlanGatedButton>
                                    <PlanGatedButton Feature="@nameof(FeatureKey.AiUndoRedo)"
                                                     Class="ai-history-button"
                                                     AriaLabel="AI Redo"
                                                     AllowedTitle="Redo the last AI-applied change."
                                                     LockedTitle="@GetFeatureTooltip(FeatureKey.AiUndoRedo)"
                                                     IsBusy="_aiUndoRedoInFlight"
                                                     IsActionDisabled="@(!_hasAiRedoHistory)"
                                                     OnClick="OnAiRedoRequested">
                                        AI Redo
                                    </PlanGatedButton>
                                    <span class="ai-history-count-pill">@_aiHistoryEntries.Count</span>
                                </div>
                                @if (_versionsLoading)
                                {
                                    <div class="drawer-empty">Loading versions...</div>
                                }
                                else if (!string.IsNullOrWhiteSpace(_versionsError))
                                {
                                    <div class="drawer-empty">@_versionsError</div>
                                }
                                else if (GetFilteredHistoryItems().Count == 0)
                                {
                                    <div class="drawer-empty">No history items for this filter.</div>
                                }
                                else
                                {
                                    <ul class="version-history-list">
                                        @foreach (CombinedHistoryItem item in GetFilteredHistoryItems())
                                        {
                                            if (item.Type == HistoryItemType.Snapshot && item.Version is not null)
                                            {
                                                PageVersionListItemDto version = item.Version;
                                                <li class="version-history-item history-item-card history-item-card--snapshot">
                                                    <div class="version-history-meta">
                                                        <span class="version-history-badge history-type-badge history-type-badge--snapshot">@GetSnapshotDisplayLabel(version.Reason)</span>
                                                        <span class="version-history-time">@version.CreatedAt.ToLocalTime().ToString("g")</span>
                                                    </div>
                                                    <div class="version-history-sub">Words: @version.WordCount</div>
                                                    <div class="history-item-helper">Restores the document to this checkpoint.</div>
                                                    <div class="version-history-actions">
                                                        <button type="button" @onclick="() => SelectDiffBaseAsync(version)">
                                                            Compare
                                                        </button>
                                                        <button type="button" class="danger" @onclick="() => PromptRestoreVersion(version)">
                                                            Restore
