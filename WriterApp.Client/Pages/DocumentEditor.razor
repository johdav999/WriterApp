            <div class="modal-header">
                <div class="modal-title">Export document</div>
            </div>
            <div class="modal-body">
            <div class="export-panel-row">
                <label class="export-panel-label" for="export-preset">Preset</label>
                <select id="export-preset" class="export-panel-select" @bind="SelectedPresetIdValue">
                    <option value="">Custom</option>
                    @foreach (ExportPresetDto preset in _exportPresets)
                    {
                        <option value="@preset.Id">@($"{preset.Name}{(preset.IsGlobalDefault ? " (Default)" : string.Empty)}")</option>
                    }
