@if (_isQualityProposalOpen && _proposalIssue is not null)
{
    <div class="modal-overlay" role="presentation">
        <div class="modal-backdrop" @onclick="CancelQualityProposal"></div>
        <div class="modal quality-proposal-dialog" role="dialog" aria-modal="true" aria-labelledby="qualityProposalTitle">
            <div class="modal-title" id="qualityProposalTitle">Apply suggested change?</div>
            <div class="modal-body">
                <div class="quality-proposal-meta">
                    <span>@_proposalIssue.Kind</span>
                    <span>@_proposalIssue.Severity</span>
                    @if (!string.IsNullOrWhiteSpace(_proposalIssue.RuleId))
                    {
                        <span>@_proposalIssue.RuleId</span>
                    }
                </div>
                <div class="quality-proposal-message">@_proposalIssue.Message</div>
                @if (!string.IsNullOrWhiteSpace(_proposalIssue.Suggestion))
                {
                    <div class="quality-proposal-suggestion">@_proposalIssue.Suggestion</div>
                }
                @if (_proposalPreview is not null)
                {
                    <div class="quality-proposal-preview">
                        <div class="quality-proposal-label">Before</div>
                        <pre>@_proposalPreview.Before</pre>
                        <div class="quality-proposal-label">After</div>
                        <pre>@_proposalPreview.After</pre>
                    </div>
                    @if (!string.IsNullOrEmpty(_proposalPreview.Prefix) || !string.IsNullOrEmpty(_proposalPreview.Suffix))
                    {
                        <div class="quality-proposal-context">
                            <div class="quality-proposal-label">Context</div>
                            <div class="quality-proposal-context-line">
                                <span>@_proposalPreview.Prefix</span><span class="quality-proposal-token quality-proposal-token--before">@_proposalPreview.Before</span><span>@_proposalPreview.Suffix</span>
                            </div>
                            <div class="quality-proposal-context-line">
                                <span>@_proposalPreview.Prefix</span><span class="quality-proposal-token quality-proposal-token--after">@_proposalPreview.After</span><span>@_proposalPreview.Suffix</span>
                            </div>
                        </div>
                    }
                }
