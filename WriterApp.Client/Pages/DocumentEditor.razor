                                                bool showDetails = _expandedAiHistoryId == entry.Id;
                                                <li class="version-history-item history-item-card history-item-card--command">
                                                    <div class="version-history-meta">
                                                        <span class="version-history-badge history-type-badge history-type-badge--command">AI Command</span>
                                                        <span class="version-history-time">@entry.Timestamp.ToLocalTime().ToString("g")</span>
