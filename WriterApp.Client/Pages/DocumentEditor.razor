                                           checked="@IsSectionSelected(scopeItem.Id)"
                                           @onchange="(args => ToggleSectionSelection(scopeItem.Id, args))" />
                                    <span>@(scopeItem.Title)</span>
                                </label>
                            }
                        </div>
                    </div>
                </div>
            }
            @if (string.Equals(_exportScopeType, "selection", StringComparison.OrdinalIgnoreCase))
            {
                <div class="export-panel-row export-panel-selection">
                    <label class="export-panel-label">Selection</label>
                    <div class="export-panel-selection-body">
                        <button type="button" @onclick="CaptureSelectionAsync">Use current editor selection</button>
                        <div class="export-panel-hint">@ExportSelectionSummary</div>
                    </div>
                </div>
            }
            <div class="export-panel-row">
                <label class="export-panel-label">Title page</label>
                <div class="export-panel-checkbox">
                    <input type="checkbox" @bind="_exportIncludeTitlePage" @bind:after="MarkPresetAsCustom" />
                    <span>Include title page</span>
                </div>
            </div>
            @if (_exportIncludeTitlePage)
            {
                <div class="export-panel-row">
                    <label class="export-panel-label" for="title-page-title">Title</label>
                    <input id="title-page-title" class="export-panel-input" @bind="_titlePageTitle" @bind:after="MarkPresetAsCustom" />
                </div>
                <div class="export-panel-row">
                    <label class="export-panel-label" for="title-page-subtitle">Subtitle</label>
                    <input id="title-page-subtitle" class="export-panel-input" @bind="_titlePageSubtitle" @bind:after="MarkPresetAsCustom" />
                </div>
                <div class="export-panel-row">
                    <label class="export-panel-label" for="title-page-author">Author</label>
                    <input id="title-page-author" class="export-panel-input" @bind="_titlePageAuthor" @bind:after="MarkPresetAsCustom" />
                </div>
                <div class="export-panel-row">
                    <label class="export-panel-label" for="title-page-draft">Draft label</label>
                    <input id="title-page-draft" class="export-panel-input" @bind="_titlePageDraftLabel" @bind:after="MarkPresetAsCustom" />
                </div>
                <div class="export-panel-row">
                    <label class="export-panel-label" for="title-page-date">Date</label>
                    <input id="title-page-date" class="export-panel-input" @bind="_titlePageDate" @bind:after="MarkPresetAsCustom" />
