            {
                <div class="export-panel-row">
                    <label class="export-panel-label" for="toc-depth">TOC depth</label>
                    <select id="toc-depth" class="export-panel-select" @bind="_exportTocDepth" @bind:after="MarkPresetAsCustom">
                        <option value="1">H1</option>
                        <option value="2">H1-H2</option>
                        <option value="3">H1-H3</option>
                    </select>
                </div>
            }
            <div class="export-panel-row">
                <label class="export-panel-label">Chapter breaks</label>
                <div class="export-panel-checkbox-group">
                    <label>
                        <input type="checkbox"
                               checked='@IsChapterBreakRuleEnabled("h1")'
                               @onchange='@(args => ToggleChapterBreakRule("h1", args))' />
                        Start each H1 on new page
                    </label>
                    <label>
                        <input type="checkbox"
                               checked='@IsChapterBreakRuleEnabled("section")'
                               @onchange='@(args => ToggleChapterBreakRule("section", args))' />
                        Start each section on new page
                    </label>
                </div>
            </div>
            <div class="export-panel-row export-panel-actions">
                <PlanGatedButton Feature="@nameof(FeatureKey.ExportTemplates)"
                                 Class="link-button"
                                 OnClick="OpenTemplateManagerAsync">
                    Manage templates...
                </PlanGatedButton>
                <span class="export-panel-hint">Templates apply to HTML/PDF/DOCX exports.</span>
            </div>
            }
            @if (!string.IsNullOrWhiteSpace(_templateLoadError))
            {
                <div class="modal-error">@_templateLoadError</div>
            }
            @if (!string.IsNullOrWhiteSpace(_templateActionError))
            {
                <div class="modal-error">@_templateActionError</div>
            }
            @if (!string.IsNullOrWhiteSpace(_presetLoadError))
            {
                <div class="modal-error">@_presetLoadError</div>
            }
            @if (!string.IsNullOrWhiteSpace(_presetActionError))
            {
                <div class="modal-error">@_presetActionError</div>
            }
            </div>
            <div class="modal-footer">
                <button type="button"
                        title="@GetExportPreviewButtonTooltip()"
                        @onclick="OpenPreviewAsync"
                        disabled="@IsExportDialogLoading">@GetExportPreviewButtonLabel()</button>
                <PlanGatedButton Feature="@GetExportSubmitFeatureName()"
                                 Class="export-submit-button"
                                 AllowedTitle="@GetExportSubmitButtonTooltip()"
                                 LockedTitle="@GetExportSubmitLockedTooltip()"
                                 AriaLabel="Export"
                                 IsActionDisabled="@IsExportDialogLoading"
                                 OnClick="ExecuteExportSelectionAsync">
                    Export
                </PlanGatedButton>
                <button type="button" @onclick="CloseExportDialog">Cancel</button>
            </div>
        </div>
    </div>
}

@if (_isTemplateManagerOpen)
{
    <div class="modal-overlay" @onclick="CloseTemplateManager">
        @* Standard modal layout *@
        <div class="modal export-dialog template-manager modal-panel" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
            <div class="modal-header">
                <div class="modal-title">Export templates</div>
            </div>
            <div class="modal-body">
            <div class="template-manager-row">
                <label class="export-panel-label" for="template-preset-create">New template</label>
                <div class="template-manager-create">
                    <select id="template-preset-create" class="export-panel-select" @bind="_createPresetKey">
                        @foreach (ExportTemplatePresetDefinition preset in PresetOptions)
                        {
                            <option value="@preset.Key">@preset.Name</option>
                        }
                    </select>
                    <button type="button" @onclick="CreateTemplateFromPresetAsync">Create</button>
                </div>
            </div>

            <div class="template-manager-list">
                @foreach (ExportTemplateDto template in _exportTemplates.OrderBy(item => item.Name))
                {
                    <div class="template-card">
                        <div class="template-card-main">
                            <div class="template-name">@template.Name</div>
                            <div class="template-tag">@GetPresetTag(template.PresetKey)</div>
                        </div>
                        <div class="template-card-actions">
                            <button type="button" @onclick="() => DuplicateTemplateAsync(template)">Duplicate</button>
                            <button type="button" @onclick="() => StartEditTemplate(template)">Edit</button>
                            <button type="button" class="danger" disabled="@_isTemplateDeleting" @onclick="() => DeleteTemplateAsync(template)">Delete</button>
                        </div>
                    </div>
                }
            </div>

            @if (_isTemplateEditorOpen && _templateEditor is not null)
            {
                <div class="template-editor">
                    <h3>Edit template</h3>
                    <div class="template-grid">
                        <label class="export-panel-label" for="template-name">Name</label>
                        <input id="template-name" class="export-panel-input" @bind="_templateEditor.Name" />

                        <label class="export-panel-label" for="template-page-size">Page size</label>
                        <select id="template-page-size" class="export-panel-select" value="@_templateEditorPagePreset" @onchange="OnTemplatePresetChanged">
                            @foreach (ExportTemplatePresetDefinition preset in PresetOptions)
                            {
                                <option value="@preset.Key">@preset.Name (@preset.PageWidthMm x @preset.PageHeightMm)</option>
                            }
                            <option value="custom">Custom</option>
                        </select>

                        <label class="export-panel-label">Width/Height (mm)</label>
                        <div class="template-inline-inputs">
                            <input type="number" class="export-panel-input" @bind="_templateEditor.PageWidthMm" />
                            <input type="number" class="export-panel-input" @bind="_templateEditor.PageHeightMm" />
                        </div>

                        <label class="export-panel-label">Margins (mm)</label>
                        <div class="template-inline-inputs">
                            <input type="number" class="export-panel-input" @bind="_templateEditor.MarginTopMm" placeholder="Top" />
                            <input type="number" class="export-panel-input" @bind="_templateEditor.MarginRightMm" placeholder="Right" />
                            <input type="number" class="export-panel-input" @bind="_templateEditor.MarginBottomMm" placeholder="Bottom" />
                            <input type="number" class="export-panel-input" @bind="_templateEditor.MarginLeftMm" placeholder="Left" />
                        </div>

                        <label class="export-panel-label">Typography</label>
                        <div class="template-inline-inputs">
                            <input class="export-panel-input" @bind="_templateEditor.FontFamily" placeholder="Font family" />
                            <input type="number" class="export-panel-input" @bind="_templateEditor.BodyFontSizePt" placeholder="Font size (pt)" />
                            <input type="number" step="0.1" class="export-panel-input" @bind="_templateEditor.LineHeight" placeholder="Line height" />
                        </div>

                        <label class="export-panel-label">Header</label>
                        <div class="template-section">
                            <label><input type="checkbox" @bind="_templateEditor.HeaderEnabled" /> Enabled</label>
                            <div class="template-inline-inputs">
                                <input class="export-panel-input" @bind="_templateEditor.HeaderLeft" placeholder="Left" title="Tokens: {DocumentTitle}, {SectionTitle}, {Date}, {PageNumber}, {TotalPages}" />
                                <input class="export-panel-input" @bind="_templateEditor.HeaderCenter" placeholder="Center" title="Tokens: {DocumentTitle}, {SectionTitle}, {Date}, {PageNumber}, {TotalPages}" />
                                <input class="export-panel-input" @bind="_templateEditor.HeaderRight" placeholder="Right" title="Tokens: {DocumentTitle}, {SectionTitle}, {Date}, {PageNumber}, {TotalPages}" />
                            </div>
                        </div>

                        <label class="export-panel-label">Footer</label>
                        <div class="template-section">
                            <label><input type="checkbox" @bind="_templateEditor.FooterEnabled" /> Enabled</label>
                            <div class="template-inline-inputs">
                                <input class="export-panel-input" @bind="_templateEditor.FooterLeft" placeholder="Left" title="Tokens: {DocumentTitle}, {SectionTitle}, {Date}, {PageNumber}, {TotalPages}" />
                                <input class="export-panel-input" @bind="_templateEditor.FooterCenter" placeholder="Center" title="Tokens: {DocumentTitle}, {SectionTitle}, {Date}, {PageNumber}, {TotalPages}" />
                                <input class="export-panel-input" @bind="_templateEditor.FooterRight" placeholder="Right" title="Tokens: {DocumentTitle}, {SectionTitle}, {Date}, {PageNumber}, {TotalPages}" />
                            </div>
                        </div>

                        <label class="export-panel-label">TOC</label>
                        <div class="template-inline-inputs">
                            <label><input type="checkbox" @bind="_templateEditor.TocEnabled" /> Enabled</label>
                            <input type="number" class="export-panel-input" @bind="_templateEditor.TocDepth" placeholder="Depth" />
                        </div>

                        <label class="export-panel-label">Page numbers</label>
                        <div class="template-inline-inputs">
                            <label><input type="checkbox" @bind="_templateEditor.PageNumbersEnabled" /> Enabled</label>
                            <input type="number" class="export-panel-input" @bind="_templateEditor.PageNumberStart" placeholder="Start" />
                        </div>
                    </div>
                    <div class="modal-actions">
                        <button type="button" @onclick="SaveTemplateAsync" disabled="@_isTemplateSaving">Save</button>
                        <button type="button" @onclick="CancelTemplateEdit">Cancel</button>
                    </div>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(_templateActionError))
            {
                <div class="modal-error">@_templateActionError</div>
            }
            </div>
            <div class="modal-footer">
                <button type="button" @onclick="CloseTemplateManager">Close</button>
            </div>
        </div>
    </div>
}

@if (_isExportPreviewOpen)
{
    <div class="modal-overlay" @onclick="ClosePreview">
        @* Standard modal layout *@
        <div class="modal export-preview modal-panel" role="dialog" aria-modal="true" style="@GetPreviewStyle()" @onclick:stopPropagation="true">
            <div class="modal-header">
                <div class="modal-title">@GetExportPreviewTitle()</div>
            </div>
            <div class="modal-body">
                <div class="preview-layout">
                    <aside class="preview-sidebar @( _previewSidebarOpen ? "is-open" : "is-collapsed")">
                        <div class="preview-sidebar-header">
                            <span>Pages</span>
                            <button type="button" class="link-button" @onclick="TogglePreviewSidebar">
                                @(_previewSidebarOpen ? "Hide" : "Show")
                            </button>
                        </div>
                        @if (_previewSidebarOpen)
                        {
                            <div class="preview-sidebar-search">
                                <input type="search"
                                       placeholder="Find in preview"
                                       @bind="_previewSearchTerm"
                                       @bind:after="RunPreviewSearchAsync" />
                                <button type="button" class="link-button" @onclick="ClearPreviewSearch">Clear</button>
                            </div>
                            <div class="preview-sidebar-toggle">
                                <label>
                                    <input type="checkbox" @bind="_previewShowPageBreaks" @bind:after="TogglePreviewPageBreaksAsync" />
                                    Show page breaks
                                </label>
                            </div>
                            <div class="preview-page-list">
                                @if (_previewHasFrontMatter)
                                {
                                    <button type="button"
                                            class="preview-page-item @( _previewCurrentPage == 0 ? "is-active" : string.Empty)"
                                            @onclick="JumpToFrontMatterAsync">
                                        Front matter
                                    </button>
                                }
                                @for (int pageIndex = 1; pageIndex <= _previewPageCount; pageIndex++)
                                {
                                    int targetPage = pageIndex;
                                    <button type="button"
                                            class="preview-page-item @(pageIndex == _previewCurrentPage ? "is-active" : string.Empty)"
                                            @onclick="() => JumpToPreviewPageAsync(targetPage)">
                                        Page @pageIndex
                                    </button>
                                }
                            </div>
                        }
                    </aside>
                    <section class="preview-main">
                        <div class="preview-toolbar">
                            <div class="preview-zoom">
                                <span>Zoom</span>
                                <button type="button" class="link-button" @onclick="SetFitWidthAsync">Fit width</button>
                                <button type="button" class="link-button" @onclick="SetFitPageAsync">Fit page</button>
                                <button type="button" @onclick="() => AdjustPreviewZoom(-0.1)">-</button>
                                <span class="preview-zoom-value">@PreviewZoomPercent</span>
                                <button type="button" @onclick="() => AdjustPreviewZoom(0.1)">+</button>
                                <button type="button" @onclick="() => SetPreviewZoom(1.0)">100%</button>
                                <button type="button" @onclick="() => SetPreviewZoom(1.25)">125%</button>
                                <button type="button" @onclick="() => SetPreviewZoom(1.5)">150%</button>
                            </div>
                            <div class="preview-toolbar-actions">
                                <button type="button" @onclick="PrintPreviewAsync">Print</button>
                            </div>
                        </div>
                        @if (_isPreviewLoading)
                        {
                            <div class="export-panel-note">Rendering preview...</div>
                        }
                        else if (!string.IsNullOrWhiteSpace(_previewError))
                        {
                            <div class="modal-error">@_previewError</div>
                        }
                        else
                        {
                            <div class="preview-frame-wrap">
                                <iframe id="export-preview-frame"
                                        class="export-preview-frame"
                                        srcdoc="@_previewHtml"
                                        @onload="OnPreviewFrameLoadedAsync"
                                        sandbox="allow-same-origin allow-scripts allow-modals"></iframe>
                            </div>
                        }
                    </section>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" @onclick="ClosePreview">Close</button>
            </div>
        </div>
    </div>
}

@if (_isContextMenuOpen)
{
    <div class="editor-context-menu-backdrop" @onclick="CloseContextMenu"></div>
    <div class="editor-context-menu"
         style="@GetContextMenuStyle()"
         tabindex="-1"
         role="menu"
         @ref="_contextMenuRef"
         @onclick:stopPropagation="true"
         @onkeydown="OnContextMenuKeyDown">
        <div class="editor-context-menu-group">
            <div class="editor-context-menu-label">Text emphasis</div>
            <button type="button"
                    class="@GetActiveClass(_formattingState.IsBold)"
                    disabled="@(!_formattingState.CanBold)"
                    @onclick="() => OnContextMenuCommand(OnBoldRequested)">Bold</button>
            <button type="button"
                    class="@GetActiveClass(_formattingState.IsItalic)"
                    disabled="@(!_formattingState.CanItalic)"
                    @onclick="() => OnContextMenuCommand(OnItalicRequested)">Italic</button>
            <button type="button"
                    class="@GetActiveClass(_formattingState.IsStrike)"
                    disabled="@(!_formattingState.CanStrike)"
                    @onclick="() => OnContextMenuCommand(OnStrikeRequested)">Strike</button>
            <button type="button"
                    class="@GetActiveClass(_formattingState.IsCode)"
                    disabled="@(!_formattingState.CanCode)"
                    @onclick="() => OnContextMenuCommand(OnCodeRequested)">Code</button>
        </div>
        <div class="editor-context-menu-group">
            <div class="editor-context-menu-label">Structure</div>
            <button type="button"
                    class='@GetActiveClass(_formattingState.BlockType == "paragraph")'
                    disabled="@(!_formattingState.CanApplyHeading)"
                    @onclick="() => OnContextMenuCommand(OnParagraphRequested)">Paragraph</button>
            <button type="button"
                    class='@GetActiveClass(_formattingState.BlockType == "heading:1")'
                    disabled="@(!_formattingState.CanApplyHeading)"
                    @onclick="() => OnContextMenuCommand(() => OnHeadingRequested(1))">Heading 1</button>
            <button type="button"
                    class='@GetActiveClass(_formattingState.BlockType == "heading:2")'
                    disabled="@(!_formattingState.CanApplyHeading)"
                    @onclick="() => OnContextMenuCommand(() => OnHeadingRequested(2))">Heading 2</button>
            <button type="button"
                    class='@GetActiveClass(_formattingState.BlockType == "heading:3")'
                    disabled="@(!_formattingState.CanApplyHeading)"
                    @onclick="() => OnContextMenuCommand(() => OnHeadingRequested(3))">Heading 3</button>
        </div>
        <div class="editor-context-menu-group">
            <div class="editor-context-menu-label">Lists</div>
            <button type="button" disabled="@(!_formattingState.CanToggleList)" @onclick="() => OnContextMenuCommand(OnBulletListRequested)">Bullet list</button>
            <button type="button" disabled="@(!_formattingState.CanToggleList)" @onclick="() => OnContextMenuCommand(OnOrderedListRequested)">Ordered list</button>
        </div>
        <div class="editor-context-menu-group">
            <div class="editor-context-menu-label">Table</div>
            <button type="button" disabled="@(!_formattingState.CanInsertTable)" @onclick="() => OnContextMenuCommand(OnInsertTableRequested)">Insert 3x3</button>
            <button type="button" disabled="@(!_formattingState.CanAddTableRowAfter)" @onclick="() => OnContextMenuCommand(OnAddTableRowAfterRequested)">Add row</button>
            <button type="button" disabled="@(!_formattingState.CanAddTableColumnAfter)" @onclick="() => OnContextMenuCommand(OnAddTableColumnAfterRequested)">Add col</button>
            <button type="button" disabled="@(!_formattingState.CanToggleTableHeaderRow)" @onclick="() => OnContextMenuCommand(OnToggleTableHeaderRowRequested)">Toggle header row</button>
            <button type="button" disabled="@(!_formattingState.CanDeleteTable)" @onclick="() => OnContextMenuCommand(OnDeleteTableRequested)">Delete table</button>
        </div>
        <div class="editor-context-menu-group">
            <div class="editor-context-menu-label">Image</div>
            <button type="button" disabled="@(!_formattingState.CanInsertImage)" @onclick="() => OnContextMenuCommand(OnInsertImageFromUrlRequested)">Insert from URL</button>
            <button type="button" disabled="@(!_formattingState.CanRemoveImage)" @onclick="() => OnContextMenuCommand(OnRemoveImageRequested)">Remove image</button>
        </div>
        <div class="editor-context-menu-group">
            <div class="editor-context-menu-label">Other</div>
            <button type="button" disabled="@(!_formattingState.CanBlockquote)" @onclick="() => OnContextMenuCommand(OnBlockquoteRequested)">Blockquote</button>
            <button type="button" class="@GetActiveClass(_formattingState.IsLink)" @onclick="() => OnContextMenuCommand(OnLinkRequested)">Link</button>
        </div>
        @if (_currentSelectionRange is not null && CanShowAiMenu && SelectionAiActions.Any())
        {
            <div class="editor-context-menu-group">
                <div class="editor-context-menu-label">AI</div>
                @foreach (AiActionOption action in SelectionAiActions)
                {
                    <button type="button" disabled="@IsAiQuotaExceeded" @onclick="() => OnContextMenuCommand(() => OnAiActionSelected(action))">@action.Label</button>
                }
            </div>
        }
    </div>
}

@if (_isLinkContextMenuOpen)
{
    <div class="editor-context-menu-backdrop" @onclick="CloseLinkContextMenu"></div>
    <div class="editor-context-menu"
         style="@GetLinkContextMenuStyle()"
         tabindex="-1"
         role="menu"
         @onclick:stopPropagation="true"
         @onkeydown="OnLinkContextMenuKeyDown">
        <div class="editor-context-menu-group">
            <div class="editor-context-menu-label">Link</div>
            <button type="button" @onclick="OpenLinkFromContextMenu">Open link</button>
            <button type="button" @onclick="EditLinkFromContextMenu">Edit link</button>
            <button type="button" @onclick="RemoveLinkFromContextMenu">Remove link</button>
        </div>
    </div>
}

@if (_isFeedbackDialogOpen)
{
    <div class="modal-overlay modal-overlay-dimmed" @onclick="CloseFeedbackDialog">
    <div class="modal-backdrop"></div>
    <div class="modal feedback-dialog modal-panel"
         role="dialog"
         aria-modal="true"
         aria-labelledby="feedbackDialogTitle"
         @onkeydown="OnFeedbackDialogKeyDown"
         @onclick:stopPropagation="true">
        <span class="focus-sentinel" tabindex="0" @onfocus="FocusFeedbackLastAsync"></span>
        <header>
            <h2 id="feedbackDialogTitle">User feedback</h2>
            <button type="button" @onclick="CloseFeedbackDialog">Close</button>
        </header>
        <div class="modal-body feedback-form">
            <label class="export-panel-label" for="feedback-type">Type</label>
            <select id="feedback-type"
                    class="export-panel-select"
                    @bind="_feedbackType"
                    @ref="_feedbackTypeSelectRef">
                <option value="bug">Bug</option>
                <option value="enhancement">Enhancement</option>
            </select>

            <label class="export-panel-label" for="feedback-subject">Title</label>
            <input id="feedback-subject" class="export-panel-input" maxlength="120" @bind="_feedbackSubject" />

            <label class="export-panel-label" for="feedback-description">Description</label>
            <textarea id="feedback-description"
                      class="notes-input scene-card-input"
                      rows="6"
                      maxlength="4000"
                      @bind="_feedbackDescription"></textarea>

            <label class="export-panel-checkbox">
                <input type="checkbox" @bind="_feedbackIncludeDiagnostics" />
                <span>Include page URL, app version, and browser details</span>
            </label>

            @if (!string.IsNullOrWhiteSpace(_feedbackErrorMessage))
            {
                <div class="modal-error">@_feedbackErrorMessage</div>
            }
        </div>
        <footer>
            <button type="button" class="btn btn-ghost" @onclick="CloseFeedbackDialog">Cancel</button>
            <button type="button"
                    class="btn btn-primary"
                    disabled="@_feedbackSubmitting"
                    @ref="_feedbackSubmitButtonRef"
                    @onclick="SubmitFeedbackAsync">
                @(_feedbackSubmitting ? "Sending..." : "OK")
            </button>
        </footer>
        <span class="focus-sentinel" tabindex="0" @onfocus="FocusFeedbackFirstAsync"></span>
    </div>
    </div>
}

@if (_isAiQuotaDialogOpen)
{
    <div class="modal-overlay modal-overlay-dimmed" role="presentation" @onclick="CloseAiQuotaDialog">
