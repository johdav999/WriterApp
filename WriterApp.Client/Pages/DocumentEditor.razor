                                        {
                                            <ul class="ai-history-list">
                                                @foreach (ContinuityIssue issue in FilteredContinuityIssues)
                                                {
                                                    <li class="ai-history-item">
                                                        <div class="ai-history-meta">
                                                            <span class="ai-history-badge">@issue.Severity.ToUpperInvariant()</span>
                                                            <span class="ai-history-summary">@issue.Type: @issue.Message</span>
                                                        </div>
                                                        <div class="ai-history-sub">
                                                            <span>@issue.Evidence.Quote</span>
                                                        </div>
                                                        <div class="ai-history-actions">
                                                            <button type="button" @onclick="() => OnJumpToContinuityIssueAsync(issue)">Jump</button>
                                                            @if (CanShowContinuityCoachFixes)
                                                            {
                                                                <PlanGatedButton Feature="@nameof(FeatureKey.ContinuityCheck)"
                                                                                 IsBusy="_continuityBusy"
                                                                                 IsActionDisabled="@string.IsNullOrWhiteSpace(issue.SuggestedFix)"
                                                                                 ShowLockIndicator="false"
                                                                                 OnClick="() => OpenContinuityProposalAsync(issue)">
                                                                    Apply suggested fix
                                                                </PlanGatedButton>
                                                            }
                                                        </div>
                                                    </li>
                                                }
                                            </ul>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        else if (_activeContextTab == ContextTab.PromptLibrary)
                        {
                            <div class="drawer-panel ai-panel">
                                @if (!CanShowPromptLibrary)
                                {
                                    <div class="drawer-empty">
                                        <div>@GetFeatureTooltip(FeatureKey.PromptLibrary)</div>
                                        <PlanGatedButton Feature="@nameof(FeatureKey.PromptLibrary)"
                                                         Class="link-button">
                                            Upgrade
                                        </PlanGatedButton>
                                    </div>
                                }
                                else
                                {
                                    <div class="ai-history-toolbar">
                                        <label for="prompt-run-scope">Run scope</label>
                                        <select id="prompt-run-scope" @bind="_promptRunScope">
                                            <option value="selection">Selection</option>
                                            <option value="section">Section</option>
                                        </select>
                                    </div>
                                    <div class="ai-actions-list">
                                        <button type="button" @onclick="BeginCreatePromptPreset">New preset</button>
                                        <button type="button" @onclick="SavePromptPresetAsync">Save preset</button>
                                    </div>
                                    <div class="template-grid">
                                        <label class="export-panel-label" for="prompt-name">Name</label>
                                        <input id="prompt-name" class="export-panel-input" @bind="_promptNameDraft" />
                                        <label class="export-panel-label" for="prompt-category">Category</label>
                                        <input id="prompt-category" class="export-panel-input" @bind="_promptCategoryDraft" />
                                        <label class="export-panel-label" for="prompt-kind">Kind</label>
                                        <select id="prompt-kind" class="export-panel-select" @bind="_promptKindDraft">
                                            <option value="builtin">Builtin action</option>
                                            <option value="custom">Custom template</option>
                                        </select>
                                        @if (_promptKindDraft == "builtin")
                                        {
                                            <label class="export-panel-label" for="prompt-action-id">Action Id</label>
                                            <input id="prompt-action-id" class="export-panel-input" @bind="_promptBuiltinActionIdDraft" />
                                        }
                                        else
                                        {
                                            <label class="export-panel-label" for="prompt-template">Template</label>
                                            <textarea id="prompt-template" class="notes-input scene-card-input" @bind="_promptTemplateDraft"></textarea>
                                            <div class="drawer-empty">Tokens: <code>{token}</code>, <code>{{token}}</code>, <code>${token}</code>. Names must use letters, digits, or underscore.</div>
                                        }
                                        <label class="export-panel-label" for="prompt-params">Parameters (JSON)</label>
                                        <textarea id="prompt-params" class="notes-input scene-card-input" @bind="_promptParametersDraft"></textarea>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(_promptStatus))
                                    {
                                        <div class="drawer-empty">@_promptStatus</div>
                                    }
                                    @if (_promptPresets.Count == 0)
                                    {
                                        <div class="drawer-empty">No presets yet.</div>
                                    }
                                    else
                                    {
                                        <ul class="ai-history-list">
                                            @foreach (PromptPresetDto preset in _promptPresets)
                                            {
                                                <li class="ai-history-item">
                                                    <div class="ai-history-meta">
                                                        <span class="ai-history-badge">P</span>
                                                        <span class="ai-history-summary">@preset.Name</span>
                                                    </div>
                                                    <div class="ai-history-sub">
                                                        <span>@(preset.Category ?? preset.Kind)</span>
                                                    </div>
                                                    <div class="ai-history-actions">
                                                        <button type="button" @onclick="() => RunPromptPresetAsync(preset)">Run</button>
                                                        <button type="button" @onclick="() => BeginEditPromptPreset(preset)">Edit</button>
                                                        <button type="button" @onclick="() => TogglePinPromptPreset(preset.Id)">
                                                            @(IsPromptPresetPinned(preset.Id) ? "Unpin" : "Pin")
                                                        </button>
                                                        <button type="button" class="danger" @onclick="() => DeletePromptPresetAsync(preset.Id)">Delete</button>
                                                    </div>
                                                </li>
                                            }
                                        </ul>
                                    }
                                }
                            </div>
                        }
                        else if (_activeContextTab == ContextTab.Annotations)
                        {
                            <div class="drawer-panel annotations-panel">
                                @if (_annotationsLoading)
                                {
                                    <div class="drawer-empty">Loading annotations...</div>
                                }
                                else if (!string.IsNullOrWhiteSpace(_annotationsError))
                                {
                                    <div class="drawer-empty">@_annotationsError</div>
                                }
                                else if (_annotations.Count == 0)
                                {
                                    <div class="drawer-empty">No annotations yet.</div>
                                }
                                else
                                {
                                    <ul class="annotations-list">
                                        @foreach (PageAnnotationDto annotation in _annotations)
                                        {
                                            <li class="annotation-item @GetAnnotationItemClass(annotation) @GetAnnotationFocusClass(annotation)"
                                                id="@GetAnnotationElementId(annotation)"
                                                @onclick="() => OnAnnotationCardClickedAsync(annotation)">
                                                <div class="annotation-meta">
                                                    <span class="annotation-kind">@GetAnnotationKindLabel(annotation.Kind)</span>
                                                    <span class="annotation-time">@annotation.CreatedAt.ToLocalTime().ToString("g")</span>
                                                    @if (string.Equals(annotation.Status, "resolved", StringComparison.OrdinalIgnoreCase))
                                                    {
                                                        <span class="annotation-status">Resolved</span>
                                                    }
                                                </div>
                                                @if (!string.IsNullOrWhiteSpace(annotation.Content))
                                                {
                                                    <div class="annotation-content">@annotation.Content</div>
                                                }
                                                <div class="annotation-actions">
                                                    @if (string.Equals(annotation.Status, "resolved", StringComparison.OrdinalIgnoreCase))
                                                    {
                                                        <button type="button"
                                                                @onclick="() => ReopenAnnotationAsync(annotation)"
                                                                @onclick:stopPropagation="true">Reopen</button>
                                                    }
                                                    else
                                                    {
                                                        <button type="button"
                                                                class="danger"
                                                                @onclick="() => ResolveAnnotationAsync(annotation)"
                                                                @onclick:stopPropagation="true">Resolve</button>
                                                    }
                                                </div>
                                            </li>
                                        }
                                    </ul>
                                }
                            </div>
                        }
                        else if (_activeContextTab == ContextTab.Quality)
                        {
                            <div class="drawer-panel quality-panel">
                                @if (!CanShowQualityChecks)
                                {
                                    <div class="drawer-empty">
                                        <div>@GetFeatureTooltip(FeatureKey.QualityChecks)</div>
                                        <PlanGatedButton Feature="@nameof(FeatureKey.QualityChecks)"
                                                         Class="link-button">
                                            Upgrade
                                        </PlanGatedButton>
                                    </div>
                                }
                                else if (_qualityLoading)
                                {
                                    <div class="drawer-empty">Checking quality...</div>
                                }
                                else if (!string.IsNullOrWhiteSpace(_qualityError))
                                {
                                    <div class="drawer-empty">@_qualityError</div>
                                }
                                else if (!_qualityHasRunOnce && _qualityIssues.Count == 0)
                                {
                                    <div class="drawer-empty quality-precheck-hint">Run quality check to find repetition, clarity issues, and pacing friction.</div>
                                }
                                else if (_qualityIssues.Count == 0)
                                {
                                    <div class="drawer-empty">No quality issues found.</div>
                                }
                                else
                                {
                                    <ul class="quality-list">
                                        @foreach (PageQualityIssueDto issue in FilterQualityIssues())
                                        {
                                            <li class="quality-item @GetQualityIssueClass(issue) @(IsQualityIssueSelected(issue) ? "quality-item--selected" : string.Empty)"
                                                @onclick="() => ShowQualityIssueInTextAsync(issue)">
                                                <div class="quality-meta">
                                                    <span class="quality-kind">@issue.Kind</span>
                                                    <span class="quality-severity">@issue.Severity</span>
                                                </div>
                                                <div class="quality-message">@issue.Message</div>
                                                @if (!string.IsNullOrWhiteSpace(issue.Suggestion))
                                                {
                                                    <div class="quality-suggestion">@issue.Suggestion</div>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(issue.AnchorText))
                                                {
                                                    <div class="quality-anchor">"@issue.AnchorText"</div>
                                                }
                                                <div class="quality-actions">
                                                    <button type="button"
                                                            @onclick="() => ShowQualityIssueInTextAsync(issue)"
                                                            @onclick:stopPropagation="true">
                                                        Scroll to
                                                    </button>
                                                    <button type="button"
                                                            class="primary"
                                                            disabled="@(!CanApplyQualityIssue(issue))"
                                                            title="@GetQualityIssueApplyButtonTitle(issue)"
                                                            @onclick="() => OpenQualityProposalAsync(issue)"
                                                            @onclick:stopPropagation="true">
                                                        Apply changes
                                                    </button>
                                                    <button type="button"
                                                            class="danger"
                                                            @onclick="() => DismissQualityIssueAsync(issue)"
                                                            @onclick:stopPropagation="true">
                                                        Dismiss
                                                    </button>
                                                </div>
                                                @if (IsQualityIssueApplied(issue))
                                                {
                                                    <div class="quality-applied">Applied.</div>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(GetQualityIssueActionError(issue)))
                                                {
                                                    <div class="quality-error">@GetQualityIssueActionError(issue)</div>
                                                }
                                            </li>
                                        }
                                    </ul>
                                }
                            </div>
                        }
                        else if (_activeContextTab == ContextTab.History)
                        {
                            <div class="drawer-panel version-history-panel">
                                @if (!CanShowVersionHistory)
                                {
                                    <div class="drawer-empty">
                                        <div>@GetFeatureTooltip(FeatureKey.VersionHistory)</div>
                                        <PlanGatedButton Feature="@nameof(FeatureKey.VersionHistory)"
                                                         Class="link-button">
                                            Upgrade
                                        </PlanGatedButton>
                                    </div>
                                }
                                else
                                {
                                <div class="history-filter-bar" role="tablist" aria-label="History filter">
                                    <button type="button"
                                            class="history-filter-button @GetHistoryFilterClass(HistoryFilter.All)"
                                            role="tab"
                                            aria-selected="@(_historyFilter == HistoryFilter.All)"
                                            @onclick="() => SetHistoryFilter(HistoryFilter.All)">
                                        All
                                    </button>
                                    <button type="button"
                                            class="history-filter-button @GetHistoryFilterClass(HistoryFilter.Snapshots)"
                                            role="tab"
                                            aria-selected="@(_historyFilter == HistoryFilter.Snapshots)"
                                            @onclick="() => SetHistoryFilter(HistoryFilter.Snapshots)">
                                        Snapshots
                                    </button>
                                    <button type="button"
                                            class="history-filter-button @GetHistoryFilterClass(HistoryFilter.Commands)"
                                            role="tab"
                                            aria-selected="@(_historyFilter == HistoryFilter.Commands)"
                                            @onclick="() => SetHistoryFilter(HistoryFilter.Commands)">
                                        AI Commands
                                    </button>
                                </div>
                                <div class="ai-history-toolbar">
                                    <button type="button"
                                            class="ai-history-button"
