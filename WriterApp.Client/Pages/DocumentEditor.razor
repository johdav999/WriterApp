                                                    <div class="history-command-summary">@entry.Label</div>
                                                    <div class="version-history-sub">
                                                        <span>Scope: @GetCommandScopeLabel(entry.ActionKey)</span>
                                                        <span class="history-command-status @GetCommandStatusClass(entry)">@GetCommandStatusLabel(entry)</span>
                                                    </div>
                                                    <div class="version-history-actions">
                                                        <button type="button"
                                                                class="ai-details-toggle"
                                                                aria-expanded="@showDetails"
                                                                aria-controls="@GetAiHistoryDetailsId(entry)"
                                                                @onclick="() => OnToggleAiHistoryDetails(entry)">
                                                            @(showDetails ? "Hide details" : "Details")
