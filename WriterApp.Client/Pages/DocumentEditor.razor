                        <label class="export-panel-label">Footer</label>
                        <div class="template-section">
                            <label><input type="checkbox" @bind="_templateEditor.FooterEnabled" /> Enabled</label>
                            <div class="template-inline-inputs">
                                <input class="export-panel-input" @bind="_templateEditor.FooterLeft" placeholder="Left" title="Tokens: {DocumentTitle}, {SectionTitle}, {Date}, {PageNumber}, {TotalPages}" />
                                <input class="export-panel-input" @bind="_templateEditor.FooterCenter" placeholder="Center" title="Tokens: {DocumentTitle}, {SectionTitle}, {Date}, {PageNumber}, {TotalPages}" />
                                <input class="export-panel-input" @bind="_templateEditor.FooterRight" placeholder="Right" title="Tokens: {DocumentTitle}, {SectionTitle}, {Date}, {PageNumber}, {TotalPages}" />
                            </div>
