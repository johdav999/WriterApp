                           class="export-panel-input"
                           placeholder="Select language"
                           @bind="_translateSourceLanguageQuery" />
                    <select id="translate-source-language" @bind="_translateSourceLanguage">
                        <option value="auto">Auto-detect</option>
                        @foreach (TranslationLanguageOption language in GetPopularTranslationLanguages(_translateSourceLanguageQuery, _translateSourceLanguage, includeAuto: true))
                        {
                            <option value="@language.Code">@GetTranslationLanguageOptionLabel(language)</option>
                        }
                        @foreach (TranslationLanguageOption language in GetAdditionalTranslationLanguages(_translateSourceLanguageQuery, _translateSourceLanguage, includeAuto: true))
                        {
                            <option value="@language.Code">@GetTranslationLanguageOptionLabel(language)</option>
                        }
                    </select>

                    <label for="translate-target-language">Target language</label>
                    <input id="translate-target-language-search"
                           class="export-panel-input"
                           placeholder="Select language"
                           @bind="_translateTargetLanguageQuery" />
                    <select id="translate-target-language" @bind="_translateTargetLanguage">
                        @if (ShouldShowTranslationLanguagePlaceholder(_translateTargetLanguage))
                        {
                            <option value="">Select language</option>
                        }
                        @foreach (TranslationLanguageOption language in GetPopularTranslationLanguages(_translateTargetLanguageQuery, _translateTargetLanguage))
                        {
                            <option value="@language.Code">@GetTranslationLanguageOptionLabel(language)</option>
                        }
                        @foreach (TranslationLanguageOption language in GetAdditionalTranslationLanguages(_translateTargetLanguageQuery, _translateTargetLanguage))
                        {
                            <option value="@language.Code">@GetTranslationLanguageOptionLabel(language)</option>
                        }
                    </select>

                    <label for="translate-style">Style</label>
                    <select id="translate-style" @bind="_translateStyle">
                        <option value="literal">Literal</option>
