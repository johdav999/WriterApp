                <button type="button"
                        class="danger"
                        @onclick="ConfirmDeleteSectionAsync"
                        disabled="@_isDeletingSection">
                    Delete
                </button>
                <button type="button"
                        @onclick="CancelDeleteSection"
                        disabled="@_isDeletingSection">
                    Cancel
                </button>
            </div>
        </div>
    </div>
}

@if (_isTranslateModalOpen)
{
    <div class="modal-overlay" @onclick="CloseTranslateModal">
