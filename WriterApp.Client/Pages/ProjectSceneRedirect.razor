@page "/projects/{ProjectId:guid}/scenes/{SceneNodeId:guid}/edit"
@using System.Net
@using System.Net.Http.Json
@using WriterApp.Application.Documents
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>Open Scene</PageTitle>

@if (_loading)
{
    <div class="landing-loading">Opening scene...</div>
}
else if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="landing-empty">
        @_error
        <div>
            <button type="button" class="secondary" @onclick="BackToProject">Back to project</button>
        </div>
    </div>
}

@code {
    [Parameter] public Guid ProjectId { get; set; }

    [Parameter] public Guid SceneNodeId { get; set; }

    private bool _loading = true;
    private string? _error;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            using HttpResponseMessage response = await Http.PostAsync(
                $"api/projects/{ProjectId}/nodes/{SceneNodeId}/open-scene",
                null);

            if (response.StatusCode == HttpStatusCode.NotFound)
            {
                _error = "Scene not found.";
                return;
            }

            if (response.StatusCode == HttpStatusCode.BadRequest)
            {
                _error = "Only scene nodes can be opened as scene text.";
                return;
            }

            if (!response.IsSuccessStatusCode)
            {
                _error = $"Open scene failed: {(int)response.StatusCode}.";
                return;
            }

            ProjectSceneOpenTargetDto? target = await response.Content.ReadFromJsonAsync<ProjectSceneOpenTargetDto>();
            if (target is null)
            {
                _error = "Open scene failed.";
                return;
            }

            await SaveResumeTargetAsync(ProjectId, SceneNodeId);
            Navigation.NavigateTo($"documents/{target.DocumentId}/sections/{target.SectionId}", replace: true);
        }
        catch (Exception ex)
        {
            _error = $"Open scene failed: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private void BackToProject()
    {
        Navigation.NavigateTo($"projects/{ProjectId}");
    }

    private async Task SaveResumeTargetAsync(Guid projectId, Guid sceneNodeId)
    {
        try
        {
            string key = $"writerapp.project.resume.{projectId:D}";
            string value = $"projects/{projectId}/scenes/{sceneNodeId}/edit";
            await JS.InvokeVoidAsync("localStorage.setItem", key, value);
        }
        catch
        {
            // ignore localStorage failures
        }
    }
}
