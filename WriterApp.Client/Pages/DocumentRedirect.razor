@page "/documents/{DocumentId:guid}"
@using System.Net.Http.Json
@using WriterApp.Application.Documents
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Opening document...</PageTitle>

@if (_loading)
{
    <div class="landing-loading">Loading document...</div>
}
else if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="landing-error">@_error</div>
    <button type="button" class="secondary" @onclick="GoToDocuments">Back to Documents</button>
}

@code {
    [Parameter]
    public Guid DocumentId { get; set; }

    private sealed record SharedWorkspace(SectionDto[] Sections);
    private bool _loading = true;
    private string? _error;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            using (var modeResponse = await Http.GetAsync($"api/documents/{DocumentId}/collaboration/capabilities"))
                {
                    if(modeResponse.IsSuccessStatusCode)
                    {
                        var capabilities=await modeResponse.Content.ReadFromJsonAsync<WriterApp.Shared.Collaboration.CollaborationCapabilities>();
                        if(capabilities?.Mode is WriterApp.Shared.Collaboration.CollaborationMode.Collaborative or WriterApp.Shared.Collaboration.CollaborationMode.Migrating)
                        {
                            if(capabilities.Mode==WriterApp.Shared.Collaboration.CollaborationMode.Migrating){Navigation.NavigateTo($"documents/{DocumentId}/sharing",replace:true);return;}
                            using var response=await Http.GetAsync($"api/documents/{DocumentId}/collaboration/workspace");response.EnsureSuccessStatusCode();
                            var workspace=await response.Content.ReadFromJsonAsync<SharedWorkspace>();
                            var firstShared=workspace?.Sections.FirstOrDefault();
                            if(firstShared is null){_error="No sections available.";return;}
                            Navigation.NavigateTo($"documents/{DocumentId}/sections/{firstShared.Id}",replace:true);return;
                        }
                    }
                }
                DocumentDetailDto? document =
                await Http.GetFromJsonAsync<DocumentDetailDto>($"api/documents/{DocumentId}");
            if (document is null)
            {
                _error = "Document not found.";
                return;
            }

            if (document.DeletedAt is not null)
            {
                _error = "Document is in Trash; restore to edit.";
                return;
            }

            List<SectionDto>? sections =
                await Http.GetFromJsonAsync<List<SectionDto>>($"api/documents/{DocumentId}/sections");
            SectionDto? first = sections?
                .OrderBy(section => section.OrderIndex)
                .FirstOrDefault();

            if (first is null)
            {
                _error = "No sections found for this document.";
                return;
            }

            Navigation.NavigateTo($"documents/{DocumentId}/sections/{first.Id}", replace: true);
        }
        catch (Exception ex)
        {
            _error = $"Open failed: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private void GoToDocuments()
    {
        Navigation.NavigateTo("documents");
    }
}
