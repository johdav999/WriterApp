@page "/logout"
@page "/app/logout"
@using Microsoft.AspNetCore.Components.WebAssembly.Hosting
@using WriterApp.Client.Utilities
@inject NavigationManager Navigation
@inject IWebAssemblyHostEnvironment HostEnvironment
@inject IOptions<WriterAuthOptions> AuthOptions
@inject WriterApp.Client.Services.ClientLogoutService ClientLogoutService

<PageTitle>Sign out</PageTitle>

<p>@_statusMessage</p>

@code {
    private string _statusMessage = "Signing out...";

    protected override async Task OnInitializedAsync()
    {
        await ClientLogoutService.ClearClientStateAsync();

        Uri currentUri = Navigation.ToAbsoluteUri(Navigation.Uri);
        Dictionary<string, string> query = QueryStringParser.Parse(currentUri.Query);
        string returnUrl = SafeReturnUrl.ResolveFromQuery(
            query,
            fallback: SafeReturnUrl.DefaultHomePath);

        if (HostEnvironment.IsDevelopment() || currentUri.IsLoopback)
        {
            _statusMessage = "Signed out (dev). Redirecting...";
            Navigation.NavigateTo(returnUrl, forceLoad: true);
            return;
        }

        string logoutUrl = EasyAuthUrlBuilder.BuildLogoutUrl(Navigation.BaseUri, returnUrl, AuthOptions.Value, SafeReturnUrl.DefaultHomePath);
        Navigation.NavigateTo(logoutUrl, forceLoad: true);
    }
}
