@page "/synopsis"
@page "/synopsis/{DocumentId:guid}"
@using System.Globalization
@using System.Net
@using System.Text.Json
@using System.Net.Http.Json
@using WriterApp.Application.Synopsis
@using WriterApp.Application.Subscriptions
@using WriterApp.Client.Services
@using WriterApp.Client.State
@inject HttpClient Http
@inject NavigationManager Navigation
@inject AuthMeStateService AuthMeStateService
@inject WriterApp.Client.State.CurrentDocumentStateService CurrentDocumentStateService
@inject ILogger<Synopsis> Logger
@inject FeatureAccessService FeatureAccessService

<PageTitle>Synopsis</PageTitle>

<div class="synopsis-shell">
    <header class="synopsis-header">
        <div>
            <h1>Synopsis</h1>
            <p class="synopsis-subtitle">Capture the story intent without touching manuscript text.</p>
        </div>
        <button type="button" class="secondary" @onclick="NavigateToDocuments">Documents</button>
    </header>

    @if (DocumentId is null)
    {
        <div class="synopsis-empty">
            <div>No document selected. Choose a document to view or edit its synopsis.</div>
            <button type="button" class="primary" @onclick="NavigateToDocuments">Go to Documents</button>
        </div>
    }
    else if (_loading)
    {
        <div class="synopsis-loading">Loading synopsis...</div>
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="synopsis-error">@_error</div>
    }
    else
    {
        <div class="synopsis-layout">
            <section class="synopsis-form">
                @foreach (SynopsisFieldDefinition field in Fields)
                {
                    <div class="synopsis-field">
                        <label class="synopsis-label">@field.Label</label>
                        <div class="synopsis-helper">@field.Helper</div>
                        <textarea class="synopsis-input"
                                  value="@GetFieldValue(field.Key)"
                                  @oninput="args => OnFieldInput(field.Key, args)"
                                  placeholder="@field.Placeholder"></textarea>
                    </div>
                }
                <div class="synopsis-status">
                    @if (_saving)
                    {
                        <span>Saving...</span>
                    }
                    else if (!string.IsNullOrWhiteSpace(_statusMessage))
                    {
                        <span>@_statusMessage</span>
                    }
                </div>
            </section>

            <aside class="synopsis-ai">
                <div class="ai-card">
                    <h2>AI Coaching</h2>
                    <p class="ai-helper">Feedback only. AI never edits your manuscript.</p>

                    <div class="ai-actions">
                        <button type="button" class="primary" disabled="@_aiInFlight" @onclick="RunEvaluateAsync">Evaluate synopsis</button>
                        <button type="button"
                                class="secondary"
                                disabled="@(_aiInFlight || !FeatureAccessService.CanUse(FeatureKey.AiGuidingQuestions))"
                                title='@(!FeatureAccessService.CanUse(FeatureKey.AiGuidingQuestions) ? FeatureAccessService.GetUpgradeMessage(FeatureKey.AiGuidingQuestions) : string.Empty)'
                                @onclick="RunQuestionsAsync">Ask guiding questions</button>
                        @if (!FeatureAccessService.CanUse(FeatureKey.AiGuidingQuestions))
                        {
                            <a class="link-button" href="@FeatureAccessService.GetUpgradePath()">Upgrade</a>
                        }
                    </div>

                    <div class="ai-suggest">
                        <label class="synopsis-label">Suggest alternatives for</label>
                        <select class="ai-select" value="@_aiSelectedFieldKey" @onchange="OnAiFieldChanged">
                            @foreach (SynopsisFieldDefinition field in Fields)
                            {
                                <option value="@field.Key">@field.Label</option>
                            }
                        </select>
                        <label class="synopsis-label">Notes for the coach (optional)</label>
                        <textarea class="ai-notes"
                                  value="@_aiUserNotes"
                                  @oninput="OnAiNotesInput"
                                  placeholder="Add constraints or intent for this suggestion..."></textarea>
                        <button type="button"
                                class="primary"
                                disabled="@(_aiInFlight || !FeatureAccessService.CanUse(FeatureKey.AiSynopsisSuggestions))"
                                title='@(!FeatureAccessService.CanUse(FeatureKey.AiSynopsisSuggestions) ? FeatureAccessService.GetUpgradeMessage(FeatureKey.AiSynopsisSuggestions) : string.Empty)'
                                @onclick="RunSuggestAsync">Suggest alternative</button>
                        @if (!FeatureAccessService.CanUse(FeatureKey.AiSynopsisSuggestions))
                        {
                            <a class="link-button" href="@FeatureAccessService.GetUpgradePath()">Upgrade</a>
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_aiError))
                    {
                        <div class="ai-error">@_aiError</div>
                    }

                    @if (_aiQuotaExceeded)
                    {
                        <div class="ai-error">
                            <div><strong>AI quota reached</strong></div>
                            <div>Plan: @_aiQuotaPlanName</div>
                            <div>Used @_aiQuotaUsed of @_aiQuotaBudget tokens.</div>
                            <button type="button" class="secondary" @onclick="NavigateToUpgrade">Upgrade</button>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(_aiOutput))
                    {
                        <div class="ai-output">
                            <div class="ai-output-header">@GetAiOutputTitle()</div>
                            <div class="ai-output-body">@_aiOutput</div>
                            @if (CanApplySuggestion)
                            {
                                <button type="button" class="primary" @onclick="ApplyAiSuggestionAsync">Apply to field</button>
                            }
                        </div>
                    }
                </div>
            </aside>
        </div>
    }
</div>

@code {
    [Parameter]
    public Guid? DocumentId { get; set; }

    private Guid? _loadedDocumentId;
    private bool _loading;
    private bool _saving;
    private bool _saveQueued;
    private string? _error;
    private string? _statusMessage;
    private DocumentSynopsisDto? _synopsis;
    private CancellationTokenSource? _autosaveCts;

    private bool _aiInFlight;
    private string? _aiError;
    private string? _aiOutput;
    private string? _aiMode;
    private string? _aiProposedText;
    private string _aiSelectedFieldKey = Fields[0].Key;
    private string _aiUserNotes = string.Empty;
    private bool _aiQuotaExceeded;
    private string _aiQuotaPlanName = "Free";
    private int _aiQuotaBudget;
    private int _aiQuotaUsed;

    private static readonly IReadOnlyList<SynopsisFieldDefinition> Fields = new[]
    {
        new SynopsisFieldDefinition("logline", "Logline", "One or two sentences that sell the premise.", "A short hook for the story."),
        new SynopsisFieldDefinition("premise", "Premise", "What the story is fundamentally about.", "The core idea in a few sentences."),
        new SynopsisFieldDefinition("theme", "Theme", "The thematic exploration (optional).", "What the story is really saying."),
        new SynopsisFieldDefinition("protagonist_arc", "Protagonist Arc", "How the protagonist changes over time.", "How they begin, what they learn, who they become."),
        new SynopsisFieldDefinition("central_conflict", "Central Conflict", "What stands in the protagonist's way.", "The main obstacle or force of opposition."),
        new SynopsisFieldDefinition("stakes", "Stakes", "What is lost if the protagonist fails.", "Personal, relational, or world stakes."),
        new SynopsisFieldDefinition("setting", "Setting", "Time/place/world details (optional).", "Where and when the story unfolds."),
        new SynopsisFieldDefinition("ending_intent", "Ending Intent", "What kind of ending is intended.", "Bittersweet? Triumphant? Ambiguous?"),
        new SynopsisFieldDefinition("open_questions", "Open Questions", "Unresolved story questions to keep in mind.", "Loose threads or mysteries to resolve."),
        new SynopsisFieldDefinition("notes", "Notes", "Freeform notes and reminders.", "Any extra ideas or constraints.")
    };

    private static readonly TimeSpan AutosaveDebounce = TimeSpan.FromSeconds(1);

    protected override async Task OnParametersSetAsync()
    {
        if (DocumentId is null)
        {
            CurrentDocumentStateService.Clear();
            _loadedDocumentId = null;
            _synopsis = null;
            _error = null;
            _statusMessage = null;
            _loading = false;
            return;
        }

        CurrentDocumentStateService.SetDocument(DocumentId.Value);

        if (_loadedDocumentId != DocumentId)
        {
            await LoadSynopsisAsync(DocumentId.Value);
        }
    }

    private async Task LoadSynopsisAsync(Guid documentId)
    {
        _loading = true;
        _error = null;
        _statusMessage = null;

        try
        {
            DocumentSynopsisDto? result =
                await Http.GetFromJsonAsync<DocumentSynopsisDto>($"api/documents/{documentId}/synopsis");
            _synopsis = result ?? CreateEmptySynopsis(documentId);
            _loadedDocumentId = documentId;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Synopsis load failed.");
            _error = "Failed to load the synopsis.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveSynopsisAsync()
    {
        if (DocumentId is null || _synopsis is null || _saving)
        {
            _saveQueued = _saveQueued || _saving;
            return;
        }

        _saving = true;
        _statusMessage = null;

        try
        {
            using HttpResponseMessage response =
                await Http.PutAsJsonAsync($"api/documents/{DocumentId}/synopsis", _synopsis);
            response.EnsureSuccessStatusCode();
            DocumentSynopsisDto? updated = await response.Content.ReadFromJsonAsync<DocumentSynopsisDto>();
            if (updated is not null)
            {
                _synopsis = updated;
            }
            _statusMessage = "Saved.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Synopsis save failed.");
            _statusMessage = "Failed to save.";
        }
        finally
        {
            _saving = false;
            if (_saveQueued)
            {
                _saveQueued = false;
                await SaveSynopsisAsync();
            }
        }
    }

    private async Task ScheduleAutosaveAsync()
    {
        _autosaveCts?.Cancel();
        _autosaveCts = new CancellationTokenSource();
        CancellationToken token = _autosaveCts.Token;

        try
        {
            await Task.Delay(AutosaveDebounce, token);
            await SaveSynopsisAsync();
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void OnFieldInput(string key, ChangeEventArgs args)
    {
        if (_synopsis is null || DocumentId is null)
        {
            return;
        }

        string value = args.Value?.ToString() ?? string.Empty;
        _synopsis = SetFieldValue(_synopsis, key, value);
        _statusMessage = null;
        _ = ScheduleAutosaveAsync();
    }

    private string GetFieldValue(string key)
    {
        if (_synopsis is null)
        {
            return string.Empty;
        }

        return key switch
        {
            "logline" => _synopsis.Logline,
            "premise" => _synopsis.Premise,
            "theme" => _synopsis.Theme,
            "protagonist_arc" => _synopsis.ProtagonistArc,
            "central_conflict" => _synopsis.CentralConflict,
            "stakes" => _synopsis.Stakes,
            "setting" => _synopsis.Setting,
            "ending_intent" => _synopsis.EndingIntent,
            "open_questions" => _synopsis.OpenQuestions,
            "notes" => _synopsis.Notes,
            _ => string.Empty
        };
    }

    private DocumentSynopsisDto SetFieldValue(DocumentSynopsisDto synopsis, string key, string value)
    {
        return key switch
        {
            "logline" => synopsis with { Logline = value },
            "premise" => synopsis with { Premise = value },
            "theme" => synopsis with { Theme = value },
            "protagonist_arc" => synopsis with { ProtagonistArc = value },
            "central_conflict" => synopsis with { CentralConflict = value },
            "stakes" => synopsis with { Stakes = value },
            "setting" => synopsis with { Setting = value },
            "ending_intent" => synopsis with { EndingIntent = value },
            "open_questions" => synopsis with { OpenQuestions = value },
            "notes" => synopsis with { Notes = value },
            _ => synopsis
        };
    }

    private async Task RunEvaluateAsync()
    {
        await RunAiAsync("evaluate");
    }

    private async Task RunQuestionsAsync()
    {
        await RunAiAsync("questions");
    }

    private async Task RunSuggestAsync()
    {
        await RunAiAsync("suggest");
    }

    private async Task RunAiAsync(string mode)
    {
        if (DocumentId is null || _aiInFlight)
        {
            return;
        }

        _aiInFlight = true;
        _aiError = null;
        _aiOutput = null;
        _aiMode = null;
        _aiProposedText = null;
        _aiQuotaExceeded = false;

        try
        {
            SynopsisAiRequestDto payload = new(
                mode == "suggest" ? _aiSelectedFieldKey : null,
                _aiUserNotes);

            using HttpResponseMessage response = await Http.PostAsJsonAsync(
                $"api/documents/{DocumentId}/synopsis/ai/{mode}",
                payload);

            if (!response.IsSuccessStatusCode)
            {
                if (await TryHandleAiQuotaExceededAsync(response))
                {
                    _aiError = "AI quota exceeded. Upgrade to continue.";
                    return;
                }

                _aiError = "AI coaching failed.";
                return;
            }

            SynopsisAiResponseDto? result = await response.Content.ReadFromJsonAsync<SynopsisAiResponseDto>();
            if (result is null)
            {
                _aiError = "AI coaching returned no response.";
                return;
            }

            _aiMode = result.Mode;
            _aiOutput = result.OutputText;
            _aiProposedText = result.ProposedText;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Synopsis AI failed.");
            _aiError = "AI coaching failed.";
        }
        finally
        {
            await AuthMeStateService.RefreshAsync(force: true);
            _aiInFlight = false;
        }
    }

    private async Task ApplyAiSuggestionAsync()
    {
        if (_synopsis is null || string.IsNullOrWhiteSpace(_aiProposedText))
        {
            return;
        }

        _synopsis = SetFieldValue(_synopsis, _aiSelectedFieldKey, _aiProposedText);
        _aiOutput = null;
        _aiProposedText = null;
        _aiMode = null;
        await SaveSynopsisAsync();
    }

    private bool CanApplySuggestion =>
        string.Equals(_aiMode, "suggest", StringComparison.OrdinalIgnoreCase)
        && !string.IsNullOrWhiteSpace(_aiProposedText);

    private string GetAiOutputTitle()
    {
        if (string.Equals(_aiMode, "evaluate", StringComparison.OrdinalIgnoreCase))
        {
            return "Evaluation";
        }

        if (string.Equals(_aiMode, "questions", StringComparison.OrdinalIgnoreCase))
        {
            return "Guiding questions";
        }

        if (string.Equals(_aiMode, "suggest", StringComparison.OrdinalIgnoreCase))
        {
            SynopsisFieldDefinition? field = Fields.FirstOrDefault(item => item.Key == _aiSelectedFieldKey);
            return field is null ? "Suggestion" : $"Suggestion for {field.Label}";
        }

        return "AI Response";
    }

    private void OnAiFieldChanged(ChangeEventArgs args)
    {
        _aiSelectedFieldKey = args.Value?.ToString() ?? Fields[0].Key;
    }

    private void OnAiNotesInput(ChangeEventArgs args)
    {
        _aiUserNotes = args.Value?.ToString() ?? string.Empty;
    }

    private static DocumentSynopsisDto CreateEmptySynopsis(Guid documentId)
    {
        return new DocumentSynopsisDto(
            documentId,
            string.Empty,
            string.Empty,
            string.Empty,
            string.Empty,
            string.Empty,
            string.Empty,
            string.Empty,
            string.Empty,
            string.Empty,
            string.Empty,
            DateTimeOffset.UtcNow);
    }

    private void NavigateToDocuments()
    {
        Navigation.NavigateTo("documents");
    }

    private void NavigateToUpgrade()
    {
        Navigation.NavigateTo("/start?plan=pro", forceLoad: true);
    }

    private async Task<bool> TryHandleAiQuotaExceededAsync(HttpResponseMessage response)
    {
        int statusCode = (int)response.StatusCode;
        if (statusCode != 402
            && statusCode != 429)
        {
            return false;
        }

        try
        {
            string payload = await response.Content.ReadAsStringAsync();
            if (string.IsNullOrWhiteSpace(payload))
            {
                return false;
            }

            using JsonDocument doc = JsonDocument.Parse(payload);
            JsonElement root = doc.RootElement;
            string? code = GetJsonString(root, "code");
            if (!string.Equals(code, "AI_QUOTA_EXCEEDED", StringComparison.OrdinalIgnoreCase))
            {
                return false;
            }

            _aiQuotaExceeded = true;
            _aiQuotaPlanName = GetJsonString(root, "planKey") ?? "Free";
            _aiQuotaBudget = GetJsonInt(root, "budget") ?? 0;
            _aiQuotaUsed = GetJsonInt(root, "used") ?? _aiQuotaBudget;
            return true;
        }
        catch
        {
            return false;
        }
    }

    private static string? GetJsonString(JsonElement root, string name)
    {
        if (root.ValueKind != JsonValueKind.Object)
        {
            return null;
        }

        foreach (JsonProperty property in root.EnumerateObject())
        {
            if (!string.Equals(property.Name, name, StringComparison.OrdinalIgnoreCase))
            {
                continue;
            }

            return property.Value.ValueKind == JsonValueKind.String
                ? property.Value.GetString()
                : property.Value.GetRawText();
        }

        return null;
    }

    private static int? GetJsonInt(JsonElement root, string name)
    {
        if (root.ValueKind != JsonValueKind.Object)
        {
            return null;
        }

        foreach (JsonProperty property in root.EnumerateObject())
        {
            if (!string.Equals(property.Name, name, StringComparison.OrdinalIgnoreCase))
            {
                continue;
            }

            if (property.Value.ValueKind == JsonValueKind.Number
                && property.Value.TryGetInt32(out int intValue))
            {
                return intValue;
            }

            if (property.Value.ValueKind == JsonValueKind.String
                && int.TryParse(property.Value.GetString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out int parsed))
            {
                return parsed;
            }

            return null;
        }

        return null;
    }

    private sealed record SynopsisFieldDefinition(string Key, string Label, string Helper, string Placeholder);
}
