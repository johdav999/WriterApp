    private void RestartSessionTicker()
    {
        _sessionTickerCts?.Cancel();
        _sessionTickerCts?.Dispose();
        _sessionTickerCts = null;

        if (_progress?.ActiveSession is null)
        {
            _sessionElapsedSeconds = 0;
            _sessionLiveDelta = 0;
            return;
        }

        _sessionTickerCts = new CancellationTokenSource();
        CancellationToken token = _sessionTickerCts.Token;
        _ = Task.Run(async () =>
        {
            int tick = 0;
            while (!token.IsCancellationRequested)
            {
                await InvokeAsync(async () =>
                {
                    tick++;
                    if (tick % 15 == 0)
                    {
                        await RefreshLiveProgressAsync();
                    }

                    UpdateSessionTelemetry();
                    StateHasChanged();
                });

                try
                {
                    await Task.Delay(1000, token);
                }
                catch (TaskCanceledException)
                {
                    break;
                }
            }
        }, token);
    }

    private async Task RefreshLiveProgressAsync()
    {
        if (_activeProject is null || _progress?.ActiveSession is null)
        {
            return;
        }

        using HttpResponseMessage response = await Http.GetAsync($"api/projects/{_activeProject.Id}/progress");
        if (!response.IsSuccessStatusCode)
        {
            return;
        }

        ProjectProgressDashboardDto? latest = await response.Content.ReadFromJsonAsync<ProjectProgressDashboardDto>();
        if (latest is null)
        {
            return;
        }

        _progress = latest;
    }

    private void UpdateSessionTelemetry()
    {
        if (_progress?.ActiveSession is null)
        {
            _sessionElapsedSeconds = 0;
            _sessionLiveDelta = 0;
            return;
        }

        _sessionElapsedSeconds = Math.Max(0, (int)(DateTimeOffset.UtcNow - _progress.ActiveSession.StartedUtc).TotalSeconds);
        _sessionLiveDelta = _progress.ActiveSession.WordsDelta;
    }

    private static string FormatDuration(int totalSeconds)
    {
        int safe = Math.Max(0, totalSeconds);
        TimeSpan span = TimeSpan.FromSeconds(safe);
        return $"{(int)span.TotalHours:00}:{span.Minutes:00}:{span.Seconds:00}";
    }

    private static string FormatWordCount(int value)
    {
        return Math.Max(0, value).ToString("N0");
    }

    private RenderFragment RenderNode(ProjectNodeDto node, int depth) => builder =>
    {
        int seq = 0;
        bool isSelected = _selectedNodeId == node.Id;
        bool isRenaming = _renamingNodeId == node.Id;
        bool isMenuOpen = _openNodeMenuId == node.Id;
        bool isPointerDropTarget = _pointerDragActive
            && _dragNodeId.HasValue
            && _dragNodeId.Value != node.Id
            && _pointerDragHoverNodeId == node.Id;
        List<ProjectNodeDto> children = GetChildren(node.Id).ToList();
        bool hasChildren = children.Count > 0;
        bool isCollapsed = hasChildren && _collapsedNodeIds.Contains(node.Id);
        string displayTitle = GetDisplayNodeTitle(node.Title, node.NodeType);

        builder.OpenElement(seq++, "li");
        builder.AddAttribute(seq++, "class", isPointerDropTarget ? "tree-node is-drop-target" : "tree-node");
        builder.AddAttribute(seq++, "onmouseenter", EventCallback.Factory.Create<MouseEventArgs>(this, () => OnNodePointerEnter(node.Id)));
        builder.AddAttribute(seq++, "onmouseup", EventCallback.Factory.Create<MouseEventArgs>(this, () => OnNodePointerDropAsync(node.Id)));
        builder.AddAttribute(seq++, "ondragover", EventCallback.Factory.Create<DragEventArgs>(this, OnNodeDragOver));
        builder.AddEventPreventDefaultAttribute(seq++, "ondragover", true);
        builder.AddAttribute(seq++, "ondrop", EventCallback.Factory.Create<DragEventArgs>(this, (args) => OnNodeDropAsync(node.Id, args)));

        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", isSelected ? "tree-row is-selected" : "tree-row");
        builder.AddAttribute(seq++, "style", $"--depth:{depth}");
        builder.AddAttribute(seq++, "title", displayTitle);
        builder.AddAttribute(seq++, "tabindex", "0");
        builder.AddAttribute(seq++, "role", "treeitem");
        builder.AddAttribute(seq++, "aria-selected", isSelected ? "true" : "false");
        builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create(this, () => OnNodeSelected(node.Id)));
        builder.AddAttribute(seq++, "onkeydown", EventCallback.Factory.Create<KeyboardEventArgs>(this, (args) => OnNodeRowKeyDown(args, node.Id)));

        builder.OpenElement(seq++, "span");
        builder.AddAttribute(seq++, "class", "tree-indent");
        builder.AddAttribute(seq++, "aria-hidden", "true");
        builder.CloseElement();

        builder.OpenElement(seq++, "button");
        builder.AddAttribute(seq++, "type", "button");
        builder.AddAttribute(seq++, "class", hasChildren
            ? (isCollapsed ? "tree-disclosure" : "tree-disclosure is-expanded")
            : "tree-disclosure is-empty");
        builder.AddAttribute(seq++, "disabled", !hasChildren);
        builder.AddAttribute(seq++, "aria-label", hasChildren ? "Toggle branch" : "No children");
        builder.AddEventStopPropagationAttribute(seq++, "onclick", true);
        if (hasChildren)
        {
            builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create(this, () => ToggleCollapsed(node.Id)));
        }

        builder.AddContent(seq++, "▸");
        builder.CloseElement();

        builder.OpenElement(seq++, "span");
        builder.AddAttribute(seq++, "class", "tree-drag");
        builder.AddAttribute(seq++, "draggable", true);
        builder.AddAttribute(seq++, "role", "button");
        builder.AddAttribute(seq++, "tabindex", "0");
        builder.AddAttribute(seq++, "aria-label", "Drag to reorder");
        builder.AddEventStopPropagationAttribute(seq++, "onmousedown", true);
        builder.AddAttribute(seq++, "onmousedown", EventCallback.Factory.Create<MouseEventArgs>(this, () => OnNodeDragHandleMouseDown(node.Id)));
        builder.AddAttribute(seq++, "ondragstart", EventCallback.Factory.Create<DragEventArgs>(this, (args) => OnNodeDragStart(node.Id, args)));
        builder.AddAttribute(seq++, "ondragend", EventCallback.Factory.Create<DragEventArgs>(this, (args) => OnNodeDragEnd(node.Id, args)));
        builder.AddContent(seq++, "::");
        builder.CloseElement();

        builder.OpenElement(seq++, "span");
        builder.AddAttribute(seq++, "class", $"tree-node-badge {GetNodeBadgeClass(node.NodeType)}");
        builder.AddAttribute(seq++, "title", displayTitle);
        builder.AddContent(seq++, GetNodeTypeLabel(node.NodeType));
        builder.CloseElement();

        if (isRenaming)
        {
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "tree-rename");
            builder.OpenElement(seq++, "input");
            builder.AddAttribute(seq++, "class", "tree-rename-input");
            builder.AddAttribute(seq++, "value", _renameDraft);
            builder.AddAttribute(seq++, "autofocus", "autofocus");
            builder.AddAttribute(seq++, "oninput", EventCallback.Factory.Create<ChangeEventArgs>(this, OnRenameInput));
            builder.AddAttribute(seq++, "onkeydown", EventCallback.Factory.Create<KeyboardEventArgs>(this, (args) => OnTreeRenameKeyDown(args, node.Id)));
            builder.AddAttribute(seq++, "onblur", EventCallback.Factory.Create<FocusEventArgs>(this, async (_) => await SaveRenameForNodeAsync(node.Id)));
            builder.AddEventStopPropagationAttribute(seq++, "onclick", true);
            builder.CloseElement();
            builder.CloseElement();
        }
        else
        {
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "tree-select");
            builder.AddAttribute(seq++, "title", displayTitle);
            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "class", "tree-select-title");
            builder.AddAttribute(seq++, "title", displayTitle);
            builder.AddAttribute(seq++, "tabindex", "0");
            builder.AddContent(seq++, displayTitle);
            builder.CloseElement();
            builder.CloseElement();
        }

        if (_showNavigatorTreeWordCount)
        {
            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "class", "tree-meta");
            builder.AddContent(seq++, $"{FormatWordCount(node.WordCountCache)} words");
            builder.CloseElement();
        }

        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "tree-row-actions");

        builder.OpenElement(seq++, "button");
        builder.AddAttribute(seq++, "type", "button");
        builder.AddAttribute(seq++, "class", "tree-row-menu-toggle");
        builder.AddAttribute(seq++, "aria-label", "Node actions");
        builder.AddAttribute(seq++, "aria-haspopup", "menu");
        builder.AddAttribute(seq++, "aria-expanded", isMenuOpen ? "true" : "false");
        builder.AddEventStopPropagationAttribute(seq++, "onclick", true);
        builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create<MouseEventArgs>(this, async args => await ToggleNodeMenuAsync(node.Id, args)));
        builder.AddElementReferenceCapture(seq++, elementReference => _nodeMenuButtons[node.Id] = elementReference);
        builder.AddContent(seq++, "⋯");
        builder.CloseElement();

        builder.CloseElement();
        builder.CloseElement();

        if (hasChildren && !isCollapsed)
        {
            builder.OpenElement(seq++, "ul");
            builder.AddAttribute(seq++, "class", "tree-list");
            foreach (ProjectNodeDto child in children)
            {
                builder.AddContent(seq++, RenderNode(child, depth + 1));
            }

            builder.CloseElement();
        }

        builder.CloseElement();
    };

