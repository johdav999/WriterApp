    private async Task ToggleNodeMenuAsync(Guid nodeId, MouseEventArgs args)
    {
        if (_openNodeMenuId == nodeId)
        {
            CloseNodeMenu();
            return;
        }

        NodeMenuAnchorLayout? anchor = null;
        if (_nodeMenuButtons.TryGetValue(nodeId, out ElementReference buttonRef))
        {
            try
            {
                anchor = await JS.InvokeAsync<NodeMenuAnchorLayout?>("writerProjectsMenu.getAnchorLayout", buttonRef);
            }
            catch
            {
                anchor = null;
            }
        }

        if (anchor is null)
        {
            double viewportWidth = 0;
            double viewportHeight = 0;
            try
            {
                NodeMenuViewport? viewport = await JS.InvokeAsync<NodeMenuViewport?>("writerProjectsMenu.getViewport");
                if (viewport is not null)
                {
                    viewportWidth = viewport.Width;
                    viewportHeight = viewport.Height;
                }
            }
            catch
            {
                // ignore and fallback defaults below
            }

            anchor = new NodeMenuAnchorLayout
            {
                Left = args.ClientX,
                Top = args.ClientY,
                Right = args.ClientX,
                Bottom = args.ClientY,
                Width = 0,
                Height = 0,
                ViewportWidth = viewportWidth <= 0 ? 1280 : viewportWidth,
                ViewportHeight = viewportHeight <= 0 ? 720 : viewportHeight
            };
        }

        const double menuWidth = 184;
        const double menuHeight = 196;
        const double gap = 6;
        const double viewportPadding = 8;

        double x = anchor.Right - menuWidth;
        double maxX = Math.Max(viewportPadding, anchor.ViewportWidth - menuWidth - viewportPadding);
        x = Math.Max(viewportPadding, Math.Min(maxX, x));

        double y = anchor.Bottom + gap;
        bool shouldFlipUp = y + menuHeight > anchor.ViewportHeight - viewportPadding;
        if (shouldFlipUp)
        {
            y = anchor.Top - gap - menuHeight;
        }

        double maxY = Math.Max(viewportPadding, anchor.ViewportHeight - menuHeight - viewportPadding);
        y = Math.Max(viewportPadding, Math.Min(maxY, y));

        _openNodeMenuX = x;
        _openNodeMenuY = y;
        _openNodeMenuId = nodeId;
        _shouldFocusNodeMenu = true;
    }

    private void CloseNodeMenu()
    {
        _openNodeMenuId = null;
        _shouldFocusNodeMenu = false;
    }

