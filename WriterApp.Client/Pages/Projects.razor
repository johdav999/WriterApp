        if (hasChildren)
        {
            builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create(this, () => ToggleCollapsed(node.Id)));
        }

        builder.AddContent(seq++, "▸");
        builder.CloseElement();

        builder.OpenElement(seq++, "button");
        builder.AddAttribute(seq++, "type", "button");
        builder.AddAttribute(seq++, "class", "tree-drag");
        builder.AddAttribute(seq++, "draggable", true);
        builder.AddAttribute(seq++, "aria-label", "Drag to reorder");
        builder.AddEventStopPropagationAttribute(seq++, "onclick", true);
        builder.AddAttribute(seq++, "ondragstart", EventCallback.Factory.Create<DragEventArgs>(this, () => OnNodeDragStart(node.Id)));
        builder.AddContent(seq++, "::");
        builder.CloseElement();

        builder.OpenElement(seq++, "span");
        builder.AddAttribute(seq++, "class", $"tree-node-badge {GetNodeBadgeClass(node.NodeType)}");
        builder.AddContent(seq++, GetNodeTypeLabel(node.NodeType));
