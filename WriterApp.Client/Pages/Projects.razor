    private async Task AddNodeInternalAsync(Guid? parentId, string nodeType, string title)
    {
        if (_activeProject is null)
        {
            return;
        }

        ProjectNodeCreateRequest request = new(parentId, nodeType, title, null, null, null);
        using HttpResponseMessage response = await Http.PostAsJsonAsync($"api/projects/{_activeProject.Id}/nodes", request);
        if (!response.IsSuccessStatusCode)
        {
            _error = "Add node failed.";
            return;
        }

        ProjectNodeDto? created = await response.Content.ReadFromJsonAsync<ProjectNodeDto>();
        if (parentId.HasValue)
        {
            _collapsedNodeIds.Remove(parentId.Value);
        }

        await RefreshProjectAsync(_activeProject.Id);
        Guid? createdId = created?.Id;
        if (!createdId.HasValue)
        {
            createdId = _nodes
                .Where(node => node.ParentId == parentId && string.Equals(node.NodeType, nodeType, StringComparison.OrdinalIgnoreCase))
                .OrderByDescending(node => node.OrderIndex)
                .Select(node => (Guid?)node.Id)
                .FirstOrDefault();
        }

        if (createdId.HasValue)
        {
            _selectedNodeId = createdId.Value;
            ProjectNodeDto? selected = _nodes.FirstOrDefault(node => node.Id == createdId.Value);
            _renameDraft = selected?.Title ?? title;
            _renamingNodeId = createdId.Value;
        }
    }

