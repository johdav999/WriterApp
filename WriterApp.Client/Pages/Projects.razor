    private async Task SaveProjectNameAsync()
    {
        if (_activeProject is null || _isProjectNameSaving)
        {
            return;
        }

        string next = (_projectNameDraft ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(next))
        {
            _projectNameStatus = "Project name is required.";
            return;
        }

        if (string.Equals(next, _projectNameOriginal, StringComparison.Ordinal))
        {
            _isProjectNameEditing = false;
            _projectNameStatus = null;
            return;
        }

        ProjectDto snapshot = _activeProject;
        int projectIndex = _projects.FindIndex(item => item.Id == snapshot.Id);
        _isProjectNameSaving = true;
        _projectNameStatus = null;

        ProjectDto optimistic = snapshot with
        {
            Title = next,
            UpdatedUtc = DateTimeOffset.UtcNow
        };
        _activeProject = optimistic;
        if (projectIndex >= 0)
        {
            _projects[projectIndex] = optimistic;
        }

        try
        {
            ProjectUpdateRequest payload = new(next, null, null, null, null, null);
            using HttpResponseMessage response = await Http.PatchAsJsonAsync($"api/projects/{snapshot.Id:D}", payload);
            if (!response.IsSuccessStatusCode)
            {
                _activeProject = snapshot;
                if (projectIndex >= 0)
                {
                    _projects[projectIndex] = snapshot;
                }

                _projectNameStatus = $"Rename failed: {(int)response.StatusCode}";
                return;
            }

            _projectNameOriginal = next;
            _projectNameDraft = next;
            _isProjectNameEditing = false;
        }
        catch (Exception ex)
        {
            _activeProject = snapshot;
            if (projectIndex >= 0)
            {
                _projects[projectIndex] = snapshot;
            }

            _projectNameStatus = $"Rename failed: {ex.Message}";
        }
        finally
        {
            _isProjectNameSaving = false;
        }
    }

