    private async Task DeleteNodeAsync(Guid nodeId)
    {
        if (_activeProject is null)
        {
            return;
        }

        ProjectNodeDto? node = _nodes.FirstOrDefault(item => item.Id == nodeId);
        if (node is null)
        {
            return;
        }

        bool confirmed;
        try
        {
            string label = GetDisplayNodeTitle(node.Title, node.NodeType);
            confirmed = await JS.InvokeAsync<bool>("confirm", $"Delete '{label}' and its child nodes?");
        }
        catch
        {
            confirmed = false;
        }

        if (!confirmed)
        {
            return;
        }

        CloseNodeMenu();
        using HttpResponseMessage response = await Http.DeleteAsync($"api/projects/{_activeProject.Id}/nodes/{nodeId}");
        if (!response.IsSuccessStatusCode)
        {
            _error = "Delete node failed.";
            return;
        }

        _collapsedNodeIds.Remove(nodeId);
        await RefreshProjectAsync(_activeProject.Id);
    }

    private async Task DuplicateNodeAsync(Guid nodeId)
    {
        if (_activeProject is null || _duplicateNodeInFlight)
        {
            return;
        }

        _duplicateNodeInFlight = true;
        _error = null;

        try
        {
            ProjectNodeDto? source = _nodes.FirstOrDefault(item => item.Id == nodeId);
            bool? deep = source is null
                ? null
                : IsScene(source)
                    ? false
                    : true;

            ProjectNodeDuplicateRequest payload = new(deep);
            using HttpResponseMessage response = await Http.PostAsJsonAsync(
                $"api/projects/{_activeProject.Id}/nodes/{nodeId}/duplicate",
                payload);

            if (!response.IsSuccessStatusCode)
            {
                _error = "Duplicate node failed.";
                return;
            }

            ProjectNodeDuplicateResponse? result = await response.Content.ReadFromJsonAsync<ProjectNodeDuplicateResponse>();
            if (result is null)
            {
                _error = "Duplicate node failed.";
                return;
            }

            foreach (ProjectNodeDto updated in result.UpdatedNodes)
            {
                int existingIndex = _nodes.FindIndex(item => item.Id == updated.Id);
                if (existingIndex >= 0)
                {
                    _nodes[existingIndex] = updated;
                }
            }

            foreach (ProjectNodeDto created in result.CreatedNodes)
            {
                if (_nodes.All(item => item.Id != created.Id))
                {
                    _nodes.Add(created);
                }
            }

            ProjectNodeDto? duplicatedRoot = _nodes.FirstOrDefault(item => item.Id == result.RootNodeId);
            if (duplicatedRoot?.ParentId.HasValue == true)
            {
                _collapsedNodeIds.Remove(duplicatedRoot.ParentId.Value);
            }

            _selectedNodeId = result.RootNodeId;
            if (_selectedNode is not null)
            {
                _renameDraft = _selectedNode.Title;
            }

            int totalWords = _nodes.Where(item => item.ParentId is null).Sum(item => item.WordCountCache);
            _activeProject = _activeProject with
            {
                TotalWordCount = totalWords,
                UpdatedUtc = DateTimeOffset.UtcNow
            };
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Duplicate node failed.");
            _error = ex is HttpRequestException
                ? "Duplicate node failed (request timed out or server unreachable)."
                : "Duplicate node failed.";
        }
        finally
        {
            _duplicateNodeInFlight = false;
        }
    }

