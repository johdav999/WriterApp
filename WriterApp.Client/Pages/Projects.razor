            builder.AddAttribute(seq++, "class", "tree-row-menu");
            builder.AddAttribute(seq++, "role", "menu");
            builder.AddEventStopPropagationAttribute(seq++, "onclick", true);

            builder.OpenElement(seq++, "button");
            builder.AddAttribute(seq++, "type", "button");
            builder.AddAttribute(seq++, "role", "menuitem");
            builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create(this, () => StartInlineRename(node.Id)));
            builder.AddContent(seq++, "Rename");
            builder.CloseElement();

            if (IsPart(node))
            {
                builder.OpenElement(seq++, "button");
                builder.AddAttribute(seq++, "type", "button");
                builder.AddAttribute(seq++, "role", "menuitem");
                builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create(this, () => AddNodeUnderNodeAsync(node.Id, "chapter", "New Chapter")));
                builder.AddContent(seq++, "Add chapter");
                builder.CloseElement();
            }
            else if (IsChapter(node))
            {
                builder.OpenElement(seq++, "button");
                builder.AddAttribute(seq++, "type", "button");
