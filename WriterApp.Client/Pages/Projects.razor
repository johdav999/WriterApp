@page "/projects"
@page "/projects/{ProjectId:guid}"
@using System.Net
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components
@using WriterApp.Application.Documents
@using WriterApp.Client.Services
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IConfiguration Configuration
@inject IJSRuntime JS
@inject WriterApp.Client.State.CurrentDocumentStateService CurrentDocumentStateService
@inject WriterApp.Client.Services.CoachRecommendationService CoachRecommendationService
@implements IAsyncDisposable

<PageTitle>Projects</PageTitle>

@if (!_projectsEnabled)
{
    <div class="projects-disabled">
        Projects workflow is disabled by configuration.
    </div>
}
else
{
    <div class="projects-page">
        <header class="projects-header">
            <div>
                <h1>Projects</h1>
                <p class="projects-subtitle">Manuscript-level structure with Parts, Chapters, and Scenes.</p>
            </div>
            <div class="projects-actions">
                <button type="button" class="primary" @onclick="CreateProjectAsync" disabled="@_creatingProject">
                    @(_creatingProject ? "Creating..." : "New project")
                </button>
                <button type="button"
                        class="secondary"
                        @onclick="CreateFromDocumentAsync"
                        disabled="@(_creatingFromDocument || !CurrentDocumentStateService.DocumentId.HasValue)">
                    @(_creatingFromDocument ? "Creating..." : "From current document")
                </button>
            </div>
        </header>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="projects-error">@_error</div>
        }

        <div class="projects-toolbar">
            <label for="project-switcher">Project</label>
            <select id="project-switcher" @onchange="OnProjectSelectionChanged" value="@(_selectedProjectId?.ToString() ?? string.Empty)">
                <option value="">Select a project</option>
                @foreach (ProjectDto project in _projects)
                {
                    <option value="@project.Id">@project.Title</option>
                }
            </select>
            @if (_activeProject is not null)
            {
                <span class="projects-total">@_activeProject.TotalWordCount words</span>
            }
        </div>
        @if (_activeProject is not null)
        {
            <div class="project-entry-points">
                <button type="button"
                        class="primary"
                        title="Resume your last writing context for this project."
                        @onclick="ResumeActiveProjectAsync">
                    Resume
                </button>
                <button type="button"
                        class="secondary"
                        title="Open manuscript editor flow."
                        @onclick="OpenActiveManuscriptAsync">
                    Open manuscript
                </button>
                <button type="button"
                        class="secondary"
                        title="You are currently in the project workspace."
                        disabled>
                    Open project
                </button>
                <span class="entry-help">Resume = last writing context. Open manuscript = manuscript editor. Open project = workspace.</span>
            </div>
            <div class="projects-tabs" role="tablist" aria-label="Project workspace tabs">
                <button type="button"
                        class="@GetTabClass("structure")"
                        @onclick='() => SelectTab("structure")'>
                    Structure
                </button>
                @if (_goalsEnabled)
                {
                    <button type="button"
                            class="@GetTabClass("progress")"
                            @onclick='() => SelectTab("progress")'>
                        Progress
                    </button>
                }
            </div>
        }

        @if (_loading)
        {
            <div class="projects-loading">Loading projects...</div>
        }
        else if (_activeProject is null)
        {
            <div class="projects-empty">Create a project to begin structuring your manuscript.</div>
        }
        else
        {
            @if (_activeTab == "progress" && _goalsEnabled)
            {
                <div class="projects-progress">
                    @if (_progress is null)
                    {
                        <div class="projects-loading">Loading progress...</div>
                    }
                    else
                    {
                        <CoachCard Recommendation="BuildProjectCoachRecommendation()" OnPrimaryAction="OnProjectCoachPrimaryActionAsync" />

                        ProgressCoachModel coach = BuildProgressCoach();
                        <section class="progress-card progress-overview">
                            <h3>Project overview</h3>
                            <div class="progress-grid">
                                <div><strong>Total words:</strong> @_progress.TotalWordCount</div>
                                <div><strong>Last edited:</strong> @FormatRelativeTime(_activeProject.UpdatedUtc)</div>
                                <div><strong>Streak:</strong> @_progress.StreakCount day(s)</div>
                                <div><strong>Today:</strong> @_progress.TodayWords / @_progress.Goal.DailyTargetWords</div>
                            </div>
                            <div class="coach-primary">
                                @if (coach.PrimaryCtaSceneNodeId.HasValue)
                                {
                                    <button type="button"
                                            class="primary"
                                            @onclick="() => OpenSceneFromProgressAsync(coach.PrimaryCtaSceneNodeId.Value)">
                                        @coach.PrimaryCtaLabel
                                    </button>
                                }
                                else
                                {
                                    <button type="button"
                                            class="primary"
                                            @onclick="OpenActiveManuscriptAsync">
                                        @coach.PrimaryCtaLabel
                                    </button>
                                }
                                <span class="entry-help">@coach.PrimaryCtaHint</span>
                            </div>
                        </section>

                        <section class="progress-card">
                            <h3>Structural progress</h3>
                            <div class="progress-grid">
                                <div><strong>Parts:</strong> @coach.PartsCount</div>
                                <div><strong>Chapters:</strong> @coach.ChaptersCount</div>
                                <div><strong>Scenes:</strong> @coach.ScenesCount</div>
                                <div><strong>Drafted scenes:</strong> @coach.DraftedScenesCount / @coach.ScenesCount</div>
                                <div><strong>Planned scenes:</strong> @coach.PlannedScenesCount</div>
                                <div><strong>Needs draft:</strong> @coach.NeedsDraftScenesCount</div>
                            </div>
                        </section>

                        <section class="progress-card">
                            <h3>Coach suggestions</h3>
                            @if (coach.Suggestions.Count == 0)
                            {
                                <div class="projects-empty">Nice shape. No immediate structural issues found.</div>
                            }
                            else
                            {
                                <ul class="coach-suggestion-list">
                                    @foreach (CoachSuggestion suggestion in coach.Suggestions)
                                    {
                                        <li>
                                            <span>@suggestion.Message</span>
                                            @if (suggestion.SceneNodeId.HasValue)
                                            {
                                                <button type="button"
                                                        class="secondary"
                                                        @onclick="() => OpenSceneFromProgressAsync(suggestion.SceneNodeId.Value)">
                                                    Review scene
                                                </button>
                                            }
                                        </li>
                                    }
                                </ul>
                            }
                        </section>

                        <section class="progress-card">
                            <h3>Targets</h3>
                            <div class="progress-targets">
                                <label>Daily target</label>
                                <input type="number" min="0" @bind="_dailyTargetDraft" />
                                <label>Weekly target</label>
                                <input type="number" min="0" @bind="_weeklyTargetDraft" />
                                <label>Timezone</label>
                                <input @bind="_timezoneDraft" />
                                <button type="button" class="primary" @onclick="SaveGoalsAsync">Save targets</button>
                            </div>
                        </section>

                        <section class="progress-card">
                            <h3>Milestones</h3>
                            <div class="milestone-create">
                                <input placeholder="Title" @bind="_milestoneTitleDraft" />
                                <input type="number" min="0" placeholder="Target words" @bind="_milestoneTargetWordsDraft" />
                                <button type="button" class="secondary" @onclick="CreateMilestoneAsync">Add milestone</button>
                            </div>
                            <ul class="milestone-list">
                                @foreach (ProjectMilestoneDto milestone in _progress.Milestones)
                                {
                                    <li>
                                        <span>@milestone.Title</span>
                                        <span>@(milestone.TargetWords?.ToString() ?? "-") words</span>
                                        <span>@milestone.Status</span>
                                        @if (string.Equals(milestone.Status, "pending", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <button type="button" class="secondary" @onclick="() => CompleteMilestoneAsync(milestone.Id)">Complete</button>
                                        }
                                        <button type="button" class="secondary" @onclick="() => DeleteMilestoneAsync(milestone.Id)">Delete</button>
                                    </li>
                                }
                            </ul>
                        </section>

                        <section class="progress-card">
                            <h3>Writing session</h3>
                            @if (_progress.ActiveSession is null)
                            {
                                <button type="button" class="primary" @onclick="StartSessionAsync">Start session</button>
                            }
                            else
                            {
                                <div class="session-live">
                                    <div><strong>Duration:</strong> @FormatDuration(_sessionElapsedSeconds)</div>
                                    <div><strong>Words:</strong> @_sessionLiveDelta</div>
                                </div>
                                <input placeholder="Session notes (optional)" @bind="_sessionNotesDraft" />
                                <button type="button" class="primary" @onclick="StopSessionAsync">Stop session</button>
                            }

                            <ul class="session-list">
                                @foreach (WritingSessionDto session in _progress.RecentSessions)
                                {
                                    <li>
                                        <span>@session.StartedUtc.LocalDateTime:g</span>
                                        <span>@FormatDuration(session.DurationSeconds)</span>
                                        <span>@session.WordsDelta words</span>
                                        <span>@(session.IsActive ? "active" : "done")</span>
                                    </li>
                                }
                            </ul>
                        </section>
                    }
                </div>
            }
            else
            {
                <div class="projects-workspace">
                    <aside class="projects-tree" aria-label="Navigator">
                        <div class="panel-header">
                            <h2>Navigator</h2>
                            <p>Parts, chapters, and scenes in manuscript order.</p>
                        </div>
                        <div class="tree-actions">
                            <label for="add-node-type">Add...</label>
                            <select id="add-node-type" @bind="_addNodeType">
                                <option value="part">Part</option>
                                <option value="chapter">Chapter</option>
                                <option value="scene">Scene</option>
                            </select>
                            <button type="button"
                                    class="secondary"
                                    @onclick="AddSelectedNodeTypeAsync"
                                    disabled="@(!CanAddSelectedNodeType())">
                                Add
                            </button>
                        </div>
                        <ul class="tree-list">
                            @foreach (ProjectNodeDto root in GetChildren(null))
                            {
                                @RenderNode(root, 0)
                            }
                        </ul>
                    </aside>

                    <section class="projects-main" aria-label="Inspector">
                        <div class="panel-header">
                            <h2>Inspector</h2>
                            <p>Details for the selected node.</p>
                        </div>
                        <CoachCard Recommendation="BuildProjectCoachRecommendation()" OnPrimaryAction="OnProjectCoachPrimaryActionAsync" />
                        @if (_selectedNode is null)
                        {
                            <div class="projects-empty">Select a node to edit details.</div>
                        }
                        else
                        {
                            <div class="inspector-grid">
                                <div class="inspector-field">
                                    <label for="node-title-input">Name</label>
                                    <div class="inspector-name-row">
                                        <input id="node-title-input"
                                               class="node-title-input"
                                               value="@_renameDraft"
                                               @oninput="OnRenameInput"
                                               @onblur="SaveRenameAsync" />
                                        <button type="button" class="secondary" @onclick="SaveRenameAsync">Save</button>
                                    </div>
                                    <div class="inspector-help">Autosaves on blur. Use Save to commit immediately.</div>
                                </div>
                                <div class="inspector-field">
                                    <label>Type</label>
                                    <div class="inspector-readonly">
                                        <span class='tree-node-badge @GetNodeBadgeClass(_selectedNode.NodeType)'>@GetNodeTypeLabel(_selectedNode.NodeType)</span>
                                    </div>
                                </div>
                                <div class="inspector-field">
                                    <label>Word count</label>
                                    <div class="inspector-readonly">@FormatWordCount(_selectedNode.WordCountCache) words</div>
                                </div>
                                @if (IsScene(_selectedNode))
                                {
                                    <div class="inspector-field">
                                        <label>Linked section</label>
                                        <div class="inspector-readonly">
                                            @(_selectedNode.LinkedSectionId.HasValue ? _selectedNode.LinkedSectionId.Value.ToString() : "Not linked yet")
                                        </div>
                                    </div>
                                }
                            </div>

                            <div class="node-actions">
                                @if (IsChapter(_selectedNode))
                                {
                                    <button type="button" class="secondary" @onclick="() => AddSceneUnderAsync(_selectedNode.Id)">Add scene under chapter</button>
                                }
                                @if (IsScene(_selectedNode))
                                {
                                    <button type="button" class="primary" @onclick="OpenSceneInEditorAsync">
                                        Open scene in editor
                                    </button>
                                }
                            </div>

                            @if (IsScene(_selectedNode) && !_selectedNode.LinkedSectionId.HasValue)
                            {
                                <div class="projects-empty">This scene will create and link a section the first time you open it.</div>
                            }
                        }
                    </section>
                </div>
            }
        }
    </div>
}

@code {
    private bool _projectsEnabled;
    private bool _loading = true;
    private bool _creatingProject;
    private bool _creatingFromDocument;
    private bool _goalsEnabled;
    private string _activeTab = "structure";
    private string? _error;
    private readonly List<ProjectDto> _projects = new();
    private readonly List<ProjectNodeDto> _nodes = new();
    private ProjectDto? _activeProject;
    private ProjectProgressDashboardDto? _progress;
    private Guid? _selectedProjectId;
    private Guid? _selectedNodeId;
    private Guid? _renamingNodeId;
    private Guid? _openNodeMenuId;
    private string _renameDraft = string.Empty;
    private Guid? _dragNodeId;
    private int _dailyTargetDraft;
    private int _weeklyTargetDraft;
    private string _timezoneDraft = "UTC";
    private string _milestoneTitleDraft = string.Empty;
    private int? _milestoneTargetWordsDraft;
    private string _sessionNotesDraft = string.Empty;
    private string _addNodeType = "part";
    private readonly HashSet<Guid> _collapsedNodeIds = new();
    private CancellationTokenSource? _sessionTickerCts;
    private int _sessionElapsedSeconds;
    private int _sessionLiveDelta;

    private ProjectNodeDto? _selectedNode =>
        _selectedNodeId.HasValue ? _nodes.FirstOrDefault(node => node.Id == _selectedNodeId.Value) : null;

    [Parameter]
    public Guid? ProjectId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _projectsEnabled = Configuration.GetValue<bool?>("Workflow:ProjectsEnabled")
            ?? Configuration.GetValue<bool?>("WriterApp:Workflow:ProjectsEnabled")
            ?? false;
        _goalsEnabled = Configuration.GetValue<bool?>("Workflow:GoalsEnabled")
            ?? Configuration.GetValue<bool?>("WriterApp:Workflow:GoalsEnabled")
            ?? false;

        if (!_projectsEnabled)
        {
            _loading = false;
            return;
        }

        await LoadProjectsAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!_projectsEnabled || !_selectedProjectId.HasValue || !ProjectId.HasValue || ProjectId.Value == _selectedProjectId.Value)
        {
            return;
        }

        if (_projects.Any(project => project.Id == ProjectId.Value))
        {
            _selectedProjectId = ProjectId.Value;
            await LoadTreeAsync(ProjectId.Value);
        }
    }

    private async Task LoadProjectsAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            using HttpResponseMessage response = await Http.GetAsync("api/projects");
            if (response.StatusCode == HttpStatusCode.NotFound)
            {
                _projectsEnabled = false;
                return;
            }

            response.EnsureSuccessStatusCode();
            List<ProjectDto>? projects = await response.Content.ReadFromJsonAsync<List<ProjectDto>>();
            _projects.Clear();
            _projects.AddRange((projects ?? new List<ProjectDto>()).OrderByDescending(project => project.UpdatedUtc));

            if (_projects.Count > 0)
            {
                if (ProjectId.HasValue && _projects.Any(project => project.Id == ProjectId.Value))
                {
                    _selectedProjectId = ProjectId.Value;
                }

                _selectedProjectId ??= _projects[0].Id;
                await LoadTreeAsync(_selectedProjectId.Value);
            }
            else
            {
                _activeProject = null;
                _nodes.Clear();
                _selectedNodeId = null;
                _progress = null;
                RestartSessionTicker();
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadTreeAsync(Guid projectId)
    {
        _error = null;
        using HttpResponseMessage response = await Http.GetAsync($"api/projects/{projectId}/tree");
        if (!response.IsSuccessStatusCode)
        {
            _error = "Failed to load project tree.";
            return;
        }

        ProjectTreeDto? tree = await response.Content.ReadFromJsonAsync<ProjectTreeDto>();
        if (tree is null)
        {
            _error = "Failed to load project tree.";
            return;
        }

        _activeProject = tree.Project;
        _nodes.Clear();
        _nodes.AddRange(tree.Nodes.OrderBy(node => node.ParentId).ThenBy(node => node.OrderIndex));
        if (_selectedNodeId.HasValue && _nodes.All(node => node.Id != _selectedNodeId.Value))
        {
            _selectedNodeId = null;
        }

        if (!_selectedNodeId.HasValue && _nodes.Count > 0)
        {
            _selectedNodeId = _nodes[0].Id;
        }

        if (_selectedNode is not null)
        {
            _renameDraft = _selectedNode.Title;
        }

        if (_goalsEnabled)
        {
            await LoadProgressAsync(projectId);
        }
    }

    private IEnumerable<ProjectNodeDto> GetChildren(Guid? parentId)
    {
        return _nodes
            .Where(node => node.ParentId == parentId)
            .OrderBy(node => node.OrderIndex);
    }

    private string GetTabClass(string tab)
    {
        return string.Equals(_activeTab, tab, StringComparison.Ordinal) ? "tab-button is-active" : "tab-button";
    }

    private async Task SelectTab(string tab)
    {
        _activeTab = tab;
        if (_activeTab == "progress" && _goalsEnabled && _activeProject is not null)
        {
            await LoadProgressAsync(_activeProject.Id);
        }
    }

    private async Task LoadProgressAsync(Guid projectId)
    {
        _error = null;
        using HttpResponseMessage response = await Http.GetAsync($"api/projects/{projectId}/progress");
        if (!response.IsSuccessStatusCode)
        {
            _progress = null;
            return;
        }

        _progress = await response.Content.ReadFromJsonAsync<ProjectProgressDashboardDto>();
        if (_progress is null)
        {
            return;
        }

        _dailyTargetDraft = _progress.Goal.DailyTargetWords;
        _weeklyTargetDraft = _progress.Goal.WeeklyTargetWords;
        _timezoneDraft = string.IsNullOrWhiteSpace(_progress.Goal.Timezone) ? "UTC" : _progress.Goal.Timezone;
        UpdateSessionTelemetry();
        RestartSessionTicker();
    }

    private async Task SaveGoalsAsync()
    {
        if (_activeProject is null)
        {
            return;
        }

        ProjectGoalUpdateRequest request = new(
            Math.Max(0, _dailyTargetDraft),
            Math.Max(0, _weeklyTargetDraft),
            _timezoneDraft);

        using HttpResponseMessage response = await Http.PutAsJsonAsync(
            $"api/projects/{_activeProject.Id}/goals",
            request);
        if (!response.IsSuccessStatusCode)
        {
            _error = "Saving goals failed.";
            return;
        }

        await LoadProgressAsync(_activeProject.Id);
    }

    private async Task CreateMilestoneAsync()
    {
        if (_activeProject is null || string.IsNullOrWhiteSpace(_milestoneTitleDraft))
        {
            return;
        }

        ProjectMilestoneCreateRequest request = new(
            _milestoneTitleDraft.Trim(),
            _milestoneTargetWordsDraft,
            null);
        using HttpResponseMessage response = await Http.PostAsJsonAsync(
            $"api/projects/{_activeProject.Id}/milestones",
            request);
        if (!response.IsSuccessStatusCode)
        {
            _error = "Creating milestone failed.";
            return;
        }

        _milestoneTitleDraft = string.Empty;
        _milestoneTargetWordsDraft = null;
        await LoadProgressAsync(_activeProject.Id);
    }

    private async Task CompleteMilestoneAsync(Guid milestoneId)
    {
        if (_activeProject is null)
        {
            return;
        }

        ProjectMilestoneUpdateRequest request = new(null, null, null, "completed");
        using HttpResponseMessage response = await Http.PatchAsJsonAsync(
            $"api/projects/{_activeProject.Id}/milestones/{milestoneId}",
            request);
        if (!response.IsSuccessStatusCode)
        {
            _error = "Updating milestone failed.";
            return;
        }

        await LoadProgressAsync(_activeProject.Id);
    }

    private async Task DeleteMilestoneAsync(Guid milestoneId)
    {
        if (_activeProject is null)
        {
            return;
        }

        using HttpResponseMessage response = await Http.DeleteAsync($"api/projects/{_activeProject.Id}/milestones/{milestoneId}");
        if (!response.IsSuccessStatusCode)
        {
            _error = "Deleting milestone failed.";
            return;
        }

        await LoadProgressAsync(_activeProject.Id);
    }

    private async Task StartSessionAsync()
    {
        if (_activeProject is null)
        {
            return;
        }

        using HttpResponseMessage response = await Http.PostAsync($"api/projects/{_activeProject.Id}/sessions/start", null);
        if (!response.IsSuccessStatusCode)
        {
            _error = "Starting session failed.";
            return;
        }

        _sessionNotesDraft = string.Empty;
        await LoadProgressAsync(_activeProject.Id);
    }

    private async Task StopSessionAsync()
    {
        if (_activeProject is null || _progress?.ActiveSession is null)
        {
            return;
        }

        WritingSessionStopRequest request = new(_sessionNotesDraft);
        using HttpResponseMessage response = await Http.PostAsJsonAsync(
            $"api/projects/{_activeProject.Id}/sessions/{_progress.ActiveSession.Id}/stop",
            request);
        if (!response.IsSuccessStatusCode)
        {
            _error = "Stopping session failed.";
            return;
        }

        _sessionNotesDraft = string.Empty;
        await LoadProgressAsync(_activeProject.Id);
    }

    private void RestartSessionTicker()
    {
        _sessionTickerCts?.Cancel();
        _sessionTickerCts?.Dispose();
        _sessionTickerCts = null;

        if (_progress?.ActiveSession is null)
        {
            _sessionElapsedSeconds = 0;
            _sessionLiveDelta = 0;
            return;
        }

        _sessionTickerCts = new CancellationTokenSource();
        CancellationToken token = _sessionTickerCts.Token;
        _ = Task.Run(async () =>
        {
            int tick = 0;
            while (!token.IsCancellationRequested)
            {
                await InvokeAsync(async () =>
                {
                    tick++;
                    if (tick % 15 == 0)
                    {
                        await RefreshLiveProgressAsync();
                    }

                    UpdateSessionTelemetry();
                    StateHasChanged();
                });

                try
                {
                    await Task.Delay(1000, token);
                }
                catch (TaskCanceledException)
                {
                    break;
                }
            }
        }, token);
    }

    private async Task RefreshLiveProgressAsync()
    {
        if (_activeProject is null || _progress?.ActiveSession is null)
        {
            return;
        }

        using HttpResponseMessage response = await Http.GetAsync($"api/projects/{_activeProject.Id}/progress");
        if (!response.IsSuccessStatusCode)
        {
            return;
        }

        ProjectProgressDashboardDto? latest = await response.Content.ReadFromJsonAsync<ProjectProgressDashboardDto>();
        if (latest is null)
        {
            return;
        }

        _progress = latest;
    }

    private void UpdateSessionTelemetry()
    {
        if (_progress?.ActiveSession is null)
        {
            _sessionElapsedSeconds = 0;
            _sessionLiveDelta = 0;
            return;
        }

        _sessionElapsedSeconds = Math.Max(0, (int)(DateTimeOffset.UtcNow - _progress.ActiveSession.StartedUtc).TotalSeconds);
        _sessionLiveDelta = _progress.ActiveSession.WordsDelta;
    }

    private static string FormatDuration(int totalSeconds)
    {
        int safe = Math.Max(0, totalSeconds);
        TimeSpan span = TimeSpan.FromSeconds(safe);
        return $"{(int)span.TotalHours:00}:{span.Minutes:00}:{span.Seconds:00}";
    }

    private static string FormatWordCount(int value)
    {
        return Math.Max(0, value).ToString("N0");
    }

    private RenderFragment RenderNode(ProjectNodeDto node, int depth) => builder =>
    {
        int seq = 0;
        bool isSelected = _selectedNodeId == node.Id;
        bool isRenaming = _renamingNodeId == node.Id;
        bool isMenuOpen = _openNodeMenuId == node.Id;
        List<ProjectNodeDto> children = GetChildren(node.Id).ToList();
        bool hasChildren = children.Count > 0;
        bool isCollapsed = hasChildren && _collapsedNodeIds.Contains(node.Id);

        builder.OpenElement(seq++, "li");
        builder.AddAttribute(seq++, "class", "tree-node");
        builder.AddAttribute(seq++, "ondragover", EventCallback.Factory.Create<DragEventArgs>(this, OnNodeDragOver));
        builder.AddAttribute(seq++, "ondrop", EventCallback.Factory.Create<DragEventArgs>(this, () => OnNodeDropAsync(node.Id)));

        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", isSelected ? "tree-row is-selected" : "tree-row");
        builder.AddAttribute(seq++, "style", $"--depth:{depth}");
        builder.AddAttribute(seq++, "tabindex", "0");
        builder.AddAttribute(seq++, "role", "treeitem");
        builder.AddAttribute(seq++, "aria-selected", isSelected ? "true" : "false");
        builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create(this, () => OnNodeSelected(node.Id)));
        builder.AddAttribute(seq++, "onkeydown", EventCallback.Factory.Create<KeyboardEventArgs>(this, (args) => OnNodeRowKeyDown(args, node.Id)));

        builder.OpenElement(seq++, "button");
