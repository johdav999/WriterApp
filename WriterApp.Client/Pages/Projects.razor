    private void OnPointerDragCancel(MouseEventArgs _)
    {
        if (!_pointerDragActive)
        {
            return;
        }

        LogDnd($"pointer drag cancel dragNode={_dragNodeId?.ToString() ?? "<null>"}");
        _pointerDragActive = false;
        _pointerDragHoverNodeId = null;
        _dragNodeId = null;
    }

    private Task OnNodeDragOver(DragEventArgs args)
    {
        if (_dragNodeId.HasValue && args.DataTransfer is not null)
        {
            args.DataTransfer.DropEffect = "move";
        }

        string active = _dragNodeId?.ToString() ?? "<null>";
        LogDnd($"dragover activeDrag={active} dropEffect={args.DataTransfer?.DropEffect ?? "<null>"}");
        return Task.CompletedTask;
    }

    private async Task OnNodeDropAsync(Guid targetNodeId, DragEventArgs _)
    {
        if (_activeProject is null || !_dragNodeId.HasValue || _dragNodeId == targetNodeId)
        {
            LogDnd($"drop ignored target={targetNodeId} activeProject={_activeProject is not null} dragNode={_dragNodeId?.ToString() ?? "<null>"}");
            return;
        }

        ProjectNodeDto? dragged = _nodes.FirstOrDefault(node => node.Id == _dragNodeId.Value);
        ProjectNodeDto? target = _nodes.FirstOrDefault(node => node.Id == targetNodeId);
        if (dragged is null || target is null)
        {
            LogDnd($"drop aborted target={targetNodeId} draggedFound={dragged is not null} targetFound={target is not null}");
            _dragNodeId = null;
            return;
        }

        LogDnd($"drop begin dragged={dragged.Id} target={target.Id} sameParent={dragged.ParentId == target.ParentId}");

        if (dragged.ParentId == target.ParentId)
        {
            Guid? parentId = target.ParentId;
            List<ProjectNodeDto> siblings = GetChildren(parentId).ToList();
            int from = siblings.FindIndex(node => node.Id == dragged.Id);
            int to = siblings.FindIndex(node => node.Id == target.Id);
            if (from >= 0 && to >= 0 && from != to)
            {
                LogDnd($"drop reorder siblings parent={parentId?.ToString() ?? "<root>"} from={from} to={to}");
                ProjectNodeDto moved = siblings[from];
                siblings.RemoveAt(from);
                siblings.Insert(to, moved);
                await SaveSiblingOrderAsync(parentId, siblings.Select(node => node.Id).ToList());
            }
            else
            {
                LogDnd($"drop no-op siblings from={from} to={to}");
            }
        }
        else if (IsScene(dragged) && IsChapter(target))
        {
            LogDnd($"drop move scene->chapter scene={dragged.Id} chapter={target.Id}");
            ProjectNodePatchRequest patch = new(
                dragged.Title,
                target.Id,
                dragged.LinkedSectionId,
                dragged.MetadataJson,
                dragged.NodeType);
            using HttpResponseMessage patchResponse = await Http.PatchAsJsonAsync(
                $"api/projects/{_activeProject.Id}/nodes/{dragged.Id}",
                patch);
            if (!patchResponse.IsSuccessStatusCode)
            {
                LogDnd($"drop patch failed status={(int)patchResponse.StatusCode}");
                string? message = await OutlineTemplatesClient.ReadErrorMessageAsync(patchResponse);
                _error = string.IsNullOrWhiteSpace(message) ? "Move node failed." : message;
                _dragNodeId = null;
                return;
            }
        }
        else
        {
            LogDnd($"drop unsupported move draggedType={dragged.NodeType} targetType={target.NodeType}");
        }

        _dragNodeId = null;
        LogDnd($"drop complete target={targetNodeId}");
        await RefreshProjectAsync(_activeProject.Id);
    }

    private async Task SaveSiblingOrderAsync(Guid? parentId, List<Guid> order)
    {
        if (_activeProject is null)
        {
            return;
        }

        Guid parentRoute = parentId ?? Guid.Empty;
        ProjectNodeReorderRequest request = new(order);
        using HttpResponseMessage response = await Http.PostAsJsonAsync(
            $"api/projects/{_activeProject.Id}/nodes/{parentRoute}/reorder",
            request);
        if (!response.IsSuccessStatusCode)
        {
            string? message = await OutlineTemplatesClient.ReadErrorMessageAsync(response);
            LogDnd($"reorder failed parent={parentRoute} status={(int)response.StatusCode} detail={message}");
            _error = string.IsNullOrWhiteSpace(message) ? "Reorder failed." : message;
        }
        else
        {
            LogDnd($"reorder saved parent={parentRoute} count={order.Count}");
        }
    }

    private void LogDnd(string message)
    {
        bool isDragOver = message.StartsWith("dragover", StringComparison.OrdinalIgnoreCase);
        if (isDragOver)
        {
            DateTimeOffset now = DateTimeOffset.UtcNow;
            if (!_dndDiagnosticsEnabled || now - _lastDndDragOverLogUtc < TimeSpan.FromMilliseconds(500))
            {
                return;
            }

            _lastDndDragOverLogUtc = now;
        }

        if (_dndDiagnosticsEnabled)
        {
            Logger.LogInformation("Navigator DnD: {Message}", message);
            Console.WriteLine($"Navigator DnD: {message}");
            return;
        }

        Logger.LogDebug("Navigator DnD: {Message}", message);
    }

