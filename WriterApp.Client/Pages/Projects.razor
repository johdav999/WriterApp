        builder.AddAttribute(seq++, "aria-expanded", isMenuOpen ? "true" : "false");
        builder.AddEventStopPropagationAttribute(seq++, "onclick", true);
        builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create(this, () => ToggleNodeMenu(node.Id)));
        builder.AddContent(seq++, "⋯");
        builder.CloseElement();

        if (isMenuOpen)
        {
