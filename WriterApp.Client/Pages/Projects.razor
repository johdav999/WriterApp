    private async Task SaveRenameAsync()
    {
        if (_selectedNode is null)
        {
            return;
        }

        await SaveRenameForNodeAsync(_selectedNode.Id);
    }

    private async Task SaveRenameForNodeAsync(Guid nodeId)
    {
        if (_activeProject is null)
        {
            return;
        }

        ProjectNodeDto? node = _nodes.FirstOrDefault(item => item.Id == nodeId);
        if (node is null)
        {
            return;
        }

        string next = _renameDraft.Trim();
        if (string.IsNullOrWhiteSpace(next) || string.Equals(next, node.Title, StringComparison.Ordinal))
        {
            _renamingNodeId = null;
            return;
        }

        ProjectNodePatchRequest payload = new(
            next,
            node.ParentId,
            node.LinkedSectionId,
            node.MetadataJson,
            node.NodeType);
        using HttpResponseMessage response = await Http.PatchAsJsonAsync(
            $"api/projects/{_activeProject.Id}/nodes/{node.Id}",
            payload);
        if (!response.IsSuccessStatusCode)
        {
            _error = "Rename failed.";
            return;
        }

        _renamingNodeId = null;
        await RefreshProjectAsync(_activeProject.Id);
    }

    private async Task OnTreeRenameKeyDown(KeyboardEventArgs args, Guid nodeId)
    {
        if (string.Equals(args.Key, "Enter", StringComparison.Ordinal))
        {
            await SaveRenameForNodeAsync(nodeId);
        }
        else if (string.Equals(args.Key, "Escape", StringComparison.Ordinal))
        {
            CancelInlineRename(nodeId);
        }
    }

    private void CancelInlineRename(Guid nodeId)
    {
        _renamingNodeId = null;
        ProjectNodeDto? node = _nodes.FirstOrDefault(item => item.Id == nodeId);
        _renameDraft = node?.Title ?? string.Empty;
    }

    private void ToggleNodeMenu(Guid nodeId)
    {
        _openNodeMenuId = _openNodeMenuId == nodeId ? null : nodeId;
    }

    private async Task AddNodeUnderNodeAsync(Guid parentId, string nodeType, string title)
    {
        _openNodeMenuId = null;
        await AddNodeInternalAsync(parentId, nodeType, title);
    }

    private async Task RefreshProjectAsync(Guid projectId)
    {
        await LoadTreeAsync(projectId);

        using HttpResponseMessage projectsResponse = await Http.GetAsync("api/projects");
        if (projectsResponse.IsSuccessStatusCode)
        {
            List<ProjectDto>? projects = await projectsResponse.Content.ReadFromJsonAsync<List<ProjectDto>>();
            _projects.Clear();
            _projects.AddRange((projects ?? new List<ProjectDto>()).OrderByDescending(project => project.UpdatedUtc));
            _activeProject = _projects.FirstOrDefault(project => project.Id == projectId) ?? _activeProject;
        }
    }

    private async Task OnProjectSelectionChanged(ChangeEventArgs args)
    {
        string raw = args.Value?.ToString() ?? string.Empty;
        if (!Guid.TryParse(raw, out Guid projectId))
        {
            _selectedProjectId = null;
            _activeProject = null;
            _nodes.Clear();
            _selectedNodeId = null;
            _progress = null;
            RestartSessionTicker();
            return;
        }

        _selectedProjectId = projectId;
        await LoadTreeAsync(projectId);
        Navigation.NavigateTo($"projects/{projectId}", replace: true);
    }

    private async Task CreateProjectAsync()
    {
        _creatingProject = true;
        _error = null;
        try
        {
            ProjectCreateRequest request = new("Untitled project", null, null, null, null, null);
            using HttpResponseMessage response = await Http.PostAsJsonAsync("api/projects", request);
            response.EnsureSuccessStatusCode();
            ProjectDto? created = await response.Content.ReadFromJsonAsync<ProjectDto>();
            if (created is null)
            {
                _error = "Create project failed.";
                return;
            }

            await LoadProjectsAsync();
            _selectedProjectId = created.Id;
            await LoadTreeAsync(created.Id);
            Navigation.NavigateTo($"projects/{created.Id}", replace: true);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _creatingProject = false;
        }
    }

    private async Task CreateFromDocumentAsync()
    {
        Guid? documentId = CurrentDocumentStateService.DocumentId;
        if (!documentId.HasValue)
        {
            return;
        }

        _creatingFromDocument = true;
        _error = null;
        try
        {
            using HttpResponseMessage response = await Http.PostAsync($"api/projects/from-document/{documentId.Value}", null);
            response.EnsureSuccessStatusCode();
            ProjectTreeDto? tree = await response.Content.ReadFromJsonAsync<ProjectTreeDto>();
            if (tree is null)
            {
                _error = "Create from document failed.";
                return;
            }

            await LoadProjectsAsync();
            _selectedProjectId = tree.Project.Id;
            await LoadTreeAsync(tree.Project.Id);
            Navigation.NavigateTo($"projects/{tree.Project.Id}", replace: true);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _creatingFromDocument = false;
        }
    }

