    private async Task SaveRenameForNodeAsync(Guid nodeId)
    {
        if (_activeProject is null)
        {
            return;
        }

        ProjectNodeDto? node = _nodes.FirstOrDefault(item => item.Id == nodeId);
        if (node is null)
        {
            return;
        }

        string next = _renameDraft.Trim();
        if (string.IsNullOrWhiteSpace(next) || string.Equals(next, node.Title, StringComparison.Ordinal))
        {
            _renamingNodeId = null;
            return;
        }

        ProjectNodePatchRequest payload = new(
            next,
            node.ParentId,
            node.LinkedSectionId,
            node.MetadataJson,
            node.NodeType);
        using HttpResponseMessage response = await Http.PatchAsJsonAsync(
            $"api/projects/{_activeProject.Id}/nodes/{node.Id}",
            payload);
        if (!response.IsSuccessStatusCode)
        {
            _error = "Rename failed.";
            return;
        }

        _renamingNodeId = null;
        await RefreshProjectAsync(_activeProject.Id);
    }

