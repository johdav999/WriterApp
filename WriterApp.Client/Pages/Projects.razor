    private async Task OpenSceneInEditorAsync()
    {
        if (_activeProject is null || _selectedNode is null)
        {
            return;
        }

        if (SceneOpenRequested.HasDelegate)
        {
            await SceneOpenRequested.InvokeAsync(_selectedNode.Id);
            return;
        }

        string target = $"projects/{_activeProject.Id}/scenes/{_selectedNode.Id}";
        await SaveResumeTargetAsync(_activeProject.Id, target);
        Navigation.NavigateTo(target);
        await Task.CompletedTask;
    }

