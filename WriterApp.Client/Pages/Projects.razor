    private static bool IsPart(ProjectNodeDto node)
    {
        return string.Equals(node.NodeType, "part", StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsChapter(ProjectNodeDto node)
    {
        return string.Equals(node.NodeType, "chapter", StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsScene(ProjectNodeDto node)
    {
        return string.Equals(node.NodeType, "scene", StringComparison.OrdinalIgnoreCase);
    }

    private CoachCardRecommendation BuildProjectCoachRecommendation()
    {
        List<ProjectNodeDto> parts = _nodes.Where(IsPart).ToList();
        List<ProjectNodeDto> chapters = _nodes.Where(IsChapter).ToList();
        List<ProjectNodeDto> scenes = _nodes.Where(IsScene).OrderBy(node => node.OrderIndex).ToList();
        List<ProjectNodeDto> placeholderNodes = _nodes
            .Where(node => CoachRecommendationService.IsPlaceholderTitle(node.Title))
            .OrderBy(node => node.OrderIndex)
            .ToList();
        List<ProjectNodeDto> unlinkedScenes = scenes
            .Where(node => !node.LinkedSectionId.HasValue)
            .OrderBy(node => node.OrderIndex)
            .ToList();
        List<ProjectNodeDto> draftedScenes = scenes
            .Where(node => node.WordCountCache > 0)
            .OrderBy(node => node.OrderIndex)
            .ToList();
        Guid? nextSceneNodeId = scenes
            .Where(node => node.WordCountCache <= 0)
            .Select(node => (Guid?)node.Id)
            .FirstOrDefault()
            ?? scenes.Select(node => (Guid?)node.Id).FirstOrDefault();

        ProjectCoachInput input = new(
            parts.Count,
            chapters.Count,
            scenes.Count,
            draftedScenes.Count,
            placeholderNodes.Count,
            unlinkedScenes.Count,
            _goalsEnabled,
            string.Equals(_activeTab, "progress", StringComparison.Ordinal),
            placeholderNodes.Select(node => (Guid?)node.Id).FirstOrDefault(),
            nextSceneNodeId);

        return CoachRecommendationService.BuildProjectRecommendation(input);
    }

    private async Task OnProjectCoachPrimaryActionAsync()
    {
        CoachCardRecommendation recommendation = BuildProjectCoachRecommendation();
        switch (recommendation.PrimaryAction)
        {
            case CoachPrimaryAction.AddFirstScene:
                await CreateFirstSceneScaffoldAsync();
                break;

            case CoachPrimaryAction.RenamePlaceholderNode:
                await FocusNodeForRenameAsync(recommendation.TargetNodeId);
                break;

            case CoachPrimaryAction.ReviewProgress:
                await SelectTab("progress");
                break;

            case CoachPrimaryAction.OpenNextScene:
                if (recommendation.NextSceneNodeId.HasValue)
                {
                    await OpenSceneFromProgressAsync(recommendation.NextSceneNodeId.Value);
                }
                else
                {
                    await OpenActiveManuscriptAsync();
                }

                break;
        }
    }

    private async Task FocusNodeForRenameAsync(Guid? nodeId)
    {
        if (!nodeId.HasValue)
        {
            return;
        }

        _selectedNodeId = nodeId.Value;
        if (_selectedNode is not null)
        {
            _renameDraft = _selectedNode.Title;
        }

        await SelectTab("structure");
        StateHasChanged();
    }

    private async Task CreateFirstSceneScaffoldAsync()
    {
        if (_activeProject is null)
        {
            return;
        }

        ProjectNodeDto? part = _nodes.Where(IsPart).OrderBy(node => node.OrderIndex).FirstOrDefault();
        if (part is null)
        {
            await AddNodeInternalAsync(null, "part", "Part 1");
            await RefreshProjectAsync(_activeProject.Id);
            part = _nodes.Where(IsPart).OrderBy(node => node.OrderIndex).FirstOrDefault();
        }

        ProjectNodeDto? chapter = _nodes
            .Where(node => IsChapter(node) && node.ParentId == part?.Id)
            .OrderBy(node => node.OrderIndex)
            .FirstOrDefault();
        if (chapter is null)
        {
            await AddNodeInternalAsync(part?.Id, "chapter", "Chapter 1");
            await RefreshProjectAsync(_activeProject.Id);
            chapter = _nodes
                .Where(node => IsChapter(node) && node.ParentId == part?.Id)
                .OrderBy(node => node.OrderIndex)
                .FirstOrDefault();
        }

        if (chapter is not null)
        {
            await AddNodeInternalAsync(chapter.Id, "scene", "Scene 1");
            await RefreshProjectAsync(_activeProject.Id);
            _selectedNodeId = _nodes
                .Where(node => IsScene(node) && node.ParentId == chapter.Id)
                .OrderByDescending(node => node.OrderIndex)
                .Select(node => (Guid?)node.Id)
                .FirstOrDefault();

            if (_selectedNode is not null)
            {
                _renameDraft = _selectedNode.Title;
            }
        }
    }

    private ProgressCoachModel BuildProgressCoach()
    {
        List<ProjectNodeDto> parts = _nodes.Where(IsPart).ToList();
        List<ProjectNodeDto> chapters = _nodes.Where(IsChapter).ToList();
        List<ProjectNodeDto> scenes = _nodes.Where(IsScene).OrderBy(node => node.OrderIndex).ToList();
        List<CoachSuggestion> suggestions = new();

        if (parts.Count == 0)
        {
            suggestions.Add(new CoachSuggestion("Add at least one part to frame your manuscript.", null));
        }

        if (chapters.Count == 0)
        {
            suggestions.Add(new CoachSuggestion("Add chapters so scenes have clear buckets.", null));
        }

        if (scenes.Count == 0)
        {
            suggestions.Add(new CoachSuggestion("Add your first scene to start drafting.", null));
        }

        List<ProjectNodeDto> untitledScenes = scenes
            .Where(node => string.IsNullOrWhiteSpace(node.Title) || node.Title.Trim().Equals("New scene", StringComparison.OrdinalIgnoreCase))
            .ToList();
        if (untitledScenes.Count > 0)
        {
            suggestions.Add(new CoachSuggestion($"{untitledScenes.Count} scene(s) still have placeholder titles.", untitledScenes[0].Id));
        }

        List<ProjectNodeDto> unlinkedScenes = scenes.Where(node => !node.LinkedSectionId.HasValue).ToList();
        if (unlinkedScenes.Count > 0)
        {
            suggestions.Add(new CoachSuggestion($"{unlinkedScenes.Count} scene(s) are not linked to section text yet.", unlinkedScenes[0].Id));
        }

        List<Guid> chaptersWithoutScenes = chapters
            .Where(chapter => _nodes.All(node => node.ParentId != chapter.Id || !IsScene(node)))
            .Select(chapter => chapter.Id)
            .ToList();
        if (chaptersWithoutScenes.Count > 0)
        {
            suggestions.Add(new CoachSuggestion($"{chaptersWithoutScenes.Count} chapter(s) have no scenes yet.", null));
        }

        List<ProjectNodeDto> zeroWordScenes = scenes.Where(node => node.WordCountCache <= 0).ToList();
        List<ProjectNodeDto> draftedScenes = scenes.Where(node => node.WordCountCache > 0).ToList();
        List<ProjectNodeDto> plannedScenes = scenes.Where(node => node.WordCountCache <= 0 && !string.IsNullOrWhiteSpace(node.Title)).ToList();

        List<int> draftedWordCounts = draftedScenes.Select(node => node.WordCountCache).OrderBy(value => value).ToList();
        if (draftedWordCounts.Count >= 4)
        {
            int median = draftedWordCounts[draftedWordCounts.Count / 2];
            int max = draftedWordCounts[^1];
            if (median > 0 && max >= median * 3)
            {
                ProjectNodeDto? maxScene = draftedScenes.OrderByDescending(node => node.WordCountCache).FirstOrDefault();
                suggestions.Add(new CoachSuggestion("Scene length variance is high; review pacing across long and short scenes.", maxScene?.Id));
            }
        }

        Guid? reviewSceneId = untitledScenes.FirstOrDefault()?.Id
            ?? zeroWordScenes.FirstOrDefault()?.Id
            ?? unlinkedScenes.FirstOrDefault()?.Id;
        Guid? continueSceneId = zeroWordScenes.FirstOrDefault()?.Id
            ?? scenes.FirstOrDefault()?.Id;

        string ctaLabel = reviewSceneId.HasValue ? "Review scenes needing work" : "Continue in next scene";
        string ctaHint = reviewSceneId.HasValue
            ? "Jump to the highest-priority scene issue."
            : "Jump into drafting in manuscript order.";
        Guid? ctaSceneId = reviewSceneId ?? continueSceneId;

        return new ProgressCoachModel(
            parts.Count,
            chapters.Count,
            scenes.Count,
            draftedScenes.Count,
            plannedScenes.Count,
            zeroWordScenes.Count,
            ctaLabel,
            ctaHint,
            ctaSceneId,
            suggestions);
    }

    private static string FormatRelativeTime(DateTimeOffset timestampUtc)
    {
        DateTime utc = timestampUtc.UtcDateTime;
        TimeSpan delta = DateTime.UtcNow - utc;
        if (delta < TimeSpan.Zero)
        {
            delta = TimeSpan.Zero;
        }

        if (delta < TimeSpan.FromMinutes(1))
        {
            return "just now";
        }

        if (delta < TimeSpan.FromHours(1))
        {
            int minutes = Math.Max(1, (int)delta.TotalMinutes);
            return minutes == 1 ? "1 min ago" : $"{minutes} min ago";
        }

        if (delta < TimeSpan.FromDays(1))
        {
            int hours = Math.Max(1, (int)delta.TotalHours);
            return hours == 1 ? "1 hr ago" : $"{hours} hr ago";
        }

        int days = Math.Max(1, (int)delta.TotalDays);
        if (days < 7)
        {
            return days == 1 ? "1 day ago" : $"{days} days ago";
        }

        return utc.ToString("yyyy-MM-dd");
    }

    private static string GetNodeTypeLabel(string nodeType)
    {
        if (string.Equals(nodeType, "part", StringComparison.OrdinalIgnoreCase))
        {
            return "Part";
        }

        if (string.Equals(nodeType, "chapter", StringComparison.OrdinalIgnoreCase))
        {
            return "Chapter";
        }

        if (string.Equals(nodeType, "scene", StringComparison.OrdinalIgnoreCase))
        {
            return "Scene";
        }

        return nodeType;
    }

    private static string GetDisplayNodeTitle(string? title, string nodeType)
    {
        string trimmed = title?.Trim() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(trimmed))
        {
            return $"New {GetNodeTypeLabel(nodeType)}";
        }

        string lower = trimmed.ToLowerInvariant();
        if (lower.StartsWith("part") || lower.StartsWith("chapter") || lower.StartsWith("scene"))
        {
            bool suffixLooksAuto = lower.SkipWhile(c => !char.IsDigit(c)).Any(char.IsDigit)
                || lower.EndsWith("0", StringComparison.Ordinal)
                || string.Equals(lower, "new part", StringComparison.Ordinal)
                || string.Equals(lower, "new chapter", StringComparison.Ordinal)
                || string.Equals(lower, "new scene", StringComparison.Ordinal);
            if (suffixLooksAuto && lower.Count(char.IsLetter) <= 7)
            {
                return $"New {GetNodeTypeLabel(nodeType)}";
            }
        }

        return trimmed;
    }

    private static string GetNodeBadgeClass(string nodeType)
    {
        if (string.Equals(nodeType, "part", StringComparison.OrdinalIgnoreCase))
        {
            return "is-part";
        }

        if (string.Equals(nodeType, "chapter", StringComparison.OrdinalIgnoreCase))
        {
            return "is-chapter";
        }

        if (string.Equals(nodeType, "scene", StringComparison.OrdinalIgnoreCase))
        {
            return "is-scene";
        }

        return string.Empty;
    }

