    private List<OutlineTemplateNodeDto> BuildTemplateNodesFromCurrentProject()
    {
        return _nodes
            .OrderBy(node => node.ParentId)
            .ThenBy(node => node.OrderIndex)
            .Select(node => new OutlineTemplateNodeDto(
                node.Id,
                node.ParentId,
                node.NodeType,
                node.Title,
                node.OrderIndex,
                null,
                node.MetadataJson,
                node.LinkedSectionId))
            .ToList();
    }

    private async Task ApplySelectedOutlineTemplateAsync()
    {
        if (!_outlineTemplatesEnabled || !_selectedOutlineTemplateId.HasValue || _activeProject is null || _isOutlineTemplateActionInFlight)
        {
            return;
        }

        _isOutlineTemplateActionInFlight = true;
        _outlineTemplateStatus = null;
        try
        {
            Guid? manuscriptDocumentId = await EnsureManuscriptDocumentIdAsync(_activeProject!.Id);
            if (!manuscriptDocumentId.HasValue)
            {
                _outlineTemplateStatus = "Unable to resolve manuscript document for this project.";
                return;
            }

            List<DocumentOutlineNodeDto> beforeNodes = await Http.GetFromJsonAsync<List<DocumentOutlineNodeDto>>(
                    $"api/documents/{manuscriptDocumentId.Value}/outline/nodes")
                ?? new List<DocumentOutlineNodeDto>();
            HashSet<Guid> existingIds = beforeNodes.Select(node => node.Id).ToHashSet();

            OutlineTemplateApplyOptionsDto options = new(
                ParentNodeId: null,
                CreateLinkedSections: _applyTemplateCreateLinkedSections,
                LinkStrategy: _applyTemplateLinkStrategy);

            using HttpResponseMessage response = await OutlineTemplatesClient.ApplyTemplateAsync(
                manuscriptDocumentId.Value,
                _selectedOutlineTemplateId.Value,
                options);
            if (!response.IsSuccessStatusCode)
            {
                string? message = await OutlineTemplatesClient.ReadErrorMessageAsync(response);
                _outlineTemplateStatus = string.IsNullOrWhiteSpace(message)
                    ? "Failed to apply template."
                    : message;
                return;
            }

            List<DocumentOutlineNodeDto>? updated = await response.Content.ReadFromJsonAsync<List<DocumentOutlineNodeDto>>();
            if (updated is null)
            {
                _outlineTemplateStatus = "Template applied, but no outline data was returned.";
                return;
            }

            List<DocumentOutlineNodeDto> inserted = updated
                .Where(node => !existingIds.Contains(node.Id))
                .OrderBy(node => node.ParentId)
                .ThenBy(node => node.Order)
                .ToList();

            Guid? targetProjectParent = _applyTemplateUnderSelectedProjectNode ? _selectedNodeId : null;
            int mirroredCount = await MirrorInsertedOutlineNodesToProjectAsync(inserted, targetProjectParent);
            await RefreshProjectAsync(_activeProject.Id);

            _outlineTemplateStatus = mirroredCount > 0
                ? "Template applied."
                : "Template applied, but no new project nodes were added.";
            _isOutlineTemplatesModalOpen = false;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to apply outline template from project.");
            _outlineTemplateStatus = "Failed to apply template.";
        }
        finally
        {
            _isOutlineTemplateActionInFlight = false;
        }
    }

    private async Task<int> MirrorInsertedOutlineNodesToProjectAsync(
        IReadOnlyList<DocumentOutlineNodeDto> insertedNodes,
        Guid? targetParentProjectNodeId)
    {
        if (_activeProject is null || insertedNodes.Count == 0)
        {
            return 0;
        }

        HashSet<Guid> insertedIds = insertedNodes.Select(node => node.Id).ToHashSet();
        Dictionary<Guid, List<DocumentOutlineNodeDto>> childrenByParent = insertedNodes
            .Where(node => node.ParentId.HasValue && insertedIds.Contains(node.ParentId.Value))
            .GroupBy(node => node.ParentId!.Value)
            .ToDictionary(
                group => group.Key,
                group => group.OrderBy(node => node.Order).ToList());

        List<DocumentOutlineNodeDto> roots = insertedNodes
            .Where(node => !node.ParentId.HasValue || !insertedIds.Contains(node.ParentId.Value))
            .OrderBy(node => node.Order)
            .ToList();

        int mirrored = 0;

        async Task MirrorSubtreeAsync(DocumentOutlineNodeDto source, Guid? parentProjectNodeId, int depth)
        {
            string nodeType = InferProjectNodeType(source, depth);
            ProjectNodeDto? created = await CreateProjectNodeFromTemplateAsync(
                parentProjectNodeId,
                nodeType,
                source.Title,
                source.LinkedSectionId,
                source.MetadataJson);
            if (created is null)
            {
                return;
            }

            mirrored++;
            if (!childrenByParent.TryGetValue(source.Id, out List<DocumentOutlineNodeDto>? children))
            {
                return;
            }

            foreach (DocumentOutlineNodeDto child in children)
            {
                await MirrorSubtreeAsync(child, created.Id, depth + 1);
            }
        }

        foreach (DocumentOutlineNodeDto root in roots)
        {
            await MirrorSubtreeAsync(root, targetParentProjectNodeId, 0);
        }

        return mirrored;
    }

    private async Task<ProjectNodeDto?> CreateProjectNodeFromTemplateAsync(
        Guid? parentId,
        string nodeType,
        string title,
        Guid? linkedSectionId,
        string? metadataJson)
    {
        if (_activeProject is null)
        {
            return null;
        }

        string safeTitle = string.IsNullOrWhiteSpace(title)
            ? $"New {GetNodeTypeLabel(nodeType)}"
            : title.Trim();

        ProjectNodeCreateRequest request = new(parentId, nodeType, safeTitle, null, linkedSectionId, metadataJson);
        using HttpResponseMessage response = await Http.PostAsJsonAsync($"api/projects/{_activeProject.Id}/nodes", request);
        if (!response.IsSuccessStatusCode)
        {
            string? message = await OutlineTemplatesClient.ReadErrorMessageAsync(response);
            _outlineTemplateStatus = string.IsNullOrWhiteSpace(message)
                ? "Failed to mirror template nodes into project tree."
                : message;
            return null;
        }

        return await response.Content.ReadFromJsonAsync<ProjectNodeDto>();
    }

    private static string InferProjectNodeType(DocumentOutlineNodeDto node, int depth)
    {
        if (TryGetNodeTypeFromMetadata(node.MetadataJson, out string metadataType))
        {
            return metadataType;
        }

        if (node.LinkedSectionId.HasValue)
        {
            return "scene";
        }

        string title = node.Title?.Trim() ?? string.Empty;
        if (title.StartsWith("scene", StringComparison.OrdinalIgnoreCase))
        {
            return "scene";
        }

        if (title.StartsWith("chapter", StringComparison.OrdinalIgnoreCase))
        {
            return "chapter";
        }

        if (title.StartsWith("part", StringComparison.OrdinalIgnoreCase))
        {
            return "part";
        }

        return depth switch
        {
            <= 0 => "part",
            1 => "chapter",
            _ => "scene"
        };
    }

    private static bool TryGetNodeTypeFromMetadata(string? metadataJson, out string nodeType)
    {
        nodeType = string.Empty;
        if (string.IsNullOrWhiteSpace(metadataJson))
        {
            return false;
        }

        try
        {
            using JsonDocument document = JsonDocument.Parse(metadataJson);
            JsonElement root = document.RootElement;
            if (root.ValueKind != JsonValueKind.Object)
            {
                return false;
            }

            if (!root.TryGetProperty("nodeType", out JsonElement value)
                && !root.TryGetProperty("type", out value))
            {
                return false;
            }

            string? raw = value.GetString();
            if (string.IsNullOrWhiteSpace(raw))
            {
                return false;
            }

            string normalized = raw.Trim().ToLowerInvariant();
            if (normalized is not ("part" or "chapter" or "scene"))
            {
                return false;
            }

            nodeType = normalized;
            return true;
        }
        catch (JsonException)
        {
            return false;
        }
    }

    private async Task<Guid?> EnsureManuscriptDocumentIdAsync(Guid projectId)
    {
        using HttpResponseMessage docsResponse = await Http.GetAsync($"api/projects/{projectId}/documents");
        if (!docsResponse.IsSuccessStatusCode)
        {
            return null;
        }

        List<ProjectDocumentDto>? docs = await docsResponse.Content.ReadFromJsonAsync<List<ProjectDocumentDto>>();
        ProjectDocumentDto? manuscript = docs?
            .Where(item => item.DeletedAt is null && string.Equals(item.Kind, "manuscript", StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(item => item.UpdatedAt)
            .FirstOrDefault();
        if (manuscript is not null)
        {
            return manuscript.Id;
        }

        ProjectDocumentCreateRequest createRequest = new(
            Id: null,
            Title: "Manuscript",
            Kind: "manuscript",
            CreateDefaultStructure: false);
        using HttpResponseMessage createResponse = await Http.PostAsJsonAsync($"api/projects/{projectId}/documents", createRequest);
        if (!createResponse.IsSuccessStatusCode)
        {
            return null;
        }

        DocumentCreateResponse? created = await createResponse.Content.ReadFromJsonAsync<DocumentCreateResponse>();
        return created?.Document.Id;
    }

