@page "/billing/checkout"
@page "/app/billing/checkout"
@page "/account/billing"
@page "/app/account/billing"
@using System.Net
@using System.Net.Http.Json
@using WriterApp.Client.State
@using WriterApp.Client.Utilities
@using WriterApp.Shared.Billing
@inject NavigationManager Navigation
@inject HttpClient Http
@inject AuthMeStateService AuthMeStateService

<PageTitle>Billing</PageTitle>

<div class="projects-page">
    <header class="projects-header">
        <div>
            <h1>Billing</h1>
            <p class="projects-subtitle">Upgrade your plan or manage your existing Stripe subscription.</p>
        </div>
    </header>

    @if (_isLoadingAccount)
    {
        <div class="projects-subtitle">Loading billing account...</div>
    }
    else
    {
        <div class="account-card">
            <div class="account-row"><strong>Current plan:</strong> @_currentPlanDisplay</div>
            <div class="account-row"><strong>Subscription status:</strong> @_subscriptionStatusDisplay</div>
            <div class="account-row">@GetBillingLifecycleMessage()</div>
            @if (ShowPortalExplanation)
            {
                <div class="account-row">@GetPortalExplanation()</div>
            }
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="projects-error" role="alert">@_errorMessage</div>
    }

    @if (_finalizingCheckout)
    {
        <div class="projects-subtitle">Confirming subscription with Prosa...</div>
    }

    @if (_showSuccessBanner)
    {
        <div class="account-row"><strong>Payment received:</strong> We are waiting for Stripe webhook confirmation before activating the new plan.</div>
    }

    @if (_showCanceledBanner)
    {
        <div class="account-row"><strong>Canceled:</strong> Billing checkout was canceled.</div>
    }

    @if (!string.IsNullOrWhiteSpace(_statusMessage))
    {
        <div class="account-row">@_statusMessage</div>
    }

    @if (_allowRecoverySync && !string.IsNullOrWhiteSpace(_sessionId))
    {
        <div class="projects-actions">
            <button type="button" class="secondary" @onclick="RunRecoverySyncAsync" disabled="@_actionInFlight">
                @(_actionInFlight && _actionName == "recovery-sync" ? "Retrying sync..." : "Retry billing sync")
            </button>
        </div>
    }

    <div class="projects-actions">
        <button type="button" class="primary" @onclick='() => StartCheckoutAsync("standard")' disabled="@DisableUpgradeToStandard">
            @(_actionInFlight && _actionName == "upgrade-standard" ? "Opening checkout..." : GetStandardActionLabel())
        </button>

        <button type="button" class="primary" @onclick='() => StartCheckoutAsync("pro")' disabled="@DisableUpgradeToPro">
            @(_actionInFlight && _actionName == "upgrade-pro" ? "Opening checkout..." : GetProfessionalActionLabel())
        </button>

        @if (_hasStripeCustomer)
        {
            <button type="button" class="secondary" @onclick="OpenPortalAsync" disabled="@_actionInFlight">
                @(_actionInFlight && _actionName == "portal" ? "Opening portal..." : "Manage payment method")
            </button>

            @if (!string.Equals(_currentPlan, "free", StringComparison.OrdinalIgnoreCase))
            {
                <button type="button" class="secondary" @onclick="HandleSubscriptionActionAsync" disabled="@_actionInFlight">
                    @GetSubscriptionActionButtonText()
                </button>
            }

        }
        <button type="button" class="secondary" @onclick="GoBack" disabled="@_actionInFlight">Back</button>
        <button type="button" class="secondary" @onclick="GoToProjects" disabled="@_actionInFlight">Go to projects</button>
    </div>
</div>

@code {
    private string _returnUrl = SafeReturnUrl.DefaultProjectsPath;
    private bool _isLoadingAccount = true;
    private bool _actionInFlight;
    private string? _actionName;
    private string? _errorMessage;
    private string _currentPlan = "free";
    private string _currentPlanDisplay = "Free";
    private string _subscriptionStatus = string.Empty;
    private string _subscriptionStatusDisplay = "-";
    private DateTimeOffset? _currentPeriodEndUtc;
    private bool _cancelAtPeriodEnd;
    private bool _hasStripeCustomer;
    private bool _showSuccessBanner;
    private bool _showCanceledBanner;
    private string? _sessionId;
    private string? _expectedPlan;
    private bool _finalizingCheckout;
    private bool _allowRecoverySync;
    private string? _statusMessage;

    private bool DisableUpgradeToStandard =>
        _isLoadingAccount
        || _actionInFlight
        || string.Equals(_currentPlan, "standard", StringComparison.OrdinalIgnoreCase)
        || string.Equals(_currentPlan, "pro", StringComparison.OrdinalIgnoreCase)
        || string.Equals(_currentPlan, "professional", StringComparison.OrdinalIgnoreCase);

    private bool DisableUpgradeToPro =>
        _isLoadingAccount
        || _actionInFlight
        || string.Equals(_currentPlan, "pro", StringComparison.OrdinalIgnoreCase)
        || string.Equals(_currentPlan, "professional", StringComparison.OrdinalIgnoreCase);

    private bool ShowPortalExplanation => _hasStripeCustomer && !string.Equals(_currentPlan, "free", StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        ApplyQueryState();
        await LoadAccountAsync(force: _showSuccessBanner);
        if (_showSuccessBanner)
        {
            await AwaitWebhookConfirmationAsync();
        }

        RemoveHandledQueryFromUrl();
    }

    private void ApplyQueryState()
    {
        Uri current = Navigation.ToAbsoluteUri(Navigation.Uri);
        Dictionary<string, string> query = QueryStringParser.Parse(current.Query);
        _returnUrl = ResolveReturnUrl(query);
        _showSuccessBanner = query.TryGetValue("success", out string? success) && success == "1";
        _showCanceledBanner = query.TryGetValue("canceled", out string? canceled) && canceled == "1";
        _sessionId = query.TryGetValue("session_id", out string? sessionId) ? sessionId : null;
        _expectedPlan = query.TryGetValue("plan", out string? plan) ? NormalizePlan(plan) : null;
    }

    private async Task AwaitWebhookConfirmationAsync()
    {
        if (string.IsNullOrWhiteSpace(_sessionId))
        {
            _statusMessage = "Payment received. Waiting for subscription confirmation.";
            _allowRecoverySync = false;
            return;
        }

        _finalizingCheckout = true;
        _allowRecoverySync = false;
        _statusMessage = null;

        try
        {
            if (IsExpectedPlanActive())
            {
                _showSuccessBanner = false;
                _statusMessage = "Subscription activated.";
                return;
            }

            int[] delaysMs = { 1000, 2000, 3000, 5000, 8000 };
            foreach (int delay in delaysMs)
            {
                await Task.Delay(delay);
                await LoadAccountAsync(force: true);

                if (IsExpectedPlanActive())
                {
                    _showSuccessBanner = false;
                    _statusMessage = "Subscription activated.";
                    return;
                }
            }

            _allowRecoverySync = true;
            _statusMessage = "Payment was received, but subscription confirmation is still pending. Stripe webhooks are the primary source of truth. You can wait a moment or retry the recovery sync.";
        }
        catch
        {
            _allowRecoverySync = true;
            _statusMessage = "Payment was received, but confirmation is still pending. You can retry the recovery sync if this does not resolve shortly.";
        }
        finally
        {
            _finalizingCheckout = false;
        }
    }

    private async Task RunRecoverySyncAsync()
    {
        if (string.IsNullOrWhiteSpace(_sessionId))
        {
            return;
        }

        _actionInFlight = true;
        _actionName = "recovery-sync";
        _errorMessage = null;
        _statusMessage = "Retrying billing sync from the server...";

        try
        {
            SyncEntitlementsRequest body = new(_sessionId, null);
            using HttpResponseMessage response = await Http.PostAsJsonAsync("/api/billing/sync-entitlements", body);
            if (!response.IsSuccessStatusCode)
            {
                _statusMessage = $"Recovery sync failed: {(int)response.StatusCode}.";
                return;
            }

            await LoadAccountAsync(force: true);
            if (IsExpectedPlanActive())
            {
                _allowRecoverySync = false;
                _showSuccessBanner = false;
                _statusMessage = "Subscription activated.";
                return;
            }

            _statusMessage = "Recovery sync completed, but the updated subscription is still not visible yet.";
        }
        catch
        {
            _statusMessage = "Recovery sync failed due to a network error.";
        }
        finally
        {
            _actionInFlight = false;
            _actionName = null;
        }
    }

    private void RemoveHandledQueryFromUrl()
    {
        Uri current = Navigation.ToAbsoluteUri(Navigation.Uri);
        Dictionary<string, string> query = QueryStringParser.Parse(current.Query);
        bool hasHandled =
            (query.TryGetValue("success", out string? success) && success == "1")
            || (query.TryGetValue("canceled", out string? canceled) && canceled == "1")
            || query.ContainsKey("session_id");
        if (!hasHandled)
        {
            return;
        }

        Navigation.NavigateTo("/app/account/billing", replace: true);
    }

    private async Task LoadAccountAsync(bool force = false)
    {
        _isLoadingAccount = true;
        _errorMessage = null;

        try
        {
            string authMeUrl = force ? "/api/auth/me?force=1" : "/api/auth/me";
            using HttpResponseMessage response = await Http.GetAsync(authMeUrl);
            if (!response.IsSuccessStatusCode)
            {
                _errorMessage = $"Could not load billing account: {(int)response.StatusCode}.";
                return;
            }

            AuthMeResponse? auth = await response.Content.ReadFromJsonAsync<AuthMeResponse>();
            if (auth is null || auth.IsAuthenticated != true)
            {
                _errorMessage = "You must be signed in to manage billing.";
                return;
            }

            _currentPlan = NormalizePlan(auth.PlanKey);
            _currentPlanDisplay = ToPlanDisplayName(_currentPlan);
            _subscriptionStatus = BillingSubscriptionPolicy.NormalizeStatus(auth.SubscriptionStatus);
            _currentPeriodEndUtc = auth.CurrentPeriodEndUtc;
            _cancelAtPeriodEnd = auth.CancelAtPeriodEnd;
            _hasStripeCustomer = !string.IsNullOrWhiteSpace(auth.StripeCustomerId);
            _subscriptionStatusDisplay = string.Equals(_currentPlan, "free", StringComparison.OrdinalIgnoreCase) && !_hasStripeCustomer
                ? "Not subscribed"
                : BillingSubscriptionPolicy.GetStatusDisplayLabel(_subscriptionStatus);
            await AuthMeStateService.RefreshAsync(force: force, serverEntitlementUpdatedUtc: auth.EntitlementUpdatedUtc);
        }
        catch
        {
            _errorMessage = "Could not load billing account due to a network error.";
        }
        finally
        {
            _isLoadingAccount = false;
        }
    }

    private async Task StartCheckoutAsync(string planKey)
    {
        _actionInFlight = true;
        _actionName = $"upgrade-{planKey}";
        _errorMessage = null;
        try
        {
            CreateCheckoutRequest body = new(planKey);
            using HttpResponseMessage response = await Http.PostAsJsonAsync("/api/billing/checkout-session", body);
            if (response.StatusCode == HttpStatusCode.Unauthorized)
            {
                _errorMessage = "Checkout failed: unauthorized.";
                return;
            }

            if (!response.IsSuccessStatusCode)
            {
                string failureBody = await response.Content.ReadAsStringAsync();
                _errorMessage = string.IsNullOrWhiteSpace(failureBody)
                    ? $"Checkout failed: {(int)response.StatusCode}."
                    : $"Checkout failed: {(int)response.StatusCode} {failureBody}";
                return;
            }

            BillingUrlResponse? payload = await response.Content.ReadFromJsonAsync<BillingUrlResponse>();
            if (payload is null || string.IsNullOrWhiteSpace(payload.Url))
            {
                _errorMessage = "Checkout failed: empty checkout URL.";
                return;
            }

            Navigation.NavigateTo(payload.Url, forceLoad: true);
        }
        catch
        {
            _errorMessage = "Checkout failed due to a network error.";
        }
        finally
        {
            _actionInFlight = false;
            _actionName = null;
        }
    }

    private async Task OpenPortalAsync()
    {
        _actionInFlight = true;
        _actionName = "portal";
        _errorMessage = null;
        try
        {
            using HttpResponseMessage response = await Http.PostAsync("/api/billing/portal", content: null);
            if (response.StatusCode == HttpStatusCode.Unauthorized)
            {
                _errorMessage = "Portal failed: unauthorized.";
                return;
            }

            if (!response.IsSuccessStatusCode)
            {
                string failureBody = await response.Content.ReadAsStringAsync();
                _errorMessage = string.IsNullOrWhiteSpace(failureBody)
                    ? $"Portal failed: {(int)response.StatusCode}."
                    : $"Portal failed: {(int)response.StatusCode} {failureBody}";
                return;
            }

            BillingUrlResponse? payload = await response.Content.ReadFromJsonAsync<BillingUrlResponse>();
            if (payload is null || string.IsNullOrWhiteSpace(payload.Url))
            {
                _errorMessage = "Portal failed: empty portal URL.";
                return;
            }

            Navigation.NavigateTo(payload.Url, forceLoad: true);
        }
        catch
        {
            _errorMessage = "Portal failed due to a network error.";
        }
        finally
        {
            _actionInFlight = false;
            _actionName = null;
        }
    }

    private Task HandleSubscriptionActionAsync()
    {
        return _cancelAtPeriodEnd
            ? OpenPortalAsync()
            : CancelSubscriptionAsync();
    }

    private async Task CancelSubscriptionAsync()
    {
        _actionInFlight = true;
        _actionName = "cancel";
        _errorMessage = null;

        try
        {
            using HttpResponseMessage response = await Http.PostAsync("/api/billing/cancel-subscription", content: null);
            if (response.StatusCode == HttpStatusCode.Unauthorized)
            {
                _errorMessage = "Cancellation failed: unauthorized.";
                return;
            }

            if (!response.IsSuccessStatusCode)
            {
                string failureBody = await response.Content.ReadAsStringAsync();
                _errorMessage = string.IsNullOrWhiteSpace(failureBody)
                    ? $"Cancellation failed: {(int)response.StatusCode}."
                    : $"Cancellation failed: {(int)response.StatusCode} {failureBody}";
                return;
            }

            await LoadAccountAsync(force: true);
            _statusMessage = _cancelAtPeriodEnd && _currentPeriodEndUtc.HasValue
                ? $"Your subscription is scheduled to cancel on {FormatBillingDate(_currentPeriodEndUtc)}. After that, your account continues on the Free plan."
                : "Your subscription is scheduled to cancel at period end. After that, your account continues on the Free plan.";
        }
        catch
        {
            _errorMessage = "Cancellation failed due to a network error.";
        }
        finally
        {
            _actionInFlight = false;
            _actionName = null;
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo(_returnUrl);
    }

    private void GoToProjects()
    {
        Navigation.NavigateTo("/projects");
    }

    private string GetBillingLifecycleMessage()
    {
        return BillingSubscriptionPolicy.BuildLifecycleMessage(
            _currentPlan,
            _currentPlanDisplay,
            _subscriptionStatus,
            _currentPeriodEndUtc,
            _cancelAtPeriodEnd);
    }

    private string GetPortalExplanation()
    {
        return BillingSubscriptionPolicy.BuildPortalExplanation(
            _currentPlan,
            _subscriptionStatus,
            _currentPeriodEndUtc,
            _cancelAtPeriodEnd);
    }

    private string GetStandardActionLabel()
    {
        if (string.Equals(_currentPlan, "standard", StringComparison.OrdinalIgnoreCase) && !_cancelAtPeriodEnd)
        {
            return "Current plan";
        }

        return string.Equals(_currentPlan, "free", StringComparison.OrdinalIgnoreCase)
            ? "Upgrade to Standard"
            : "Change plan to Standard";
    }

    private string GetProfessionalActionLabel()
    {
        if (string.Equals(_currentPlan, "pro", StringComparison.OrdinalIgnoreCase) && !_cancelAtPeriodEnd)
        {
            return "Current plan";
        }

        return string.Equals(_currentPlan, "free", StringComparison.OrdinalIgnoreCase)
            ? "Upgrade to Professional"
            : "Change plan to Professional";
    }

    private string GetPortalSubscriptionActionLabel()
    {
        return _cancelAtPeriodEnd
            ? "Review cancellation"
            : "Cancel subscription";
    }

    private string GetSubscriptionActionButtonText()
    {
        if (_actionInFlight && _actionName == "cancel")
        {
            return "Scheduling cancellation...";
        }

        if (_actionInFlight && _actionName == "portal")
        {
            return "Opening portal...";
        }

        return GetPortalSubscriptionActionLabel();
    }

    private bool IsExpectedPlanActive()
    {
        string expectedPlan = NormalizePlan(_expectedPlan);
        if (string.IsNullOrWhiteSpace(expectedPlan) || string.Equals(expectedPlan, "free", StringComparison.OrdinalIgnoreCase))
        {
            return !string.Equals(_currentPlan, "free", StringComparison.OrdinalIgnoreCase)
                && IsSubscriptionLifecycleActive(_subscriptionStatus);
        }

        return string.Equals(_currentPlan, expectedPlan, StringComparison.OrdinalIgnoreCase)
            && IsSubscriptionLifecycleActive(_subscriptionStatus);
    }

    private static string ResolveReturnUrl(Dictionary<string, string> query)
    {
        return SafeReturnUrl.ResolveFromQuery(query, fallback: SafeReturnUrl.DefaultProjectsPath);
    }

    private static string NormalizePlan(string? planKey)
    {
        if (string.IsNullOrWhiteSpace(planKey))
        {
            return "free";
        }

        string candidate = planKey.Trim().ToLowerInvariant();
        if (candidate == "professional")
        {
            return "pro";
        }

        return candidate;
    }

    private static bool IsSubscriptionLifecycleActive(string? subscriptionStatus)
    {
        return BillingSubscriptionPolicy.Evaluate(subscriptionStatus).KeepsPaidAccess;
    }

    private static string ToPlanDisplayName(string normalizedPlan)
    {
        return normalizedPlan switch
        {
            "standard" => "Standard",
            "pro" => "Professional",
            _ => "Free"
        };
    }

    private static string FormatBillingDate(DateTimeOffset? value)
    {
        return value.HasValue
            ? value.Value.ToLocalTime().ToString("yyyy-MM-dd")
            : "-";
    }

    private sealed class CreateCheckoutRequest
    {
        public CreateCheckoutRequest(string planKey)
        {
            PlanKey = planKey;
        }

        public string PlanKey { get; }
    }

    private sealed class AuthMeResponse
    {
        public bool IsAuthenticated { get; init; }
        public string? PlanKey { get; init; }
        public string? EffectivePlanKey { get; init; }
        public string? SubscriptionStatus { get; init; }
        public DateTimeOffset? CurrentPeriodEndUtc { get; init; }
        public bool CancelAtPeriodEnd { get; init; }
        public bool IsPaidAccessActive { get; init; }
        public string? StripeCustomerId { get; init; }
        public DateTimeOffset EntitlementUpdatedUtc { get; init; }
    }

    private sealed class BillingUrlResponse
    {
        public string? Url { get; init; }
    }

    private sealed record SyncEntitlementsRequest(string SessionId, string? SubscriptionId);
}
