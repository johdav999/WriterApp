<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <StaticWebAssetBasePath>app</StaticWebAssetBasePath>
    <DefineConstants>$(DefineConstants);CLIENT_FEATURE_REGISTRY_INTERNAL</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WriterApp.UI.Shared\WriterApp.UI.Shared.csproj" />
    <ProjectReference Include="..\WriterApp.Shared\WriterApp.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Application\Subscriptions\FeatureRegistry.cs" Link="Application\Subscriptions\FeatureRegistry.cs" />
  </ItemGroup>

</Project>
