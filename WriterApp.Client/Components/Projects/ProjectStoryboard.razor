    private async Task HandleDuplicateSceneAsync(Guid sceneId)
    {
        if (Project is null || _moveInFlight)
        {
            return;
        }

        ProjectNodeDto? sourceNode = _renderNodes.FirstOrDefault(node => node.Id == sceneId);
        if (sourceNode is null)
        {
            return;
        }

        _storyboardError = null;
        Guid? targetChapterId = sourceNode.ParentId;

        try
        {
            Logger.LogInformation(
                "Storyboard duplicate start. ProjectId={ProjectId} SourceNodeId={SourceNodeId} ChapterId={ChapterId}",
                Project.Id,
                sceneId,
                targetChapterId);

            SceneCardDto? sourceCard = await Http.GetFromJsonAsync<SceneCardDto>($"api/scenes/{sceneId}/scene-card");

            using HttpResponseMessage duplicateResponse = await Http.PostAsJsonAsync(
                $"api/projects/{Project.Id}/nodes/{sceneId}/duplicate",
                new ProjectNodeDuplicateRequest(false));
            if (!duplicateResponse.IsSuccessStatusCode)
            {
                throw new InvalidOperationException(await ReadApiErrorAsync(duplicateResponse, "Duplicate scene failed."));
            }

            ProjectNodeDuplicateResponse? payload =
                await duplicateResponse.Content.ReadFromJsonAsync<ProjectNodeDuplicateResponse>();
            if (payload is null)
            {
                throw new InvalidOperationException("Duplicate scene failed.");
            }

            foreach (ProjectNodeDto updatedNode in payload.UpdatedNodes)
            {
                InsertOrUpdateRenderNode(updatedNode);
            }

            foreach (ProjectNodeDto createdNode in payload.CreatedNodes)
            {
                InsertOrUpdateRenderNode(createdNode);
            }

            ProjectNodeDto? duplicatedNode = payload.CreatedNodes.FirstOrDefault(node => node.Id == payload.RootNodeId);
            if (duplicatedNode is null)
            {
                throw new InvalidOperationException("Duplicate scene failed.");
            }

            string duplicateTitle = BuildDuplicateSceneTitle(sourceNode.Title);
            string duplicateMetadataJson = sourceNode.MetadataJson ?? duplicatedNode.MetadataJson ?? string.Empty;
            ProjectNodeDto patchedNode = duplicatedNode with
            {
                Title = duplicateTitle,
                MetadataJson = duplicateMetadataJson,
                UpdatedUtc = DateTimeOffset.UtcNow
            };

            using HttpResponseMessage patchResponse = await Http.PatchAsJsonAsync(
                $"api/projects/{Project.Id}/nodes/{duplicatedNode.Id}",
                new ProjectNodePatchRequest(
                    duplicateTitle,
                    duplicatedNode.ParentId,
                    duplicatedNode.LinkedSectionId,
                    duplicateMetadataJson,
                    duplicatedNode.NodeType));
            if (!patchResponse.IsSuccessStatusCode)
            {
                throw new InvalidOperationException(await ReadApiErrorAsync(patchResponse, "Duplicate scene failed."));
            }

            if (sourceCard is not null)
            {
                SceneCardUpdateRequest sceneCardPayload = new(
                    sourceCard.NarrativePurpose,
                    sourceCard.EmotionalBeat,
                    sourceCard.KeyEvents,
                    sourceCard.OpenQuestions,
                    sourceCard.PovCharacterId,
                    sourceCard.PlaceId,
                    sourceCard.TimelineEventId,
                    sourceCard.TimeRef,
                    sourceCard.Tags ?? Array.Empty<string>(),
                    Array.Empty<SceneCardReferenceDto>(),
                    sourceCard.Summary,
                    sourceCard.Status,
                    sourceCard.SubplotTags ?? Array.Empty<string>(),
                    sourceCard.NarrativeRole,
                    sourceCard.NarrativeIntent);

                using HttpResponseMessage sceneCardResponse =
                    await Http.PutAsJsonAsync($"api/scenes/{duplicatedNode.Id}/scene-card", sceneCardPayload);
                if (!sceneCardResponse.IsSuccessStatusCode)
                {
                    throw new InvalidOperationException(await ReadApiErrorAsync(sceneCardResponse, "Duplicate scene failed."));
                }
            }

            InsertOrUpdateRenderNode(patchedNode);
            _highlightedSceneId = patchedNode.Id;
            _pendingScrollSceneId = patchedNode.Id;

            foreach (ProjectNodeDto updatedNode in payload.UpdatedNodes)
            {
                await NotifySceneUpdatedAsync(updatedNode);
            }

            await NotifySceneUpdatedAsync(patchedNode);

            Logger.LogInformation(
                "Storyboard duplicate local sync applied. ProjectId={ProjectId} SourceNodeId={SourceNodeId} NewNodeId={NewNodeId} ChapterId={ChapterId} RefreshMode={RefreshMode}",
                Project.Id,
                sceneId,
                patchedNode.Id,
                patchedNode.ParentId,
                "local-sync");

            if (OnStructureChanged.HasDelegate)
            {
                await OnStructureChanged.InvokeAsync();
            }

            await SelectSceneAsync(patchedNode.Id);
            await InvokeAsync(StateHasChanged);

            Logger.LogInformation(
                "Storyboard duplicate success. ProjectId={ProjectId} SourceNodeId={SourceNodeId} NewNodeId={NewNodeId} ChapterId={ChapterId}",
                Project.Id,
                sceneId,
                patchedNode.Id,
                patchedNode.ParentId);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(
                ex,
                "Storyboard duplicate failed. ProjectId={ProjectId} SourceNodeId={SourceNodeId} ChapterId={ChapterId}",
                Project.Id,
                sceneId,
                targetChapterId);
            _storyboardError = ex.Message;
        }
    }

