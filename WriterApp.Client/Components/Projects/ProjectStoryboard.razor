    private static SceneMetadata ReadSceneMetadata(ProjectNodeDto scene)
    {
        SceneMetadata metadata = new(
            Summary: null,
            Status: null,
            Pov: null,
            SubplotTags: Array.Empty<string>(),
            NarrativePurpose: null,
            NarrativeRole: null,
            NarrativeIntent: null,
            HasNotes: scene.LinkedSectionId.HasValue,
            UpdatedUtc: scene.UpdatedUtc);

        if (string.IsNullOrWhiteSpace(scene.MetadataJson))
        {
            return metadata;
        }

        try
        {
            using JsonDocument document = JsonDocument.Parse(scene.MetadataJson);
            JsonElement root = document.RootElement;
            string? summary = GetString(root, "summary")
                ?? GetString(root, "subtitle")
                ?? GetString(root, "description");
            string? status = GetString(root, "status");
            string? pov = GetString(root, "pov")
                ?? GetString(root, "pointOfView");
            string? narrativeRole = GetString(root, "narrativeRole");
            string? narrativeIntent = GetString(root, "narrativeIntent");
            string? narrativePurpose = GetString(root, "narrativePurpose");
            if (string.IsNullOrWhiteSpace(narrativeRole)
                && SceneNarrativeRoleCatalog.TryNormalize(narrativePurpose, out string? normalizedRole))
            {
                narrativeRole = normalizedRole;
            }

            if (string.IsNullOrWhiteSpace(narrativeIntent)
                && string.IsNullOrWhiteSpace(narrativeRole))
            {
                narrativeIntent = NormalizeOptionalValue(narrativePurpose);
            }
            IReadOnlyList<string> subplotTags = GetStringArray(root, "subplotTags");
            if (subplotTags.Count == 0)
            {
                subplotTags = GetStringArray(root, "tags");
            }
            bool hasNotes = metadata.HasNotes
                || HasMeaningfulValue(root, "notes")
                || HasMeaningfulValue(root, "notesText");

            return new SceneMetadata(
                string.IsNullOrWhiteSpace(summary) ? null : summary.Trim(),
                string.IsNullOrWhiteSpace(status) ? null : status.Trim(),
                string.IsNullOrWhiteSpace(pov) ? null : pov.Trim(),
                subplotTags,
                string.IsNullOrWhiteSpace(narrativePurpose) ? null : narrativePurpose.Trim(),
                string.IsNullOrWhiteSpace(narrativeRole) ? null : narrativeRole.Trim(),
                string.IsNullOrWhiteSpace(narrativeIntent) ? null : narrativeIntent.Trim(),
                hasNotes,
                scene.UpdatedUtc);
        }
        catch
        {
            return metadata;
        }
    }

    private static string? GetString(JsonElement element, string propertyName)
    {
        foreach (JsonProperty property in element.EnumerateObject())
        {
            if (!string.Equals(property.Name, propertyName, StringComparison.OrdinalIgnoreCase))
            {
                continue;
            }

            return property.Value.ValueKind == JsonValueKind.String
                ? property.Value.GetString()
                : property.Value.ToString();
        }

        return null;
    }

    private static bool HasMeaningfulValue(JsonElement element, string propertyName)
    {
        foreach (JsonProperty property in element.EnumerateObject())
        {
            if (!string.Equals(property.Name, propertyName, StringComparison.OrdinalIgnoreCase))
            {
                continue;
            }

            return property.Value.ValueKind switch
            {
                JsonValueKind.Null => false,
                JsonValueKind.Undefined => false,
                JsonValueKind.False => false,
                JsonValueKind.String => !string.IsNullOrWhiteSpace(property.Value.GetString()),
                JsonValueKind.Array => property.Value.GetArrayLength() > 0,
                JsonValueKind.Object => property.Value.EnumerateObject().Any(),
                _ => true
            };
        }

        return false;
    }

    private static IReadOnlyList<string> GetStringArray(JsonElement element, string propertyName)
    {
        foreach (JsonProperty property in element.EnumerateObject())
        {
            if (!string.Equals(property.Name, propertyName, StringComparison.OrdinalIgnoreCase))
            {
                continue;
            }

            if (property.Value.ValueKind != JsonValueKind.Array)
            {
                return Array.Empty<string>();
            }

            return property.Value
                .EnumerateArray()
                .Where(item => item.ValueKind == JsonValueKind.String)
                .Select(item => item.GetString()?.Trim() ?? string.Empty)
                .Where(item => !string.IsNullOrWhiteSpace(item))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToArray();
        }

        return Array.Empty<string>();
    }

