    private StoryboardSelectionChange BuildSelectionChange(Guid chapterId, Guid sceneId, MouseEventArgs args)
    {
        bool isToggle = args.CtrlKey || args.MetaKey;
        bool isRange = args.ShiftKey;
        HashSet<Guid> nextSelection = SelectedSceneIds.ToHashSet();

        if (isRange)
        {
            Guid[] chapterSceneIds = ChapterColumns
                .FirstOrDefault(column => column.Chapter.Id == chapterId)?
                .Scenes
                .Select(scene => scene.SceneId)
                .ToArray()
                ?? [];

            Guid anchorSceneId = GetRangeAnchorSceneId(chapterId, chapterSceneIds, sceneId);
            int anchorIndex = Array.IndexOf(chapterSceneIds, anchorSceneId);
            int targetIndex = Array.IndexOf(chapterSceneIds, sceneId);
            if (anchorIndex >= 0 && targetIndex >= 0)
            {
                int start = Math.Min(anchorIndex, targetIndex);
                int end = Math.Max(anchorIndex, targetIndex);
                nextSelection.Clear();
                for (int index = start; index <= end; index++)
                {
                    nextSelection.Add(chapterSceneIds[index]);
                }
            }
            else
            {
                nextSelection.Clear();
                nextSelection.Add(sceneId);
            }
        }
        else if (isToggle)
        {
            if (!nextSelection.Add(sceneId))
            {
                nextSelection.Remove(sceneId);
            }
        }
        else
        {
            nextSelection.Clear();
            nextSelection.Add(sceneId);
        }

        Guid? primarySceneId = nextSelection.Count == 0
            ? null
            : sceneId;

        return new StoryboardSelectionChange(primarySceneId, nextSelection.ToArray());
    }

    private Guid GetRangeAnchorSceneId(Guid chapterId, IReadOnlyList<Guid> chapterSceneIds, Guid fallbackSceneId)
    {
        if (SelectedSceneId.HasValue && chapterSceneIds.Contains(SelectedSceneId.Value))
        {
            return SelectedSceneId.Value;
        }

        Guid chapterSelection = ChapterColumns
            .FirstOrDefault(column => column.Chapter.Id == chapterId)?
            .Scenes
            .Select(scene => scene.SceneId)
            .FirstOrDefault(sceneId => SelectedSceneIds.Contains(sceneId))
            ?? Guid.Empty;
        if (chapterSelection != Guid.Empty)
        {
            return chapterSelection;
        }

        return fallbackSceneId;
    }

