    private async Task HandleChapterTitleKeyDownAsync(ProjectNodeDto chapter, KeyboardEventArgs args)
    {
        if (string.Equals(args.Key, "Enter", StringComparison.Ordinal))
        {
            await CommitChapterTitleEditAsync(chapter);
            return;
        }

        if (string.Equals(args.Key, "Escape", StringComparison.Ordinal))
        {
            CancelChapterRename();
        }
    }

    private void CancelChapterRename()
    {
        if (_savingChapterTitleId.HasValue)
        {
            return;
        }

        _editingChapterId = null;
        _chapterTitleDraft = string.Empty;
        _focusChapterTitleInputPending = false;
    }

    private async Task CommitChapterTitleEditAsync(ProjectNodeDto chapter)
    {
        if (Project is null || _editingChapterId != chapter.Id || _savingChapterTitleId == chapter.Id)
        {
            return;
        }

        ProjectNodeDto? existing = _renderNodes.FirstOrDefault(node => node.Id == chapter.Id);
        if (existing is null)
        {
            CancelChapterRename();
            return;
        }

        string nextTitle = GetChapterDisplayTitle(_chapterTitleDraft);
        _editingChapterId = null;
        _chapterTitleDraft = string.Empty;

        if (string.Equals(nextTitle, GetChapterDisplayTitle(existing.Title), StringComparison.Ordinal))
        {
            await InvokeAsync(StateHasChanged);
            return;
        }

        _savingChapterTitleId = chapter.Id;
        ProjectNodeDto optimistic = existing with
        {
            Title = nextTitle,
            UpdatedUtc = DateTimeOffset.UtcNow
        };

        InsertOrUpdateRenderNode(optimistic);
        await InvokeAsync(StateHasChanged);

        try
        {
            using HttpResponseMessage response = await Http.PatchAsJsonAsync(
                $"api/projects/{Project.Id}/nodes/{chapter.Id}",
                new ProjectNodePatchRequest(
                    optimistic.Title,
                    existing.ParentId,
                    existing.LinkedSectionId,
                    existing.MetadataJson,
                    existing.NodeType));
            if (!response.IsSuccessStatusCode)
            {
                throw new InvalidOperationException(await ReadApiErrorAsync(response, "Rename chapter failed."));
            }

            if (OnStructureChanged.HasDelegate)
            {
                await OnStructureChanged.InvokeAsync();
            }
        }
        catch (Exception ex)
        {
            _storyboardError = ex.Message;
            InsertOrUpdateRenderNode(existing);
            await InvokeAsync(StateHasChanged);
        }
        finally
        {
            _savingChapterTitleId = null;
        }
    }

