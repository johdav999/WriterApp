    private static string BuildDuplicateSceneTitle(string? title)
    {
        string baseTitle = string.IsNullOrWhiteSpace(title) ? "Untitled scene" : title.Trim();
        return $"Copy of {baseTitle}";
    }

    private string GetGapDropClass(Guid chapterId, Guid? beforeSceneId)
    {
        List<string> classes = new() { "storyboard-drop-gap" };
        if (_dropChapterId == chapterId && _dropBeforeSceneId == beforeSceneId)
        {
            classes.Add("is-drop-target");
        }

        return string.Join(" ", classes);
    }

    private static Guid? GetNextSceneId(IReadOnlyList<StoryboardSceneCard> scenes, Guid sceneId)
    {
        for (int index = 0; index < scenes.Count; index++)
        {
            if (scenes[index].SceneId != sceneId)
            {
                continue;
            }

            return index + 1 < scenes.Count ? scenes[index + 1].SceneId : null;
        }

        return null;
    }

    private Guid? GetDeleteSelectionTarget(Guid deletedSceneId)
    {
        foreach (StoryboardChapterColumn column in ChapterColumns)
        {
            int sceneIndex = column.Scenes.FindIndex(scene => scene.SceneId == deletedSceneId);
            if (sceneIndex < 0)
            {
                continue;
            }

            if (sceneIndex + 1 < column.Scenes.Count)
            {
                return column.Scenes[sceneIndex + 1].SceneId;
            }

            if (sceneIndex - 1 >= 0)
            {
                return column.Scenes[sceneIndex - 1].SceneId;
            }

            break;
        }

        return ChapterColumns
            .SelectMany(column => column.Scenes)
            .Select(scene => scene.SceneId)
            .FirstOrDefault(sceneId => sceneId != deletedSceneId);
    }

    private StoryboardSelectionChange BuildDeleteSelectionChange(Guid deletedSceneId, Guid? nextSceneId)
    {
        HashSet<Guid> remainingSelection = SelectedSceneIds
            .Where(sceneId => sceneId != deletedSceneId)
            .ToHashSet();

        if (remainingSelection.Count > 0)
        {
            Guid primarySceneId = SelectedSceneId.HasValue && remainingSelection.Contains(SelectedSceneId.Value)
                ? SelectedSceneId.Value
                : remainingSelection.First();
            return new StoryboardSelectionChange(primarySceneId, remainingSelection.ToArray());
        }

        if (nextSceneId.HasValue)
        {
            return new StoryboardSelectionChange(nextSceneId.Value, [nextSceneId.Value]);
        }

        return new StoryboardSelectionChange(null, Array.Empty<Guid>());
    }

    private (StoryboardSelectionChange Selection, Guid? NextSceneId) RemoveSceneAndReselect(Guid deletedSceneId)
    {
        Guid? nextSceneId = GetDeleteSelectionTarget(deletedSceneId);
        StoryboardSelectionChange nextSelection = BuildDeleteSelectionChange(deletedSceneId, nextSceneId);

        RemoveRenderNodeTree(deletedSceneId);

        if (_highlightedSceneId == deletedSceneId)
        {
            _highlightedSceneId = nextSelection.PrimarySceneId;
        }

        if (_pendingScrollSceneId == deletedSceneId)
        {
            _pendingScrollSceneId = nextSelection.PrimarySceneId;
        }

        return (nextSelection, nextSceneId);
    }

    private HashSet<Guid> GetSceneIdsInNodeTree(Guid nodeId)
    {
        HashSet<Guid> nodeIds = GetNodeTreeIds(nodeId);
        return _renderNodes
            .Where(node => nodeIds.Contains(node.Id) && IsScene(node))
            .Select(node => node.Id)
            .ToHashSet();
    }

    private StoryboardSelectionChange BuildSelectionAfterRemovedScenes(IReadOnlySet<Guid> removedSceneIds)
    {
        HashSet<Guid> remainingSelection = SelectedSceneIds
            .Where(sceneId => !removedSceneIds.Contains(sceneId))
            .ToHashSet();

        if (remainingSelection.Count > 0)
        {
            Guid primarySceneId = SelectedSceneId.HasValue && remainingSelection.Contains(SelectedSceneId.Value)
                ? SelectedSceneId.Value
                : remainingSelection.First();
            return new StoryboardSelectionChange(primarySceneId, remainingSelection.ToArray());
        }

        Guid nextSceneId = BuildAllSceneCards()
            .Select(scene => scene.SceneId)
            .FirstOrDefault();
        return nextSceneId != Guid.Empty
            ? new StoryboardSelectionChange(nextSceneId, [nextSceneId])
            : new StoryboardSelectionChange(null, Array.Empty<Guid>());
    }

    private HashSet<Guid> GetNodeTreeIds(Guid nodeId)
    {
        HashSet<Guid> idsToRemove = [nodeId];
        bool added;
        do
        {
            added = false;
            foreach (ProjectNodeDto node in _renderNodes)
            {
                if (node.ParentId.HasValue && idsToRemove.Contains(node.ParentId.Value) && idsToRemove.Add(node.Id))
                {
                    added = true;
                }
            }
        }
        while (added);

        return idsToRemove;
    }

    private void RemoveRenderNodeTree(Guid nodeId)
    {
        HashSet<Guid> idsToRemove = GetNodeTreeIds(nodeId);
        _renderNodes.RemoveAll(node => idsToRemove.Contains(node.Id));
    }

