    private string GetSceneAccentClass(StoryboardSceneCard scene)
    {
        return _colorMode switch
        {
            StoryboardColorMode.Pov => GetPaletteAccentClass(scene.Pov),
            StoryboardColorMode.Subplot => GetPaletteAccentClass(scene.SubplotTags.FirstOrDefault()),
            StoryboardColorMode.Status => GetStatusAccentClass(scene.Status),
            _ => "scene-card--accent-none"
        };
    }

    private static string GetStatusAccentClass(string? status)
    {
        string normalized = status?.Trim().ToLowerInvariant() ?? string.Empty;
        return normalized switch
        {
            "idea" => "scene-card--accent-status-idea",
            "draft" => "scene-card--accent-status-draft",
            "revised" => "scene-card--accent-status-revised",
            "final" => "scene-card--accent-status-final",
            _ => "scene-card--accent-none"
        };
    }

    private static string GetPaletteAccentClass(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "scene-card--accent-none";
        }

        int hash = 17;
        foreach (char character in value.Trim().ToLowerInvariant())
        {
            hash = (hash * 31) + character;
        }

        int index = ((hash & int.MaxValue) % 8) + 1;
        return $"scene-card--accent-{index}";
    }

