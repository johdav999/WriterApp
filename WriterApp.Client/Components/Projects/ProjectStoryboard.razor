    private async Task AddSceneAsync(Guid chapterId)
    {
        if (Project is null || _moveInFlight || _addingSceneChapterId == chapterId)
        {
            return;
        }

        _addingSceneChapterId = chapterId;
        _storyboardError = null;

        try
        {
            ProjectNodeCreateRequest request = new(
                chapterId,
                "scene",
                "New scene",
                null,
                null,
                "{\"status\":\"Draft\"}");

            using HttpResponseMessage response = await Http.PostAsJsonAsync(
                $"api/projects/{Project.Id}/nodes",
                request);
            if (!response.IsSuccessStatusCode)
            {
                throw new InvalidOperationException(await ReadApiErrorAsync(response, "Add scene failed."));
            }

            ProjectNodeDto? created = await response.Content.ReadFromJsonAsync<ProjectNodeDto>();
            if (created is not null)
            {
                ProjectNodeDto createdNode = created with
                {
                    Title = string.IsNullOrWhiteSpace(created.Title) ? "New scene" : created.Title,
                    MetadataJson = string.IsNullOrWhiteSpace(created.MetadataJson) ? request.MetadataJson : created.MetadataJson
                };

                InsertOrUpdateRenderNode(createdNode);
                _highlightedSceneId = createdNode.Id;
                _pendingScrollSceneId = createdNode.Id;
                await InvokeAsync(StateHasChanged);

                await SelectSceneAsync(createdNode.Id);
            }

            if (OnStructureChanged.HasDelegate)
            {
                await OnStructureChanged.InvokeAsync();
            }
        }
        catch (Exception ex)
        {
            _storyboardError = ex.Message;
        }
        finally
        {
            _addingSceneChapterId = null;
        }
    }

