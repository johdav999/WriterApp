    private void OnSceneDragStart(Guid sceneId, DragEventArgs args)
    {
        if (_moveInFlight)
        {
            LogDnd($"dragstart blocked scene={sceneId} moveInFlight=true");
            return;
        }

        _dragSceneId = sceneId;
        _storyboardError = null;
        LogDnd(
            $"dragstart scene={sceneId} hasDataTransfer={args.DataTransfer is not null} effectAllowed={args.DataTransfer?.EffectAllowed ?? "<null>"} dropEffect={args.DataTransfer?.DropEffect ?? "<null>"}");
        if (args.DataTransfer is not null)
        {
            args.DataTransfer.DropEffect = "move";
            args.DataTransfer.EffectAllowed = "move";
        }
    }

    private void OnSceneDragEnd()
    {
        LogDnd($"dragend scene={_dragSceneId?.ToString() ?? "<null>"} dropChapter={_dropChapterId?.ToString() ?? "<null>"} beforeScene={_dropBeforeSceneId?.ToString() ?? "<null>"}");
        ClearDropState();
    }

    private void OnColumnDragOver(Guid chapterId, Guid? beforeSceneId, DragEventArgs args)
    {
        if (_moveInFlight || !_dragSceneId.HasValue)
        {
            LogDnd($"dragover ignored chapter={chapterId} beforeScene={beforeSceneId?.ToString() ?? "<null>"} moveInFlight={_moveInFlight} activeDrag={_dragSceneId?.ToString() ?? "<null>"}");
            return;
        }

        if (args.DataTransfer is not null)
        {
            args.DataTransfer.DropEffect = "move";
        }

        _dropChapterId = chapterId;
        _dropBeforeSceneId = beforeSceneId;
        LogDnd($"dragover chapter={chapterId} beforeScene={beforeSceneId?.ToString() ?? "<null>"} dragScene={_dragSceneId.Value}");
    }

    private async Task OnColumnDropAsync(Guid chapterId, Guid? beforeSceneId, DragEventArgs _)
    {
        if (_moveInFlight || Project is null || !_dragSceneId.HasValue)
        {
            LogDnd($"drop ignored chapter={chapterId} beforeScene={beforeSceneId?.ToString() ?? "<null>"} moveInFlight={_moveInFlight} projectPresent={Project is not null} dragScene={_dragSceneId?.ToString() ?? "<null>"}");
            return;
        }

        ProjectNodeDto? dragged = _renderNodes.FirstOrDefault(node => node.Id == _dragSceneId.Value);
        if (dragged is null || !IsScene(dragged))
        {
            LogDnd($"drop aborted chapter={chapterId} beforeScene={beforeSceneId?.ToString() ?? "<null>"} draggedFound={dragged is not null}");
            ClearDropState();
            return;
        }

        if (dragged.ParentId == chapterId && beforeSceneId == dragged.Id)
        {
            LogDnd($"drop no-op chapter={chapterId} beforeScene={beforeSceneId?.ToString() ?? "<null>"} scene={dragged.Id}");
            ClearDropState();
            return;
        }

        _moveInFlight = true;
        _storyboardError = null;
        LogDnd($"drop begin scene={dragged.Id} fromChapter={dragged.ParentId?.ToString() ?? "<null>"} toChapter={chapterId} beforeScene={beforeSceneId?.ToString() ?? "<null>"}");

        List<ProjectNodeDto> renderSnapshot = _renderNodes.ToList();

        try
        {
            Dictionary<Guid, List<ProjectNodeDto>> byParent = _renderNodes
                .Where(node => node.ParentId.HasValue)
                .GroupBy(node => node.ParentId!.Value)
                .ToDictionary(
                    group => group.Key,
                    group => group.OrderBy(node => node.OrderIndex).ToList());

            List<ProjectNodeDto> destinationScenes = GetChildren(chapterId, byParent)
                .Where(IsScene)
                .ToList();

            ApplyOptimisticDrop(dragged, chapterId, beforeSceneId);
            await InvokeAsync(StateHasChanged);

            if (dragged.ParentId == chapterId)
            {
                List<Guid> order = BuildDestinationOrder(destinationScenes, dragged.Id, beforeSceneId);
                List<Guid> current = destinationScenes.Select(scene => scene.Id).ToList();
                if (!current.SequenceEqual(order))
                {
                    LogDnd($"drop reorder chapter={chapterId} order={string.Join(",", order)}");
                    await SaveSiblingOrderAsync(chapterId, order);
                }
                else
                {
                    LogDnd($"drop reorder skipped chapter={chapterId} reason=no-change");
                }
            }
            else
            {
                LogDnd($"drop move scene={dragged.Id} targetChapter={chapterId}");
                await MoveSceneToChapterAsync(dragged, chapterId);
                List<Guid> order = BuildDestinationOrder(destinationScenes, dragged.Id, beforeSceneId);
                LogDnd($"drop reorder after move chapter={chapterId} order={string.Join(",", order)}");
                await SaveSiblingOrderAsync(chapterId, order);
            }

            if (OnStructureChanged.HasDelegate)
            {
                LogDnd("drop refresh begin");
                await OnStructureChanged.InvokeAsync();
                LogDnd("drop refresh complete");
            }
        }
        catch (Exception ex)
        {
            _renderNodes = renderSnapshot;
            await InvokeAsync(StateHasChanged);
            LogDnd($"drop failed chapter={chapterId} scene={dragged.Id} error={ex.Message}");
            _storyboardError = ex.Message;
        }
        finally
        {
            _moveInFlight = false;
            ClearDropState();
        }
    }

    private async Task MoveSceneToChapterAsync(ProjectNodeDto scene, Guid chapterId)
    {
        if (Project is null)
        {
            return;
        }

        ProjectNodePatchRequest patch = new(
            scene.Title,
            chapterId,
            scene.LinkedSectionId,
            scene.MetadataJson,
            scene.NodeType);

        using HttpResponseMessage response = await Http.PatchAsJsonAsync(
            $"api/projects/{Project.Id}/nodes/{scene.Id}",
            patch);
        if (!response.IsSuccessStatusCode)
        {
            LogDnd($"move patch failed scene={scene.Id} chapter={chapterId} status={(int)response.StatusCode}");
            throw new InvalidOperationException(await ReadApiErrorAsync(response, "Move scene failed."));
        }

        LogDnd($"move patch succeeded scene={scene.Id} chapter={chapterId}");
    }

    private async Task SaveSiblingOrderAsync(Guid chapterId, IReadOnlyList<Guid> orderedChildIds)
    {
        if (Project is null)
        {
            return;
        }

        ProjectNodeReorderRequest request = new(orderedChildIds);
        using HttpResponseMessage response = await Http.PostAsJsonAsync(
            $"api/projects/{Project.Id}/nodes/{chapterId}/reorder",
            request);
        if (!response.IsSuccessStatusCode)
        {
            LogDnd($"reorder failed chapter={chapterId} status={(int)response.StatusCode}");
            throw new InvalidOperationException(await ReadApiErrorAsync(response, "Reorder scenes failed."));
        }

        LogDnd($"reorder succeeded chapter={chapterId} count={orderedChildIds.Count}");
    }

    private static List<Guid> BuildDestinationOrder(
        IReadOnlyList<ProjectNodeDto> destinationScenes,
        Guid draggedSceneId,
        Guid? beforeSceneId)
    {
        List<Guid> order = destinationScenes
            .Select(scene => scene.Id)
            .Where(id => id != draggedSceneId)
            .ToList();

        int insertIndex = beforeSceneId.HasValue
            ? order.IndexOf(beforeSceneId.Value)
            : -1;

        if (insertIndex < 0)
        {
            order.Add(draggedSceneId);
        }
        else
        {
            order.Insert(insertIndex, draggedSceneId);
        }

        return order;
    }

    private void ApplyOptimisticDrop(ProjectNodeDto dragged, Guid chapterId, Guid? beforeSceneId)
    {
        if (_renderNodes.Count == 0)
        {
            return;
        }

        List<ProjectNodeDto> nextNodes = _renderNodes.ToList();
        int draggedIndex = nextNodes.FindIndex(node => node.Id == dragged.Id);
        if (draggedIndex < 0)
        {
            return;
        }

        nextNodes[draggedIndex] = nextNodes[draggedIndex] with
        {
            ParentId = chapterId,
            UpdatedUtc = DateTimeOffset.UtcNow
        };

        List<ProjectNodeDto> chapterScenes = nextNodes
            .Where(node => node.ParentId == chapterId && IsScene(node))
            .OrderBy(node => node.OrderIndex)
            .Where(node => node.Id != dragged.Id)
            .ToList();

        int insertIndex = beforeSceneId.HasValue
            ? chapterScenes.FindIndex(node => node.Id == beforeSceneId.Value)
            : -1;

        if (insertIndex < 0)
        {
            chapterScenes.Add(nextNodes[draggedIndex]);
        }
        else
        {
            chapterScenes.Insert(insertIndex, nextNodes[draggedIndex]);
        }

        for (int index = 0; index < chapterScenes.Count; index++)
        {
            ProjectNodeDto scene = chapterScenes[index];
            int sceneIndex = nextNodes.FindIndex(node => node.Id == scene.Id);
            if (sceneIndex < 0)
            {
                continue;
            }

            nextNodes[sceneIndex] = nextNodes[sceneIndex] with { OrderIndex = index };
        }

        _renderNodes = nextNodes
            .OrderBy(node => node.ParentId)
            .ThenBy(node => node.OrderIndex)
            .ToList();
    }

    private static async Task<string> ReadApiErrorAsync(HttpResponseMessage response, string fallback)
    {
        try
        {
            string payload = await response.Content.ReadAsStringAsync();
            return string.IsNullOrWhiteSpace(payload) ? fallback : payload;
        }
        catch
        {
            return fallback;
        }
    }

