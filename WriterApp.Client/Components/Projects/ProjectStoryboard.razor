    private async Task AddChapterAsync(Guid? parentPartId)
    {
        if (Project is null || _addingChapterInFlight)
        {
            return;
        }

        _addingChapterInFlight = true;
        _storyboardError = null;
        _openChapterMenuId = null;

        int orderIndex = GetNextOrderIndex(parentPartId);
        Guid temporaryId = Guid.NewGuid();
        ProjectNodeDto temporaryChapter = new(
            temporaryId,
            Project.Id,
            parentPartId,
            "chapter",
            "New Chapter",
            orderIndex,
            null,
            null,
            0,
            DateTimeOffset.UtcNow);

        InsertOrUpdateRenderNode(temporaryChapter);
        _pendingScrollChapterId = temporaryId;
        await InvokeAsync(StateHasChanged);

        try
        {
            ProjectNodeCreateRequest request = new(
                parentPartId,
                "chapter",
                "New Chapter",
                orderIndex,
                null,
                null);

            using HttpResponseMessage response = await Http.PostAsJsonAsync(
                $"api/projects/{Project.Id}/nodes",
                request);
            if (!response.IsSuccessStatusCode)
            {
                throw new InvalidOperationException(await ReadApiErrorAsync(response, "Add chapter failed."));
            }

            ProjectNodeDto? created = await response.Content.ReadFromJsonAsync<ProjectNodeDto>();
            if (created is null)
            {
                throw new InvalidOperationException("Add chapter failed.");
            }

            _renderNodes.RemoveAll(node => node.Id == temporaryId);
            InsertOrUpdateRenderNode(created);
            _pendingScrollChapterId = created.Id;

            if (OnStructureChanged.HasDelegate)
            {
                await OnStructureChanged.InvokeAsync();
            }

            await StartChapterRenameAsync(created);
        }
        catch (Exception ex)
        {
            _renderNodes.RemoveAll(node => node.Id == temporaryId);
            _storyboardError = ex.Message;
            await InvokeAsync(StateHasChanged);
        }
        finally
        {
            _addingChapterInFlight = false;
        }
    }

    private async Task AddSceneAsync(Guid chapterId)
    {
        if (_addingSceneChapterId == chapterId)
        {
            return;
        }

        _addingSceneChapterId = chapterId;
        _storyboardError = null;

        try
        {
            await CreateSceneInChapterAsync(chapterId, new StoryboardSceneSeed(
                "New scene",
                null,
                "Draft",
                null,
                Array.Empty<string>(),
                null,
                null,
                null));
        }
        catch (Exception ex)
        {
            _storyboardError = ex.Message;
        }
        finally
        {
            _addingSceneChapterId = null;
        }
    }

    public async Task<bool> CreateSuggestedSceneAsync(StoryboardNextSceneSuggestion suggestion)
    {
        if (Project is null || suggestion is null || _moveInFlight)
        {
            return false;
        }

        Guid? chapterId = GetPreferredChapterForSceneCreation(suggestion.PreferredChapterTitle);
        if (!chapterId.HasValue)
        {
            _storyboardError = "No chapter is available for the suggested scene.";
            return false;
        }

        try
        {
            StoryboardSceneSeed seed = new(
                string.IsNullOrWhiteSpace(suggestion.Title) ? "New scene" : suggestion.Title.Trim(),
                suggestion.Summary,
                string.IsNullOrWhiteSpace(suggestion.Status) ? "Draft" : suggestion.Status.Trim(),
                suggestion.PovCharacterId,
                suggestion.SubplotTags ?? Array.Empty<string>(),
                suggestion.NarrativePurpose,
                suggestion.NarrativeRole,
                suggestion.NarrativeIntent);

            return await CreateSceneInChapterAsync(chapterId.Value, seed);
        }
        catch (Exception ex)
        {
            _storyboardError = ex.Message;
            return false;
        }
    }

