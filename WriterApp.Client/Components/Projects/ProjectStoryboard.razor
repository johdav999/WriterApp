    private async Task ConfirmDeleteSceneAsync()
    {
        if (Project is null || !_pendingDeleteSceneId.HasValue || _deleteSceneInFlight)
        {
            return;
        }

        Guid sceneId = _pendingDeleteSceneId.Value;
        Guid? previousSelectedSceneId = SelectedSceneId;

        _deleteSceneInFlight = true;
        _deleteSceneError = null;
        _storyboardError = null;

        try
        {
            Logger.LogInformation(
                "Storyboard delete start. ProjectId={ProjectId} SceneId={SceneId}",
                Project.Id,
                sceneId);

            using HttpResponseMessage response = await Http.DeleteAsync($"api/projects/{Project.Id}/nodes/{sceneId}");
            if (!response.IsSuccessStatusCode)
            {
                throw new InvalidOperationException(await ReadApiErrorAsync(response, "Delete scene failed."));
            }

            if (SelectedSceneId == sceneId && OnSelectionChanged.HasDelegate)
            {
                await OnSelectionChanged.InvokeAsync(new StoryboardSelectionChange(null, Array.Empty<Guid>()));
            }

            (StoryboardSelectionChange nextSelection, Guid? nextSceneId) = RemoveSceneAndReselect(sceneId);

            _pendingDeleteSceneId = null;
            _pendingDeleteSceneTitle = null;
            _deleteSceneError = null;

            if (OnStructureChanged.HasDelegate)
            {
                await OnStructureChanged.InvokeAsync();
            }

            if (OnSelectionChanged.HasDelegate)
            {
                await OnSelectionChanged.InvokeAsync(nextSelection);
            }

            await InvokeAsync(StateHasChanged);

            Logger.LogInformation(
                "Storyboard delete local sync applied. ProjectId={ProjectId} SceneId={SceneId} PreviousSelectionId={PreviousSelectionId} NextSelectionId={NextSelectionId} RefreshMode={RefreshMode}",
                Project.Id,
                sceneId,
                previousSelectedSceneId,
                nextSceneId,
                "local-sync");
        }
        catch (Exception ex)
        {
            Logger.LogWarning(
                ex,
                "Storyboard delete failed. ProjectId={ProjectId} SceneId={SceneId}",
                Project.Id,
                sceneId);
            _deleteSceneError = ex.Message;
        }
        finally
        {
            _deleteSceneInFlight = false;
        }
    }

    private async Task ConfirmDeleteChapterAsync()
    {
        if (Project is null || !_pendingDeleteChapterId.HasValue || _deleteChapterInFlight)
        {
            return;
        }

        Guid chapterId = _pendingDeleteChapterId.Value;
        List<ProjectNodeDto> snapshot = _renderNodes.ToList();
        StoryboardSelectionChange previousSelection = new(SelectedSceneId, SelectedSceneIds.ToArray());
        HashSet<Guid> removedSceneIds = GetSceneIdsInNodeTree(chapterId);

        _deleteChapterInFlight = true;
        _deleteChapterError = null;
        _storyboardError = null;

        try
        {
            RemoveRenderNodeTree(chapterId);
            StoryboardSelectionChange nextSelection = BuildSelectionAfterRemovedScenes(removedSceneIds);
            _pendingDeleteChapterId = null;
            _pendingDeleteChapterTitle = null;

            if (_editingChapterId == chapterId)
            {
                CancelChapterRename();
            }

            if (OnSelectionChanged.HasDelegate)
            {
                await OnSelectionChanged.InvokeAsync(nextSelection);
            }

            await InvokeAsync(StateHasChanged);

            using HttpResponseMessage response = await Http.DeleteAsync($"api/projects/{Project.Id}/nodes/{chapterId}");
            if (!response.IsSuccessStatusCode)
            {
                throw new InvalidOperationException(await ReadApiErrorAsync(response, "Delete chapter failed."));
            }

            if (OnStructureChanged.HasDelegate)
            {
                await OnStructureChanged.InvokeAsync();
            }
        }
        catch (Exception ex)
        {
            _deleteChapterError = ex.Message;
            _storyboardError = ex.Message;
            _renderNodes = snapshot;
            _pendingDeleteChapterId = chapterId;
            _pendingDeleteChapterTitle = GetChapterDisplayTitle(snapshot.FirstOrDefault(node => node.Id == chapterId)?.Title);

            if (OnSelectionChanged.HasDelegate)
            {
                await OnSelectionChanged.InvokeAsync(previousSelection);
            }

            await InvokeAsync(StateHasChanged);
        }
        finally
        {
            _deleteChapterInFlight = false;
        }
    }

