    private sealed record StoryboardChapterColumn(
        ProjectNodeDto Chapter,
        string? PartTitle,
        List<StoryboardSceneCard> Scenes)
    {
        public int DraftSceneCount => Scenes.Count(scene => IsDraftStatus(scene.Status));

        public string? DominantPov => Scenes
            .Select(scene => scene.Pov?.Trim())
            .Where(pov => !string.IsNullOrWhiteSpace(pov))
            .GroupBy(pov => pov!, StringComparer.OrdinalIgnoreCase)
            .OrderByDescending(group => group.Count())
            .ThenBy(group => group.Key, StringComparer.OrdinalIgnoreCase)
            .Select(group => group.Key)
            .FirstOrDefault();
    }

    private StoryboardCoachSummary BuildCoachSummary()
    {
        IReadOnlyList<StoryboardChapterColumn> columns = ChapterColumns;
        int totalChapters = columns.Count;
        int totalScenes = columns.Sum(column => column.Scenes.Count);
        double averageScenes = totalChapters == 0 ? 0 : (double)totalScenes / totalChapters;
        List<string> observations = new();

        foreach (StoryboardChapterColumn column in columns.Where(column => column.Scenes.Count == 0))
        {
            observations.Add($"{column.Chapter.Title} has no scenes.");
        }

        if (averageScenes > 0)
        {
            foreach (StoryboardChapterColumn column in columns.Where(column => column.Scenes.Count >= Math.Max(6, Math.Ceiling(averageScenes * 1.75))))
            {
                observations.Add($"{column.Chapter.Title} contains {column.Scenes.Count} scenes, well above the project average of {averageScenes:0.#}.");
            }
        }

        List<StoryboardSceneCard> genericTitles = columns
            .SelectMany(column => column.Scenes)
            .Where(scene => IsGenericSceneTitle(scene.Title))
            .ToList();
        if (genericTitles.Count > 0)
        {
            observations.Add($"{genericTitles.Count} scene title{(genericTitles.Count == 1 ? " is" : "s are")} still generic or very short.");
        }

        int maxScenes = columns.Count == 0 ? 0 : columns.Max(column => column.Scenes.Count);
        int minScenes = columns.Count == 0 ? 0 : columns.Min(column => column.Scenes.Count);
        if (totalChapters >= 3 && maxScenes - minScenes >= 4)
        {
            observations.Add("Scene distribution is uneven across chapters.");
        }

        return new StoryboardCoachSummary(totalChapters, totalScenes, observations);
    }

    private static bool IsGenericSceneTitle(string? title)
    {
        if (string.IsNullOrWhiteSpace(title))
        {
            return true;
        }

        string normalized = title.Trim();
        if (normalized.Length <= 4)
        {
            return true;
        }

        return normalized.StartsWith("scene", StringComparison.OrdinalIgnoreCase)
            || normalized.StartsWith("new scene", StringComparison.OrdinalIgnoreCase)
            || normalized.StartsWith("untitled", StringComparison.OrdinalIgnoreCase);
    }

