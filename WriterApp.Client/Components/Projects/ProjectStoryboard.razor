    }

    private async Task AddBulkSubplotTagAsync()
    {
        string? tag = NormalizeOptionalValue(_bulkSubplotTagDraft);
        if (string.IsNullOrWhiteSpace(tag))
        {
            return;
        }

        await ApplyBulkSceneCardUpdateAsync(
            subplotTagTransform: tags => tags
                .Append(tag)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToArray(),
            errorFallback: "Bulk subplot tag update failed.");

        _bulkSubplotTagDraft = string.Empty;
    }

    private async Task RemoveBulkSubplotTagAsync(ChangeEventArgs args)
    {
        string? tagToRemove = NormalizeOptionalValue(args.Value?.ToString());
        if (string.IsNullOrWhiteSpace(tagToRemove))
        {
            return;
        }

        await ApplyBulkSceneCardUpdateAsync(
            subplotTagTransform: tags => tags
                .Where(tag => !string.Equals(tag, tagToRemove, StringComparison.OrdinalIgnoreCase))
                .ToArray(),
            errorFallback: "Bulk subplot tag removal failed.");
    }

    private async Task ApplyBulkSceneCardUpdateAsync(
        string? status = null,
        string? narrativePurpose = null,
        string? narrativeRole = null,
        string? narrativeIntent = null,
        Func<IReadOnlyList<string>, IReadOnlyList<string>>? subplotTagTransform = null,
        string errorFallback = "Bulk scene update failed.")
    {
        if (Project is null)
        {
            return;
        }

        IReadOnlyList<ProjectNodeDto> selectedNodes = GetSelectedSceneNodes();
        if (selectedNodes.Count == 0)
        {
            return;
        }

        _storyboardError = null;
        List<ProjectNodeDto> snapshot = _renderNodes.ToList();
        Dictionary<Guid, string?> metadataBySceneId = new();

        foreach (ProjectNodeDto node in selectedNodes)
        {
            SceneMetadata metadata = TryGetSceneMetadata(node);
            IReadOnlyList<string>? subplotTags = subplotTagTransform is null
                ? null
                : NormalizeTags(subplotTagTransform(metadata.SubplotTags));
            string metadataJson = UpdateSceneMetadata(
                node.MetadataJson,
                status: status,
                pov: metadata.Pov,
                subplotTags: subplotTags,
                narrativePurpose: narrativePurpose,
                narrativeRole: narrativeRole,
                narrativeIntent: narrativeIntent);
            metadataBySceneId[node.Id] = metadataJson;
            InsertOrUpdateRenderNode(node with
            {
                MetadataJson = metadataJson,
                UpdatedUtc = DateTimeOffset.UtcNow
            });
        }

        foreach (ProjectNodeDto node in selectedNodes)
        {
            try
            {
                SceneCardDto? currentCard = await Http.GetFromJsonAsync<SceneCardDto>($"api/scenes/{node.Id}/scene-card");
                IReadOnlyList<string> nextSubplotTags = subplotTagTransform is null
                    ? currentCard?.SubplotTags ?? Array.Empty<string>()
                    : NormalizeTags(subplotTagTransform(currentCard?.SubplotTags ?? Array.Empty<string>()));
                SceneCardUpdateRequest payload = new(
                    narrativePurpose ?? currentCard?.NarrativePurpose,
                    currentCard?.EmotionalBeat,
                    currentCard?.KeyEvents,
                    currentCard?.OpenQuestions,
                    currentCard?.PovCharacterId,
                    currentCard?.PlaceId,
                    currentCard?.TimelineEventId,
                    currentCard?.TimeRef,
                    currentCard?.Tags ?? Array.Empty<string>(),
                    currentCard?.References ?? Array.Empty<SceneCardReferenceDto>(),
                    currentCard?.Summary,
                    status ?? NormalizeStatus(currentCard?.Status),
                    nextSubplotTags,
                    narrativeRole ?? currentCard?.NarrativeRole,
                    narrativeIntent ?? currentCard?.NarrativeIntent);

                using HttpResponseMessage sceneCardResponse =
                    await Http.PutAsJsonAsync($"api/scenes/{node.Id}/scene-card", payload);
                if (!sceneCardResponse.IsSuccessStatusCode)
                {
                    throw new InvalidOperationException(await ReadApiErrorAsync(sceneCardResponse, errorFallback));
                }

                using HttpResponseMessage nodeResponse = await Http.PatchAsJsonAsync(
                    $"api/projects/{Project.Id}/nodes/{node.Id}",
                    new ProjectNodePatchRequest(
                        node.Title,
                        node.ParentId,
                        node.LinkedSectionId,
                        metadataBySceneId[node.Id],
                        node.NodeType));
                if (!nodeResponse.IsSuccessStatusCode)
                {
                    throw new InvalidOperationException(await ReadApiErrorAsync(nodeResponse, errorFallback));
                }

                ProjectNodeDto updatedNode = _renderNodes.First(existing => existing.Id == node.Id);
                await NotifySceneUpdatedAsync(updatedNode);
            }
            catch (Exception ex)
            {
                _storyboardError = ex.Message;
                _renderNodes = snapshot;
                await InvokeAsync(StateHasChanged);
                return;
            }
        }

        await InvokeAsync(StateHasChanged);
    }

