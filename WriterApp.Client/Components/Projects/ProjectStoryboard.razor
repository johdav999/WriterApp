@using System.Text.Json
@using System.Text.Json.Nodes
@using WriterApp.Application.Documents
@using WriterApp.Application.Subscriptions
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Web
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ILogger<ProjectStoryboard> Logger
@inject IJSRuntime JS

<section class="project-storyboard" aria-label="Storyboard">
    @if (!string.IsNullOrWhiteSpace(_storyboardError))
    {
        <div class="project-storyboard-error">@_storyboardError</div>
    }

    <div class="project-storyboard-main">
            <div class="project-storyboard-toolbar">
                <div class="project-storyboard-board-meta">
                    <span>@ChapterColumns.Count chapter@(ChapterColumns.Count == 1 ? string.Empty : "s")</span>
                    <span>Scroll horizontally to move across the manuscript.</span>
                    @if (SelectedSceneIds.Count > 0)
                    {
                        <span class="project-storyboard-selection-count">@SelectedSceneIds.Count selected</span>
                    }
                    <div class="project-storyboard-filters">
                        <button type="button"
                                class="project-storyboard-filters-trigger"
                                aria-expanded="@_filtersOpen"
                                aria-controls="storyboard-filters-panel"
                                @onclick="ToggleFilters">
                            <span>Filters</span>
                            @if (ActiveFilterCount > 0)
                            {
                                <span class="project-storyboard-filters-trigger__count">@ActiveFilterCount</span>
                            }
                        </button>

                        @if (ActiveFilterSummaries.Count > 0)
                        {
                            <div class="project-storyboard-filter-chips" aria-label="Active filters">
                                @foreach (string summary in ActiveFilterSummaries)
                                {
                                    <span class="project-storyboard-filter-chip">@summary</span>
                                }
                            </div>
                        }

                        @if (_filtersOpen)
                        {
                            <div id="storyboard-filters-panel"
                                 class="project-storyboard-filters-panel"
                                 @onclick:stopPropagation="true">
                                <div class="project-storyboard-filters-panel__header">
                                    <strong>Filter storyboard</strong>
                                    @if (ActiveFilterCount > 0)
                                    {
                                        <button type="button"
                                                class="project-storyboard-filters-clear"
                                                @onclick="ClearFilters">
                                            Clear all
                                        </button>
                                    }
                                </div>

                                <div class="project-storyboard-filters-grid">
                                    <label class="project-storyboard-filter" for="storyboard-filter-pov">
                                        <span>POV</span>
                                        <select id="storyboard-filter-pov"
                                                class="project-storyboard-filter-select"
                                                value="@_povFilter"
                                                @onchange="OnPovFilterChanged">
                                            <option value="">All</option>
                                            @foreach (string option in PovFilterOptions)
                                            {
                                                <option value="@option">@option</option>
                                            }
                                        </select>
                                    </label>

                                    <label class="project-storyboard-filter" for="storyboard-filter-status">
                                        <span>Status</span>
                                        <select id="storyboard-filter-status"
                                                class="project-storyboard-filter-select"
                                                value="@_statusFilter"
                                                @onchange="OnStatusFilterChanged">
                                            <option value="">All</option>
                                            @foreach (string option in StatusFilterOptions)
                                            {
                                                <option value="@option">@option</option>
                                            }
                                        </select>
                                    </label>

                                    <label class="project-storyboard-filter" for="storyboard-filter-subplot">
                                        <span>Subplot</span>
                                        <select id="storyboard-filter-subplot"
                                                class="project-storyboard-filter-select"
                                                value="@_subplotFilter"
                                                @onchange="OnSubplotFilterChanged">
                                            <option value="">All</option>
                                            @foreach (string option in SubplotFilterOptions)
                                            {
                                                <option value="@option">@option</option>
                                            }
                                        </select>
                                    </label>

                                    <label class="project-storyboard-color-mode" for="storyboard-color-mode">
                                        <span>Color by</span>
                                        <select id="storyboard-color-mode"
                                                class="project-storyboard-color-mode-select"
                                                value="@_colorMode"
                                                @onchange="OnColorModeChanged">
                                            <option value="@StoryboardColorMode.None">None</option>
                                            <option value="@StoryboardColorMode.Pov">POV</option>
                                            <option value="@StoryboardColorMode.Subplot">Subplot</option>
                                            <option value="@StoryboardColorMode.Status">Status</option>
                                        </select>
                                    </label>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                @if (SelectedSceneIds.Count >= 2)
                {
                    <div class="project-storyboard-bulk-bar" @onclick:stopPropagation="true">
                        <div class="project-storyboard-bulk-bar__title">@SelectedSceneIds.Count scenes selected</div>
                        <label class="project-storyboard-bulk-field" for="storyboard-bulk-status">
                            <span>Status</span>
                            <select id="storyboard-bulk-status"
                                    class="project-storyboard-bulk-select"
                                    value=""
                                    @onchange="ApplyBulkStatusAsync">
                                <option value="">@BulkStatusPlaceholder</option>
                                @foreach (string option in BulkStatusOptions)
                                {
                                    <option value="@option">@option</option>
                                }
                            </select>
                        </label>
                        <label class="project-storyboard-bulk-field" for="storyboard-bulk-purpose">
                            <span>Role</span>
                            <select id="storyboard-bulk-purpose"
                                    class="project-storyboard-bulk-select"
                                    value=""
                                    @onchange="ApplyBulkNarrativeRoleAsync">
                                <option value="">@BulkNarrativeRolePlaceholder</option>
                                @foreach (string option in BulkNarrativeRoleOptions)
                                {
                                    <option value="@option">@option</option>
                                }
                            </select>
                        </label>
                        <label class="project-storyboard-bulk-field project-storyboard-bulk-field--wide" for="storyboard-bulk-tag-add">
                            <span>Add subplot tag</span>
                            <div class="project-storyboard-bulk-input-group">
                                <input id="storyboard-bulk-tag-add"
                                       class="project-storyboard-bulk-input"
                                       value="@_bulkSubplotTagDraft"
                                       @oninput="OnBulkSubplotTagDraftChanged"
                                       @onkeydown="HandleBulkSubplotTagKeyDownAsync"
                                       placeholder="Add tag to selected scenes" />
                                <button type="button"
                                        class="project-storyboard-bulk-button"
                                        @onclick="AddBulkSubplotTagAsync">
                                    Add
                                </button>
                            </div>
                        </label>
                        <label class="project-storyboard-bulk-field" for="storyboard-bulk-tag-remove">
                            <span>Remove subplot tag</span>
                            <select id="storyboard-bulk-tag-remove"
                                    class="project-storyboard-bulk-select"
                                    value=""
                                    @onchange="RemoveBulkSubplotTagAsync">
                                <option value="">@BulkRemoveTagPlaceholder</option>
                                @foreach (string option in BulkRemovableSubplotTags)
                                {
                                    <option value="@option">@option</option>
                                }
                            </select>
                        </label>
                    </div>
                }
            </div>

            <div class="project-storyboard-board"
                 role="list"
                 aria-label="Storyboard chapter columns"
                 @onclick="HandleBoardBackgroundClickAsync">
                @foreach (StoryboardChapterColumn column in ChapterColumns)
                {
                    <section id="@GetChapterElementId(column.Chapter.Id)"
                             class="storyboard-column"
                             role="listitem"
                             aria-label="@column.Chapter.Title"
                             @onclick:stopPropagation="true">
                        <header class="storyboard-column-header">
                            @if (!string.IsNullOrWhiteSpace(column.PartTitle))
                            {
                                <div class="storyboard-part-label">@column.PartTitle</div>
                            }
                            <div class="storyboard-column-title-row">
                                @if (column.IsPartPlaceholder)
                                {
                                    <h4>@GetChapterDisplayTitle(column.Chapter.Title)</h4>
                                }
                                else if (_editingChapterId == column.Chapter.Id)
                                {
                                    <input class="storyboard-column-title-input"
                                           value="@_chapterTitleDraft"
                                           @ref="_chapterTitleInputRef"
                                           @oninput="OnChapterTitleDraftChanged"
                                           @onkeydown:stopPropagation="true"
                                           @onkeydown="args => HandleChapterTitleKeyDownAsync(column.Chapter, args)"
                                           @onblur="() => CommitChapterTitleEditAsync(column.Chapter)" />
                                }
                                else
                                {
                                    <h4>@GetChapterDisplayTitle(column.Chapter.Title)</h4>
                                }
                                @if (!column.IsPartPlaceholder)
                                {
                                    <div class="storyboard-column-menu" @onclick:stopPropagation="true" @onpointerdown:stopPropagation="true">
                                        <button type="button"
                                                class="storyboard-column-menu-button"
                                                aria-label="Chapter actions"
                                                aria-haspopup="menu"
                                                aria-expanded="@(_openChapterMenuId == column.Chapter.Id)"
                                                @onclick="() => ToggleChapterMenu(column.Chapter.Id)">
                                            <span class="material-symbols-rounded" aria-hidden="true">more_horiz</span>
                                        </button>
                                        @if (_openChapterMenuId == column.Chapter.Id)
                                        {
                                            <div class="storyboard-column-menu-popover" role="menu" aria-label="Chapter actions">
                                                <button type="button"
                                                        class="storyboard-column-menu-item"
                                                        role="menuitem"
                                                        @onpointerdown:stopPropagation="true"
                                                        @onclick="() => StartChapterRenameAsync(column.Chapter)">
                                                    Rename
                                                </button>
                                                <button type="button"
                                                        class="storyboard-column-menu-item storyboard-column-menu-item--danger"
                                                        role="menuitem"
                                                        @onpointerdown:stopPropagation="true"
                                                        @onclick="() => PromptDeleteChapter(column.Chapter.Id)">
                                                    Delete chapter
                                                </button>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                            <div class="storyboard-column-toolbar">
                                <div class="storyboard-column-meta">
                                    @(column.IsPartPlaceholder ? "0 chapters" : $"{column.Scenes.Count} scene{(column.Scenes.Count == 1 ? string.Empty : "s")}")
                                </div>
                                @if (!column.IsPartPlaceholder)
                                {
                                    <div class="storyboard-column-insights">
                                        <span>@column.DraftSceneCount draft@(column.DraftSceneCount == 1 ? string.Empty : "s")</span>
                                        <span>POV: @(string.IsNullOrWhiteSpace(column.DominantPov) ? "Mixed" : column.DominantPov)</span>
                                    </div>
                                }
                                <div class="storyboard-column-actions">
                                    <button type="button"
                                            class="storyboard-column-action"
                                            @onclick="() => OpenChapter(column.Chapter.Id)">
                                        Open chapter
                                    </button>
                                </div>
                            </div>
                        </header>

                        <div class="storyboard-column-body" @onclick="ClearSelectionAsync">
                            @if (column.IsPartPlaceholder)
                            {
                                <div class="storyboard-scene-empty">No chapters in this part yet.</div>
                                <div class="storyboard-add-scene-anchor" @onclick:stopPropagation="true">
                                    <PlanGatedButton Feature="@nameof(FeatureKey.ProjectStructureEditing)"
                                                     Class="storyboard-add-scene storyboard-add-scene--chapter"
                                                     LockedTitle="Project structure changes are locked on your current plan."
                                                     AriaLabel="Add chapter"
                                                     ShowLockIndicator="false"
                                                     IsBusy="@_addingChapterInFlight"
                                                     IsActionDisabled="@(_moveInFlight || _deleteChapterInFlight)"
                                                     OnClick="() => AddChapterAsync(column.Chapter.Id)">
                                        <span class="storyboard-add-scene__icon" aria-hidden="true"></span>
                                        <span class="storyboard-add-scene__label">
                                            @(_addingChapterInFlight ? "Adding chapter..." : "Add chapter")
                                        </span>
                                    </PlanGatedButton>
                                </div>
                            }
                            else
                            {
                            <div class="@GetColumnDropClass(column.Chapter.Id, null)"
                                 @ondragover:preventDefault
                                 @ondrop:preventDefault
                                 @ondragover="args => OnColumnDragOver(column.Chapter.Id, null, args)"
                                 @ondrop="args => OnColumnDropAsync(column.Chapter.Id, null, args)">
                                @if (column.Scenes.Count == 0)
                                {
                                    <div class="storyboard-scene-empty">No scenes in this chapter yet.</div>
                                }
                                else
                                {
                                    <div class="@GetGapDropClass(column.Chapter.Id, column.Scenes[0].SceneId)"
                                         @ondragover:preventDefault
                                         @ondrop:preventDefault
                                         @ondragover="args => OnColumnDragOver(column.Chapter.Id, column.Scenes[0].SceneId, args)"
                                         @ondrop="args => OnColumnDropAsync(column.Chapter.Id, column.Scenes[0].SceneId, args)"></div>

                                    @foreach (StoryboardSceneCard scene in column.Scenes)
                                    {
                                        <div id="@GetSceneElementId(scene.SceneId)"
                                             class="@GetSceneDropClass(column.Chapter.Id, scene.SceneId)"
                                             draggable="@(!_moveInFlight)"
                                             @ondragstart="args => OnSceneDragStart(scene.SceneId, args)"
                                             @ondragend="OnSceneDragEnd"
                                             @onclick:stopPropagation="true"
                                             @onclick="args => HandleSceneClickAsync(column.Chapter.Id, scene.SceneId, args)">
                                            <SceneCard SceneId="@scene.SceneId"
                                                       Title="@scene.Title"
                                                       Summary="@scene.Summary"
                                                       WordCount="@scene.WordCount"
                                                       Status="@scene.Status"
                                                       Pov="@scene.Pov"
                                                       SubplotTags="@scene.SubplotTags"
                                                       NarrativePurpose="@scene.NarrativePurpose"
                                                       NarrativeRole="@scene.NarrativeRole"
                                                       NarrativeIntent="@scene.NarrativeIntent"
                                                       AccentClass="@GetSceneAccentClass(scene)"
                                                       IsSelected="@(SelectedSceneIds.Contains(scene.SceneId))"
                                                       HasNotes="@scene.HasNotes"
                                                       UpdatedUtc="@scene.UpdatedUtc"
                                                       DuplicateScene="HandleDuplicateSceneAsync"
                                                       DeleteScene="PromptDeleteScene"
                                                       SaveTitleQuickEdit="HandleSceneTitleQuickEditAsync"
                                                       SaveStatusQuickEdit="HandleSceneStatusQuickEditAsync"
                                                       OpenScene="OpenSceneAsync"
                                                       RevealInNavigator="RevealInNavigator" />
                                        </div>

                                        <div class="@GetGapDropClass(column.Chapter.Id, GetNextSceneId(column.Scenes, scene.SceneId))"
                                             @ondragover:preventDefault
                                             @ondrop:preventDefault
                                             @ondragover="args => OnColumnDragOver(column.Chapter.Id, GetNextSceneId(column.Scenes, scene.SceneId), args)"
                                             @ondrop="args => OnColumnDropAsync(column.Chapter.Id, GetNextSceneId(column.Scenes, scene.SceneId), args)"></div>
                                    }
                                }
                                <div class="storyboard-add-scene-anchor" @onclick:stopPropagation="true">
                                    <PlanGatedButton Feature="@nameof(FeatureKey.ProjectStructureEditing)"
                                                     Class="storyboard-add-scene"
                                                 LockedTitle="Project structure changes are locked on your current plan."
                                                 AriaLabel="Add scene"
                                                 ShowLockIndicator="false"
                                                 IsBusy="@(_addingSceneChapterId == column.Chapter.Id)"
                                                 IsActionDisabled="@(_moveInFlight || _addingChapterInFlight)"
                                                 OnClick="() => AddSceneAsync(column.Chapter.Id)">
                                        <span class="storyboard-add-scene__icon" aria-hidden="true"></span>
                                        <span class="storyboard-add-scene__label">
                                            @(_addingSceneChapterId == column.Chapter.Id ? "Adding scene..." : "Add scene")
                                        </span>
                                    </PlanGatedButton>
                                </div>
                            </div>
                            }
                        </div>
                    </section>
                }

                <section class="storyboard-column storyboard-column--add"
                         role="listitem"
                         aria-label="Add chapter"
                         @onclick:stopPropagation="true">
                    <div class="storyboard-column-add-placeholder">
                        <PlanGatedButton Feature="@nameof(FeatureKey.ProjectStructureEditing)"
                                         Class="storyboard-add-scene storyboard-add-scene--chapter"
                                         LockedTitle="Project structure changes are locked on your current plan."
                                         AriaLabel="Add chapter"
                                         ShowLockIndicator="false"
                                         IsBusy="@_addingChapterInFlight"
                                         IsActionDisabled="@(_moveInFlight || _deleteChapterInFlight)"
                                         OnClick="() => AddChapterAsync(null)">
                            <span class="storyboard-add-scene__icon" aria-hidden="true"></span>
                            <span class="storyboard-add-scene__label">
                                @(_addingChapterInFlight ? "Adding chapter..." : "Add chapter")
                            </span>
                        </PlanGatedButton>
                    </div>
                </section>
            </div>
    </div>
</section>

@if (_pendingDeleteSceneId.HasValue)
{
    <div class="storyboard-modal-overlay" role="presentation">
        <div class="storyboard-modal-backdrop" @onclick="CancelDeleteScene"></div>
        <div class="storyboard-modal" role="dialog" aria-modal="true" aria-labelledby="deleteSceneTitle">
            <div class="storyboard-modal-title" id="deleteSceneTitle">Delete this scene?</div>
            <div class="storyboard-modal-body">
                <p>This cannot be undone.</p>
                @if (!string.IsNullOrWhiteSpace(_pendingDeleteSceneTitle))
                {
                    <div class="storyboard-modal-scene-label">Scene: @_pendingDeleteSceneTitle</div>
                }
            </div>
            @if (!string.IsNullOrWhiteSpace(_deleteSceneError))
            {
                <div class="storyboard-modal-error">@_deleteSceneError</div>
            }
            <div class="storyboard-modal-actions">
                <button type="button"
                        class="storyboard-modal-danger"
                        @onclick="ConfirmDeleteSceneAsync"
                        disabled="@_deleteSceneInFlight">
                    Delete
                </button>
                <button type="button"
                        @onclick="CancelDeleteScene"
                        disabled="@_deleteSceneInFlight">
                    Cancel
                </button>
            </div>
        </div>
    </div>
}

@if (_pendingDeleteChapterId.HasValue)
{
    <div class="storyboard-modal-overlay" role="presentation">
        <div class="storyboard-modal-backdrop" @onclick="CancelDeleteChapter"></div>
        <div class="storyboard-modal" role="dialog" aria-modal="true" aria-labelledby="deleteChapterTitle">
            <div class="storyboard-modal-title" id="deleteChapterTitle">Delete chapter '@_pendingDeleteChapterTitle'?</div>
            <div class="storyboard-modal-body">
                <p>This will also delete all scenes in this chapter.</p>
            </div>
            @if (!string.IsNullOrWhiteSpace(_deleteChapterError))
            {
                <div class="storyboard-modal-error">@_deleteChapterError</div>
            }
            <div class="storyboard-modal-actions">
                <button type="button"
                        class="storyboard-modal-danger"
                        @onclick="ConfirmDeleteChapterAsync"
                        disabled="@_deleteChapterInFlight">
                    Delete
                </button>
                <button type="button"
                        @onclick="CancelDeleteChapter"
                        disabled="@_deleteChapterInFlight">
                    Cancel
                </button>
            </div>
        </div>
    </div>
}

@code {
    private IReadOnlyList<StoryboardChapterColumn> ChapterColumns => BuildChapterColumns();
    private StoryboardCoachSummary CoachSummary => BuildCoachSummary();
    private IReadOnlyList<string> PovFilterOptions => GetFilterOptions(scene => scene.Pov);
    private IReadOnlyList<string> StatusFilterOptions => GetFilterOptions(scene => scene.Status);
    private IReadOnlyList<string> SubplotFilterOptions => GetFilterOptions(scene => scene.SubplotTags);
    private IReadOnlyList<string> ActiveFilterSummaries => BuildActiveFilterSummaries();
    private int ActiveFilterCount => ActiveFilterSummaries.Count;
    private IReadOnlyList<string> BulkRemovableSubplotTags => GetSelectedSceneCards()
        .SelectMany(scene => scene.SubplotTags)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(tag => tag, StringComparer.OrdinalIgnoreCase)
        .ToArray();
    private string BulkStatusPlaceholder => GetBulkPlaceholder(
        GetSelectedSceneCards().Select(scene => NormalizeStatus(scene.Status)),
        "Set status",
        "Mixed status");
    private string BulkNarrativeRolePlaceholder => GetBulkPlaceholder(
        GetSelectedSceneCards().Select(scene => scene.NarrativeRole),
        "Set role",
        "Mixed role");
    private string BulkRemoveTagPlaceholder => BulkRemovableSubplotTags.Count == 0
        ? "No shared tags"
        : BulkRemovableSubplotTags.Count == 1
            ? $"Remove {BulkRemovableSubplotTags[0]}"
            : "Remove subplot tag";

    [Parameter]
    public ProjectDto? Project { get; set; }

    [Parameter]
    public IReadOnlyList<ProjectNodeDto>? Nodes { get; set; }

    [Parameter]
    public EventCallback OnStructureChanged { get; set; }

    [Parameter]
    public Guid? SelectedSceneId { get; set; }

    [Parameter]
    public IReadOnlyCollection<Guid> SelectedSceneIds { get; set; } = Array.Empty<Guid>();

    [Parameter]
    public EventCallback<StoryboardSelectionChange> OnSelectionChanged { get; set; }

    [Parameter]
    public EventCallback<StoryboardSceneInspectorUpdate> OnSceneUpdated { get; set; }

    private List<ProjectNodeDto> _renderNodes = new();
    private Guid? _dragSceneId;
    private Guid? _dropChapterId;
    private Guid? _dropBeforeSceneId;
    private bool _moveInFlight;
    private Guid? _addingSceneChapterId;
    private bool _addingChapterInFlight;
    private Guid? _highlightedSceneId;
    private Guid? _pendingScrollSceneId;
    private Guid? _pendingScrollChapterId;
    private string? _storyboardError;
    private Guid? _pendingDeleteSceneId;
    private string? _pendingDeleteSceneTitle;
    private string? _deleteSceneError;
    private bool _deleteSceneInFlight;
    private Guid? _pendingDeleteChapterId;
    private string? _pendingDeleteChapterTitle;
    private string? _deleteChapterError;
    private bool _deleteChapterInFlight;
    private Guid? _editingChapterId;
    private Guid? _savingChapterTitleId;
    private string _chapterTitleDraft = string.Empty;
    private ElementReference _chapterTitleInputRef;
    private bool _focusChapterTitleInputPending;
    private Guid? _openChapterMenuId;
    private StoryboardColorMode _colorMode;
    private string _povFilter = string.Empty;
    private string _statusFilter = string.Empty;
    private string _subplotFilter = string.Empty;
    private bool _filtersOpen;
    private string _bulkSubplotTagDraft = string.Empty;
    private static readonly string[] BulkStatusOptions = ["Idea", "Draft", "Revised", "Final"];
    private static readonly string[] BulkNarrativeRoleOptions =
    [
        "Setup",
        "Inciting Incident",
        "Turn",
        "Escalation",
        "Complication",
        "Revelation",
        "Relationship Beat",
        "Reversal",
        "Decision",
        "Climax",
        "Aftermath"
    ];

    protected override void OnParametersSet()
    {
        if (_moveInFlight)
        {
            return;
        }

        _renderNodes = Nodes?
            .OrderBy(node => node.ParentId)
            .ThenBy(node => node.OrderIndex)
            .ToList()
            ?? new List<ProjectNodeDto>();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendingScrollChapterId.HasValue)
        {
            Guid chapterId = _pendingScrollChapterId.Value;
            _pendingScrollChapterId = null;
            await JS.InvokeVoidAsync("tiptapEditor.scrollToElement", GetChapterElementId(chapterId));
        }

        if (_pendingScrollSceneId.HasValue)
        {
            Guid sceneId = _pendingScrollSceneId.Value;
            _pendingScrollSceneId = null;
            await JS.InvokeVoidAsync("tiptapEditor.scrollToElement", GetSceneElementId(sceneId));
        }

        if (_focusChapterTitleInputPending)
        {
            _focusChapterTitleInputPending = false;
            await JS.InvokeVoidAsync("writerProjectsMenu.focusAndSelectInput", _chapterTitleInputRef);
        }
    }

    private IReadOnlyList<StoryboardChapterColumn> BuildChapterColumns()
    {
        if (_renderNodes.Count == 0)
        {
            return Array.Empty<StoryboardChapterColumn>();
        }

        List<ProjectNodeDto> roots = _renderNodes
            .Where(node => !node.ParentId.HasValue)
            .OrderBy(node => node.OrderIndex)
            .ToList();
        Dictionary<Guid, List<ProjectNodeDto>> byParent = _renderNodes
            .Where(node => node.ParentId.HasValue)
            .GroupBy(node => node.ParentId!.Value)
            .ToDictionary(
                group => group.Key,
                group => group.OrderBy(node => node.OrderIndex).ToList());

        Dictionary<Guid, ProjectNodeDto> byId = _renderNodes.ToDictionary(node => node.Id);
        List<StoryboardChapterColumn> columns = new();

        foreach (ProjectNodeDto root in roots)
        {
            AppendChapterColumns(root, partTitle: null, byParent, byId, columns);
        }

        return columns;
    }

    private void AppendChapterColumns(
        ProjectNodeDto node,
        string? partTitle,
        IReadOnlyDictionary<Guid, List<ProjectNodeDto>> byParent,
        IReadOnlyDictionary<Guid, ProjectNodeDto> byId,
        ICollection<StoryboardChapterColumn> columns)
    {
        if (IsPart(node))
        {
            List<ProjectNodeDto> children = GetChildren(node.Id, byParent).ToList();
            bool hasChapterDescendant = children.Any(IsChapter)
                || children.Any(child => HasChapterDescendant(child.Id, byParent));
            if (!hasChapterDescendant)
            {
                columns.Add(new StoryboardChapterColumn(node, "Part", new List<StoryboardSceneCard>(), IsPartPlaceholder: true));
                return;
            }

            foreach (ProjectNodeDto child in children)
            {
                AppendChapterColumns(child, node.Title, byParent, byId, columns);
            }

            return;
        }

        if (IsChapter(node))
        {
            List<StoryboardSceneCard> scenes = GetChildren(node.Id, byParent)
                .Where(IsScene)
                .Select(scene => new StoryboardSceneCard(
                    scene.Id,
                    scene.Title,
                    TryExtractSceneSummary(scene),
                    scene.WordCountCache,
                    TryGetSceneMetadata(scene)))
                .Where(ShouldIncludeScene)
                .ToList();

            string? resolvedPartTitle = partTitle;
            if (string.IsNullOrWhiteSpace(resolvedPartTitle)
                && node.ParentId.HasValue
                && byId.TryGetValue(node.ParentId.Value, out ProjectNodeDto? parent)
                && IsPart(parent))
            {
                resolvedPartTitle = parent.Title;
            }

            columns.Add(new StoryboardChapterColumn(node, resolvedPartTitle, scenes));
            return;
        }

        foreach (ProjectNodeDto child in GetChildren(node.Id, byParent))
        {
            AppendChapterColumns(child, partTitle, byParent, byId, columns);
        }
    }

    private bool ShouldIncludeScene(StoryboardSceneCard scene)
    {
        if (!string.IsNullOrWhiteSpace(_povFilter)
            && !string.Equals(scene.Pov, _povFilter, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        if (!string.IsNullOrWhiteSpace(_statusFilter)
            && !string.Equals(scene.Status, _statusFilter, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        if (!string.IsNullOrWhiteSpace(_subplotFilter)
            && !scene.SubplotTags.Any(tag => string.Equals(tag, _subplotFilter, StringComparison.OrdinalIgnoreCase)))
        {
            return false;
        }

        return true;
    }

    private static IReadOnlyList<ProjectNodeDto> GetChildren(
        Guid parentId,
        IReadOnlyDictionary<Guid, List<ProjectNodeDto>> byParent)
    {
        return byParent.TryGetValue(parentId, out List<ProjectNodeDto>? children)
            ? children
            : Array.Empty<ProjectNodeDto>();
    }

    private static bool HasChapterDescendant(
        Guid parentId,
        IReadOnlyDictionary<Guid, List<ProjectNodeDto>> byParent)
    {
        if (!byParent.TryGetValue(parentId, out List<ProjectNodeDto>? children))
        {
            return false;
        }

        return children.Any(IsChapter)
            || children.Any(child => HasChapterDescendant(child.Id, byParent));
    }

