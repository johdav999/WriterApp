    }

    private static string UpdateSceneMetadata(
        string? metadataJson,
        string? summary = null,
        string? status = null,
        string? pov = null,
        IReadOnlyList<string>? subplotTags = null,
        string? narrativePurpose = null,
        string? notesText = null)
    {
        JsonObject root = ParseMetadata(metadataJson);

        if (summary is not null)
        {
            SetString(root, "summary", summary);
        }

        if (status is not null)
        {
            SetString(root, "status", status);
        }

        if (pov is not null)
        {
            SetString(root, "pov", pov);
        }

        if (subplotTags is not null)
        {
            SetStringArray(root, "subplotTags", subplotTags);
        }

        if (narrativePurpose is not null)
        {
            SetString(root, "narrativePurpose", narrativePurpose);
        }

        if (notesText is not null)
        {
            SetString(root, "notesText", notesText);
        }

        return root.ToJsonString();
    }

    private static JsonObject ParseMetadata(string? metadataJson)
    {
        if (string.IsNullOrWhiteSpace(metadataJson))
        {
            return new JsonObject();
        }

        try
        {
            JsonNode? node = JsonNode.Parse(metadataJson);
            return node as JsonObject ?? new JsonObject();
        }
        catch
        {
            return new JsonObject();
        }
    }

    private static void SetString(JsonObject root, string propertyName, string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            root.Remove(propertyName);
            return;
        }

        root[propertyName] = value.Trim();
    }

    private static void SetStringArray(JsonObject root, string propertyName, IReadOnlyList<string>? values)
    {
        IReadOnlyList<string> normalized = values?
            .Select(value => value?.Trim())
            .Where(value => !string.IsNullOrWhiteSpace(value))
            .Select(value => value!)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToArray()
            ?? Array.Empty<string>();

        if (normalized.Count == 0)
        {
            root.Remove(propertyName);
            return;
        }

        JsonArray array = new();
        foreach (string value in normalized)
        {
            array.Add(value);
        }

        root[propertyName] = array;
    }

