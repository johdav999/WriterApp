    private async Task<bool> CreateSceneInChapterAsync(Guid chapterId, StoryboardSceneSeed seed)
    {
        if (Project is null || _moveInFlight)
        {
            return false;
        }

        string metadataJson = UpdateSceneMetadata(
            null,
            summary: seed.Summary,
            status: seed.Status,
            pov: seed.PovCharacterId,
            subplotTags: seed.SubplotTags,
            narrativePurpose: seed.NarrativePurpose,
            narrativeRole: seed.NarrativeRole,
            narrativeIntent: seed.NarrativeIntent);

        ProjectNodeCreateRequest request = new(
            chapterId,
            "scene",
            seed.Title,
            null,
            null,
            metadataJson);

        using HttpResponseMessage response = await Http.PostAsJsonAsync(
            $"api/projects/{Project.Id}/nodes",
            request);
        if (!response.IsSuccessStatusCode)
        {
            throw new InvalidOperationException(await ReadApiErrorAsync(response, "Add scene failed."));
        }

        ProjectNodeDto? created = await response.Content.ReadFromJsonAsync<ProjectNodeDto>();
        if (created is null)
        {
            return false;
        }

        ProjectNodeDto createdNode = created with
        {
            Title = string.IsNullOrWhiteSpace(created.Title) ? seed.Title : created.Title,
            MetadataJson = string.IsNullOrWhiteSpace(created.MetadataJson) ? metadataJson : created.MetadataJson
        };

        SceneCardUpdateRequest payload = new(
            seed.NarrativePurpose,
            null,
            null,
            null,
            seed.PovCharacterId,
            null,
            null,
            null,
            Array.Empty<string>(),
            Array.Empty<SceneCardReferenceDto>(),
            seed.Summary,
            seed.Status,
            seed.SubplotTags,
            seed.NarrativeRole,
            seed.NarrativeIntent);

        using HttpResponseMessage sceneCardResponse =
            await Http.PutAsJsonAsync($"api/scenes/{createdNode.Id}/scene-card", payload);
        if (!sceneCardResponse.IsSuccessStatusCode)
        {
            throw new InvalidOperationException(await ReadApiErrorAsync(sceneCardResponse, "Add scene failed."));
        }

        InsertOrUpdateRenderNode(createdNode);
        _highlightedSceneId = createdNode.Id;
        _pendingScrollSceneId = createdNode.Id;
        await NotifySceneUpdatedAsync(createdNode);
        await InvokeAsync(StateHasChanged);
        await SelectSceneAsync(createdNode.Id);

        if (OnStructureChanged.HasDelegate)
        {
            await OnStructureChanged.InvokeAsync();
        }

        return true;
    }

    private Guid? GetPreferredChapterForSceneCreation(string? preferredChapterTitle = null)
    {
        if (!string.IsNullOrWhiteSpace(preferredChapterTitle))
        {
            StoryboardChapterColumn? matchedChapter = ChapterColumns.FirstOrDefault(column =>
                string.Equals(column.Chapter.Title?.Trim(), preferredChapterTitle.Trim(), StringComparison.OrdinalIgnoreCase));
            if (matchedChapter is not null)
            {
                return matchedChapter.Chapter.Id;
            }
        }

        if (SelectedSceneId.HasValue)
        {
            ProjectNodeDto? sceneNode = _renderNodes.FirstOrDefault(node => node.Id == SelectedSceneId.Value);
            if (sceneNode?.ParentId is Guid chapterId)
            {
                return chapterId;
            }
        }

        StoryboardChapterColumn? lastChapterWithScenes = ChapterColumns.LastOrDefault(column => column.Scenes.Count > 0);
        if (lastChapterWithScenes is not null)
        {
            return lastChapterWithScenes.Chapter.Id;
        }

        return ChapterColumns.LastOrDefault()?.Chapter.Id;
    }

    private sealed record StoryboardChapterColumn(
        ProjectNodeDto Chapter,
        string? PartTitle,
        List<StoryboardSceneCard> Scenes,
        bool IsPartPlaceholder = false)
    {
        public int DraftSceneCount => Scenes.Count(scene => IsDraftStatus(scene.Status));

        public string? DominantPov => Scenes
            .Select(scene => scene.Pov?.Trim())
            .Where(pov => !string.IsNullOrWhiteSpace(pov))
            .GroupBy(pov => pov!, StringComparer.OrdinalIgnoreCase)
            .OrderByDescending(group => group.Count())
            .ThenBy(group => group.Key, StringComparer.OrdinalIgnoreCase)
            .Select(group => group.Key)
            .FirstOrDefault();
    }

    private StoryboardCoachSummary BuildCoachSummary()
    {
        IReadOnlyList<StoryboardChapterColumn> columns = ChapterColumns;
        int totalChapters = columns.Count;
        int totalScenes = columns.Sum(column => column.Scenes.Count);
        int draftScenes = columns.Sum(column => column.DraftSceneCount);
        int incompleteScenes = columns.Sum(column => column.Scenes.Count(scene =>
            string.IsNullOrWhiteSpace(scene.Summary)
            || string.IsNullOrWhiteSpace(scene.Pov)
            || string.IsNullOrWhiteSpace(scene.NarrativeRole)));
        double averageScenes = totalChapters == 0 ? 0 : (double)totalScenes / totalChapters;
        List<string> observations = new();
        List<string> insights = new();
        List<string> suggestions = new();

        foreach (StoryboardChapterColumn column in columns.Where(column => column.Scenes.Count == 0))
        {
            observations.Add($"{column.Chapter.Title} has no scenes.");
        }

        if (averageScenes > 0)
        {
            foreach (StoryboardChapterColumn column in columns.Where(column => column.Scenes.Count >= Math.Max(6, Math.Ceiling(averageScenes * 1.75))))
            {
                observations.Add($"{column.Chapter.Title} contains {column.Scenes.Count} scenes, well above the project average of {averageScenes:0.#}.");
            }
        }

        List<StoryboardSceneCard> genericTitles = columns
            .SelectMany(column => column.Scenes)
            .Where(scene => IsGenericSceneTitle(scene.Title))
            .ToList();
        if (genericTitles.Count > 0)
        {
            observations.Add($"{genericTitles.Count} scene title{(genericTitles.Count == 1 ? " is" : "s are")} still generic or very short.");
        }

        int maxScenes = columns.Count == 0 ? 0 : columns.Max(column => column.Scenes.Count);
        int minScenes = columns.Count == 0 ? 0 : columns.Min(column => column.Scenes.Count);
        if (totalChapters >= 3 && maxScenes - minScenes >= 4)
        {
            observations.Add("Scene distribution is uneven across chapters.");
        }

        if (totalScenes > 0 && draftScenes >= Math.Max(3, (int)Math.Ceiling(totalScenes * 0.5)))
        {
            insights.Add("A large share of the board is still in draft, which may make pacing decisions less stable.");
        }

        if (totalChapters > 0 && columns.Count(column => column.Scenes.Count > 0) == 1)
        {
            insights.Add("Most of the visible story weight is concentrated in a single chapter, so overall structure may still be front-loaded.");
        }

        if (incompleteScenes > 0)
        {
            suggestions.Add($"Add summary, POV, or narrative role to the {incompleteScenes} incomplete scene{(incompleteScenes == 1 ? string.Empty : "s")} to make the board easier to scan.");
        }

        if (columns.Any(column => column.Scenes.Count == 0))
        {
            suggestions.Add("Fill empty chapters with at least one scene so every chapter has a visible structural role.");
        }

        if (totalChapters >= 3 && maxScenes - minScenes >= 4)
        {
            suggestions.Add("Rebalance scene counts across chapters to smooth the board’s pacing and reduce structural clustering.");
        }

        return new StoryboardCoachSummary(
            totalChapters,
            totalScenes,
            draftScenes,
            incompleteScenes,
            observations,
            insights,
            suggestions);
    }

    private static bool IsGenericSceneTitle(string? title)
    {
        if (string.IsNullOrWhiteSpace(title))
        {
            return true;
        }

        string normalized = title.Trim();
        if (normalized.Length <= 4)
        {
            return true;
        }

        return normalized.StartsWith("scene", StringComparison.OrdinalIgnoreCase)
            || normalized.StartsWith("new scene", StringComparison.OrdinalIgnoreCase)
            || normalized.StartsWith("untitled", StringComparison.OrdinalIgnoreCase);
    }

