    private static string ComputeShortHash(string? value)
    {
        if (string.IsNullOrEmpty(value))
        {
            return "0";
        }

        using var sha = System.Security.Cryptography.SHA256.Create();
        byte[] bytes = System.Text.Encoding.UTF8.GetBytes(value);
        byte[] hash = sha.ComputeHash(bytes);
        return Convert.ToHexString(hash.AsSpan(0, 4));
    }

    private static object BuildFingerprint(string? content)
    {
        string value = content ?? string.Empty;
        string plain = PlainTextMapper.ToPlainText(value);
        return new
        {
            jsonLength = value.Length,
            textLength = plain.Length,
            hash = ComputeShortHash(value)
        };
    }

    private static string BuildAnnotationsFingerprint(IReadOnlyList<PageAnnotationDto>? annotations)
    {
        if (annotations is null || annotations.Count == 0)
        {
            return "none";
        }

        return string.Join("|", annotations
            .OrderBy(item => item.Id)
            .Select(item => $"{item.Id}:{item.AnchorFrom}:{item.AnchorTo}:{item.Kind}:{item.Status}"));
    }

    private static string BuildQualityIssuesFingerprint(IReadOnlyList<PageQualityIssueDto>? issues)
    {
        if (issues is null || issues.Count == 0)
        {
            return "none";
        }

        return string.Join("|", issues
            .OrderBy(item => item.IssueKey)
            .Select(item => $"{item.IssueKey}:{item.StartOffset}:{item.EndOffset}:{item.Kind}:{item.Severity}:{item.Fix?.Kind}:{item.Fix?.From}:{item.Fix?.To}:{item.Fix?.Text}"));
    }

    public async Task<IReadOnlyList<PageAnnotationAnchorUpdateRequest>> GetAnnotationAnchorsAsync()
    {
        if (_editorInstance is null)
        {
            return Array.Empty<PageAnnotationAnchorUpdateRequest>();
        }

        List<AnnotationAnchorPayload>? payload = await JSRuntime.InvokeAsync<List<AnnotationAnchorPayload>>(
            "tiptapEditor.getAnnotations",
            _editorInstance);

        if (payload is null || payload.Count == 0)
        {
            return Array.Empty<PageAnnotationAnchorUpdateRequest>();
        }

        List<PageAnnotationAnchorUpdateRequest> result = new(payload.Count);
        foreach (AnnotationAnchorPayload item in payload)
        {
            if (!Guid.TryParse(item.Id, out Guid id))
            {
                continue;
            }

            result.Add(new PageAnnotationAnchorUpdateRequest(
                id,
                item.From,
                item.To,
                item.Text));
        }

        return result;
    }

