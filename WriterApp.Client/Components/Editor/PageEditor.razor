    public async Task<bool> ApplyQualityIssueFixAsync(QualityIssueFixDto fix, string? issueAnchorText = null, string? issueKey = null)
    {
        if (_editorInstance is null)
        {
            return false;
        }

        string? anchorText = string.IsNullOrWhiteSpace(fix.AnchorText) ? issueAnchorText : fix.AnchorText;
        string? resolvedIssueKey = string.IsNullOrWhiteSpace(fix.IssueKey) ? issueKey : fix.IssueKey;
        string effectiveKind = string.Equals(fix.Kind, "rewrite", StringComparison.OrdinalIgnoreCase)
            ? "replace"
            : fix.Kind;
        _lastQualityFixFailureReason = null;
        _lastQualityFixFailureSource = null;

        try
        {
            async Task<QualityIssueFixApplyResult?> ApplyOnceAsync(object payload)
            {
                return await JSRuntime.InvokeAsync<QualityIssueFixApplyResult>(
                    "tiptapEditor.applyQualityIssueFixDetailed",
                    _editorInstance,
                    payload);
            }

            object basePayload = new
            {
                kind = effectiveKind,
                from = fix.From,
                to = fix.To,
                text = fix.Text,
                anchorText,
                issueKey = resolvedIssueKey,
                docFrom = fix.DocFrom,
                docTo = fix.DocTo,
                expectedText = fix.ExpectedText,
                beforeAnchor = fix.BeforeAnchor,
                afterAnchor = fix.AfterAnchor,
                needleText = fix.NeedleText
            };

            QualityIssueFixApplyResult? result = await ApplyOnceAsync(basePayload);

            if (result is null)
            {
                Logger.LogWarning(
                    "Quality fix interop returned null. IssueKey={IssueKey}, Kind={Kind}, From={From}, To={To}",
                    resolvedIssueKey,
                    fix.Kind,
                    fix.From,
                    fix.To);
                return false;
            }

            bool shouldRetry = (!result.Applied || !result.Changed)
                && (string.Equals(result.Reason, "doc_expected_text_mismatch", StringComparison.OrdinalIgnoreCase)
                    || string.Equals(result.Reason, "could_not_resolve_range", StringComparison.OrdinalIgnoreCase));
            if (shouldRetry)
            {
                Logger.LogWarning(
                    "Quality fix apply retry requested. PageId={PageId}, IssueKey={IssueKey}, Reason={Reason}",
                    Page?.Id,
                    resolvedIssueKey,
                    result.Reason);

                QualityIssueRangeResolution? resolution = await ResolvePlainRangeAsync(fix.From, fix.To, anchorText);
                object retryPayload = new
                {
                    kind = effectiveKind,
                    from = fix.From,
                    to = fix.To,
                    text = fix.Text,
                    anchorText,
                    issueKey = resolvedIssueKey,
                    docFrom = resolution?.DocFrom,
                    docTo = resolution?.DocTo,
                    expectedText = resolution?.ExpectedText ?? fix.ExpectedText,
                    beforeAnchor = fix.BeforeAnchor,
                    afterAnchor = fix.AfterAnchor,
                    needleText = fix.NeedleText
                };

                QualityIssueFixApplyResult? retryResult = await ApplyOnceAsync(retryPayload);
                if (retryResult is not null)
                {
                    result = retryResult;
                }
            }

            if (!result.Applied || !result.Changed)
            {
                _lastQualityFixFailureReason = result.Reason;
                _lastQualityFixFailureSource = result.Source;
                Logger.LogWarning(
                    "Quality fix apply failed/no-op. PageId={PageId}, IssueKey={IssueKey}, Kind={Kind}, From={From}, To={To}, Applied={Applied}, Changed={Changed}, Reason={Reason}, Source={Source}, DocFrom={DocFrom}, DocTo={DocTo}",
                    Page?.Id,
                    resolvedIssueKey,
                    effectiveKind,
                    fix.From,
                    fix.To,
                    result.Applied,
                    result.Changed,
                    result.Reason,
                    result.Source,
                    result.DocFrom,
                    result.DocTo);
            }
            else
            {
                _lastQualityFixFailureReason = null;
                _lastQualityFixFailureSource = null;
                Logger.LogInformation(
                    "Quality fix applied. PageId={PageId}, IssueKey={IssueKey}, Kind={Kind}, From={From}, To={To}, Source={Source}, DocFrom={DocFrom}, DocTo={DocTo}",
                    Page?.Id,
                    resolvedIssueKey,
                    effectiveKind,
                    fix.From,
                    fix.To,
                    result.Source,
                    result.DocFrom,
                    result.DocTo);
            }

            return result.Applied && result.Changed;
        }
        catch (JSException)
        {
            _lastQualityFixFailureReason = "js_exception";
            _lastQualityFixFailureSource = null;
            try
            {
                return await JSRuntime.InvokeAsync<bool>(
                    "tiptapEditor.applyQualityIssueFix",
                    _editorInstance,
                    new
                    {
                        kind = effectiveKind,
                        from = fix.From,
                        to = fix.To,
                        text = fix.Text,
                        anchorText,
                        issueKey = resolvedIssueKey
                    });
            }
            catch (JSException)
            {
                _lastQualityFixFailureReason = "js_exception";
                _lastQualityFixFailureSource = null;
                return false;
            }
        }
    }

    public string? LastQualityFixFailureReason => _lastQualityFixFailureReason;
    public string? LastQualityFixFailureSource => _lastQualityFixFailureSource;

