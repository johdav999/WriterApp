@using WriterApp.Application.Documents
@using WriterApp.Application.Subscriptions
@using System
@using System.Linq
@using WriterApp.Shared
@implements IDisposable
@inject WriterApp.Client.Services.CoverApiClient CoverApiClient
@inject WriterApp.Client.State.AuthMeStateService AuthMeStateService
@inject WriterApp.Client.Services.FeatureAccessService FeatureAccessService
@inject NavigationManager Navigation
@inject WriterApp.Client.Services.AuthStateService Authentication
@inject Microsoft.JSInterop.IJSRuntime JS

<section class="cover-studio" aria-label="Cover studio">
    <div class="cover-studio-panel cover-studio-brief">
        <div class="cover-studio-header">
            <h3>Book Cover</h3>
            <p>Generate and customize cover artwork for your manuscript.</p>
        </div>

        <WriterApp.UI.Shared.CoverBrief Value="@BuildPrompt()" ValueChanged="BriefChanged" Disabled="@(_isGenerating || _isSavingCover)" />

        <div class="cover-actions">
            <button type="button" class="secondary" disabled="@(!_isGenerating)" @onclick="CancelEdit">Cancel generation</button>
            <button type="button" class="secondary" disabled="@(_isGenerating || _isSavingCover)" @onclick="DismissEditAsync">Dismiss preview</button>
            <button type="button"
                    class="@GetGenerationButtonClass("primary")"
                    title="@GetGenerationTooltip()"
                    aria-disabled="@(!IsProfessional)"
                    @onclick="OnGenerateCoverConceptsClickedAsync">
                @if (!IsProfessional)
                {
                    <span class="cover-gated-button-icon" aria-hidden="true">
                        <Icon Name="lock" />
                    </span>
                }
                <span>@(_isGenerating ? "Generating..." : "Generate cover concepts")</span>
            </button>
            <button type="button"
                    class="@GetGenerationButtonClass("secondary")"
                    title="@GetGenerationTooltip()"
                    aria-disabled="@(!IsProfessional)"
                    @onclick="OnSurpriseMeClickedAsync">
                @if (!IsProfessional)
                {
                    <span class="cover-gated-button-icon" aria-hidden="true">
                        <Icon Name="lock" />
                    </span>
                }
                <span>Choose another brief</span>
            </button>
            <button type="button" class="secondary" @onclick="SaveProjectCoverAsync" disabled="@(!_selectedImageAvailable || _isSavingCover || _isGenerating)">
                @(_isSavingCover ? "Saving..." : "Save as project cover")
            </button>
        </div>

        @if (!string.IsNullOrWhiteSpace(_saveStatus))
        {
            <div class="cover-save-status">@_saveStatus</div>
        }
        @if(_editPreview is { } review && review.Edit.Request.Source.MetadataRevision!=_metadataRevision && review.Receipt is null) {
            <p role="status">This cover review has an older project revision. Reconcile an approved save or generate a new edit before saving.</p>
        }
    </div>

    <div class="cover-studio-panel cover-studio-preview">
        <div class="cover-studio-header">
            <h3>Cover Preview</h3>
            <p>@(Project?.Title ?? "Current project")</p>
        </div>

        <div class="cover-current-state">
            @if (!string.IsNullOrWhiteSpace(_projectCoverImageUrl))
            {
                <div class="cover-current-label">Current saved cover</div>
                <img class="cover-current-image" src="@_projectCoverImageUrl" alt="Current saved project cover" />
            }
            else
            {
                <div class="cover-current-empty">
                    <strong>No saved cover yet.</strong>
                    <span>Generate concepts and save one as the project cover.</span>
                </div>
            }
        </div>

        @if (_generatedImageUrls.Count == 0 || !string.IsNullOrWhiteSpace(_coverError))
        {
        <div class="cover-preview-frame">
            @if (!string.IsNullOrWhiteSpace(_coverError))
            {
                <div class="cover-preview-placeholder">@_coverError</div>
            }
            else if (_selectedImageUrl is not null)
            {
                <img class="cover-preview-image" src="@_selectedImageUrl" alt="Selected generated book cover concept" />
            }
            else if (string.IsNullOrWhiteSpace(_previewCaption))
            {
                <div class="cover-preview-placeholder">No cover generated yet.</div>
            }
            else
            {
                <div class="cover-preview-placeholder">@_previewCaption</div>
            }
        </div>

        }
        @if(_editPreview is { } edit) {
            <WriterApp.UI.Shared.CoverEditReview Operation="@edit.Edit.Request.Operation" AssetId="@edit.Edit.Request.AssetId" Hash="@edit.Edit.Request.ContentHash"
                Original="@edit.Original" Proposed="@EditedImage(edit)" Selected="edit.Selected" SelectedChanged="SelectEditAsync" Disabled="@(_isGenerating || _isSavingCover)" />
        } else { <WriterApp.UI.Shared.CoverConcepts Images="_generatedImageUrls" Selected="@_generatedImageUrls.IndexOf(_selectedImageUrl ?? string.Empty)" SelectedChanged="i => SelectImage(_generatedImageUrls[i])" Disabled="@(_isGenerating || _isSavingCover)" /> }

    </div>

    <div class="cover-studio-panel cover-studio-controls">
        <WriterApp.UI.Shared.CoverEditControls Capabilities="_editCapabilities" Disabled="@(_isGenerating || _isSavingCover || !IsProfessional)" HasSource="_selectedImageAvailable" Requested="EditAsync" />
        <button type="button" disabled="@(_isGenerating || _isSavingCover)" @onclick="RefreshEditsAsync">Refresh availability / reopen cached review</button>
        <button type="button" disabled="@(_isGenerating || _isSavingCover || _editPreview?.SaveApproved!=true)" @onclick="ReconcileEditAsync">Check approved save</button>
        <button type="button" disabled="@(_isGenerating || _isSavingCover || !HasEditRecovery)" @onclick="RestoreEditAsync">Restore previous project cover</button>
        <p>Cached reviews can be reopened offline. Saving and restoring on the web require connectivity and an owned persistence acknowledgement.</p>
    </div>

</section>

@code {
    private static readonly string[] GenreOptions = CoverStudioContract.Genres;
    private static readonly string[] MoodOptions = CoverStudioContract.Moods;
    private static readonly string[] VisualStyleOptions = CoverStudioContract.Styles;
    private static readonly string[] ColorPaletteOptions = CoverStudioContract.Palettes;
    private long _metadataRevision;
    private long _epoch;
    private readonly System.Threading.CancellationTokenSource _lifetime=new();
    private System.Threading.CancellationTokenSource? _request;
    private void BriefChanged(CoverPrompt prompt) { _description=prompt.Description ?? ""; _genre=prompt.Genre ?? GenreOptions[0]; _mood=prompt.Mood ?? MoodOptions[0]; _visualStyle=prompt.Style ?? VisualStyleOptions[0]; _colorPalette=prompt.ColorPalette ?? ColorPaletteOptions[0]; }

    private string _description = string.Empty;
    private string _genre = GenreOptions[0];
    private string _mood = MoodOptions[0];
    private string _visualStyle = VisualStyleOptions[0];
    private string _colorPalette = ColorPaletteOptions[0];
    private string? _lastAction;
    private string? _previewCaption;
    private string? _coverError;
    private bool _isGenerating;
    private bool _isSavingCover;
    private string? _selectedImageUrl;
    private string? _saveStatus;
    private string? _projectCoverImageUrl;
    private readonly List<string> _generatedImageUrls = new();
    private Guid? _boundProjectId;

    [Parameter]
    public ProjectDto? Project { get; set; }

    private bool IsProfessional => string.Equals(AuthMeStateService.EffectivePlanKey, "Professional", StringComparison.OrdinalIgnoreCase);
    private bool _selectedImageAvailable => !string.IsNullOrWhiteSpace(_selectedImageUrl);

    protected override void OnInitialized()
    {
        AuthMeStateService.Changed += HandleAuthMeChanged;
    }

    protected override void OnParametersSet()
    {
        bool projectChanged = _boundProjectId != Project?.Id;
        if(projectChanged) { _epoch++; _request?.Cancel(); _generatedImageUrls.Clear(); _conceptAssets.Clear(); _editPreview=null; _coverRecovery=null; _editCapabilities=null; _selectedImageUrl=null; _coverError=null; _saveStatus=null; }
        _boundProjectId = Project?.Id;

        if (Project is null)
        {
            _projectCoverImageUrl = null;
            return;
        }

        if(projectChanged || Project.MetadataRevision >= _metadataRevision) {
            _projectCoverImageUrl = Project.CoverImageUrl; _metadataRevision = Project.MetadataRevision;
        }
        if (!string.IsNullOrWhiteSpace(_projectCoverImageUrl))
        {
            if (!_generatedImageUrls.Any(url => string.Equals(url, _projectCoverImageUrl, StringComparison.Ordinal)))
            {
                _generatedImageUrls.Insert(0, _projectCoverImageUrl);
            }

            if (projectChanged || string.IsNullOrWhiteSpace(_selectedImageUrl))
            {
                _selectedImageUrl = _projectCoverImageUrl;
                _previewCaption = null;
            }
        }
        else if (projectChanged)
        {
            _selectedImageUrl = null;
        }
    }

    public void Dispose()
    {
        AuthMeStateService.Changed -= HandleAuthMeChanged;
        _lifetime.Cancel(); _request?.Cancel();
    }

    private void HandleAuthMeChanged()
    {
        _epoch++; _request?.Cancel(); _generatedImageUrls.Clear(); _conceptAssets.Clear(); _editPreview=null; _coverRecovery=null; _editCapabilities=null; _selectedImageUrl=null;
        InvokeAsync(StateHasChanged);
    }

    private async Task OnGenerateCoverConceptsClickedAsync()
    {
        if (await RedirectToUpgradeIfLockedAsync())
        {
            return;
        }

        await GenerateCoverConceptsAsync();
    }

    private async Task OnSurpriseMeClickedAsync()
    {
        if (await RedirectToUpgradeIfLockedAsync())
        {
            return;
        }

        await SurpriseMeAsync();
    }

    private Task<bool> RedirectToUpgradeIfLockedAsync()
    {
        if (IsProfessional)
        {
            return Task.FromResult(false);
        }

        Navigation.NavigateTo(
            FeatureAccessService.GetUpgradePathWithCurrentReturn(FeatureKey.CoverGeneration),
            forceLoad: true);
        return Task.FromResult(true);
    }

    private string GetGenerationButtonClass(string baseClass)
    {
        return IsProfessional
            ? baseClass
            : $"{baseClass} cover-gated-button is-locked";
    }

    private string? GetGenerationTooltip()
    {
        return IsProfessional ? null : "Cover generation requires the Professional plan.";
    }

    private async Task GenerateCoverConceptsAsync()
    {
        if(_isGenerating || _isSavingCover) return;
        var sourceProject=Project?.Id; var epoch=_epoch;
        using var request=System.Threading.CancellationTokenSource.CreateLinkedTokenSource(_lifetime.Token); _request=request;
        _isGenerating = true;
        _coverError = null;
        _saveStatus = null;
        _lastAction = "Generating cover concepts...";
        _previewCaption = null;

        try
        {
            var brief=BuildPrompt();
            if(brief.ProjectId is not { } project || brief.DocumentId is not { } document)throw new InvalidOperationException("Choose a saved project manuscript first.");
            var context=await CoverApiClient.EditCallAsync<CoverAssetSource>(HttpMethod.Get,$"api/covers/generation-source/{project}/{document}?revision={_metadataRevision}",null,request.Token,16_384);
            if(context.ProjectId!=project || context.DocumentId!=document || context.MetadataRevision!=_metadataRevision)throw new InvalidOperationException("Cover source changed. Reload first.");
            brief=new CoverPrompt {ContractVersion=1,ProjectId=project,DocumentId=document,ExpectedMetadataRevision=context.MetadataRevision,ExpectedDocumentVersion=context.DocumentVersion,
                Description=brief.Description,Genre=brief.Genre,Mood=brief.Mood,Style=brief.Style,ColorPalette=brief.ColorPalette};
            CoverGenerationResponse response = await CoverApiClient.GenerateCoverConceptsAsync(brief,request.Token);
            if(Project?.Id != sourceProject || epoch!=_epoch) return;
            request.Token.ThrowIfCancellationRequested();
            if(response.ContractVersion!=1 || response.ProjectId!=project || response.DocumentId!=document || response.MetadataRevision!=context.MetadataRevision || response.DocumentVersion!=context.DocumentVersion)
                throw new InvalidOperationException("The backend did not confirm the saved cover source.");
            if(response.ImageUrls is null || response.ImageUrls.Count is <1 or >4) throw new InvalidOperationException("Invalid cover concept count.");
            foreach(var image in response.ImageUrls) CoverStudioContract.ReadPng(image);
            _generatedImageUrls.Clear();
            _editPreview=null;_conceptAssets.Clear();
            if(response.Assets is { } assets) {
                if(assets.Count!=response.ImageUrls.Count)throw new InvalidOperationException("Cover asset mapping is incomplete.");
                for(int i=0;i<assets.Count;i++)if(assets[i] is { } asset){CoverAssetContract.Validate(asset,CoverStudioContract.ReadPng(response.ImageUrls[i]),project);_conceptAssets[response.ImageUrls[i]]=asset;}
            }
            _generatedImageUrls.AddRange(response.ImageUrls);
            _selectedImageUrl = _generatedImageUrls.Count > 0 ? _generatedImageUrls[0] : null;
            _lastAction = _generatedImageUrls.Count > 0
                ? $"Generated {_generatedImageUrls.Count} cover concept{(_generatedImageUrls.Count == 1 ? string.Empty : "s")}."
                : "No cover concepts were returned.";
        }
        catch (Exception ex)
        {
            if(epoch!=_epoch) return;
            _coverError = ex.Message;
            _lastAction = null;
        }
        finally
        {
            _isGenerating = false; if(_request==request) _request=null;
        }
    }

    private Task SurpriseMeAsync()
    {
        _saveStatus = null;
        _description = string.Empty;
        _genre = GenreOptions[(Array.IndexOf(GenreOptions, _genre) + 1) % GenreOptions.Length];
        _mood = MoodOptions[(Array.IndexOf(MoodOptions, _mood) + 1) % MoodOptions.Length];
        _visualStyle = VisualStyleOptions[(Array.IndexOf(VisualStyleOptions, _visualStyle) + 1) % VisualStyleOptions.Length];
        _colorPalette = ColorPaletteOptions[(Array.IndexOf(ColorPaletteOptions, _colorPalette) + 1) % ColorPaletteOptions.Length];
        return SetPendingActionAsync("Surprise me clicked.");
    }

    private Task SetPendingActionAsync(string action)
    {
        _lastAction = action;
        _coverError = null;
        _saveStatus = null;
        if (_selectedImageUrl is null)
        {
            _previewCaption = null;
        }
        return Task.CompletedTask;
    }

    private CoverPrompt BuildPrompt()
    {
        return new CoverPrompt
        {
            Description = string.IsNullOrWhiteSpace(_description) ? null : _description.Trim(),
            Genre = _genre,
            Mood = _mood,
            Style = _visualStyle,
            ColorPalette = _colorPalette,
            ProjectId=Project?.Id,DocumentId=Project?.PrimaryDocumentId ?? Project?.DocumentId,ExpectedMetadataRevision=_metadataRevision
        };
    }

    private void SelectImage(string imageUrl)
    {
        _selectedImageUrl = imageUrl;
        _coverError = null;
        _saveStatus = null;
        _lastAction = "Selected cover concept.";
    }

    private async Task SaveProjectCoverAsync()
    {
        if (Project is null || !_selectedImageAvailable || _isGenerating || _isSavingCover)
        {
            return;
        }
        if(_editPreview is not null) {await SaveEditAsync();return;}

        var sourceProject=Project.Id; var epoch=_epoch;
        using var request=System.Threading.CancellationTokenSource.CreateLinkedTokenSource(_lifetime.Token); _request=request;
        _isSavingCover = true;
        _coverError = null;
        _saveStatus = null;

        try
        {
            ProjectDto updatedProject = await CoverApiClient.SaveProjectCoverAsync(sourceProject, _selectedImageUrl!, _metadataRevision,request.Token);
            if(Project?.Id!=sourceProject || epoch!=_epoch) return;
            _projectCoverImageUrl = updatedProject.CoverImageUrl;
            _metadataRevision = updatedProject.MetadataRevision;
            _selectedImageUrl = updatedProject.CoverImageUrl;
            _saveStatus = "Cover saved.";
            _lastAction = "Saved as project cover.";
        }
        catch (Exception ex)
        {
            _coverError = ex.Message;
        }
        finally
        {
            _isSavingCover = false; if(_request==request) _request=null;
        }
    }
}
