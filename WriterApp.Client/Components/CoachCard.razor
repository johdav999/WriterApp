@using WriterApp.Application.Subscriptions
@using WriterApp.Client.Services
@inject FeatureAccessService FeatureAccessService

<WorkspaceCoachCard ContextTitle="@Recommendation.ContextTitle" Observations="Recommendation.Observations" Why="@Recommendation.Why">
    <PrimaryAction>
        <PlanGatedButton ButtonType="button" Class="primary coach-card-next-action" Feature="@GetRequiredFeatureName()"
                         LockedTitle="@GetLockedTitle()" AriaLabel="@Recommendation.PrimaryActionLabel" OnClick="OnPrimaryAction">
            @Recommendation.PrimaryActionLabel
        </PlanGatedButton>
    </PrimaryAction>
</WorkspaceCoachCard>
@code {
    [Parameter]
    public CoachCardRecommendation Recommendation { get; set; } = new(
        "Coach",
        Array.Empty<string>(),
        "Continue",
        "The next small step keeps momentum.",
        CoachPrimaryAction.None,
        null,
        null);

    [Parameter]
    public EventCallback OnPrimaryAction { get; set; }

    private string? GetRequiredFeatureName()
    {
        return Recommendation.RequiredFeature;
    }

    private string? GetLockedTitle()
    {
        if (!TryResolveFeature(out FeatureKey feature))
        {
            return null;
        }

        return FeatureAccessService.GetRequiredPlanMessage(feature);
    }

    private bool TryResolveFeature(out FeatureKey feature)
    {
        return Enum.TryParse(Recommendation.RequiredFeature, ignoreCase: true, out feature);
    }
}
