@using System.Net.Http.Json
@using WriterApp.Shared
@using WriterApp.UI.Shared
@using WriterApp.Client.Services
@inject HttpClient Http
@inject WebCheckedAi CheckedAi
@inject WebAiHistoryOutbox Outbox
<p>Recovery uses snapshots retained on this backend for this account and manuscript. Device-local history stays on its device.</p>
<AiHistoryPanel Entries="@Items" PlainComparisons="true" Busy="@_busy" Refresh="Refresh" Undo="@(id=>Replay(id,"Undone"))" Redo="@(id=>Replay(id,"Redone"))" />
@if(_message is not null){<p role="status">@_message</p>}
@code {
    [Parameter] public Guid DocumentId {get;set;}
    [Parameter] public bool Aggregate {get;set;}
    [Parameter] public bool IncludeAggregate {get;set;}
    [Parameter] public Func<Task<bool>>? BeforeWork {get;set;}
    [Parameter] public EventCallback Changed {get;set;}
    [Parameter] public EventCallback<bool> BusyChanged {get;set;}
    private IReadOnlyList<WebRecoveryItem> _entries=[];
    private bool _busy;private string? _message;private Guid _loaded;
    private AiHistoryItem[] Items=>_entries.Select(i=>new AiHistoryItem(i.ApplicationId,i.Action,i.TargetKind,i.Outcome=="Redone"?"Applied":i.Outcome,i.CreatedAt,i.Original,i.Proposed,i.CanUndo,i.CanRedo,i.UnavailableReason,"Web scoped snapshots",CanRecover:false)).ToArray();
    protected override async Task OnParametersSetAsync(){if(DocumentId!=_loaded){_loaded=DocumentId;await Refresh();}}
    private async Task Refresh(){if(_busy)return;_busy=true;try{
        var document=DocumentId;var lease=await CheckedAi.Capture(document);
        using var response=await Http.GetAsync($"api/ai/actions/history/recovery/{document}");response.EnsureSuccessStatusCode();
        var entries=await WebAiSources.Read<WebRecoveryItem[]>(response.Content);
        CheckedAi.RequireLease(lease);if(DocumentId!=document)throw new InvalidOperationException("History target changed.");
        _entries=entries.Where(i=>IncludeAggregate || (Aggregate?i.TargetKind=="Aggregate":i.TargetKind!="Aggregate")).ToArray();_message=null;
    }catch(Exception e)when(e is HttpRequestException or InvalidOperationException or InvalidDataException or System.Text.Json.JsonException){_entries=[];_message="Recovery unavailable. Update/refresh the matching backend: "+e.Message;}finally{_busy=false;}}
    private async Task Replay(Guid id,string outcome){if(_busy)return;_busy=true;_message=null;try{
        await BusyChanged.InvokeAsync(true);
        if(BeforeWork is not null && !await BeforeWork())throw new InvalidOperationException("Save current writing and planning before recovery.");
        var item=_entries.Single(i=>i.ApplicationId==id);var document=DocumentId;
        if(outcome=="Undone"?!item.CanUndo:!item.CanRedo)throw new InvalidOperationException("This entry has no matching scoped recovery.");
        var lease=await CheckedAi.Capture(document,item.SectionId,page:item.PageId,scene:item.SceneId);
        var request=new WebRecoveryRequest(Guid.NewGuid(),id,outcome,lease.Source);
        using var response=await Http.PostAsJsonAsync("api/ai/actions/history/recovery/replay",request);
        if(!response.IsSuccessStatusCode){var error=await response.Content.ReadFromJsonAsync<System.Text.Json.JsonElement>();throw new InvalidOperationException(error.TryGetProperty("message",out var text)?text.GetString():"Recovery was refused; current content is retained.");}
        var result=await WebAiSources.Read<WebRecoveryReceipt>(response.Content);CheckedAi.RequireLease(lease);
        if(DocumentId!=document || result.Intent.OperationId!=request.OperationId || result.Intent.ApplicationId!=id || result.Intent.Source!=lease.Source)throw new InvalidDataException("Recovery returned another operation. Reload the current target.");
        WebAiHistoryContracts.RequireReceipt(result.Intent,result.Receipt);
        // Server commits snapshots/content/receipt atomically. Local delivery can reconcile after reload.
        try{await Outbox.Prepare(result.Intent,lease);await Outbox.Flush(lease);}catch(Exception e)when(e is InvalidOperationException or InvalidDataException or HttpRequestException or Microsoft.JSInterop.JSException){_message="Recovery saved; history delivery pending. Refresh to reconcile.";}
        await Changed.InvokeAsync();_message??="Scoped recovery saved.";
    }catch(Exception e)when(e is HttpRequestException or InvalidOperationException or InvalidDataException or System.Text.Json.JsonException){_message=e.Message;}finally{await BusyChanged.InvokeAsync(false);_busy=false;var message=_message;await Refresh();_message=message??_message;}}
}
