@using WriterApp.Shared.Localization
<fieldset disabled="@Disabled">
<legend>Translation scope and language</legend>
<label>Scope <select value="@Scope" @onchange="ChangeScope" disabled="@FixedScope">
    <option value="selection">Selection</option><option value="section">Current section</option><option value="document">Entire document</option>
</select></label>
<label>Source language <select value="@SourceLanguage" @onchange="ChangeSource">
<option value="auto">Auto-detect</option>
@foreach (var language in TranslationLanguages.All) { <option value="@language.Code">@language.SearchLabel</option> }
</select></label>
<label>Find target language <input type="search" @bind="_query" @bind:event="oninput" placeholder="Language or native name" maxlength="80" /></label>
<label>Target language <select value="@TargetLanguage" @onchange="ChangeLanguage">
@foreach (var language in TranslationLanguages.All.Where(l => l.Code == TargetLanguage || string.IsNullOrWhiteSpace(_query)
    || l.SearchLabel.Contains(_query, StringComparison.OrdinalIgnoreCase) || l.Code.Contains(_query, StringComparison.OrdinalIgnoreCase))) { <option value="@language.Code">@language.SearchLabel</option> }
</select></label>
<label>Style <select value="@Style" @onchange="ChangeStyle"><option value="literal">Literal</option><option value="natural">Natural</option><option value="formal">Formal</option><option value="informal">Informal</option></select></label>
</fieldset>
@code {
    private string _query = "";
    private Task ChangeScope(ChangeEventArgs e) => ScopeChanged.InvokeAsync(e.Value?.ToString() ?? "selection");
    private Task ChangeLanguage(ChangeEventArgs e) => TargetLanguageChanged.InvokeAsync(e.Value?.ToString() ?? "en");
    private Task ChangeSource(ChangeEventArgs e) => SourceLanguageChanged.InvokeAsync(e.Value?.ToString() ?? "auto");
    private Task ChangeStyle(ChangeEventArgs e) => StyleChanged.InvokeAsync(e.Value?.ToString() ?? "natural");
    [Parameter] public string Scope { get; set; } = "selection";
    [Parameter] public EventCallback<string> ScopeChanged { get; set; }
    [Parameter] public string TargetLanguage { get; set; } = "en";
    [Parameter] public EventCallback<string> TargetLanguageChanged { get; set; }
    [Parameter] public string SourceLanguage { get; set; } = "auto";
    [Parameter] public EventCallback<string> SourceLanguageChanged { get; set; }
    [Parameter] public string Style { get; set; } = "natural";
    [Parameter] public EventCallback<string> StyleChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool FixedScope { get; set; }
}
