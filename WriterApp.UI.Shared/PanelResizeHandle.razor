@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

<div @ref="_handle" class="panel-resize-handle is-@Side" role="separator" tabindex="0"
     aria-label="@Label" aria-orientation="vertical" title="Drag to resize. Use arrow keys when focused; double-click to reset."></div>

@code {
    [Parameter] public string Side { get; set; } = "right";
    [Parameter] public string Label { get; set; } = "Resize right panel";
    private ElementReference _handle;
    private IJSObjectReference? _module;
    private bool _disposed, _attaching;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed || _attaching) return;
        _attaching = true;
        var handle = _handle;
        var side = Side;
        try
        {
            if (_module is null)
            {
                var module = await JS.InvokeAsync<IJSObjectReference>("import", "/_content/WriterApp.UI.Shared/panel-resize.js");
                if (_disposed) { await module.DisposeAsync(); return; }
                _module = module;
            }
            if (!_disposed) await _module.InvokeVoidAsync("attach", handle, side);
        }
        catch (Exception error) when (_disposed && (error is JSException or ObjectDisposedException)) { }
        finally { _attaching = false; }
    }
    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        var module = _module;
        _module = null;
        if (module is null) return;
        try { await module.InvokeVoidAsync("detach", _handle); await module.DisposeAsync(); }
        catch (JSDisconnectedException) { }
    }
}
