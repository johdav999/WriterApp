@using WriterApp.Shared
<fieldset class="cover-brief" disabled="@Disabled">
    <legend>Cover brief</legend>
    <label>Describe your cover<textarea maxlength="4000" value="@_current.Description" @oninput="e => Change(description: e.Value?.ToString())" placeholder="Subject, setting and visual details"></textarea></label>
    <label>Genre<select value="@_current.Genre" @onchange="e => Change(genre: e.Value?.ToString())">@foreach(var value in CoverStudioContract.Genres) { <option>@value</option> }</select></label>
    <label>Mood<select value="@_current.Mood" @onchange="e => Change(mood: e.Value?.ToString())">@foreach(var value in CoverStudioContract.Moods) { <option>@value</option> }</select></label>
    <label>Visual style<select value="@_current.Style" @onchange="e => Change(style: e.Value?.ToString())">@foreach(var value in CoverStudioContract.Styles) { <option>@value</option> }</select></label>
    <label>Color palette<select value="@_current.ColorPalette" @onchange="e => Change(palette: e.Value?.ToString())">@foreach(var value in CoverStudioContract.Palettes) { <option>@value</option> }</select></label>
</fieldset>
@code {
    [Parameter] public CoverPrompt Value { get; set; } = new() { Genre="Fantasy", Mood="Dark", Style="Cinematic", ColorPalette="Warm" };
    [Parameter] public EventCallback<CoverPrompt> ValueChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }
    private CoverPrompt _current=new();
    protected override void OnParametersSet()=>_current=Value;
    private Task Change(string? description=null, string? genre=null, string? mood=null, string? style=null, string? palette=null) {
        // Keep consecutive input events coherent before the parent's render supplies
        // the next Value. The description is committed on input, including before blur.
        _current=new() {Description=description ?? _current.Description,Genre=genre ?? _current.Genre,Mood=mood ?? _current.Mood,
            Style=style ?? _current.Style,ColorPalette=palette ?? _current.ColorPalette};
        return ValueChanged.InvokeAsync(_current);
    }
}
