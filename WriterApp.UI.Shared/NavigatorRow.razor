<div class="tree-row @(Selected ? "is-selected" : "")" style="@($"--depth:{Depth}")" title="@Title"
     tabindex="@(Disabled ? -1 : 0)" role="treeitem" aria-selected="@Selected.ToString().ToLowerInvariant()"
     aria-disabled="@Disabled.ToString().ToLowerInvariant()" aria-level="@(Depth + 1)" aria-expanded="@(Expanded?.ToString().ToLowerInvariant())" @onclick="SelectAsync" @onkeydown="KeyAsync">
    @ChildContent
</div>
@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public int Depth { get; set; }
    [Parameter] public bool Selected { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool? Expanded { get; set; }
    [Parameter] public EventCallback OnSelect { get; set; }
    [Parameter] public EventCallback<KeyboardEventArgs> OnKeyDown { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private Task SelectAsync() => Disabled ? Task.CompletedTask : OnSelect.InvokeAsync();
    private Task KeyAsync(KeyboardEventArgs args) => Disabled ? Task.CompletedTask : OnKeyDown.InvokeAsync(args);
}
