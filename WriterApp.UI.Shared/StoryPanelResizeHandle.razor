@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

<div @ref="_handle" class="story-panel-resize-handle" role="separator" tabindex="0"
     aria-label="Resize Story and coaching panels" aria-orientation="horizontal"
     title="Drag up or down to resize. Use up/down arrow keys when focused; double-click to reset."></div>

@code {
    private ElementReference _handle;
    private IJSObjectReference? _module;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "/_content/WriterApp.UI.Shared/story-panel-resize.js");
        await _module.InvokeVoidAsync("attach", _handle);
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is null) return;
        try { await _module.InvokeVoidAsync("detach", _handle); await _module.DisposeAsync(); }
        catch (JSDisconnectedException) { }
    }
}
