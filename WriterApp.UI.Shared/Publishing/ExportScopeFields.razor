<div class="export-scope-fields">
    <label for="@Id">Scope</label>
    <select id="@Id" value="@Value" disabled="@Disabled" @onchange='e => ValueChanged.InvokeAsync(e.Value?.ToString() ?? "document")'>
        <option value="document">Whole manuscript</option>
        <option value="section">@(Extended ? "Current section" : "One section / scene")</option>
        @if (Extended) { <option value="page">Current page</option><option value="sections">Selected sections</option><option value="selection">Selection</option> }
    </select>
</div>
@code {
    [Parameter] public string Id { get; set; } = "publishing-scope";
    [Parameter] public string Value { get; set; } = "document";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public bool Extended { get; set; }
    [Parameter] public bool Disabled { get; set; }
}
