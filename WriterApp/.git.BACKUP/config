[core]
	repositoryformatversion = 0
	filemode = false
	bare = false
	logallrefupdates = true
	symlinks = false
	ignorecase = true
[branch "main"]
	vscode-merge-base = origin/main
	remote = origin
	merge = refs/heads/main
[remote "origin"]
	url = https://github.com/johdav999/WriterApp.git
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "refactor/wasm-hosted"]
	remote = origin
	merge = refs/heads/refactor/wasm-hosted
