<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:shared="clr-namespace:WriterApp.Device.Shared;assembly=WriterApp.Device.Shared" xmlns:android="clr-namespace:WriterApp.Android.Components" x:Class="WriterApp.Android.MainPage" SafeAreaEdges="All" BackgroundColor="{DynamicResource PageBackgroundColor}">
  <BlazorWebView x:Name="Browser" HostPage="wwwroot/index.html">
    <BlazorWebView.RootComponents>
      <RootComponent Selector="#app" ComponentType="{x:Type shared:Routes}" />
      <RootComponent Selector="#android-session" ComponentType="{x:Type android:AndroidSession}" />
    </BlazorWebView.RootComponents>
  </BlazorWebView>
</ContentPage>
