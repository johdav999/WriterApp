@page "/"
@inject DeviceHostOptions HostOptions
@inject LocalDocumentRepository LocalDocuments

<PageTitle>Prosa</PageTitle>

<section class="device-hero">
    <p class="device-eyebrow">@HostOptions.HostName</p>
    <h1>Your writing stays available on this device.</h1>
    <p class="device-lede">
        The native host is ready for the shared editor. Ordinary document work will use local storage;
        account sync and AI requests will use the existing Prosa backend.
    </p>
</section>

<section class="device-grid" aria-label="Device host readiness">
    <article class="device-card">
        <h2>Local documents</h2>
        <p>@_documentCount local documents available.</p>
        @if (_storageError is not null)
        {
            <p role="alert">@_storageError</p>
        }
        @foreach (var issue in _issues)
        {
            <p role="alert">@issue.FileName: @issue.Message</p>
        }
    </article>
    <article class="device-card">
        <h2>Backend</h2>
        <p>The API client points to <code>@HostOptions.ApiBaseAddress</code>.</p>
    </article>
    <article class="device-card">
        <h2>Next integration</h2>
        <p>Move reusable editor components from <code>WriterApp.Client</code> into this shared device UI.</p>
    </article>
</section>

@code {
    private int _documentCount;
    private IReadOnlyList<LocalDocumentIssue> _issues = [];
    private string? _storageError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            LocalDocumentList result = await LocalDocuments.ListAsync();
            _documentCount = result.Documents.Count;
            _issues = result.Issues;
        }
        catch (Exception error) when (error is IOException or UnauthorizedAccessException)
        {
            _storageError = "Local storage is unavailable or in use by another app instance. Close the other instance or check storage access, then reopen Prosa.";
        }
    }
}
