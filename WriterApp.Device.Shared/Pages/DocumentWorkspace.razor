    private async Task ApplySearchNavigationAsync()
    {
        if (_session is null || _lastSearch == (SearchPage, SearchQuery, SearchRequest)) return;
        try
        {
        _lastSearch = (SearchPage, SearchQuery, SearchRequest);
        _searchNotice = null;
        if (_hasRecovery || _session.Document.DeletedAtUtc is not null) { _searchNotice = "Resolve recovery or restore the document before opening a search result."; return; }
        if (_contextBusy || !await SaveAllAsync(releaseEditor: false)) return;
        var latest = await CurrentForTransferAsync();
        if (latest.LocalRevision > _session.Document.LocalRevision) _session.AdoptSavedDocument(latest);
        var page = latest.Sections.SelectMany(s => s.Pages).FirstOrDefault(p => p.PageId == SearchPage);
        if (page is null) { _searchNotice = "The search page is no longer available. Search again for its current location."; return; }
        _preview = null;
        if (_selectedPage != page.PageId) { _selectedPage = page.PageId; _editor = null; }
        else if (_editor is not null) await _editor.SetEditableAsync(true);
        _session.RememberPage(page.PageId);
        await _session.SaveAsync();
        _searchMatch = null;
        if (!string.IsNullOrWhiteSpace(SearchQuery))
        {
            string text = LocalDocumentPreview.PlainText(page);
            var match = TextSearch.Find(text, SearchQuery, 1).FirstOrDefault();
            _searchMatch = match is null ? null : text.Substring(match.Start, match.Length);
            _searchNotice = match is null ? "The result changed; this page no longer contains the search text."
                : DeviceContentCompatibility.CanEdit(page.Content, page.ContentFormat) ? "Search match selected on this local page."
                : "Search text is in this protected original. Use Preview and Find in preview to read the match.";
        }
        }
        catch (Exception error) when (error is IOException or UnauthorizedAccessException or InvalidOperationException or ArgumentException or JSException)
        { _searchNotice = "The search target changed or could not be read. Your writing remains here. Search again before navigating."; }
        finally { if (_preview is null && _editor is not null) await _editor.SetEditableAsync(true); }
    }
