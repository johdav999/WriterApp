@page "/documents/{DocumentId:guid}"
@using WriterApp.Device.Shared.Components
@using Microsoft.JSInterop
@inject LocalDocumentRepository Documents
@inject LocalRecoveryStore RecoveryStore
@inject LocalRecoveryService Recovery
@inject DeviceSaveLifetime Lifetime
@inject DeviceAiService Ai
@inject DeviceAiUndoStore AiUndo
@inject DeviceSyncEngine Sync
@inject DeviceDocumentTransfer Transfer
@inject DeviceDiagnostics Diagnostics
@implements IDisposable

<PageTitle>@(_session?.Document.Title ?? "Document") · Prosa</PageTitle>
<NavigationLock OnBeforeInternalNavigation="BeforeNavigationAsync" ConfirmExternalNavigation="@(_session?.IsDirty == true)" />

<div class="workspace-page">
    <nav aria-label="Document navigation"><a href="/">← My documents</a></nav>
    @if (_session is null)
    {
        <h1 tabindex="-1">Document</h1>
        <p role="alert">@(_error ?? "Opening document…")</p>
    }
    else
    {
        LocalDocument document = _session.Document;
        DeviceDocumentStatus status = DeviceDocumentStatus.For(document, _saveFailed || _autosave?.Error is not null ? LocalSaveState.Error : _busy ? LocalSaveState.Saving : _session.SaveState);
        <header class="workspace-heading">
            <div><p class="workspace-eyebrow">Local document</p><h1 tabindex="-1">@document.Title</h1></div>
            <span class="workspace-status" role="status" title="@status.Detail">@status.Label</span>
        </header>
        <DocumentSyncStatus Document="document" />
        @if (_error is not null) { <p class="workspace-notice" role="alert">@_error</p> }
        @if (_autosave?.Error is not null) { <p role="alert">@_autosave.Error</p> }
        @if (_hasRecovery)
        {
            <RecoveryNotice @key="DocumentId" DocumentId="DocumentId" Resolved="ReloadAfterRecoveryAsync" />
            <p>Resolve the recovery record before continuing to edit this document.</p>
        }
        else if (document.DeletedAtUtc is not null)
        {
            <p class="workspace-notice">This document is in Trash. Restore it from the library before editing.</p>
        }
        else if (_selectedPage is not null)
        {
            <div class="workspace-controls">
                <label for="page-selection">Section / page</label>
                <select id="page-selection" @bind:get="_selectedPage" @bind:set="SwitchPageAsync" disabled="@(_busy || _aiBusy || _applyingAi || _transferBusy)">
                    @foreach (LocalSection section in document.Sections)
                    {
                        <optgroup label="@section.Title">
                            @foreach (LocalPage item in section.Pages)
                            {
                                <option value="@item.PageId">@section.Title — @item.Title</option>
                            }
                        </optgroup>
                    }
                </select>
                <button type="button" disabled="@(_busy || _transferBusy)" @onclick="SaveButtonAsync">Save on this device</button>
            </div>
            <p class="workspace-help">Autosaves on this device after typing pauses. Ctrl+S to retry/save · Ctrl+B bold · Ctrl+I italic · Ctrl+K link · Ctrl+Z undo · Ctrl+Y redo.</p>
            LocalPage selected = document.Sections.SelectMany(section => section.Pages).Single(item => item.PageId == _selectedPage);
            <DeviceTextEditor @key="selected.PageId" @ref="_editor"
                              Content="@_session.ContentFor(selected)" Format="@_session.FormatFor(selected)"
                              ContentChanged="html => OnEdited(selected.PageId, html)" SaveRequested="SaveButtonAsync" />
            <details class="workspace-ai" aria-label="AI writing actions">
                <summary>AI writing help</summary>
                <p>AI uses the synced cloud copy. Select text for Rewrite, Expand, or Shorten. Summarize reads the current section.</p>
                @if (document.ServerDocumentId is null)
                { <p>Enable cloud sync for this document before using AI.</p> }
                <div class="workspace-ai-actions">
                    <button type="button" disabled="@(_busy || _aiBusy || _transferBusy || document.ServerDocumentId is null)" @onclick="() => RunAiAsync(DeviceAiAction.Rewrite)">Rewrite selection</button>
                    <button type="button" disabled="@(_busy || _aiBusy || _transferBusy || document.ServerDocumentId is null)" @onclick="() => RunAiAsync(DeviceAiAction.Expand)">Expand selection</button>
                    <button type="button" disabled="@(_busy || _aiBusy || _transferBusy || document.ServerDocumentId is null)" @onclick="() => RunAiAsync(DeviceAiAction.Shorten)">Shorten selection</button>
                    <button type="button" disabled="@(_busy || _aiBusy || _transferBusy || document.ServerDocumentId is null)" @onclick="() => RunAiAsync(DeviceAiAction.Summarize)">Summarize section</button>
                </div>
                <label for="custom-ai-instruction">Custom instruction</label>
                <textarea id="custom-ai-instruction" @bind="_customAiInstruction" maxlength="2000" rows="2"
                          disabled="@(_busy || _aiBusy || _transferBusy)" placeholder="Describe the change you want"></textarea>
                <button type="button" disabled="@(_busy || _aiBusy || _transferBusy || document.ServerDocumentId is null)" @onclick="() => RunAiAsync(DeviceAiAction.Custom)">Preview custom action</button>
                @if (_aiBusy)
                {
                    <p role="status">Preparing an AI proposal. Your writing is unchanged.</p>
                    <button type="button" @onclick="CancelAi">Cancel AI request</button>
                }
                @if (_aiError is not null) { <p role="alert">@_aiError</p> }
                @if (_aiMessage is not null) { <p role="status">@_aiMessage</p> }
                @if (_aiProposal is { } proposal)
                {
                    <div class="workspace-ai-preview" role="group" aria-label="AI proposal preview">
                        <h3>Review before applying</h3>
                        @if (!string.IsNullOrWhiteSpace(proposal.Summary)) { <p>@proposal.Summary</p> }
                        <h4>@(proposal.Prepared.ApplyMode == "append" ? "Source section" : "Original selection")</h4>
                        <pre>@proposal.SourceText</pre>
                        <h4>Proposed text</h4><pre>@proposal.ProposedText</pre>
                        <p>@(proposal.Prepared.ApplyMode == "append" ? "Apply adds this text at the end of the current page." : "Apply replaces only the selected text.")</p>
                        <button type="button" disabled="@(_busy || _aiBusy || _applyingAi || _transferBusy)" @onclick="ApplyAiAsync">Apply</button>
                        <button type="button" disabled="@(_busy || _aiBusy || _applyingAi || _transferBusy)" @onclick="DismissAi">Dismiss</button>
                    </div>
                }
                @if (_aiUndo is { AfterHtml: not null } && _aiUndo.PageId == _selectedPage)
                { <button type="button" disabled="@(_busy || _aiBusy || _applyingAi || _transferBusy)" @onclick="UndoAiAsync">Restore writing before last AI apply</button> }
                @if (_aiPendingUndo is { } pending && pending.PageId == _selectedPage)
                {
                    <details><summary>Writing saved before an interrupted AI apply</summary><pre>@pending.BeforeHtml</pre></details>
                    <button type="button" disabled="@(_busy || _aiBusy || _applyingAi || _transferBusy)" @onclick="RestorePendingCopyAsync">Save this earlier writing as a separate local copy</button>
                }
                @if (_aiRecoveredCopy is { } recovered)
                { <a href="@($"/documents/{recovered}")">Open recovered copy</a> }
            </details>
            @if (Transfer.IsAvailable)
            {
                <details class="workspace-transfer" aria-label="Local import and export">
                    <summary>Import and export</summary>
                    <p>Import UTF-8 .txt, .html, or .htm (up to 5 MB) into this page of the current section. Unsupported formatting, scripts, images, and active content are removed. Choose how the imported writing changes this page.</p>
                    <label for="import-mode">Import into @document.Sections.Single(s => s.Pages.Any(p => p.PageId == _selectedPage)).Title / @document.Sections.SelectMany(s => s.Pages).Single(p => p.PageId == _selectedPage).Title</label>
                    <select id="import-mode" @bind="_importModeChoice" disabled="@(_busy || _aiBusy || _transferBusy)">
                        <option value="">Choose append or replace</option>
                        <option value="append">Append after this page's writing</option>
                        <option value="replace">Replace this page's writing</option>
                    </select>
                    <button type="button" disabled="@(_busy || _aiBusy || _transferBusy || string.IsNullOrEmpty(_importModeChoice))" @onclick="ImportIntoPageAsync">Choose file and import</button>
                    <p>Export the entire local document without signing in or syncing. HTML keeps supported formatting and opens in a browser or word processor; plain text keeps the words and section order. Legacy JSON pages must be opened and saved first.</p>
                    <label for="export-format">Export format</label>
                    <select id="export-format" @bind="_exportFormat" disabled="@(_busy || _aiBusy || _transferBusy)">
                        <option value="Html">HTML document (.html)</option>
                        <option value="Text">Plain text (.txt)</option>
                    </select>
                    <button type="button" disabled="@(_busy || _aiBusy || _transferBusy)" @onclick="ExportDocumentAsync">Choose save location</button>
                    @if (_transferMessage is not null) { <p role="status">@_transferMessage</p> }
                    @if (_transferError is not null) { <p role="alert">@_transferError</p> }
                </details>
            }
        }
        else
        {
            <p>This document has no pages to edit.</p>
        }
    }
</div>

@code {
    [Parameter] public Guid DocumentId { get; set; }
    private LocalEditorSession? _session;
    private DeviceTextEditor? _editor;
    private Guid? _selectedPage;
    private string? _error;
    private bool _busy;
    private bool _saveFailed;
    private bool _hasRecovery;
    private LocalAutosaveCoordinator? _autosave;
    private readonly SemaphoreSlim _flushGate = new(1, 1);
    private Func<bool, Task<bool>>? _lifetimeFlush;
    private bool _disposed;
    private Guid? _editingId;
    private string _customAiInstruction = "";
    private bool _aiBusy;
    private bool _applyingAi;
    private string? _aiError;
    private string? _aiMessage;
    private DeviceAiProposal? _aiProposal;
    private DeviceAiUndoRecord? _aiUndo;
    private DeviceAiUndoRecord? _aiPendingUndo;
    private Guid? _aiRecoveredCopy;
    private CancellationTokenSource? _aiRequest;
    private bool _transferBusy;
    private string _importModeChoice = "";
    private DeviceExportFormat _exportFormat = DeviceExportFormat.Html;
    private string? _transferMessage;
    private string? _transferError;

    protected override async Task OnParametersSetAsync()
    {
        if (_session?.Document.DocumentId == DocumentId) return;
        if (_editingId is { } previous) Documents.EndEditing(previous);
        _aiRequest?.Cancel();
        _aiProposal = null; _aiUndo = null; _aiPendingUndo = null; _aiRecoveredCopy = null; _aiError = null; _aiMessage = null;
        _transferMessage = null; _transferError = null; _importModeChoice = "";
        _editingId = DocumentId;
        Documents.BeginEditing(DocumentId);
        _autosave?.Dispose();
        _autosave = null;
        _session = null;
        _editor = null;
        _selectedPage = null;
        _hasRecovery = false;
        _error = null;
        _saveFailed = false;
        Guid loadingId = DocumentId;
        try
        {
            LocalDocument? document = await Documents.LoadAsync(loadingId);
            if (DocumentId != loadingId) return;
            if (document is null) { _error = "This document was not found on this device."; return; }
            bool hasRecovery = (await Recovery.DiscoverAsync()).Records.Any(r => r.Document.DocumentId == loadingId);
            if (DocumentId != loadingId || _disposed) return;
            _session = new LocalEditorSession(Documents, document);
            _hasRecovery = hasRecovery;
            _autosave = new LocalAutosaveCoordinator(_session, RecoveryStore, () => InvokeAsync(SaveButtonAsync));
            _autosave.Changed += OnSaveChanged;
            _lifetimeFlush = closing => InvokeFlushAsync(closing);
            Lifetime.Flush = _lifetimeFlush;
            _selectedPage = document.Sections.SelectMany(section => section.Pages).FirstOrDefault()?.PageId;
            try { _aiUndo = await AiUndo.LoadAsync(loadingId); _aiPendingUndo = await AiUndo.LoadPendingAsync(loadingId); }
            catch (Exception error) when (error is IOException or System.Text.Json.JsonException)
            { _aiError = "The previous AI undo backup could not be read. Its file was preserved."; }
        }
        catch (Exception error) when (error is IOException or UnauthorizedAccessException)
        { _error = error is LocalDocumentReadException read ? read.Issue.Message : "Unable to read local storage. Check access and try again."; }
    }

    private Task OnEdited(Guid pageId, string html) => _autosave?.EditAsync(pageId, html) ?? Task.CompletedTask;

    private async Task RunAiAsync(DeviceAiAction action)
    {
        if (_aiBusy || _busy || _applyingAi || _transferBusy || _session is null || _editor is null || _selectedPage is null || _hasRecovery) return;
        _aiProposal = null; _aiError = null; _aiMessage = null; _aiBusy = true;
        using var request = new CancellationTokenSource();
        _aiRequest = request;
        Guid pageId = _selectedPage.Value;
        try
        {
            var capture = await _editor.CaptureAiAsync();
            if (action is DeviceAiAction.Rewrite or DeviceAiAction.Expand or DeviceAiAction.Shorten
                && string.IsNullOrWhiteSpace(capture.SelectedText))
                throw new DeviceAiException(DeviceAiFailure.Invalid, "Select text in the editor first.");
            if (_session.ContentFor(_session.Document.Sections.SelectMany(s => s.Pages).Single(p => p.PageId == pageId)) != capture.Html)
                await OnEdited(pageId, capture.Html);
            if (!await SaveCurrentAsync()) return;
            await Sync.SyncAsync(request.Token);
            request.Token.ThrowIfCancellationRequested();
            LocalDocument latest = await Documents.LoadAsync(DocumentId, request.Token)
                ?? throw new IOException("The document is no longer available.");
            LocalSection section = latest.Sections.Single(s => s.Pages.Any(p => p.PageId == pageId));
            LocalPage page = section.Pages.Single(p => p.PageId == pageId);
            if (_selectedPage != pageId || page.Content != capture.Html)
                throw new DeviceAiException(DeviceAiFailure.Invalid, "The writing changed while syncing. Review it and run AI again.");
            var prepared = DeviceAiRequests.Build(latest, section, page, capture, action, _customAiInstruction);
            _aiProposal = await Ai.ProposeAsync(prepared, request.Token);
            _aiMessage = "Proposal ready. Review both versions before applying.";
        }
        catch (OperationCanceledException) { _aiMessage = "AI request canceled. Your writing is unchanged."; }
        catch (DeviceAiException error) { _aiError = error.Message; }
        catch (Exception error) when (error is HttpRequestException or IOException or InvalidOperationException or JSException)
        { _aiError = "AI could not prepare a proposal. Check the connection or editor and try again; your writing is unchanged."; }
        finally { _aiRequest = null; _aiBusy = false; if (!_disposed) StateHasChanged(); }
    }
    private void CancelAi() => _aiRequest?.Cancel();
    private void DismissAi() { _aiProposal = null; _aiMessage = "Proposal dismissed. Your writing is unchanged."; }

    private async Task ApplyAiAsync()
    {
        if (_aiProposal is not { } proposal || _editor is null || _selectedPage != proposal.Prepared.LocalPageId || _busy || _applyingAi || _transferBusy) return;
        _applyingAi = true;
        _aiError = null;
        try
        {
            var record = new DeviceAiUndoRecord(DocumentId, _selectedPage.Value, proposal.Prepared.BaseHtml, null, DateTimeOffset.UtcNow);
            await AiUndo.SaveBeforeAsync(record);
            _aiPendingUndo = record;
            string after = await _editor.ApplyAiAsync(proposal.Prepared.BaseHtml, proposal.Prepared.From, proposal.Prepared.To,
                proposal.Prepared.SelectedText, proposal.ProposedText, proposal.Prepared.ApplyMode);
            _aiProposal = null;
            bool saved = await SaveCurrentAsync();
            if (!saved) return;
            _aiUndo = record with { AfterHtml = after };
            await AiUndo.ConfirmAsync(_aiUndo);
            _aiPendingUndo = null;
            _aiMessage = "Applied and saved locally. Undo in the editor or restore the saved pre-AI writing.";
        }
        catch (Exception error) when (error is IOException or UnauthorizedAccessException or InvalidOperationException or JSException)
        { _aiError = error is JSException ? "The writing changed after the preview. Run AI again; no proposal was applied." : "AI apply or backup failed. Check local storage and review your writing before retrying."; }
        finally { _applyingAi = false; }
    }
    private async Task UndoAiAsync()
    {
        if (_aiUndo is not { AfterHtml: not null } record || _editor is null || _selectedPage != record.PageId || _busy || _transferBusy) return;
        _aiError = null;
        try
        {
            await _editor.RestoreAiAsync(record.AfterHtml, record.BeforeHtml);
            if (await SaveCurrentAsync()) _aiMessage = "Original writing restored and saved locally.";
        }
        catch (Exception error) when (error is IOException or UnauthorizedAccessException or InvalidOperationException or JSException)
        { _aiError = "The page changed after AI was applied, so the saved original was not restored automatically. Your current writing is unchanged."; }
    }
    private async Task RestorePendingCopyAsync()
    {
        if (_aiPendingUndo is not { } record || _busy || _transferBusy) return;
        try
        {
            LocalDocument source = await Documents.LoadAsync(DocumentId) ?? throw new IOException("Document missing.");
            int sectionIndex = Array.FindIndex(source.Sections.ToArray(), s => s.Pages.Any(p => p.PageId == record.PageId));
            if (sectionIndex < 0) throw new InvalidOperationException("The earlier page no longer exists.");
            int pageIndex = Array.FindIndex(source.Sections[sectionIndex].Pages.ToArray(), p => p.PageId == record.PageId);
            LocalDocument copy = await Documents.DuplicateAsync(DocumentId);
            var sections = copy.Sections.ToArray();
            var pages = sections[sectionIndex].Pages.ToArray();
            pages[pageIndex] = pages[pageIndex] with { Content = record.BeforeHtml, ContentFormat = LocalContentFormat.Html };
            sections[sectionIndex] = sections[sectionIndex] with { Pages = pages };
            copy = await Documents.SaveAsync(copy with { Sections = sections });
            _aiRecoveredCopy = copy.DocumentId;
            _aiMessage = "The earlier writing was saved as a separate local copy.";
        }
        catch (Exception error) when (error is IOException or UnauthorizedAccessException or InvalidOperationException)
        { _aiError = "Could not create the recovery copy. The earlier source remains in the AI backup file."; }
    }

    private async Task ImportIntoPageAsync()
    {
        if (_transferBusy || _busy || _aiBusy || _applyingAi || _session is null || _editor is null
            || _selectedPage is null || _hasRecovery || _importModeChoice is not ("append" or "replace")) return;
        _transferBusy = true; _transferError = null; _transferMessage = null;
        bool committed = false;
        try
        {
            DevicePreparedImport? import = await Transfer.PickImportAsync();
            if (import is null) { _transferMessage = "Import canceled. Your writing is unchanged."; return; }
            if (!await SaveCurrentAsync(releaseEditor: false)) return;
            LocalDocument latest = await CurrentForTransferAsync();
            LocalDocument saved = await Transfer.ImportPageAsync(latest, _selectedPage.Value, import,
                _importModeChoice == "append" ? DeviceImportMode.Append : DeviceImportMode.Replace);
            committed = true;
            _session.AdoptSavedDocument(saved);
            string html = saved.Sections.SelectMany(s => s.Pages).Single(p => p.PageId == _selectedPage).Content;
            await _editor.SetContentAsync(html);
            _aiProposal = null;
            _transferMessage = "Imported and saved on this device. Cloud sync will pick up the local change when available.";
        }
        catch (Exception error) when (error is IOException or UnauthorizedAccessException or InvalidOperationException
            or ArgumentException or JSException or System.Runtime.InteropServices.COMException)
        {
            _transferError = committed
                ? "The import was saved locally, but the editor could not refresh. Reopen this document to see it."
                : error is InvalidDataException ? error.Message
                : error is LocalDocumentConflictException ? "This document changed during import. Review the current version and try again."
                : "Import failed. The existing writing was not changed.";
        }
        finally
        {
            try { if (_editor is not null) await _editor.SetEditableAsync(true); } catch (JSException) { }
            _transferBusy = false;
        }
    }

    private async Task ExportDocumentAsync()
    {
        if (_transferBusy || _busy || _aiBusy || _applyingAi || _session is null || _editor is null || _hasRecovery) return;
        _transferBusy = true; _transferError = null; _transferMessage = null;
        try
        {
            if (!await SaveCurrentAsync(releaseEditor: false)) return;
            LocalDocument latest = await CurrentForTransferAsync();
            bool saved = await Transfer.ExportAsync(latest, _exportFormat);
            _transferMessage = saved ? "Document exported to the chosen file." : "Export canceled. No file was written.";
        }
        catch (Exception error) when (error is IOException or UnauthorizedAccessException or InvalidOperationException
            or ArgumentException or JSException or System.Runtime.InteropServices.COMException)
        {
            _transferError = error is InvalidDataException ? error.Message
                : error is LocalDocumentConflictException ? "This document changed during export. Review it and try again."
                : "Export failed. Your local document was not changed.";
        }
        finally
        {
            try { if (_editor is not null) await _editor.SetEditableAsync(true); } catch (JSException) { }
            _transferBusy = false;
        }
    }

    private async Task<LocalDocument> CurrentForTransferAsync()
    {
        LocalDocument latest = await Documents.LoadAsync(DocumentId) ?? throw new IOException("Document missing.");
        if (_session is null || DeviceSyncMapping.Fingerprint(latest) != DeviceSyncMapping.Fingerprint(_session.Document))
            throw new LocalDocumentConflictException(DocumentId);
        return latest;
    }

    private void OnSaveChanged() { if (!_disposed) _ = InvokeAsync(StateHasChanged); }
    private async Task<bool> InvokeFlushAsync(bool closing)
    {
        bool saved = false;
        await InvokeAsync(async () => saved = await SaveCurrentAsync(releaseEditor: !closing));
        return saved;
    }
    private async Task ReloadAfterRecoveryAsync()
    { _hasRecovery = (await Recovery.DiscoverAsync()).Records.Any(r => r.Document.DocumentId == DocumentId); await InvokeAsync(StateHasChanged); }

    private async Task SaveButtonAsync() => await SaveCurrentAsync();

    private async Task<bool> SaveCurrentAsync(bool releaseEditor = true)
    {
        if (_session is null || _hasRecovery || _disposed) return true;
        await _flushGate.WaitAsync();
        if (_session is null || _hasRecovery || _disposed) { _flushGate.Release(); return true; }
        _busy = true;
        _saveFailed = false;
        _error = null;
        bool saved = false;
        try
        {
            if (_editor is not null)
            {
                // Autosave must not blur contenteditable or interrupt typing. The session
                // preserves edits arriving during SaveAsync; freeze only for leaving/replacing a page.
                if (!releaseEditor) await _editor.SetEditableAsync(false);
                await _editor.FlushAsync();
            }
            StateHasChanged();
            await _autosave!.SaveAsync();
            saved = true;
            return true;
        }
        catch (Exception error) when (error is IOException or UnauthorizedAccessException or InvalidOperationException or JSException)
        {
            try { await Diagnostics.RecordAsync(DeviceDiagnosticEvent.SaveFailed, error: error); }
            catch (Exception logError) when (logError is IOException or UnauthorizedAccessException) { }
            _saveFailed = true;
            _error = error is LocalDocumentConflictException
                ? "This document changed elsewhere. Your edits remain here; copy your text before reloading to resolve the conflict."
                : "Saving failed. Your edits remain here. Check local storage and try Save again before leaving.";
            return false;
        }
        finally
        {
            _busy = false;
            try
            {
                if (_editor is not null && !releaseEditor && !saved)
                {
                    try { await _editor.SetEditableAsync(true); }
                    catch (JSException) { }
                }
            }
            finally { _flushGate.Release(); }
            if (!_disposed) StateHasChanged();
        }
    }

    private async Task SwitchPageAsync(Guid? id)
    {
        if (id is null || id == _selectedPage || _transferBusy) return;
        if (await SaveCurrentAsync(releaseEditor: false)) { _selectedPage = id; _editor = null; }
    }

    private async Task BeforeNavigationAsync(LocationChangingContext context)
    {
        if (_applyingAi || _transferBusy) { context.PreventNavigation(); return; }
        if (!await SaveCurrentAsync(releaseEditor: false) || _session?.IsDirty == true)
        {
            context.PreventNavigation();
            if (_editor is not null) await _editor.SetEditableAsync(true);
        }
    }

    public void Dispose()
    {
        _disposed = true;
        _aiRequest?.Cancel();
        if (_editingId is { } id) Documents.EndEditing(id);
        _autosave?.Dispose();
        if (Lifetime.Flush == _lifetimeFlush) Lifetime.Flush = null;
    }
}
