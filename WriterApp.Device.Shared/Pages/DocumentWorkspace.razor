@page "/documents/{DocumentId:guid}"
@using WriterApp.Device.Shared.Components
@using Microsoft.JSInterop
@inject LocalDocumentRepository Documents

<PageTitle>@(_session?.Document.Title ?? "Document") · Prosa</PageTitle>
<NavigationLock OnBeforeInternalNavigation="BeforeNavigationAsync" ConfirmExternalNavigation="@(_session?.IsDirty == true)" />

<div class="workspace-page">
    <nav aria-label="Document navigation"><a href="/">← My documents</a></nav>
    @if (_session is null)
    {
        <h1 tabindex="-1">Document</h1>
        <p role="alert">@(_error ?? "Opening document…")</p>
    }
    else
    {
        LocalDocument document = _session.Document;
        DeviceDocumentStatus status = DeviceDocumentStatus.For(document, _saveFailed ? LocalSaveState.Error : _busy ? LocalSaveState.Saving : _session.SaveState);
        <header class="workspace-heading">
            <div><p class="workspace-eyebrow">Local document</p><h1 tabindex="-1">@document.Title</h1></div>
            <span class="workspace-status" role="status" title="@status.Detail">@status.Label</span>
        </header>
        @if (_error is not null) { <p class="workspace-notice" role="alert">@_error</p> }
        @if (document.DeletedAtUtc is not null)
        {
            <p class="workspace-notice">This document is in Trash. Restore it from the library before editing.</p>
        }
        else if (_selectedPage is not null)
        {
            <div class="workspace-controls">
                <label for="page-selection">Section / page</label>
                <select id="page-selection" @bind:get="_selectedPage" @bind:set="SwitchPageAsync" disabled="@_busy">
                    @foreach (LocalSection section in document.Sections)
                    {
                        <optgroup label="@section.Title">
                            @foreach (LocalPage item in section.Pages)
                            {
                                <option value="@item.PageId">@section.Title — @item.Title</option>
                            }
                        </optgroup>
                    }
                </select>
                <button type="button" disabled="@_busy" @onclick="SaveButtonAsync">Save on this device</button>
            </div>
            <p class="workspace-help">Ctrl+S to save · Ctrl+B bold · Ctrl+I italic · Ctrl+K link · Ctrl+Z undo · Ctrl+Y redo. Pages save before you switch or return to the library.</p>
            LocalPage selected = document.Sections.SelectMany(section => section.Pages).Single(item => item.PageId == _selectedPage);
            <DeviceTextEditor @key="selected.PageId" @ref="_editor"
                              Content="@_session.ContentFor(selected)" Format="@_session.FormatFor(selected)"
                              ContentChanged="html => OnEdited(selected.PageId, html)" SaveRequested="SaveButtonAsync" />
        }
        else
        {
            <p>This document has no pages to edit.</p>
        }
    }
</div>

@code {
    [Parameter] public Guid DocumentId { get; set; }
    private LocalEditorSession? _session;
    private DeviceTextEditor? _editor;
    private Guid? _selectedPage;
    private string? _error;
    private bool _busy;
    private bool _saveFailed;

    protected override async Task OnParametersSetAsync()
    {
        if (_session?.Document.DocumentId == DocumentId) return;
        _session = null;
        _editor = null;
        _error = null;
        _saveFailed = false;
        Guid loadingId = DocumentId;
        try
        {
            LocalDocument? document = await Documents.LoadAsync(loadingId);
            if (DocumentId != loadingId) return;
            if (document is null) { _error = "This document was not found on this device."; return; }
            _session = new LocalEditorSession(Documents, document);
            _selectedPage = document.Sections.SelectMany(section => section.Pages).FirstOrDefault()?.PageId;
        }
        catch (Exception error) when (error is IOException or UnauthorizedAccessException)
        { _error = error is LocalDocumentReadException read ? read.Issue.Message : "Unable to read local storage. Check access and try again."; }
    }

    private void OnEdited(Guid pageId, string html) => _session?.Edit(pageId, html);

    private async Task SaveButtonAsync() => await SaveCurrentAsync();

    private async Task<bool> SaveCurrentAsync(bool releaseEditor = true)
    {
        if (_session is null) return true;
        if (_busy) return false;
        _busy = true;
        _saveFailed = false;
        _error = null;
        bool saved = false;
        try
        {
            if (_editor is not null)
            {
                await _editor.SetEditableAsync(false);
                await _editor.FlushAsync();
            }
            StateHasChanged();
            await _session.SaveAsync();
            saved = true;
            return true;
        }
        catch (Exception error) when (error is IOException or UnauthorizedAccessException or InvalidOperationException or JSException)
        {
            _saveFailed = true;
            _error = error is LocalDocumentConflictException
                ? "This document changed elsewhere. Your edits remain here; copy your text before reloading to resolve the conflict."
                : "Saving failed. Your edits remain here. Check local storage and try Save again before leaving.";
            return false;
        }
        finally
        {
            _busy = false;
            if (_editor is not null && (releaseEditor || !saved))
            {
                try { await _editor.SetEditableAsync(true); }
                catch (JSException) { }
            }
        }
    }

    private async Task SwitchPageAsync(Guid? id)
    {
        if (id is null || id == _selectedPage) return;
        if (await SaveCurrentAsync(releaseEditor: false)) { _selectedPage = id; _editor = null; }
    }

    private async Task BeforeNavigationAsync(LocationChangingContext context)
    {
        if (!await SaveCurrentAsync(releaseEditor: false) || _session?.IsDirty == true)
        {
            context.PreventNavigation();
            if (_editor is not null) await _editor.SetEditableAsync(true);
        }
    }
}
