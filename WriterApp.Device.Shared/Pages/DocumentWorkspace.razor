    protected override async Task OnParametersSetAsync()
    {
        if (_session?.Document.DocumentId == DocumentId) { await ApplySearchNavigationAsync(); await ApplyPanelNavigationAsync(); return; }
        View.Reset();
        _documentMenuOpen = false;
        _subviews.Clear(); _planningPanel = null; _aiPanel = null; _promptPanel = null; _qualityPanel = null; _translationPanel = null; _consistencyPassage = null; _lastPanelNavigation = null;
        if (_editingId is { } previous) Documents.EndEditing(previous);
        _aiRequest?.Cancel();
        _aiProposal = null; _aiUndo = null; _aiPendingUndo = null; _aiRecoveredCopy = null; _aiError = null; _aiMessage = null;
        _transferMessage = null; _transferError = null; _importModeChoice = "";
        _structureMessage = null;
        _preview = null; _searchMatch = null; _searchNotice = null; _lastSearch = default;
        _editingId = DocumentId;
        Documents.BeginEditing(DocumentId);
        _autosave?.Dispose();
        _autosave = null;
        _session = null;
        _editor = null;
        _selectedPage = null;
        _hasRecovery = false;
        _error = null;
        _saveFailed = false;
        Guid loadingId = DocumentId;
        try
        {
            LocalDocument? document = await Documents.LoadAsync(loadingId);
            if (DocumentId != loadingId) return;
            if (document is null) { _error = "This document was not found on this device."; return; }
            bool hasRecovery = (await Recovery.DiscoverAsync()).Records.Any(r => r.Document.DocumentId == loadingId);
            if (DocumentId != loadingId || _disposed) return;
            _session = new LocalEditorSession(Documents, document);
            _hasRecovery = hasRecovery;
            _autosave = new LocalAutosaveCoordinator(_session, RecoveryStore, () => InvokeAsync(SaveButtonAsync));
            _autosave.Changed += OnSaveChanged;
            _lifetimeFlush = closing => InvokeFlushAsync(closing);
            Lifetime.Flush = _lifetimeFlush;
            _selectedPage = document.Sections.SelectMany(section => section.Pages).FirstOrDefault(p => p.PageId == document.Project?.LastPageId)?.PageId
                ?? document.Sections.SelectMany(section => section.Pages).FirstOrDefault()?.PageId;
            await ApplySearchNavigationAsync();
            await ApplyPanelNavigationAsync();
            try { await ReloadHistoryAsync(); _aiUndo = await AiUndo.LoadAsync(loadingId); _aiPendingUndo = await AiUndo.LoadPendingAsync(loadingId); }
            catch (Exception error) when (error is IOException or InvalidDataException or UnauthorizedAccessException or System.Text.Json.JsonException)
            { _aiError = "AI history or undo evidence could not be read. Existing files were preserved; local editing remains available."; }
        }
        catch (Exception error) when (error is IOException or InvalidDataException or UnauthorizedAccessException)
        { _error = error is LocalDocumentReadException read ? read.Issue.Message : "Unable to read local storage. Check access and try again."; }
    }

