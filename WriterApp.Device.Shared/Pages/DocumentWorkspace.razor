    private async Task AfterContextWorkAsync()
    {
        try {
            if (_session is not null && !_session.IsDirty) {
                var latest = await Documents.LoadAsync(DocumentId);
                if (latest is not null && latest.LocalRevision > _session.Document.LocalRevision) {
                    var oldPage = _session.Document.Sections.SelectMany(s => s.Pages).FirstOrDefault(p => p.PageId == _selectedPage);
                    string? before = oldPage is null ? null : _session.ContentFor(oldPage);
                    _session.AdoptSavedDocument(latest);
                    var page = latest.Sections.SelectMany(s => s.Pages).FirstOrDefault(p => p.PageId == _selectedPage);
                    if (_editor is not null && page is not null && (before != page.Content || oldPage?.ContentFormat != page.ContentFormat))
                        await _editor.SetContentAsync(page.Content, page.ContentFormat);
                }
            }
        } catch (Exception e) when (e is IOException or InvalidOperationException or UnauthorizedAccessException or JSException) { _error = "Reloading saved panel changes failed. " + e.Message; }
        finally { await ReleaseContextEditorAsync(); if (!_disposed) await InvokeAsync(StateHasChanged); }
    }
