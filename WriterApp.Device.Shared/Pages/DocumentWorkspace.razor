    private async Task TogglePreviewAsync()
    {
        if (_session is null || _contextBusy || _busy || _previewBusy || _structureBusy || _transferBusy || _aiBusy || _applyingAi || _hasRecovery) return;
        if (_preview is not null)
        {
            _preview = null;
            if (_editor is not null) await _editor.SetEditableAsync(true);
            return;
        }
        if (!await FlushPlanningAsync()) return;
        _previewBusy = true;
        try
        {
            if (!await SaveCurrentAsync(releaseEditor: false) || _session.IsDirty) return;
            var saved = await CurrentForTransferAsync();
            _preview = await Task.Run(() => LocalDocumentPreview.Create(saved));
        }
        catch (Exception error) when (error is IOException or UnauthorizedAccessException or InvalidOperationException or ArgumentException or JSException)
        { _error = "Preview could not read a current saved snapshot. Your writing is unchanged. Save and retry."; }
        finally
        {
            _previewBusy = false;
            if (_preview is null && _editor is not null) await _editor.SetEditableAsync(true);
        }
    }

    private async Task RunAiAsync(DeviceAiAction action)
    {
        if (_aiBusy || _applyingAi) return;
        if (_promptPanel?.IsBusy == true || _writingPanel?.IsBusy == true || _translationPanel?.IsBusy == true || _qualityPanel?.IsBusy == true || PanelOperationsDisabled)
        { _aiError = "Finish the current operation before requesting an AI review."; _focusAiFeedback = true; return; }
        if (_session is null || _editor is null || _selectedPage is null)
        { _aiError = "The editor is not ready. Open a page and try the review again."; _focusAiFeedback = true; return; }
        if (action == DeviceAiAction.Custom) {
            DismissAi(); _aiError = null; _aiMessage = null;
            if (_writingPanel is not null) await _writingPanel.RunCustomAsync(_customAiInstruction);
            return;
        }
        _aiProposal = null; _aiError = null; _aiMessage = "Saving the writing for review…"; _aiBusy = true;
        using var request = new CancellationTokenSource();
        _aiRequest = request;
        Guid pageId = _selectedPage.Value;
        try
        {
            if (!await FlushPlanningAsync())
            { _aiError = "Save the pending planning changes before requesting an AI review."; return; }
            var capture = await _editor.CaptureAiAsync(currentSelectionOnly: action == DeviceAiAction.StyleQuality);
            if (action == DeviceAiAction.StyleQuality && string.IsNullOrWhiteSpace(capture.SelectedText))
                capture = await _editor.CaptureAiAsync(wholePage: true);
            if (action is DeviceAiAction.Rewrite or DeviceAiAction.Expand or DeviceAiAction.Shorten or DeviceAiAction.Translate
                && string.IsNullOrWhiteSpace(capture.SelectedText))
                throw new DeviceAiException(DeviceAiFailure.Invalid, "Select text in the editor first.");
            if (_session.ContentFor(_session.Document.Sections.SelectMany(s => s.Pages).Single(p => p.PageId == pageId)) != capture.Html)
                await OnEdited(pageId, capture.Html);
            if (!await SaveCurrentAsync())
            { _aiError = _error ?? "Save the writing before requesting an AI review."; _aiMessage = null; return; }
            _aiMessage = "Synchronizing the saved writing before requesting AI…";
            StateHasChanged();
            await Sync.SyncAsync(request.Token);
            request.Token.ThrowIfCancellationRequested();
            LocalDocument latest = await Documents.LoadAsync(DocumentId, request.Token)
                ?? throw new IOException("The document is no longer available.");
            LocalSection section = latest.Sections.Single(s => s.Pages.Any(p => p.PageId == pageId));
            LocalPage page = section.Pages.Single(p => p.PageId == pageId);
            if (_selectedPage != pageId || page.Content != capture.Html)
                throw new DeviceAiException(DeviceAiFailure.Invalid, "The writing changed while syncing. Review it and run AI again.");
            var prepared = DeviceAiRequests.Build(latest, section, page, capture, action, action == DeviceAiAction.Translate ? _targetLanguage : _customAiInstruction,
                translationSource: _translationSource, translationStyle: _translationStyle, styleGoal: _styleGoal);
            prepared=LocalWritingOutline.Bind(prepared,latest);
            if(prepared.Request.WritingOutline is not null)await Ai.RequireWritingOutlineCapabilityAsync(request.Token);
            _aiMessage = "Checking the writing with AI. Your writing is unchanged.";
            StateHasChanged();
            var proposal = await Ai.ProposeAsync(prepared, request.Token);
            if(prepared.Request.WritingOutline is { } generatedOutline)LocalWritingOutline.RequireCurrent(await Documents.LoadAsync(DocumentId,request.Token) ?? throw new IOException("Document unavailable."),generatedOutline);
            Ai.RequireCurrentAccount(proposal);request.Token.ThrowIfCancellationRequested();
            if (proposal.StyleReview is { Edits.Count: > 0 } styleReport)
                await _editor.PreviewStyleQualityAsync(capture.Html, capture.SelectionStart, proposal.SourceText, styleReport.Edits);
            _aiHistoryRecord = new(1, Guid.NewGuid(), DocumentId, prepared.Key, action == DeviceAiAction.Translate ? "Translation selection" : "Manuscript " + prepared.ApplyMode, latest.LocalRevision, latest.ServerVersion, DateTimeOffset.UtcNow, "Reviewed", latest, proposal.ProposedText, pageId, OriginalText: proposal.SourceText, CloudOrigin:proposal.HistoryOrigin);
            await AiHistory.SaveHistoryAsync(_aiHistoryRecord, request.Token);
            Ai.RequireCurrentAccount(proposal);request.Token.ThrowIfCancellationRequested();
            _aiProposal = proposal;
            _approvedStyleEdits = proposal.StyleReview is { } report ? Enumerable.Range(0, report.Edits.Count).ToArray() : Array.Empty<int>();
            await ReloadHistoryAsync();
            _aiMessage = proposal.StyleReview is { Edits.Count: 0 }
                ? "Style review completed. No changes suggested; your writing is unchanged."
                : "Proposal ready. Review both versions before applying.";
        }
        catch (OperationCanceledException) { _aiMessage = "AI request canceled. Your writing is unchanged."; }
        catch (DeviceAiException error) { _aiError = error.Message; }
        catch (InvalidDataException error) { _aiError = error.Message; }
        catch (JSException) when (action == DeviceAiAction.StyleQuality) { _aiError = "Some suggested changes could not be mapped safely to the page formatting. Check a shorter selection; your writing is unchanged."; }
        catch (Exception error) when (error is HttpRequestException or IOException or UnauthorizedAccessException or InvalidOperationException or JSException)
        { _aiError = "AI could not prepare a proposal. Check the connection or editor and try again; your writing is unchanged."; }
        finally { _aiRequest = null; _aiBusy = false; if (_aiError is not null) _aiMessage = null; _focusAiFeedback = true; if (!_disposed) StateHasChanged(); }
    }
