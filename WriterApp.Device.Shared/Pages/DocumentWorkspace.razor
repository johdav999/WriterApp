@page "/documents/{DocumentId:guid}"
@using WriterApp.Device.Shared.Components
@using WriterApp.Device.Shared.Pages
@using WriterApp.Shared.Localization
@using Microsoft.JSInterop
@inject LocalDocumentRepository Documents
@inject LocalRecoveryStore RecoveryStore
@inject LocalRecoveryService Recovery
@inject DeviceSaveLifetime Lifetime
@inject DeviceAiService Ai
@inject DeviceAiUndoStore AiUndo
@inject LocalAiStore AiHistory
@inject DeviceSyncEngine Sync
@inject DeviceDocumentTransfer Transfer
@inject DeviceDiagnostics Diagnostics
@inject DeviceAccountLinks AccountLinks
@implements IDisposable

<PageTitle>@(_session?.Document.Title ?? "Document") · Prosa</PageTitle>
<NavigationLock OnBeforeInternalNavigation="BeforeNavigationAsync" ConfirmExternalNavigation="@(_session?.IsDirty == true || _planningPanel?.HasDraft == true || _contextBusy)" />

<div class="prosa-editor">
@if (_session is null)
{
    <p role="alert">@(_error ?? "Opening document…")</p>
}
else
{
    LocalDocument document = _session.Document;
    @if (document.Project is { } project)
    {
        <nav class="local-project-context" aria-label="Writing context"><a href="/projects">Projects</a> / <a href="@($"/projects/{project.ProjectId}?documentId={(document.Kind == "manuscript" ? document.DocumentId : project.PrimaryDocumentId)}")">@project.Title</a> / @document.Title / @document.Sections.FirstOrDefault(s => s.Pages.Any(p => p.PageId == _selectedPage))?.Title @if (document.Kind == "manuscript") { <a href="@($"/projects/{project.ProjectId}/storyboard?documentId={document.DocumentId}&scene={project.Nodes.FirstOrDefault(n => n.SectionId == CurrentSectionId && n.DeletionId is null)?.NodeId}")">Storyboard</a> }</nav>
    }
    DeviceDocumentStatus status = DeviceDocumentStatus.For(document, _saveFailed || _autosave?.Error is not null ? LocalSaveState.Error : _busy ? LocalSaveState.Saving : _session.SaveState);
    @if (document.Project is not null) { <a href="@($"/documents/{DocumentId}/cover")">Cover studio</a> }
    <EditorWorkspace Class="@(View.FocusMode ? "is-focus-mode" : "")" WorkspaceClass="@(View.ContextCollapsed || View.FocusMode ? "is-context-collapsed" : "")" Style="@($"--editor-max-width: {(_wideWriting ? "100%" : "900px")}; --topbar-height: 72px;")">
        <Main>
            <EditorHeading Label="@document.Title" Title="@(document.Sections.FirstOrDefault(s => s.Pages.Any(p => p.PageId == _selectedPage))?.Title ?? "Document")">
                <Actions>
                    <button type="button" class="panel-toggle preview-toggle" disabled="@(_contextBusy || _busy || _structureBusy || _transferBusy || _aiBusy || _applyingAi || _previewBusy || _hasRecovery || document.DeletedAtUtc is not null)" @onclick="TogglePreviewAsync">
                        <Icon Name="@(_preview is null ? "visibility" : "edit")" /><span>@(_preview is null ? "Preview" : "Back to editing")</span>
                    </button>
                    @if (_preview is not null || _selectedPage is null || _hasRecovery || document.DeletedAtUtc is not null) { @DocumentActions }
                    <EditorPanelControls FocusMode="View.FocusMode" ContextCollapsed="@(View.ContextCollapsed || View.FocusMode)" ToggleFocus="View.ToggleFocusAsync" ToggleContext="View.ToggleContextAsync" /></Actions>
            </EditorHeading>
            @if (_error is not null) { <p role="alert">@_error</p> }
            @if (_autosave?.Error is not null) { <p role="alert">@_autosave.Error</p> }
            @if (_searchNotice is not null) { <p role="status">@_searchNotice</p> }
            @if (_annotationNotice is not null) { <p role="status">@_annotationNotice</p> }
            @if (_previewBusy) { <p role="status">Preparing saved document preview…</p> }
            @if (_preview is not null)
            { <LocalDocumentPreviewPanel @key="_preview" Snapshot="_preview" BackToEditing="TogglePreviewAsync" /> }
            <div class="local-writing-view" hidden="@(_preview is not null)">
            @if (_hasRecovery)
            {
                <RecoveryNotice @key="DocumentId" DocumentId="DocumentId" Resolved="ReloadAfterRecoveryAsync" />
                <p>Resolve the recovery record before continuing to edit this document.</p>
            }
            else if (document.DeletedAtUtc is not null)
            { <p>This document is in Trash. Restore it from the library before editing.</p> }
            else if (_selectedPage is not null)
            {
                LocalPage selected = document.Sections.SelectMany(section => section.Pages).Single(item => item.PageId == _selectedPage);
                @if (!DeviceContentCompatibility.CanEdit(selected.Content, selected.ContentFormat))
                {
                    <p role="status">Read-only original. Editing and imports cannot replace this page. Export a source backup to preserve all pages and their original formats.</p>
                    @if (Transfer.IsAvailable)
                    {
                        <button type="button" disabled="@(_contextBusy || _busy || _transferBusy)" @onclick="ExportSourceAsync">Export original source backup</button>
                    }
                }
                <DeviceTextEditor @key="selected.PageId" @ref="_editor" PrintLayout="_printLayout" Content="@_session.ContentFor(selected)" Format="@_session.FormatFor(selected)" ContentChanged="html => OnEdited(selected.PageId, html)" SaveRequested="SaveButtonAsync" SearchText="@_searchMatch" SearchRequest="@SearchRequest" SearchLocated="SearchLocated"
                    Annotations="@LocalAnnotationMarkup.ForPage(_session.Snapshot(), selected.PageId)" AnnotationClicked="ShowAnnotationAsync"
                    RequestedAnnotationId="@(_selectedPage == _annotationPage ? _requestedAnnotationId : null)" AnnotationRequest="_annotationRequest" AnnotationLocated="AnnotationLocated"
                    ConsistencyPassage="@(_consistencyPassage?.PageId == selected.PageId ? _consistencyPassage : null)" ConsistencyLocated="ConsistencyLocated">
                    <AdditionalActions>
                        <a class="editor-action-link" href="/account#feedback" title="Report a bug or request an enhancement" aria-label="User feedback"><Icon Name="feedback" /></a>
                        <button type="button" class="icon-only" title="Open Prosa documentation" aria-label="Documentation" disabled="@(!AccountLinks.IsAvailable)" @onclick="OpenDocumentationAsync"><Icon Name="menu_book" /></button>
                        @DocumentActions
                    </AdditionalActions>
                </DeviceTextEditor>
            }
            else { <p>This document has no pages to edit.</p> }
            </div>
            <EditorStatus WordCount="CurrentWordCount" WordCountScope="Total words on the current local page."
                SaveLabel="@status.Label" SaveDetail="@status.Detail" StorageLabel="Local copy" StorageDetail="Local saving works without an account. Cloud sync controls are in this status bar.">
                <button type="button" class="panel-toggle" disabled="@(_contextBusy || _busy || _transferBusy)" @onclick="SaveButtonAsync">Save on this device</button>
                <DocumentSyncStatus Document="document" Compact="true" />
                <span>Ctrl+S save · Ctrl+B bold · Ctrl+I italic</span>
            </EditorStatus>
        </Main>
        <Context>
            <aside class="context-drawer @(View.ContextCollapsed || View.FocusMode ? "is-collapsed" : "")">
                <RightPanelShell PanelId="editor-context-content" LabelledBy="@DeviceSubviewId" PinTrailingBody="@PinStoryCoaching" TrailingBodyVisible="@ShowContextAi">
                    <Tabs><EditorContextNavigation TCategory="DeviceEditorPanel" TSubview="string"
                        Categories="DeviceCategories" Subviews="DeviceSubviews" Category="View.Panel" Subview="@ActiveSubview"
                        CategoryChanged="SelectCategoryAsync" SubviewChanged="SelectSubviewAsync"
                        Heading="@PanelLabel"
                        Helper="@PanelHelper" /></Tabs>
                    <Header>
                        @if (View.Panel != DeviceEditorPanel.Writing) { <div class="rp-context-label">@PanelLabel</div> }
                        @if (View.Panel == DeviceEditorPanel.Writing)
                        {
                            <div class="rp-title">@WritingSubviewTitle</div>
                            <div class="rp-subtitle">@WritingSubviewDescription</div>
                        }
                    </Header>
                    <Body>
                        <DesktopAiGuide DocumentId="DocumentId" />
                        @if (View.Panel == DeviceEditorPanel.Writing && ActiveSubview != "tools" && _preview is null && _selectedPage is not null && !_hasRecovery && document.DeletedAtUtc is null)
                        {
                            <WorkspaceCoachCard ContextTitle="Writing" Observations="@WritingObservations" Why="@WritingCoachWhy">
                                <PrimaryAction>
                                    <button type="button" class="primary desktop-coach-action" @onclick='() => SelectSubviewAsync(ActiveSubview == "tools" ? "quality" : "tools")'>@(ActiveSubview == "tools" ? "Review writing stats" : "Open writing tools")</button>
                                </PrimaryAction>
                            </WorkspaceCoachCard>
                        }
                        <fieldset class="desktop-context-view planning-fields" disabled="@PanelOperationsDisabled" hidden="@(PanelOperationsBlocked || View.Panel is not (DeviceEditorPanel.Story or DeviceEditorPanel.Notes))">
                            <LocalPlanningPanel @key="DocumentId" @ref="_planningPanel" Document="document" SectionId="CurrentSectionId" Subview="@PlanningSubview"
                                Commit="CommitPanelMutationAsync" OpenPage="id => SwitchPageAsync(id)" RevealNavigator="() => SelectCategoryAsync(DeviceEditorPanel.Navigator)"
                                SelectedAnnotationId="_activeAnnotationId" AnnotationFocusRequest="_annotationFocusRequest" AnnotationRequested="NavigateToAnnotationAsync" GetSelectedText="SelectedAnnotationTextAsync" />
                        </fieldset>
                        @if (View.Panel == DeviceEditorPanel.Navigator)
                        {
                            @if (document.Kind == "manuscript" && document.Project is { } navigatorProject)
                            {
                                <Projects ProjectId="navigatorProject.ProjectId" EmbedNavigator="true" HostDocumentId="document.DocumentId" HostRevision="document.LocalRevision"
                                    BeforeWork="BeforeContextWorkAsync" AfterWork="AfterContextWorkAsync" SceneOpenRequested="id => SwitchPageAsync(id)" />
                                <details class="desktop-page-navigation"><summary>Sections and pages</summary>
                                    <LocalStructureNavigator Document="document" SelectedPage="_selectedPage" Disabled="PanelOperationsDisabled"
                                        SelectPage="id => SwitchPageAsync(id)" Change="ChangeStructureAsync" />
                                </details>
                            }
                            else
                            {
                                <LocalStructureNavigator Document="document" SelectedPage="_selectedPage" Disabled="PanelOperationsDisabled"
                                    SelectPage="id => SwitchPageAsync(id)" Change="ChangeStructureAsync" />
                            }
                            @if (_structureMessage is not null) { <p role="status">@_structureMessage</p> }
                        }
                        @if (_preview is not null)
                        { <p>Read-only preview of the saved document. Return to editing to change writing or structure.</p> }
                        @if (_preview is null && View.Panel == DeviceEditorPanel.Writing && ActiveSubview is "tools" or "quality" && _selectedPage is not null && !_hasRecovery && document.DeletedAtUtc is null)
                        {
            @if (SelectedPageEditable)
            {
            <WritingPanel Class="desktop-writing-tools" ShowTitle="false">
                @if (ActiveSubview == "quality")
                {
                    <StyleQualityOptions @bind-Goal="_styleGoal" Busy="@PanelOperationsDisabled" />
                    <p>Select text for a focused review, or leave the selection empty to check this page. Review findings and choose changes before applying.</p>
                    <button type="button" disabled="@(PanelOperationsDisabled || document.ServerDocumentId is null)" @onmousedown:preventDefault="true" @onclick="() => RunAiAsync(DeviceAiAction.StyleQuality)">Suggest style & quality revision</button>
                    @if (document.ServerDocumentId is null) { <p>Sync this document and sign in to request a style revision.</p> }
                }
                else
                {
                <div class="workspace-writing-actions">
                    <LocalWritingPanel @ref="_writingPanel" DocumentId="DocumentId" SectionId="CurrentSectionId" HasCloudCopy="@(document.ServerDocumentId is not null)"
                        ExternalBusy="@PanelOperationsDisabled" BeforeWork="BeforeContextWorkAsync" AfterWork="AfterContextWorkAsync" Capture="CaptureWritingSourceAsync">
                <details class="desktop-writing-more desktop-writing-custom">
                <summary>Custom prompt</summary>
                <div class="desktop-writing-details-content">
                <p>Select a passage to revise it, or leave nothing selected to revise all pages in this section. Review before replacing the original.</p>
                <label for="custom-ai-instruction">Prompt for the next change</label>
                <textarea id="custom-ai-instruction" @bind="_customAiInstruction" @bind:event="oninput" maxlength="2000" rows="2"
                          disabled="@(_contextBusy || _busy || _aiBusy || _transferBusy)" placeholder="Describe the change you want"></textarea>
                <button type="button" disabled="@(_contextBusy || _busy || _aiBusy || _transferBusy || document.ServerDocumentId is null)" @onmousedown:preventDefault="true" @onclick="() => RunAiAsync(DeviceAiAction.Custom)">Preview custom action</button>
                </div>
                </details>
                    </LocalWritingPanel>
                </div>
                <div class="desktop-writing-utility">
                    <button type="button" disabled="@(_contextBusy || _busy || _aiBusy || _transferBusy || document.ServerDocumentId is null)" @onmousedown:preventDefault="true" @onclick="() => RunAiAsync(DeviceAiAction.Summarize)">Summarize section</button>
                </div>
                <details class="desktop-writing-more">
                    <summary>Translate &amp; more</summary>
                    <div class="desktop-writing-details-content">
                    <LocalTranslationPanel @key="DocumentId" @ref="_translationPanel" DocumentId="DocumentId" SectionId="CurrentSectionId"
                        ExternalBusy="@(_contextBusy || _busy || _aiBusy || _applyingAi || _transferBusy || document.ServerDocumentId is null)"
                        BeforeWork="BeforeContextWorkAsync" AfterWork="AfterContextWorkAsync" SelectionRequest="TranslateSelectionAsync" />
                    <button type="button" @onclick="() => SelectCategoryAsync(DeviceEditorPanel.Advanced)">Prompt Library</button>
                    </div>
                </details>
                }
                <div class="workspace-ai-feedback" tabindex="-1" @ref="_aiFeedback">
                @if (_aiBusy)
                {
                    <p role="status">@(_aiMessage ?? "Preparing an AI proposal. Your writing is unchanged.")</p>
                    <button type="button" @onclick="CancelAi">Cancel AI request</button>
                }
                @if (_aiError is not null) { <p role="alert">@_aiError</p> }
                @if (!_aiBusy && _aiMessage is not null) { <p role="status">@_aiMessage</p> }
                @if (_aiProposal is { } proposal)
                {
                    <div class="workspace-ai-preview" role="group" aria-label="AI proposal preview">
                        <h3>Review before applying</h3>
                        @if (proposal.StyleReview is { } styleReview) {
                            <StyleQualityRevisionReview Report="styleReview" Source="@proposal.SourceText"
                                Goal="@(proposal.Prepared.Request.Parameters?[WriterApp.Shared.StyleQualityReview.Parameter]?.ToString() ?? WriterApp.Shared.StyleQualityReview.DefaultGoal)"
                                Approved="_approvedStyleEdits" ApprovedChanged="StyleEditsChanged" Busy="@PanelOperationsDisabled" />
                        } else {
                            @if (proposal.Prepared.Action == DeviceAiAction.StyleQuality) { <p>Style &amp; quality revision · Preserve existing voice</p> }
                            else if (!string.IsNullOrWhiteSpace(proposal.Summary)) { <p>@proposal.Summary</p> }
                            <AiTextComparison OriginalLabel='@(proposal.Prepared.Target == DeviceAiApplyTarget.ManuscriptPage ? "Original page" : proposal.Prepared.ApplyMode == "append" ? "Source section" : "Original selection")' Original="@proposal.SourceText" Proposed="@proposal.ProposedText" HighlightChanges="@(proposal.Prepared.Action == DeviceAiAction.StyleQuality)" />
                        }
                        <p>@(proposal.StyleReview is not null ? "Apply updates only the selected changes. Other writing and formatting stay intact. You can undo or restore the original after applying." : proposal.Prepared.Target == DeviceAiApplyTarget.ManuscriptPage ? "Apply replaces this page's writing with the reviewed revision. You can undo or restore the original after applying." : proposal.Prepared.ApplyMode == "append" ? "Apply adds this text at the end of the current page." : "Apply replaces only the selected text.")</p>
                        <button type="button" disabled="@(_contextBusy || _busy || _aiBusy || _applyingAi || _transferBusy || proposal.StyleReview is not null && _approvedStyleEdits.Count == 0)" @onclick="ApplyAiAsync">@(proposal.Prepared.Action == DeviceAiAction.StyleQuality ? "Apply style revision" : "Apply")</button>
                        <button type="button" disabled="@(_contextBusy || _busy || _aiBusy || _applyingAi || _transferBusy)" @onclick="DismissAi">Dismiss</button>
                    </div>
                }
                </div>
                @if (ActiveSubview == "quality")
                {
                    <LocalQualityPanel @key="_selectedPage" @ref="_qualityPanel" DocumentId="DocumentId" PageId="_selectedPage"
                        StyleGoal="@_styleGoal" CurrentHtml="@CurrentQualityHtml" ExternalBusy="@PanelOperationsDisabled"
                        BeforeWork="BeforeContextWorkAsync" AfterWork="AfterContextWorkAsync" Capture="CaptureQualitySourceAsync"
                        Navigate="NavigateQualityAsync" Highlights="HighlightQualityAsync" />
                }
                @if (_aiPendingUndo is { } pending && pending.PageId == _selectedPage)
                {
                    <details><summary>Writing saved before an interrupted AI apply</summary><pre>@pending.BeforeHtml</pre></details>
                    <button type="button" disabled="@(_contextBusy || _busy || _aiBusy || _applyingAi || _transferBusy)" @onclick="RestorePendingCopyAsync">Save this earlier writing as a separate local copy</button>
                }
                @if (_aiRecoveredCopy is { } recovered)
                { <a href="@($"/documents/{recovered}")">Open recovered copy</a> }
                <div class="desktop-writing-history">
                    <button type="button" @onclick="() => SelectCategoryAsync(DeviceEditorPanel.History)">Review history</button>
                    @if (ActiveSubview == "tools") { <button type="button" @onclick='() => SelectSubviewAsync("quality")'>Writing stats</button> }
                </div>
            </WritingPanel>
            }
            else { <p role="status">Writing tools are unavailable for this protected page. Export its original source from Document actions.</p> }
                        }
                        else if (_preview is null && View.Panel == DeviceEditorPanel.Writing && ActiveSubview is "tools" or "quality")
                        { <p role="status">@(_hasRecovery ? "Resolve the recovery record before using Writing tools." : document.DeletedAtUtc is not null ? "Restore this document from Trash before editing." : "No page is available for Writing tools.")</p> }
                    </Body>
                    <TrailingBody>
                        <div class="desktop-context-ai" hidden="@(!ShowContextAi)">
                            @if(ContextAiMode=="prompts") {
                                <LocalPromptPanel @key="DocumentId" @ref="_promptPanel" DocumentId="DocumentId" SectionId="CurrentSectionId"
                                    CloudProjectId="@document.ServerProjectId"
                                    ExternalBusy="@PanelOperationsDisabled" Capture="CaptureWritingSourceAsync" BeforeWork="BeforeContextWorkAsync" AfterWork="AfterContextWorkAsync" />
                            } else {
                            <LocalAiPanel @key="DocumentId" @ref="_aiPanel" DocumentId="DocumentId" SectionId="CurrentSectionId" Mode="@ContextAiMode"
                                BeforeWork="BeforeContextWorkAsync" AfterWork="AfterContextWorkAsync" FixedRequest="@PinStoryCoaching" JumpConsistency="NavigateConsistencyAsync" ClearConsistencyHighlight="ClearConsistencyHighlight" />
                            }
                        </div>
                    </TrailingBody>
                </RightPanelShell>
            </aside>
        </Context>
    </EditorWorkspace>
}
</div>

@code {
    private bool _wideWriting, _printLayout;
    private RenderFragment DocumentActions => @<EditorDocumentActions IsOpen="_documentMenuOpen" Toggle="() => _documentMenuOpen = !_documentMenuOpen" PanelClass="is-file-transfer">
                        <button type="button" @onclick="() => _wideWriting = !_wideWriting">@(_wideWriting ? "Use focused writing width" : "Use full writing width")</button>
                        <button type="button" @onclick="() => _printLayout = !_printLayout">@(_printLayout ? "Hide print layout" : "Show print layout")</button>
                        <button type="button" disabled="@(_contextBusy || _busy || _transferBusy)" @onclick="SaveButtonAsync">Save now</button>
                        @if (_selectedPage is not null && !_hasRecovery && _session!.Document.DeletedAtUtc is null)
                        {
            @if (Transfer.IsAvailable)
            {
                <details class="workspace-transfer" aria-label="Local import and export">
                    <summary>Import / Export...</summary>
                    <p>Import DOCX or UTF-8 .txt, .html, or .htm (up to 5 MB) into this page of the current section. Unsupported formatting, scripts, images, and active content are removed. Choose how the imported writing changes this page.</p>
                    <label for="import-mode">Import into @(_session!.Document.Sections.Single(s => s.Pages.Any(p => p.PageId == _selectedPage)).Title) / @(_session!.Document.Sections.SelectMany(s => s.Pages).Single(p => p.PageId == _selectedPage).Title)</label>
                    <select id="import-mode" @bind="_importModeChoice" disabled="@(_contextBusy || _busy || _aiBusy || _transferBusy)">
                        <option value="">Choose append or replace</option>
                        <option value="append">Append after this page's writing</option>
                        <option value="replace">Replace this page's writing</option>
                    </select>
                    <button type="button" disabled="@(_contextBusy || _busy || _aiBusy || _transferBusy || !SelectedPageEditable || string.IsNullOrEmpty(_importModeChoice))" @onclick="ImportIntoPageAsync">Choose file and import</button>
                    <p>@DevicePublishing.ConversionNotice</p>
                    <p>HTML and text export require supported pages. A lossless source backup preserves every original page and its format, including unsupported content, as inert JSON. Keep this backup for recovery; it is not an importable writing file.</p>
                    <a href="@($"/documents/{DocumentId}/publishing")">Publishing, export layouts and PDF</a>
                    <label for="export-format">Quick export format</label>
                    <select id="export-format" @bind="_exportFormat" disabled="@(_contextBusy || _busy || _aiBusy || _transferBusy)">
                        <option value="Html">HTML document (.html)</option>
                        <option value="Text">Plain text (.txt)</option>
                        <option value="SourceBackup">Lossless source backup (.source.json)</option>
                    </select>
                    <button type="button" disabled="@(_contextBusy || _busy || _aiBusy || _transferBusy)" @onclick="ExportDocumentAsync">Choose save location</button>
                    @if (_transferMessage is not null) { <p role="status">@_transferMessage</p> }
                    @if (_transferError is not null) { <p role="alert">@_transferError</p> }
                </details>
            }
                        }
                    </EditorDocumentActions>;
    private async Task OpenDocumentationAsync()
    {
        try { await AccountLinks.OpenAsync(AccountDestination.Documentation); }
        catch (Exception error) when (error is InvalidOperationException or IOException) { _error = error.Message; }
    }

    [SupplyParameterFromQuery(Name = "panel")] public string? RequestedPanel { get; set; }
    [SupplyParameterFromQuery(Name = "view")] public string? RequestedSubview { get; set; }
    private (string?, string?)? _lastPanelNavigation;
    private async Task ApplyPanelNavigationAsync()
    {
        if (_lastPanelNavigation == (RequestedPanel, RequestedSubview)) return;
        _lastPanelNavigation = (RequestedPanel, RequestedSubview);
        if (!Enum.TryParse<DeviceEditorPanel>(RequestedPanel, true, out var panel) || !Enum.IsDefined(panel)) return;
        if (panel == DeviceEditorPanel.Synopsis) { panel = DeviceEditorPanel.Story; RequestedSubview = "synopsis"; }
        if (!await FlushPlanningAsync()) return;
        if (RequestedSubview is { } subview && SubviewsFor(panel).Any(s => s.Key == subview)) _subviews[panel] = subview;
        await View.SelectPanelAsync(panel);
    }

    private bool _documentMenuOpen;
    private bool HasLocalProject => _session?.Document is { Kind: "manuscript", Project: not null };
    private LocalPlanningPanel? _planningPanel;
    private LocalAiPanel? _aiPanel;
    private LocalPromptPanel? _promptPanel;
    protected override void OnInitialized() => Sync.Changed += OnSyncChanged;
    private void OnSyncChanged()
    {
        if (_disposed || Sync.IsRunning) return;
        _ = InvokeAsync(async () =>
        {
            var session = _session;
            if (_disposed || session is null) return;
            try
            {
                bool refreshed = await session.RefreshSyncMetadataAsync();
                if (!_disposed && _session == session && refreshed) StateHasChanged();
            }
            catch (Exception e) when (e is IOException or InvalidOperationException or UnauthorizedAccessException)
            {
                if (!_disposed && _session == session)
                {
                    _error = "Refreshing cloud sync status failed. " + e.Message;
                    StateHasChanged();
                }
            }
        });
    }
    private bool _contextBusy;
    private Guid? CurrentSectionId => _session?.Document.Sections.FirstOrDefault(s => s.Pages.Any(p => p.PageId == _selectedPage))?.SectionId;
    private Guid? _activeAnnotationId, _requestedAnnotationId, _annotationRequest, _annotationPage, _annotationFocusRequest;
    private string? _annotationNotice;
    private async Task ShowAnnotationAsync(Guid id)
    {
        if (PanelOperationsDisabled || !await FlushPlanningAsync()) return;
        _activeAnnotationId = id;
        _annotationFocusRequest = Guid.NewGuid();
        _subviews[DeviceEditorPanel.Notes] = "annotations";
        await View.SelectPanelAsync(DeviceEditorPanel.Notes);
        if (View.FocusMode) await View.ToggleFocusAsync();
        if (View.ContextCollapsed) await View.ToggleContextAsync();
    }
    private async Task NavigateToAnnotationAsync(Guid id)
    {
        if (_session is null || PanelOperationsDisabled) return;
        Guid? pageId = LocalAnnotationMarkup.PageFor(_session.Snapshot(), id);
        if (pageId is null) { _annotationNotice = "This quote no longer matches a passage. Review it against the current writing."; return; }
        if (pageId != _selectedPage) await SwitchPageAsync(pageId);
        if (_selectedPage != pageId) return;
        _activeAnnotationId = _requestedAnnotationId = id;
        _annotationPage = pageId;
        _annotationRequest = Guid.NewGuid();
        _annotationNotice = null;
        _searchMatch = null;
    }
    private void AnnotationLocated(bool located) => _annotationNotice = located ? null : "This quote no longer matches a passage. Review it against the current writing.";
    private Task<string> SelectedAnnotationTextAsync() => _editor?.SelectedTextAsync() ?? Task.FromResult("");
    private bool PanelOperationsDisabled => _busy || _contextBusy || _structureBusy || _aiBusy || _applyingAi || _transferBusy || _previewBusy || _preview is not null || _hasRecovery || _session?.Document.DeletedAtUtc is not null;
    private IReadOnlyList<EditorTabDescriptor<DeviceEditorPanel>> DeviceCategories => [
        new(DeviceEditorPanel.Writing, "Writing", "context-category-writing"),
        new(DeviceEditorPanel.Story, "Story", "context-category-story"),
        new(DeviceEditorPanel.Navigator, "Navigator", "context-category-navigator"),
        new(DeviceEditorPanel.Notes, "Notes & Tasks", "context-category-notes"),
        new(DeviceEditorPanel.History, "History", "context-category-history"),
        new(DeviceEditorPanel.Advanced, "Advanced", "context-category-advanced")];
    private string PanelLabel => View.Panel switch { DeviceEditorPanel.Story => "Story", DeviceEditorPanel.Notes => "Notes & Tasks", DeviceEditorPanel.Navigator => "Navigator", DeviceEditorPanel.History => "History", DeviceEditorPanel.Advanced => "Advanced", _ => "Writing" };
    private string PanelHelper => ActiveSubview switch
    {
        "consistency" => "Check consistency in the saved section.", "quality" => "Review and apply a style revision to this page or selected writing.",
        "scene" => "Capture scene intent, beats, and metadata before drafting.", "storyboard" => "Arrange scenes in manuscript order.",
        "synopsis" => "Capture the story intent for this project.", "notes" => "Keep personal notes for this scene.",
        "annotations" => "Track comments, tasks, and detached quotes.", "history" => "Review AI results, undo changes, or reapply a saved revision.",
        "navigator" => "Parts, chapters, and scenes in manuscript order.", "prompts" => "Run reusable prompt presets for analysis and planning.",
        _ => "Rewrite, shorten, translate, and preview a change."
    };
    private readonly Dictionary<DeviceEditorPanel, string> _subviews = [];
    private string ActiveSubview => _subviews.GetValueOrDefault(View.Panel, View.Panel switch {
        DeviceEditorPanel.Story => "scene", DeviceEditorPanel.Notes => "notes", DeviceEditorPanel.History => "history",
        DeviceEditorPanel.Navigator => "navigator", DeviceEditorPanel.Advanced => "prompts", _ => "tools" });
