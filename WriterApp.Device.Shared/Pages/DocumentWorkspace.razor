    private async Task<LocalDocument?> CommitPanelMutationAsync(Func<LocalDocument, LocalDocument> mutation)
    {
        if (_session is null || PanelOperationsBlocked || _contextBusy || _structureBusy || _previewBusy || _transferBusy || _aiBusy || _applyingAi) return null;
        _contextBusy = true;
        try {
            if (!await SaveCurrentAsync(releaseEditor: false) || _session.IsDirty) return null;
            var latest = await CurrentForTransferAsync();
            var saved = await Documents.SaveAsync(mutation(latest));
            _session.AdoptSavedDocument(saved); _aiProposal = null;
            return saved;
        }
        finally
        {
            await ReleaseContextEditorAsync();
            // Planning calls this through a Func, not an EventCallback. Refresh the
            // workspace after adoption so the editor receives the saved annotations.
            if (!_disposed) await InvokeAsync(StateHasChanged);
        }
    }
    private async Task<bool> BeforeContextWorkAsync()
    {
        if (PanelOperationsBlocked || _structureBusy || _previewBusy || _transferBusy || _aiBusy || _applyingAi || !await SaveAllAsync(releaseEditor: false)) return false;
        _contextBusy = true;
