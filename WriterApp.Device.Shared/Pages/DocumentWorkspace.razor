    private async Task ApplyAiAsync()
    {
        if (_aiProposal is not { } proposal || _editor is null || _selectedPage != proposal.Prepared.LocalPageId || _contextBusy || _busy || _applyingAi || _transferBusy || _structureBusy) return;
        _applyingAi = true;
        _aiError = null;
        try
        {
            Ai.RequireCurrentAccount(proposal);
            proposal.Prepared.RequireManuscriptTarget();
            if (_aiHistoryRecord is null) throw new InvalidOperationException("Recovery evidence is missing.");
            var latest = await Documents.LoadAsync(DocumentId) ?? throw new IOException("Document unavailable.");
            AdvancedAiRequests.RequireFresh(latest, new(_aiHistoryRecord.Before, Guid.Empty, null, "", LocalAiTarget.Analysis, proposal.Prepared));
            if(proposal.Prepared.Request.WritingOutline is { } reviewedOutline)LocalWritingOutline.RequireCurrent(latest,reviewedOutline);
            if (proposal.StyleReview is not null)
                _aiHistoryRecord = LocalStyleQualityApproval.Prepare(proposal, _approvedStyleEdits, _aiHistoryRecord);
            await AiHistory.SaveHistoryAsync(_aiHistoryRecord with { Status = "Applying" });
            var record = new DeviceAiUndoRecord(DocumentId, _selectedPage.Value, proposal.Prepared.BaseHtml, null, DateTimeOffset.UtcNow);
            await AiUndo.SaveBeforeAsync(record);
            _aiPendingUndo = record;
            Ai.RequireCurrentAccount(proposal);
            string after = proposal.StyleReview is { } styleReport
                ? await _editor.ApplyStyleQualityAsync(proposal.Prepared.BaseHtml, proposal.Prepared.Request.SelectionStart!.Value, proposal.SourceText,
                    styleReport.Edits.Where((edit, index) => _approvedStyleEdits.Contains(index)).ToArray())
                : await _editor.ApplyAiAsync(proposal.Prepared.BaseHtml, proposal.Prepared.From, proposal.Prepared.To,
                    proposal.Prepared.SelectedText, proposal.ProposedText, proposal.Prepared.ApplyMode);
            _aiProposal = null;
            bool saved = await SaveCurrentAsync();
            if (!saved) return;
            _aiUndo = record with { AfterHtml = after };
            await AiUndo.ConfirmAsync(_aiUndo);
            await AiHistory.SaveHistoryAsync(_aiHistoryRecord with { Status = "Applied", AfterHtml = after });
            await ReloadHistoryAsync();
            _aiPendingUndo = null;
            _aiMessage = "Applied and saved locally. Open History to undo or redo this AI change.";
        }
        catch (Exception error) when (error is DeviceAiException or IOException or InvalidDataException or UnauthorizedAccessException or InvalidOperationException or JSException)
        { _aiError = error is JSException ? "The writing changed after the preview. Run AI again; no proposal was applied." : "AI apply or backup failed. Check local storage and review your writing before retrying."; }
        finally { _applyingAi = false; }
    }
    private async Task RestorePendingCopyAsync()
    {
        if (_aiPendingUndo is not { } record || _contextBusy || _busy || _transferBusy || _structureBusy) return;
        try
        {
            LocalDocument source = await Documents.LoadAsync(DocumentId) ?? throw new IOException("Document missing.");
            int sectionIndex = Array.FindIndex(source.Sections.ToArray(), s => s.Pages.Any(p => p.PageId == record.PageId));
            if (sectionIndex < 0) throw new InvalidOperationException("The earlier page no longer exists.");
            int pageIndex = Array.FindIndex(source.Sections[sectionIndex].Pages.ToArray(), p => p.PageId == record.PageId);
            LocalDocument copy = await Documents.DuplicateAsync(DocumentId);
            var sections = copy.Sections.ToArray();
            var pages = sections[sectionIndex].Pages.ToArray();
            pages[pageIndex] = pages[pageIndex] with { Content = record.BeforeHtml, ContentFormat = LocalContentFormat.Html };
            sections[sectionIndex] = sections[sectionIndex] with { Pages = pages };
            copy = await Documents.SaveAsync(copy with { Sections = sections });
            _aiRecoveredCopy = copy.DocumentId;
            _aiMessage = "The earlier writing was saved as a separate local copy.";
        }
        catch (Exception error) when (error is IOException or InvalidDataException or UnauthorizedAccessException or InvalidOperationException)
        { _aiError = "Could not create the recovery copy. The earlier source remains in the AI backup file."; }
    }

    private async Task ImportIntoPageAsync()
    {
        if (_contextBusy || _transferBusy || _structureBusy || _previewBusy || _preview is not null || _busy || _aiBusy || _applyingAi || _session is null || _editor is null
            || _selectedPage is null || _hasRecovery || _importModeChoice is not ("append" or "replace")) return;
        if (!await FlushPlanningAsync()) return;
        _transferBusy = true; _transferError = null; _transferMessage = null;
        bool committed = false;
        try
        {
            DevicePreparedImport? import = await Transfer.PickImportAsync();
            if (import is null) { _transferMessage = "Import canceled. Your writing is unchanged."; return; }
            if (!await SaveCurrentAsync(releaseEditor: false)) return;
            LocalDocument latest = await CurrentForTransferAsync();
            LocalDocument saved = await Transfer.ImportPageAsync(latest, _selectedPage.Value, import,
                _importModeChoice == "append" ? DeviceImportMode.Append : DeviceImportMode.Replace);
            committed = true;
            _session.AdoptSavedDocument(saved);
            string html = saved.Sections.SelectMany(s => s.Pages).Single(p => p.PageId == _selectedPage).Content;
            await _editor.SetContentAsync(html);
            _aiProposal = null;
            _transferMessage = "Imported and saved on this device. " + string.Join(" ", import.Warnings ?? []);
        }
        catch (Exception error) when (error is IOException or InvalidDataException or UnauthorizedAccessException or InvalidOperationException
            or ArgumentException or JSException or System.Runtime.InteropServices.COMException)
        {
            _transferError = committed
                ? "The import was saved locally, but the editor could not refresh. Reopen this document to see it."
                : error is InvalidDataException ? error.Message
                : error is LocalDocumentConflictException ? "This document changed during import. Review the current version and try again."
                : "Import failed. The existing writing was not changed.";
        }
        finally
        {
            try { if (_editor is not null) await _editor.SetEditableAsync(true); } catch (JSException) { }
            _transferBusy = false;
        }
    }

    private async Task ExportDocumentAsync()
    {
        if (_contextBusy || _transferBusy || _structureBusy || _busy || _aiBusy || _applyingAi || _session is null || _editor is null || _hasRecovery) return;
        if (!await FlushPlanningAsync()) return;
        _transferBusy = true; _transferError = null; _transferMessage = null;
        try
        {
            if (!await SaveCurrentAsync(releaseEditor: false)) return;
            LocalDocument latest = await CurrentForTransferAsync();
            bool saved = await Transfer.ExportAsync(latest, _exportFormat);
            _transferMessage = saved ? "Document exported to the chosen file." : "Export canceled. No file was written.";
        }
        catch (Exception error) when (error is IOException or InvalidDataException or UnauthorizedAccessException or InvalidOperationException
            or ArgumentException or JSException or System.Runtime.InteropServices.COMException)
        {
            _transferError = error is InvalidDataException ? error.Message
                : error is LocalDocumentConflictException ? "This document changed during export. Review it and try again."
                : "Export failed. Your local document was not changed.";
        }
        finally
        {
            try { if (_editor is not null) await _editor.SetEditableAsync(true); } catch (JSException) { }
            _transferBusy = false;
        }
    }

    private async Task<LocalDocument> CurrentForTransferAsync()
    {
        LocalDocument latest = await Documents.LoadAsync(DocumentId) ?? throw new IOException("Document missing.");
        if (_session is null || DeviceSyncMapping.Fingerprint(latest) != DeviceSyncMapping.Fingerprint(_session.Document))
            throw new LocalDocumentConflictException(DocumentId);
        return latest;
    }

    private async Task ChangeStructureAsync(LocalStructureChange change)
    {
        if (_session is null || _contextBusy || _structureBusy || _previewBusy || _preview is not null || _busy || _transferBusy || _aiBusy || _applyingAi || _hasRecovery) return;
        if (!await FlushPlanningAsync()) return;
        _structureBusy = true;
        _structureMessage = null;
        try
        {
            // Stop editing only for this mutation. Flush the WebView and recovery journal first.
            if (!await SaveCurrentAsync(releaseEditor: false) || _session.IsDirty) return;
            LocalDocument latest = await CurrentForTransferAsync();
            LocalDocument saved = await Documents.ChangeStructureAsync(latest, change);
            Guid? next = LocalDocumentStructure.SelectPage(latest, saved, _selectedPage);
            _session.AdoptSavedDocument(saved);
            if (_selectedPage != next) { _selectedPage = next; _editor = null; }
            _aiProposal = null;
            _structureMessage = "Structure saved on this device. Deleted writing remains in local trash; cloud sync uses the saved change.";
        }
        catch (Exception error) when (error is IOException or UnauthorizedAccessException or InvalidOperationException or ArgumentException or JSException or OverflowException or System.Text.Json.JsonException)
        {
            _error = error is LocalDocumentConflictException
                ? "The document changed elsewhere. No structure change was applied. Your writing remains saved here; reopen to review the current structure."
                : error is InvalidOperationException or System.Text.Json.JsonException ? error.Message
                : "The structure change could not be saved. The current writing and structure were retained. Check storage access and retry.";
        }
        finally
        {
            try { if (_editor is not null) await _editor.SetEditableAsync(true); } catch (JSException) { }
            _structureBusy = false;
        }
    }

    private void OnSaveChanged() { if (!_disposed) _ = InvokeAsync(StateHasChanged); }
    private async Task<bool> InvokeFlushAsync(bool closing)
    {
        if (_promptPanel?.IsBusy == true || _writingPanel?.IsBusy == true || _translationPanel?.IsBusy == true || _qualityPanel?.IsBusy == true || _contextBusy || _aiPanel?.IsBusy == true || _aiBusy || _structureBusy || _previewBusy || _transferBusy || _applyingAi) return false;
        bool saved = false;
        await InvokeAsync(async () => saved = await SaveAllAsync(releaseEditor: !closing));
        return saved;
    }
    private async Task ReloadAfterRecoveryAsync()
    { _hasRecovery = (await Recovery.DiscoverAsync()).Records.Any(r => r.Document.DocumentId == DocumentId); await InvokeAsync(StateHasChanged); }

    private async Task SaveButtonAsync() => await SaveAllAsync();

    private async Task<bool> SaveCurrentAsync(bool releaseEditor = true)
    {
        if (_session is null || _hasRecovery || _disposed) return true;
        await _flushGate.WaitAsync();
        if (_session is null || _hasRecovery || _disposed) { _flushGate.Release(); return true; }
        _busy = true;
        _saveFailed = false;
        _error = null;
        bool saved = false;
        try
        {
            if (_editor is not null)
            {
                // Autosave must not blur contenteditable or interrupt typing. The session
                // preserves edits arriving during SaveAsync; freeze only for leaving/replacing a page.
                if (!releaseEditor) await _editor.SetEditableAsync(false);
                await _editor.FlushAsync();
            }
            StateHasChanged();
            await _autosave!.SaveAsync();
            saved = true;
            return true;
        }
        catch (Exception error) when (error is IOException or InvalidDataException or UnauthorizedAccessException or InvalidOperationException or JSException)
        {
            try { await Diagnostics.RecordAsync(DeviceDiagnosticEvent.SaveFailed, error: error); }
            catch (Exception logError) when (logError is IOException or UnauthorizedAccessException) { }
            _saveFailed = true;
            _error = error is LocalDocumentConflictException
                ? "This document changed elsewhere. Your edits remain here; copy your text before reloading to resolve the conflict."
                : "Saving failed. Your edits remain here. Check local storage and try Save again before leaving.";
            return false;
        }
        finally
        {
            _busy = false;
            try
            {
                if (_editor is not null && !releaseEditor && !saved)
                {
                    try { await _editor.SetEditableAsync(true); }
                    catch (JSException) { }
                }
            }
            finally { _flushGate.Release(); }
            if (!_disposed) StateHasChanged();
        }
    }

    private async Task SwitchPageAsync(Guid? id)
    {
        if (id is null || id == _selectedPage || _contextBusy || _promptPanel?.IsBusy == true || _writingPanel?.IsBusy == true || _translationPanel?.IsBusy == true || _qualityPanel?.IsBusy == true || _aiPanel?.IsBusy == true || _transferBusy || _structureBusy || _previewBusy || _preview is not null || _aiBusy || _applyingAi) return;
        if (await SaveAllAsync(releaseEditor: false))
        {
            _selectedPage = id; _editor = null;
            _session?.RememberPage(id);
            try { if (_session is not null) await _session.SaveAsync(); }
            catch (Exception e) when (e is IOException or InvalidOperationException or UnauthorizedAccessException) { _error = "Writing was saved, but the resume location could not be saved. Retry Save now. " + e.Message; }
        }
    }

    private async Task BeforeNavigationAsync(LocationChangingContext context)
    {
        if (_contextBusy || _promptPanel?.IsBusy == true || _writingPanel?.IsBusy == true || _translationPanel?.IsBusy == true || _qualityPanel?.IsBusy == true || _aiPanel?.IsBusy == true || _applyingAi || _transferBusy || _structureBusy || _previewBusy) { context.PreventNavigation(); return; }
        if (_contextBusy || !await SaveAllAsync(releaseEditor: false) || _session?.IsDirty == true)
        {
            context.PreventNavigation();
            if (_editor is not null) await _editor.SetEditableAsync(true);
        }
    }

    public void Dispose()
    {
        Sync.Changed -= OnSyncChanged;
        View.Reset();
        _disposed = true;
        _aiRequest?.Cancel();
        if (_editingId is { } id) Documents.EndEditing(id);
        _autosave?.Dispose();
        if (Lifetime.Flush == _lifetimeFlush) Lifetime.Flush = null;
    }
}
