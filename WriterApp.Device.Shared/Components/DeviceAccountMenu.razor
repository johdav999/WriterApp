@implements IDisposable
@inject DeviceAccountService Account
@inject DeviceAccountOverview Overview

<details class="device-account @(Compact ? "sidebar-account" : "")">
    <summary>
        @if (Compact)
        {
            <span class="account-avatar" aria-hidden="true">@Initials</span>
            <span class="account-name">@DisplayName</span>
            <LibraryIcon Name="chevron" />
        }
        else { @(Account.IsSignedIn ? Account.DisplayName ?? "Signed in" : "Account") }
    </summary>
    <div class="device-account-panel">
    <a href="/account">Account, plan and help</a>
    <p>Sign in for online features. Local writing and saving work without an account.</p>
    @if (!Account.IsConfigured && Account.Message is null) { <p>Sign-in settings are missing from this build. Install a configured Prosa build.</p> }
    @if (Account.Message is not null) { <p role="status">@Account.Message</p> }
    @if (_message is not null) { <p role="status">@_message</p> }
    <button disabled="@(_busy || !Account.IsConfigured)" @onclick="SignInAsync">@(Account.IsSignedIn ? "Switch account" : "Sign in with browser")</button>
    <button disabled="@(_busy || !Account.IsConfigured)" @onclick="SignOutAsync">Sign out on this device</button>
    @if (Account.IsSignedIn) { <button disabled="@_busy" @onclick="VerifyAsync">Check backend connection</button> }
    @if (_busy) { <button @onclick="() => _operation?.Cancel()">Cancel</button> }
    @if (_busy) { <p role="status">Completing sign-in or checking the account…</p> }
    </div>
</details>

@code {
    [Parameter] public bool Compact { get; set; }
    private string DisplayName => Account.IsSignedIn ? Account.DisplayName ?? "Signed in" : "Local account";
    private string Initials => Account.IsSignedIn
        ? string.Concat(DisplayName.Split(new[] { ' ', '.', '@' }, StringSplitOptions.RemoveEmptyEntries).Take(2).Select(part => char.ToUpperInvariant(part[0])))
        : "P";
    private bool _busy;
    private string? _message;
    private CancellationTokenSource? _operation;
    private bool _disposed;
    protected override async Task OnInitializedAsync()
    {
        Account.Changed += Changed;
        await RunAsync(async ct =>
        {
            await Account.RestoreAsync(ct);
            if (Account.IsSignedIn) await VerifyBackendAsync(ct);
        });
    }
    private void Changed() { if (!_disposed) _ = InvokeAsync(StateHasChanged); }
    private Task SignInAsync() => RunAsync(async ct =>
    { await Account.SignInAsync(ct); await VerifyBackendAsync(ct); });
    private Task SignOutAsync() => RunAsync(_ => Account.SignOutAsync());
    private Task VerifyAsync() => RunAsync(VerifyBackendAsync);
    private async Task VerifyBackendAsync(CancellationToken ct)
    {
        await Overview.RefreshAsync(ct);
        _message = Overview.Message;
    }
    private async Task RunAsync(Func<CancellationToken, Task> action)
    {
        if (_busy) return;
        _busy = true; _message = null;
        using var operation = new CancellationTokenSource(TimeSpan.FromMinutes(5));
        _operation = operation;
        try { await action(operation.Token); }
        catch (OperationCanceledException) { _message = "Sign-in or connection check canceled."; }
        catch (DeviceSignInRequiredException) { _message = "Sign in to continue online."; }
        catch (DeviceIdentityUnavailableException) { _message = "Sign-in or secure storage is unavailable. Retry when available."; }
        catch (DeviceIdentityConfigurationException error) { _message = error.Message; }
        catch (Exception error) when (error is HttpRequestException or System.Text.Json.JsonException or InvalidOperationException)
        { _message = "The backend could not be reached or returned an unexpected response. Local editing is unaffected."; }
        finally { _operation = null; _busy = false; }
    }
    public void Dispose()
    { _disposed = true; Account.Changed -= Changed; _operation?.Cancel(); }
}
