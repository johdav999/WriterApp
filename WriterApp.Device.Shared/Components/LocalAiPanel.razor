        bool began = false;
        try { if (saveDocument && BeforeWork is not null && !await BeforeWork()) { _error = "Save the current writing and planning before continuing."; return; } began = saveDocument; await action(source.Token); }
        catch(OperationCanceledException) { _message="Canceled. Any saved changes remain in history."; }
        catch(Exception e) when(e is DeviceSignInRequiredException or DeviceIdentityUnavailableException or DeviceAiException or IOException or InvalidDataException or InvalidOperationException or UnauthorizedAccessException or System.Text.Json.JsonException or HttpRequestException or JSException) { _error=e.Message.Split('\n')[0]; }
        finally { try { if (began && AfterWork is not null) await AfterWork(); } finally {
            await RefreshDocumentAsync(afterWork: true);
