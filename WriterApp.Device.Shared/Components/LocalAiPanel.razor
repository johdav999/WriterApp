        var sourcePages = (allSections ? source.Sections : source.Sections.Where(s => s.SectionId == _section)).SelectMany(s => s.Pages.OrderBy(p => p.OrderIndex)).ToArray();
        if (sourcePages.Length > (allSections ? 2000 : 200) || sourcePages.Any(p => p.Content.Length > 500_000))
            throw new InvalidDataException($"Check a {(allSections ? "manuscript with at most 2,000" : "section with at most 200")} pages of supported size.");
