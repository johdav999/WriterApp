            if (page.PlainText.IndexOf(comparison.Quote, start + 1, StringComparison.Ordinal) >= 0) throw new InvalidDataException("The conflicting passage is ambiguous.");
            passage = new(page.PageId, page.PlainText, start, comparison.Quote, Guid.NewGuid(), current.DocumentId);
