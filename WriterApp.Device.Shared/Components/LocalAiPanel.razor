@implements IDisposable
@implements IAsyncDisposable
@inject LocalDocumentRepository Documents
@inject DeviceSyncEngine Sync
@inject DeviceAiService Ai
@inject LocalAiStore Store
@inject LocalAiHistoryActions HistoryActions
@inject DevicePromptLibrary CloudPrompts
@inject DeviceAccountService Account
@inject DeviceBibleService Bibles
@inject Microsoft.JSInterop.IJSRuntime JS
@inject IServiceProvider Services
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.JSInterop
@using WriterApp.Controllers
@using WriterApp.Shared.Canon
<div class="ai-workspace @(Mode == "consistency" ? "consistency-workspace" : null) @(Mode == "storyboard" ? "storyboard-workspace" : null) @(Mode == "synopsis" ? "synopsis-workspace" : null) @(FixedRequest ? "ai-workspace-fixed" : null)" role="@(FixedRequest ? "region" : null)" aria-label="@(FixedRequest ? Heading : null)" tabindex="@(FixedRequest ? "0" : null)">
<div class="ai-request">
@if (Mode != "history") { <h3>@(Mode == "consistency" ? "Find story inconsistencies" : Heading)</h3><p>@(Mode == "storyboard" ? "Trace story threads across the saved storyboard. Review gaps, pacing and unresolved threads in one report." : Mode == "consistency" ? "Find contradictions in characters, places and timing. Story references are prepared automatically. You decide which writing changes to apply." : Mode == "synopsis" ? "Running synopsis coaching sends your saved synopsis and coaching notes to your configured backend. Review field suggestions before Apply." : "Running AI sends saved scene context to your configured backend. Review every proposal before Apply.")</p> }
@if (Mode == "scene") {
<DeviceBiblePanel DocumentId="DocumentId" SectionId="SectionId" BeforeWork="BeforeWork" AfterWork="AfterWork"
    ExternalBusy="_busy" BusyChanged="BibleBusyChanged" />
}
@if(_document is not null && Mode != "history") {
<fieldset disabled="@(_busy || _bibleBusy)"><legend>@(Mode == "storyboard" ? "Analyze saved storyboard" : Mode == "synopsis" ? "Analyze saved synopsis" : "Analyze saved writing and planning")</legend>
@if (Mode == "storyboard") { var count = _document.Project?.Nodes.Count(n => n.NodeType == "scene" && n.DeletionId is null) ?? 0; <p class="storyboard-scope">Entire storyboard · @count scene@(count == 1 ? "" : "s")</p><p>Uses chapter order, subplot tags, summaries and key events from saved scene cards.</p> }
else if (Mode != "synopsis") { <p>Scene: @_document.Sections.FirstOrDefault(s => s.SectionId == _section)?.Title</p> }
@if(_action==AdvancedAiAction.Synopsis) {
<div class="synopsis-coaching-options">
<label>Synopsis coaching mode<select aria-label="Synopsis coaching mode" @bind="_synopsisMode"><option value="evaluate">Evaluate synopsis</option><option value="questions">Ask guiding questions</option><option value="suggest">Improve a field</option></select></label>
@if (_synopsisMode == "suggest") { <label>Synopsis target<select aria-label="Synopsis target" @bind="_field">@foreach(var f in WriterApp.Shared.SynopsisCoaching.Fields) { <option value="@f.Key">@f.Label</option> }</select></label> }
</div>
<p>Coaching uses all ten saved synopsis fields and your notes. Scenes and manuscript pages are not required.</p>
@if (_document.Project is null) { <p role="status">Choose a project manuscript before synopsis coaching.</p> }
else if (WriterApp.Shared.SynopsisCoaching.Fields.All(f=>string.IsNullOrWhiteSpace(WriterApp.Shared.SynopsisCoaching.Value(_document.Project.Synopsis ?? new(), f.Key)))) {
<p role="status">Your synopsis is empty. Guiding questions can help you start; field suggestions need synopsis details or coaching notes.</p>
}
}
@if (_action == AdvancedAiAction.SceneCard) {
<label>Scene coaching target<select aria-label="Scene coaching target" @bind="_sceneField"><option value="">Whole scene card</option>
@foreach (var field in Enum.GetValues<WriterApp.Application.Documents.SceneCoachingField>()) { <option value="@WriterApp.Application.Documents.SceneCoaching.Key(field)">@WriterApp.Application.Documents.SceneCoaching.Label(field)</option> }
</select></label>
<p>Links use exact IDs from current project canon and planning. Missing or stale canon cannot resolve new links. Narrative coaching remains available.</p>
<button type="button" @onclick="FindOpenQuestions">Find open questions</button>
}
@if (Mode == "prompts") {
<label>Saved local prompt<select @onchange="ChoosePrompt"><option value="">Choose prompt</option>@foreach(var p in _prompts) { <option value="@p.Id">@p.Name</option> }</select></label>
}
@if (Mode is "prompts" or "scene" or "synopsis" or "storyboard") {
<label>@(Mode == "storyboard" ? "Focus for this check (optional)" : Mode == "synopsis" ? "Notes for the coach (optional)" : "Instruction / coaching notes")<textarea @bind="_instruction" @bind:event="oninput" maxlength="2000" rows="3" placeholder="@(Mode == "storyboard" ? "For example: follow the family conflict through the final chapters…" : Mode == "synopsis" ? "For example: sharpen the stakes while keeping the ending unresolved…" : null)"></textarea></label>
<p>@(Mode == "storyboard" ? "Leave blank for a full continuity review. Add scene summaries or subplot tags when the board needs more context." : Mode == "synopsis" ? "These notes guide the request and remain separate from your authored synopsis notes." : "This text is used for reusable prompts and scene, storyboard or synopsis coaching. Consistency and style checks use their predefined instructions.")</p>
}
@if (Mode == "prompts") {
<label>New local prompt name<input @bind="_name" @bind:event="oninput" maxlength="100" /></label><button @onclick="SavePrompt">Save a new local prompt</button>
<p>Saving creates a new local copy. Cloud transfers require sign-in and create separate copies; there is no automatic merge or overwrite.</p>
<button @onclick="LoadCloud">Refresh cloud prompts</button>
@foreach (var local in _prompts) { <button @onclick="() => UploadPrompt(local)">Copy @local.Name to cloud</button> }
@if (Account.Generation == _cloudGeneration) { @foreach (var cloud in _cloudPrompts) { <button @onclick="() => ImportPrompt(cloud.Id)">Copy @cloud.Name to this device</button> } }
<p>Only account-wide custom prompts without extra parameters are supported. If an upload is interrupted, refresh the cloud list before retrying; the server may already have saved the copy.</p>
}
<button class="@(Mode is "consistency" or "storyboard" ? "primary consistency-run" : Mode == "synopsis" ? "primary synopsis-run" : null)" disabled="@(_document.ServerDocumentId is null || _document.DeletedAtUtc is not null || (_action == AdvancedAiAction.Synopsis ? _document.Project is null : _section == Guid.Empty))" @onclick="RunAi">@RunLabel</button>
@if (Mode == "consistency") { <p class="consistency-request-note">AI compares your saved scene with passages from this manuscript and available story references. Writing changes only when you apply a reviewed revision.</p> }
@if(_document.ServerDocumentId is null) { <p>Enable cloud sync explicitly in the document before running AI. Local prompts and history remain available.</p> }
</fieldset>
}
</div>
@if (_busy || _proposal is not null || _error is not null || _message is not null || Mode == "history") {
<div class="ai-response" role="region" aria-label="AI results and status" tabindex="@(FixedRequest ? "0" : null)">
@if(_busy) { <p role="status">@(_operation ?? (Mode == "history" ? "Updating AI history…" : "Working…"))</p><button @onclick="Cancel">Cancel request</button> }
@if(_proposal is not null && _prepared is not null) {
<section aria-label="Review AI result">
@if (Mode == "storyboard") { <p class="storyboard-result-source">Based on saved storyboard · revision @_prepared.Source.LocalRevision</p> }
else if (Mode != "synopsis") { <h2>@(Mode == "consistency" ? "Consistency review" : "Review AI result")</h2> }
@if (Mode == "synopsis") {
<p class="synopsis-result-source">Based on saved synopsis · revision @_prepared.Source.LocalRevision</p>
<details class="synopsis-result-details"><summary>Source details</summary><p>Cloud version: @_prepared.Source.ServerVersion</p></details>
}
else if (Mode is not ("consistency" or "storyboard")) { <p>Target: @(_prepared.Request.SynopsisRequest is not null ? _prepared.Target == LocalAiTarget.SynopsisField ? "Synopsis · " + WriterApp.Shared.SynopsisCoaching.Fields.Single(f=>f.Key==_prepared.Field).Label : "Synopsis feedback" : _prepared.Target.ToString()) · source revision @_prepared.Source.LocalRevision · cloud version @_prepared.Source.ServerVersion</p> }
@if (_runCanon is not null && _prepared.Request.Key == "continuity.check_section") {
@if (_runCanon.Snapshots.Count != 3) { <p class="consistency-coverage" role="status">Some story references could not be prepared. This check uses your writing and the available references.</p> }
<details class="consistency-analysis-context"><summary>Check coverage</summary><p>@string.Join(", ", Enum.GetValues<CanonKind>().Select(k => _runCanon.Snapshots.ContainsKey(k) ? k + " current" : k + " omitted")).</p>
<p>Missing reference links are not story inconsistencies and do not block the check.</p>
@foreach (var warning in _runCanon.UnresolvedReferences().Distinct()) { <p>@warning</p> }</details>
}
@if (_prepared.Request.SynopsisRequest is { } synopsisRequest) {
<SynopsisCoachingFeedback Mode="@(_prepared.Request.Key == "synopsis.evaluate" ? "evaluate" : _prepared.Request.Key == "synopsis.questions" ? "questions" : "suggest")"
    Field="@_prepared.Field" Original="@Original(_prepared)" Proposed="@_proposal.ProposedText" Feedback="@(_proposal.Summary ?? "")" Source="@synopsisRequest.SourceSynopsis" UserNotes="@synopsisRequest.UserNotes" />
} else if (_sceneReview is not null && _prepared.Target == LocalAiTarget.SceneCard) {
<SceneCoachingReview Changes="_sceneReview.Changes" Approved="_approvedSceneFields" ApprovedChanged="ApprovedSceneFieldsChanged" Busy="_busy" />
} else {
<AiResultPreview ActionKey="@_prepared.Request.Key" Original="@Original(_prepared)" Proposed="@_proposal.ProposedText" SceneCard="@AdvancedAiRequests.SceneProposal(_proposal)" StoryboardContext="@(_prepared.Request.Request.Parameters?.GetValueOrDefault("storyboard_context")?.ToString())"
    ReviewConsistencySuggestion="ReviewConsistencySuggestion" DiscardConsistencySuggestion="DiscardConsistencySuggestion" DiscardedConsistencySuggestions="_discardedSuggestions" ReviewingConsistencySuggestion="_consistencyPreview?.Index" Busy="IsBusy" AppliedConsistencySuggestions="_appliedSuggestions" JumpConsistency="JumpFinding" ConsistencyLocation="FindingLocation"
    JumpConsistencyComparison="JumpComparison" ConsistencyComparisonLocation="ComparisonLocation" MarkConsistencyIntentional="MarkIntentional" IntentionalConsistencySuggestions="_intentionalSuggestions">
<ConsistencySuggestionReview Context="index">
@if (_consistencyReviewIndex == index) {
    @if (_busy) { <p class="consistency-review-feedback" role="status">Preparing suggestion…</p> }
    @if (_error is not null) { <p class="consistency-review-feedback" role="alert">@_error</p> }
}
@if (_consistencyPreview is { } preview && preview.Index == index) {
<section class="consistency-approval" aria-label="Approve consistency suggestion">
<h3>Compare the wording</h3>
<AiTextComparison OriginalLabel="Current wording" ProposedLabel="@(preview.Revision.Delete ? "Suggested deletion" : "Suggested wording")" Original="@preview.Revision.Original" Proposed="@(preview.Revision.Delete ? "Remove this passage." : preview.Revision.Proposed)" />
<p>Apply @(preview.Revision.Delete ? "removes" : "replaces") only this passage. You can undo the saved change in History.</p>
<div class="consistency-approval-actions"><button class="primary" type="button" disabled="@IsBusy" @onclick="ApplyConsistencySuggestion">Apply suggestion</button>
<button type="button" disabled="@IsBusy" @onclick="() => DiscardConsistencySuggestion(index)">Discard suggestion</button></div>
</section>
}
</ConsistencySuggestionReview>
</AiResultPreview>
}
@if (_prepared.Target == LocalAiTarget.SynopsisField) { <p class="synopsis-apply-note">Apply updates only the reviewed @WriterApp.Shared.SynopsisCoaching.Fields.Single(f=>f.Key==_prepared.Field).Label field. You can undo the saved change in History.</p> }
<div class="ai-result-actions">
@if(_prepared.Target is LocalAiTarget.SceneCard or LocalAiTarget.SynopsisField) { <button class="@(_prepared.Target == LocalAiTarget.SynopsisField ? "primary" : null)" disabled="@(_busy || (_prepared.Target == LocalAiTarget.SceneCard && (_sceneReview is null || _approvedSceneFields.Count == 0)))" @onclick="Apply">@(_prepared.Target == LocalAiTarget.SynopsisField ? "Apply field suggestion" : "Apply to " + _prepared.Target + " only")</button> }
else if (_prepared.Request.Key == "continuity.check_section") { <p>Review and approve individual suggestions to update your writing. Applied revisions can be undone in History.</p> }
else if (_prepared.Request.SynopsisRequest is null) { <p>Analysis only. No manuscript changes will be applied.</p> }
<button disabled="@_busy" @onclick="() => _proposal=null">Dismiss</button></div></section>
}
@if(_error is not null) { <p role="alert">@_error</p> }
@if(_message is not null) { <p role="status">@_message</p> }
@if (Mode == "history") {
    @if (CloudHistory is { } cloudHistory) {
        <div class="history-cloud-controls" aria-label="Cloud history">
            <p>Local saves and recovery are independent of cloud reporting. @_pendingHistory event(s) await confirmation.</p>
            @if (cloudHistory.DeliveryError is { } deliveryError) { <p role="status">@deliveryError</p> }
            <button type="button" disabled="@(_busy || !cloudHistory.CanConnect || _document?.ServerDocumentId is null)" @onclick="LoadCloudHistory">Load cloud history</button>
            <button type="button" disabled="@(_busy || !cloudHistory.CanConnect || _pendingHistory == 0)" @onclick="DeliverHistory">Report saved events</button>
            @if (_cloudHistory?.Snapshot.Truncated == true) { <p>Cloud inspection is limited to 200 entries. Other retained entries are available in web history.</p> }
            <p>Cloud-only entries are comparisons. Undo and recovery use retained local snapshots. The combined list shows up to 200 entries.</p>
        </div>
    }
    <AiHistoryPanel Entries="HistoryItems" Busy="_busy" Recover="Recover" Refresh="RefreshHistory" Undo="UndoHistory" Redo="RedoHistory" Dismiss="DismissHistory" />
}
@if (Mode == "history") {
    @foreach (var pending in VisibleHistory.Where(h => h.Version == 5 && h.Status == "Applying")) {
        <p role="alert">An approved synopsis field save was interrupted. The original and approved field text are retained.</p>
        <button type="button" disabled="@_busy" @onclick="() => ResumeSynopsis(pending.Id)">Finish approved synopsis save</button>
    }
    @foreach (var pending in VisibleHistory.Where(h => h.Version == 4 && h.Status == "Applying")) {
        <p role="alert">An approved scene save was interrupted. Original and approved fields are retained.</p>
        <button type="button" disabled="@_busy" @onclick="() => ResumeScene(pending.Id)">Finish approved scene save</button>
    }
    @foreach (var pending in VisibleHistory.Where(h => h.Version == 3 && h.Status == "Applying" && h.Target.StartsWith("Writing:", StringComparison.Ordinal))) {
        <p role="alert">An approved writing save was interrupted. The complete original and reviewed writing are retained.</p>
        <button type="button" disabled="@_busy" @onclick="() => ResumeWriting(pending.Id)">Finish approved writing save</button>
    }
    @foreach (var pending in VisibleHistory.Where(h => h.Version == 2 && h.Status == "Applying" && h.Target.StartsWith("Translation:", StringComparison.Ordinal))) {
        <p role="alert">An approved translation save was interrupted. The complete original and translated preview are retained.</p>
        <button type="button" disabled="@_busy" @onclick="() => ResumeTranslation(pending.Id)">Finish approved translation save</button>
    }
    @foreach (var copy in VisibleHistory.Where(h => h.Target == "Translation:duplicate-document" && h.After is not null && h.Status == "Applied")) {
        <a href="@($"/documents/{copy.After!.DocumentId}")">Open translated copy</a>
    }
}
</div>
}
@if (Mode == "consistency") {
<details class="consistency-reference"><summary><span>Story reference</span><span>Characters, places & timeline</span></summary>
<DeviceBiblePanel DocumentId="DocumentId" SectionId="SectionId" BeforeWork="BeforeWork" AfterWork="AfterWork" ExternalBusy="_busy" BusyChanged="BibleBusyChanged" />
</details>
}
</div>
@code {
    [Parameter] public Guid DocumentId {get;set;}
    [Parameter] public Guid? SectionId {get;set;}
    [Parameter] public string Mode {get;set;} = "prompts";
    [Parameter] public bool FixedRequest {get;set;}
    [Parameter] public Func<Task<bool>>? BeforeWork {get;set;}
    [Parameter] public Func<Task>? AfterWork {get;set;}
    [Parameter] public EventCallback<ConsistencyPassage> JumpConsistency {get;set;}
    [Parameter] public EventCallback ClearConsistencyHighlight {get;set;}
    private DeviceCanonContext? _canon, _runCanon;
    private Dictionary<CanonKind, string> _canonStatus = [];
    private string? _operation;
    private IReadOnlyList<ConsistencyPageText> _reportPages = [];
    private long _accountGeneration;
    private bool _bibleBusy;
    public bool IsBusy => _busy || _bibleBusy;
    private bool _refineScene;
    private string _sceneField = "";
    private string _synopsisMode = "suggest";
    private LocalSceneReview? _sceneReview;
    private IReadOnlyList<WriterApp.Application.Documents.SceneCoachingField> _approvedSceneFields = [];
    private Task ApprovedSceneFieldsChanged(IReadOnlyList<WriterApp.Application.Documents.SceneCoachingField> fields) { _approvedSceneFields = fields; return Task.CompletedTask; }
    private Task FindOpenQuestions() { _sceneField = "openQuestions"; _refineScene = false; return RunAi(); }
    public Task SuggestSceneAsync(string instruction, bool refine = false)
    {
        if (Mode != "scene" || _busy) return Task.CompletedTask;
        _instruction = instruction; _refineScene = refine; _sceneField = ""; _action = AdvancedAiAction.SceneCard;
        return RunAi();
    }
    private (Guid, Guid?, string)? _loaded;
    private string Heading => Mode switch { "history" => "History", "consistency" => "Consistency Coach", "quality" => "Style & quality Coach", "scene" => "Scene card Coach", "synopsis" => "Synopsis coaching", "storyboard" => "Storyboard coaching", _ => "Prompt Library" };
    private string RunLabel => Mode switch { "consistency" => "Check consistency", "quality" => "Analyze style & quality", "scene" => "Suggest scene details", "synopsis" => _synopsisMode switch { "evaluate" => "Evaluate synopsis", "questions" => "Ask guiding questions", _ => "Improve synopsis field" }, "storyboard" => "Check subplot continuity", _ => "Preview prompt result" };
    private LocalDocument? _document; private Guid _section; private AdvancedAiAction _action;
    private string _field="logline",_instruction="",_name=""; private string? _error,_message;
    private bool _busy; private CancellationTokenSource? _cancel;
    private long _cloudGeneration = -1; private IReadOnlyList<PromptPresetDto> _cloudPrompts=[];
    private IReadOnlyList<LocalAiPrompt> _prompts=[]; private IReadOnlyList<LocalAiHistory> _history=[];
    private IReadOnlySet<Guid> _dismissedHistory = new HashSet<Guid>();
    private IEnumerable<LocalAiHistory> VisibleHistory => _history.Where(h => !_dismissedHistory.Contains(h.Id) && (h.CloudOrigin is null || h.CloudOrigin.Scope == CloudHistory?.Scope));
    private bool _accountSignedIn;
    private DeviceAiHistoryService? CloudHistory => Services.GetService<DeviceAiHistoryService>();
    private LocalCloudHistoryCache? _cloudHistory;
    private int _pendingHistory;
    private AdvancedAiPrepared? _prepared; private DeviceAiProposal? _proposal; private LocalAiHistory? _record;
    private readonly HashSet<int> _appliedSuggestions = [];
    private readonly HashSet<int> _discardedSuggestions = [];
    private readonly HashSet<int> _intentionalSuggestions = [];
    private LocalDocument? _consistencySource;
    private sealed record ConsistencyPreview(int Index, ConsistencyRevision Revision, LocalDocument Source, string AfterHtml, DeviceAiProposal? Generated = null);
    private ConsistencyPreview? _consistencyPreview;
    private int? _consistencyReviewIndex;
    private bool _disposed;
    protected override void OnInitialized()
    {
        Sync.Changed += OnDocumentChanged;
        Documents.Changed += OnDocumentChanged;
        _accountGeneration = Account.Generation; _accountSignedIn = Account.IsSignedIn; Account.Changed += AccountChanged;
    }
    private void AccountChanged()
    {
        if (_accountGeneration == Account.Generation && _accountSignedIn == Account.IsSignedIn) return;
        _accountGeneration = Account.Generation; _accountSignedIn = Account.IsSignedIn; Cancel();
        _cloudHistory = null; _pendingHistory = 0; _history = _history.Where(h => h.CloudOrigin is null).ToArray();
        _proposal = null; _sceneReview = null; _approvedSceneFields = []; _consistencyPreview = null; _runCanon = _canon = null; _canonStatus.Clear(); _intentionalSuggestions.Clear();
        if (!_disposed) _ = InvokeAsync(async () => { StateHasChanged(); await RefreshDocumentAsync(); StateHasChanged(); });
    }
    private async Task BibleBusyChanged(bool busy) { _bibleBusy = busy; if (!busy) await RefreshDocumentAsync(); }
    private async Task RefreshCanon()
    {
        _canon = null; _canonStatus.Clear();
        if (Mode is not ("consistency" or "scene") || _document is null || !Bibles.CanView) return;
        var source = _document; var generation = Account.Generation;
        var context = await Bibles.ContextAsync(source);
        var statuses = new Dictionary<CanonKind, string>();
        foreach (var kind in Enum.GetValues<CanonKind>()) {
            var cache = await Bibles.CachedAsync(source, kind);
            statuses[kind] = context.Snapshots.ContainsKey(kind) ? "Current" : cache?.RefreshState == "Interrupted" ? "Interrupted — omitted"
                : cache?.RefreshState == "Refreshing" ? "Refresh pending — omitted" : cache?.Snapshot?.Exists == true ? "Stale — omitted" : "Missing — omitted";
        }
        if (generation == Account.Generation && source.DocumentId == DocumentId) { _canon = context; _canonStatus = statuses; }
    }
    private readonly HashSet<Task> _documentRefreshes = [];
    private void OnDocumentChanged()
    {
        if (_disposed || _busy) return;
        var task=InvokeAsync(async () => { await RefreshDocumentAsync(); if (!_disposed) StateHasChanged(); });
        lock(_documentRefreshes)_documentRefreshes.Add(task);
        _=task.ContinueWith(completed=>{lock(_documentRefreshes)_documentRefreshes.Remove(completed);},TaskScheduler.Default);
    }
    private async Task RefreshDocumentAsync(bool afterWork = false)
    {
        if(_disposed)return;
        Guid id = DocumentId;
        try
        {
            var latest = await Documents.LoadAsync(id);
            if (!_disposed && (!_busy || afterWork) && DocumentId == id && latest is not null
                && (_document is null || _document.DocumentId != id || latest.LocalRevision >= _document.LocalRevision)) {
                _document = latest; await RefreshCanon();
                if (_proposal is not null && _prepared?.Request.SynopsisRequest is not null) {
                    try { AdvancedAiRequests.RequireFresh(latest,_prepared); }
                    catch (InvalidOperationException e) { _proposal=null; _error=e.Message; }
                }
                if (_sceneReview is not null && _proposal is not null) {
                    try { AdvancedAiRequests.RequireFresh(latest, _sceneReview.Prepared); if (_canon is not null) LocalConsistencyContext.RequireSameCanon(_sceneReview.Canon, _canon); }
                    catch (InvalidOperationException e) { _proposal = null; _sceneReview = null; _approvedSceneFields = []; _error = e.Message; }
                }
            }
        }
        catch (Exception e) when (e is IOException or InvalidOperationException or UnauthorizedAccessException or System.Text.Json.JsonException or DeviceSignInRequiredException)
        { if (!_disposed && (!_busy || afterWork) && DocumentId == id) _error = e.Message; }
    }
    private IReadOnlyList<AiHistoryItem> HistoryItems {
        get {
        var items = VisibleHistory.Select(h => {
        bool redo = h.Status is "Undone" or "Redoing";
        string? reason = _document is null ? "Document unavailable." : LocalAiHistoryActions.UnavailableReason(_document, h, redo);
        string target = h.Target;
        if (h.Version == 3) target = h.Target.Replace("Writing:", "Writing · ", StringComparison.Ordinal) + " · " + h.Before.Sections.FirstOrDefault(s => s.SectionId == h.SectionId)?.Title;
        else if (h.PageId is { } page) target = "Writing · " + (h.Before.Sections.SelectMany(s => s.Pages).FirstOrDefault(p => p.PageId == page)?.Title ?? "Page");
        else if (h.NodeId is { } node) target = "Scene details · " + h.Before.Project?.Nodes.FirstOrDefault(n => n.NodeId == node)?.Title;
        return new AiHistoryItem(h.Id, h.Action, target, h.Status, h.CreatedAt,
            h.Version == 4 ? LocalSceneCoaching.Readable(h,true) : h.OriginalText ?? (h.PageId is { } id ? h.Before.Sections.SelectMany(s=>s.Pages).FirstOrDefault(p=>p.PageId==id)?.Content ?? "" : "Original manuscript retained for recovery."),
            h.Version == 4 ? LocalSceneCoaching.Readable(h,false) : h.Version == 3 ? LocalWriting.ReadableProposal(h) : h.Proposed + (string.IsNullOrWhiteSpace(h.SynopsisCommentary) ? "" : "\n\nCoaching commentary:\n" + h.SynopsisCommentary), !redo && reason is null, redo && reason is null, reason);
    }).ToArray();
        return _document is not null && CloudHistory is { } cloud ? cloud.Combine(_document, items, _history, _cloudHistory, _dismissedHistory) : items;
        }
    }
    protected override async Task OnParametersSetAsync()
    {
        if (_loaded == (DocumentId, SectionId, Mode) || _busy) return;
        _loaded = (DocumentId, SectionId, Mode); _proposal = null; _sceneReview = null; _approvedSceneFields = []; _consistencyPreview = null; _consistencyReviewIndex = null; _appliedSuggestions.Clear(); _discardedSuggestions.Clear(); _error = null; _message = null;
        _action = Mode switch { "consistency" => AdvancedAiAction.Consistency, "quality" => AdvancedAiAction.StyleQuality,
            "scene" => AdvancedAiAction.SceneCard, "synopsis" => AdvancedAiAction.Synopsis, "storyboard" => AdvancedAiAction.Storyboard, _ => AdvancedAiAction.Custom };
        try { _document = await Latest(); _section = SectionId ?? AdvancedAiRequests.ActiveSections(_document).FirstOrDefault()?.SectionId ?? Guid.Empty;
            _prompts = await Store.PromptsAsync(); _history = await Store.HistoryAsync(DocumentId); await RefreshCanon(); await LoadHistoryCache(); }
        catch (Exception e) when (e is IOException or InvalidOperationException or UnauthorizedAccessException or System.Text.Json.JsonException or DeviceSignInRequiredException) { _error = e.Message; }
    }
    private async Task LoadHistoryCache(CancellationToken ct = default) {
        var document = DocumentId; var scope = CloudHistory?.Scope;
        var dismissed = await Store.DismissedHistoryAsync(document, scope, ct);
        if (DocumentId != document || CloudHistory?.Scope != scope) return;
        _dismissedHistory = dismissed;
        if (Mode != "history" || CloudHistory is not { } cloud || _document is null) return;
        _cloudHistory = await cloud.CachedAsync(_document,ct); _pendingHistory = await cloud.PendingAsync(DocumentId,ct);
    }
    private Task RefreshHistory() => Work(async ct => { _document = await Latest(ct); _history = await Store.HistoryAsync(DocumentId, ct); await LoadHistoryCache(ct); });
    private Task LoadCloudHistory() => Work(async ct => {
        var source = await Latest(ct); var generation = Account.Generation;
        var cache = await CloudHistory!.RefreshAsync(source,ct);
        if (generation == Account.Generation && source.DocumentId == DocumentId) _cloudHistory = cache;
    });
