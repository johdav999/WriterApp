            catch (Exception e) when(e is IOException or InvalidOperationException or UnauthorizedAccessException or System.Text.Json.JsonException or DeviceSignInRequiredException) { _error=e.Message; }
            _busy=false;_cancel=null;_operation=null;
            if (!_disposed) await InvokeAsync(StateHasChanged);
        } }
    }
