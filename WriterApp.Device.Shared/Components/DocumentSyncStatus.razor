@implements IDisposable
@inject DeviceSyncEngine Sync

@if (Compact)
{
    <div class="document-sync-bar">
        @if (Document.ServerDocumentId is null && Sync.Status(Document.DocumentId) is null)
        {
            <button type="button" class="panel-toggle" disabled="@Sync.IsRunning" @onclick="EnableAsync">Enable cloud sync</button>
        }
        <details class="document-sync-menu" open="@_showDetails">
            <summary title="Cloud sync status and actions" role="status">@(Sync.IsRunning ? "Syncing…" : Sync.LastError is not null ? "Sync failed" : Sync.Status(Document.DocumentId)?.Label ?? "Cloud sync details")</summary>
            <div class="document-sync-popover">@SyncDetails</div>
        </details>
    </div>
}
else
{
    @SyncDetails
}

@code {
    private RenderFragment SyncDetails => @<div class="document-sync-content">
@if (_actionError is not null) { <p role="alert">@_actionError</p> }
@if (Document.Project is not null)
{
    <p>Project and manuscript save on this device. Cloud synchronization requires a paid account and a project-aware backend.</p>
}
@if (Sync.Status(Document.DocumentId) is { } status)
{
    <div class="document-sync-details">
        <p role="status">@status.Label</p>
        @if (status.LastSynced is { } last) { <small>Last synchronized @last.ToLocalTime().ToString("g")</small> }
        @if (status.Error is not null) { <p role="alert">@status.Error</p><button disabled="@Sync.IsRunning" @onclick="RetryDocumentAsync">Retry after fixing</button> }
        @if (status.Conflict) { <a href="/sync/conflicts">Review both versions</a> }
        @if (Document.DeletedAtUtc is not null && !status.Deleted && !status.Conflict)
        {
            @if (!_confirm) { <button disabled="@Sync.IsRunning" @onclick="() => _confirm = true">Delete from cloud…</button> }
            else
            {
                <p>Permanently delete the cloud document on all devices? The local copy is retained.</p>
                <button disabled="@Sync.IsRunning" @onclick="DeleteAsync">Confirm cloud deletion</button>
                <button @onclick="() => _confirm = false">Cancel</button>
            }
        }
    </div>
}
else if (Document.ServerDocumentId is null && !Compact)
{
    <button disabled="@Sync.IsRunning" @onclick="EnableAsync">Enable cloud sync for this @(Document.Project is null ? "document" : "project")</button>
}
else if (Document.ServerDocumentId is not null) { <p>Sign in to the linked account to synchronize this document.</p> }
<p role="@(Sync.LastError is null ? "status" : "alert")">@(Document.ServerDocumentId is null && Sync.Status(Document.DocumentId) is null && !Sync.IsRunning && Sync.LastError is null ? "Saved only on this device." : Sync.Message)</p>
@if (Sync.LastError is not null)
{
    <button type="button" disabled="@Sync.IsRunning" @onclick="RetryAsync">Retry cloud sync</button>
}
    </div>;

    [Parameter, EditorRequired] public LocalDocument Document { get; set; } = default!;
    [Parameter] public bool Compact { get; set; }
    [Parameter] public Func<Task<bool>>? BeforeSync { get; set; }
    [Parameter] public EventCallback AfterSync { get; set; }
    private string? _actionError;
    private bool _confirm;
    private bool _showDetails;
    private Task EnableAsync() => RunSyncAsync(() => Sync.EnableAsync(Document.DocumentId));
    private Task RetryDocumentAsync() => RunSyncAsync(() => Sync.RetryAsync(Document.DocumentId));
    private Task RetryAsync() => RunSyncAsync(async () =>
    {
        if (Document.ServerDocumentId is null && Sync.Status(Document.DocumentId) is null) await Sync.EnableAsync(Document.DocumentId);
        else await Sync.SyncAsync();
    });
    private async Task RunSyncAsync(Func<Task> sync)
    {
        _actionError=null;
        try {
            if (BeforeSync is not null && !await BeforeSync()) {
                _actionError="Saving failed. Your writing and message are retained. Retry saving before cloud sync.";
                return;
            }
            await sync();
            await AfterSync.InvokeAsync();
        }
        catch (Exception e) when (e is IOException or InvalidOperationException or UnauthorizedAccessException or Microsoft.JSInterop.JSException) {
            _actionError="Cloud sync stopped. Your writing and message are retained. " + e.Message;
        }
        finally { _showDetails=_actionError is not null || Sync.LastError is not null; }
    }
    protected override void OnInitialized() => Sync.Changed += Updated;
    private void Updated() => _ = InvokeAsync(StateHasChanged);
    private async Task DeleteAsync() { await Sync.DeleteAsync(Document.DocumentId); _confirm = false; }
    public void Dispose() => Sync.Changed -= Updated;
}
